;;; Curved road-aligned ICE geometry, batched in one draw before machines.
;;; Meshes change only with hazard state, not every frame. Old GPU resources
;;; are released explicitly. Reduced motion keeps the same static warnings.
(define-library (signal ice draw)
  (import (sigil math)
          (sigil graphics)
          (signal track)
          (signal ice runtime)
          (signal mode7 camera)
          (signal mode7 render))
  (export ice-draw-init! ice-draw-prepare! draw-live-ice!)
  (begin
    (define VERTEX
      "uniform vec4 cam;\nuniform vec4 proj;\nuniform vec4 view;\nuniform vec4 bend;\nin vec3 position;\nin vec4 color;\nout vec4 v_color;\nout vec2 v_world;\nout float v_along;\nvoid main() {\n vec2 fw=vec2(sin(cam.w),-cos(cam.w));\n vec2 rt=vec2(cos(cam.w),sin(cam.w));\n vec3 d=position-vec3(cam.xyz);\n float along=dot(d.xy,fw);\n float depth=along*cos(proj.z)-d.z*sin(proj.z);\n float side=dot(d.xy,rt);\n float up=along*sin(proj.z)+d.z*cos(proj.z);\n float sx=view.x*0.5+proj.x*side/depth;\n float sy=proj.y-proj.x*up/depth;\n float bu=clamp((view.y-sy)/(view.y-proj.w),0.0,1.0);\n sy+=bend.x*bu*bu;\n gl_Position=vec4((2.0*sx/view.x-1.0)*depth,(1.0-2.0*sy/view.y)*depth,depth-8.0,depth);\n v_color=color;v_world=position.xy;v_along=along;\n}\n")
    (define FRAGMENT
      "uniform vec4 fog;\nuniform vec4 fogc;\nin vec4 v_color;\nin vec2 v_world;\nin float v_along;\nout vec4 frag_color;\nvoid main(){\n if(v_color.w<0.5 && mod(floor(v_world.x/5.0)+floor(v_world.y/5.0),4.0)>0.5)discard;\n if(v_color.w>0.5 && v_color.w<1.5 && mod(floor(v_world.x/4.0)+floor(v_world.y/4.0),2.0)>0.5)discard;\n if(v_color.w>2.5 && mod(floor(gl_FragCoord.x)+floor(gl_FragCoord.y),2.0)>0.5)discard;\n vec3 c=v_color.rgb;\n if(fog.z>0.5)c=mix(c,fogc.rgb,smoothstep(fog.x,fog.y,v_along)*fogc.a);\n frag_color=vec4(c,1.0);\n}\n")
    (define *layout* #f)
    (define *pipeline* #f)
    (define *mesh* #f)
    (define *key* #f)
    (define (v4 a b c d)
      (map exact->inexact (list a b c d)))

    (define (ice-draw-init!)
      (set! *layout* (make-vertex-layout '((position float3) (color float4))))
      (set! *pipeline*
        (make-pipeline *layout*
          (string-append (glsl-header) VERTEX)
          (string-append (glsl-header) FRAGMENT)
          '(depth-test #f depth-write #f cull none))))

    (define (point t s u z)
      (let ((p (track-point t s u))) (list (car p) (cadr p) z)))

    (define (build-vertices t active warnings)
      (let ((floats '()))
        (define (vertex! p color style)
          (for-each (lambda (value) (set! floats (cons value floats)))
                    (append p color (list style))))
        (define (quad! a b c d color style)
          (for-each (lambda (p) (vertex! p color style)) (list a b c a c d)))
        (define (floor! from to left right color style)
          (let loop ((s from))
            (when (< s to)
              (let ((end (min to (+ s 16.0))))
                (quad! (point t s left 0.15) (point t s right 0.15)
                       (point t end right 0.15) (point t end left 0.15) color style)
                (loop end)))))
        (define (drone! s u color)
          (let ((wing (/ 8.0 (track-hw t (track-index-at t s))))
                (body (/ 2.0 (track-hw t (track-index-at t s)))))
            (quad! (point t (- s 5.0) (- u wing) 18.0)
                   (point t (- s 5.0) (+ u wing) 18.0)
                   (point t (+ s 5.0) (+ u wing) 18.0)
                   (point t (+ s 5.0) (- u wing) 18.0) color 2.0)
            (quad! (point t s (- u body) 14.0) (point t s (+ u body) 14.0)
                   (point t s (+ u body) 22.0) (point t s (- u body) 22.0) color 2.0)))
        (define (zone! owned warning?)
          (let* ((kind (cadr owned))
                 (zone (list-ref owned 3))
                 (from (car zone)) (to (cadr zone))
                 (left (caddr zone)) (right (cadddr zone))
                 (color (if warning? '(1.0 0.8 0.2) '(1.0 0.624 0.102))))
            (floor! from to left right color (if warning? 0.0 1.0))
            ;; The two side lines always show the exact occupied footprint.
            (let ((edge (/ 2.0 (track-hw t (track-index-at t from)))))
              (floor! from to left (min right (+ left edge)) color 2.0)
              (floor! from to (max left (- right edge)) right color 2.0))
            (unless warning?
              (let loop ((s from))
                (when (< s to)
                  (cond
                    ((string=? kind "firewall")
                     (quad! (point t s left 0.2) (point t s right 0.2)
                            (point t s right 22.0) (point t s left 22.0) color 3.0))
                    ((string=? kind "drone")
                     (for-each (lambda (f) (drone! s (+ left (* f (- right left))) color))
                               '(0.2 0.5 0.8))))
                  (loop (+ s 64.0)))))))
        (for-each (lambda (zone) (zone! zone #t)) warnings)
        (for-each (lambda (zone) (zone! zone #f)) active)
        (let* ((values (reverse floats))
               (bytes (make-bytevector (* 4 (length values)) 0)))
          (let write ((remaining values) (offset 0))
            (unless (null? remaining)
              (bytevector-ieee-single-set! bytes offset (exact->inexact (car remaining)) 'little)
              (write (cdr remaining) (+ offset 4))))
          bytes)))

    ;; Graphics forbids freeing GPU resources inside a 3D pass. Prepare
    ;; state transitions before the pass; drawing only submits the cache.
    (define (ice-draw-prepare! t state)
      (when *pipeline*
        (let* ((active (ice-state-active state))
               (warnings (ice-state-telegraphs state))
               (key (list (track-name t) active warnings)))
          (unless (equal? key *key*)
            (when *mesh* (mesh-free! *mesh*) (set! *mesh* #f))
            (unless (and (null? active) (null? warnings))
              (set! *mesh* (make-mesh *layout* (build-vertices t active warnings))))
            (set! *key* key)))))

    (define (draw-live-ice! c)
      (when (and *pipeline* *mesh*)
            (let ((look (mode7-ground-look)))
              (set-pipeline-uniform! *pipeline* 'cam (v4 (cam-x c) (cam-y c) (cam-height c) (cam-heading c)))
              (set-pipeline-uniform! *pipeline* 'proj (v4 (cam-focal c) (cam-cy c) (cam-pitch c) (cam-horizon c)))
              (set-pipeline-uniform! *pipeline* 'view (v4 (cam-w c) (cam-h c) 0 0))
              (set-pipeline-uniform! *pipeline* 'bend (v4 (caddr look) 0 0 0))
              (set-pipeline-uniform! *pipeline* 'fog (car look))
              (set-pipeline-uniform! *pipeline* 'fogc (cadr look))
              (draw-mesh *pipeline* *mesh*))))))
