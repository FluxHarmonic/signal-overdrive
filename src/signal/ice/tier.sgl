;;; Resolve difficulty into the same immutable schedule contract the runtime
;;; and gate execute. Existing authored footprints and cadence stay intact.
(define-library (signal ice tier)
  (import (signal tiers))
  (export ice-tier-contract)
  (begin
    (define (ice-tier-contract contract tier)
      (let* ((rules (list-ref contract 4))
             (tracer (list-ref contract 7))
             (telegraph (max (list-ref rules 7)
                             (tier-value tier 'telegraph-bars))))
        (list (car contract)
              (list-ref contract 1)
              (list-ref contract 2)
              (list-ref contract 3)
              (list (list-ref rules 0)
                    (list-ref rules 1)
                    (list-ref rules 2)
                    (list-ref rules 3)
                    (list-ref rules 4)
                    (list-ref rules 5)
                    (list-ref rules 6)
                    telegraph
                    (list-ref rules 8))
              (list-ref contract 5)
              (list-ref contract 6)
              (list (car tracer)
                    (cadr tracer)
                    (max (caddr tracer)
                         (tier-value tier 'tracer-every-bars)))
              (tier-value tier 'ice-every-bars))))))
