;;; Pure consumer of the generated track-ice-schedule contract.
;;; Bar timing, phrase seeds, ownership reservations and neighbour corridors
;;; match scripts/track/schedule.mjs and combined-ice.mjs. No rivals or device.
;;; Crossings are lap1 through finish ticks; #f means not observed yet.
;;; Owned zones are (owner kind layout (from to left right)), arc texels.
(define-library (signal ice schedule)
  (import (sigil math))
  (export ice-bar->tick ice-tick->bar ice-zones-at ice-tracer-slot ice-corridor?
          ice-zone-reservation)
  (begin
    (define (rule c i) (list-ref (list-ref c 4) i))
    (define (wrap value length)
      (- value (* (floor (/ value length)) length)))
    (define (ice-bar->tick c bar)
      (exact (ceiling (/ (* bar 32 60 5 3) (* (list-ref c 3) 2)))))
    (define (ice-tick->bar c tick)
      (exact (floor (/ (* tick (list-ref c 3) 2) (* 32 60 5 3)))))
    (define (first-bar c tick)
      (let ((bar (ice-tick->bar c tick)))
        (if (< (ice-bar->tick c bar) tick) (+ bar 1) bar)))

    (define (layer-live? c layer crossings tick)
      (and (car crossings)
           (>= tick (car crossings))
           (or (not (list-ref crossings 3)) (< tick (list-ref crossings 3)))
           (or (string=? (cadr layer) "seeded-static")
               (let ((bar (ice-tick->bar c tick))
                     (crossing (list-ref crossings (- (list-ref layer 2) 1))))
                 (and crossing
                      (>= bar (+ (first-bar c crossing)
                                 (rule c 7)))
                      ;; Tier density removes bars from the authored schedule.
                      ;; It never turns a down bar into an up bar.
                      (= (modulo bar (if (> (length c) 8) (list-ref c 8) 1)) 0)
                      (< (modulo (+ bar (list-ref layer 6))
                                 (+ (list-ref layer 4) (list-ref layer 5)))
                         (list-ref layer 4)))))))

    (define (ice-zones-at c crossings seed tick)
      (let loop ((layers (list-ref c 6)) (remaining seed))
        (if (null? layers)
            '()
            (let* ((layer (car layers))
                   (layouts (list-ref layer 7))
                   (count (length layouts))
                   (digit (modulo remaining count))
                   (bar (ice-tick->bar c tick))
                   (phrase (if (or (string=? (cadr layer) "seeded-static")
                                   (= (list-ref layer 3) 0))
                               0
                               (exact (floor (/ (+ bar (list-ref layer 6))
                                                (list-ref layer 3))))))
                   (layout (list-ref layouts (modulo (+ digit phrase) count))))
              (append
                (if (layer-live? c layer crossings tick)
                    (map (lambda (zone) (list (car layer) (cadr layer) (car layout) zone))
                         (cadr layout))
                    '())
                (loop (cdr layers) (quotient remaining count)))))))

    (define (inside? c zone s)
      (<= (wrap (- s (car zone)) (list-ref c 1))
          (+ (- (cadr zone) (car zone)) 1e-8)))
    (define (intervals-at c zones s)
      (let loop ((remaining zones))
        (cond
          ((null? remaining) '())
          ((inside? c (list-ref (car remaining) 3) s)
           (cons (cddr (list-ref (car remaining) 3)) (loop (cdr remaining))))
          (else (loop (cdr remaining))))))

    (define (widest intervals)
      ;; Every free component starts at-1 or at an occupied right endpoint.
      (let loop ((edges (cons -1.0 (map cadr intervals))) (best 0.0))
        (if (null? edges)
            best
            (let ((edge (car edges)))
              (let scan ((remaining intervals) (next 1.0) (blocked? #f))
                (if (null? remaining)
                    (loop (cdr edges) (if blocked? best (max best (- next edge))))
                    (let ((left (caar remaining)) (right (cadar remaining)))
                      (scan (cdr remaining)
                            (if (> left edge) (min next left) next)
                            (or blocked? (and (<= left edge) (< edge right)))))))))))

    (define (ice-corridor? c zones)
      (let* ((length (list-ref c 1))
             (half-width (list-ref c 2))
             (points (append (list 0.0 length)
                             (apply append
                                    (map (lambda (owned)
                                           (let ((zone (list-ref owned 3)))
                                             (list (wrap (car zone) length)
                                                   (wrap (cadr zone) length))))
                                         zones)))))
        (let loop ((remaining points))
          (or (null? remaining)
              (let* ((a (car remaining)) (ia (intervals-at c zones a)))
                (and (>= (+ (* half-width (widest ia)) 1e-8) (rule c 0))
                     (let pairs ((others (cdr remaining)))
                       (or (null? others)
                           (let* ((b (car others))
                                  (distance (min (wrap (- a b) length)
                                                 (wrap (- b a) length))))
                             (and (or (>= distance (- (rule c 1) 1e-8))
                                      (>= (+ (* half-width
                                                (widest (append ia (intervals-at c zones b))))
                                             1e-8)
                                          (rule c 0)))
                                  (pairs (cdr others))))))
                     (loop (cdr remaining))))))))

    (define (contains-zone? c stretch zone)
      (let* ((length (list-ref c 1))
             (span (- (list-ref stretch 2) (list-ref stretch 1)))
             (offset (wrap (- (car zone) (list-ref stretch 1)) length))
             ;; A computed endpoint a few ulps below the stretch start
             ;; wraps to almost a full lap. Apply the same1e-8 containment
             ;; tolerance at that edge as at the far edge.
             (offset (if (>= offset (- length 1e-8)) 0.0 offset)))
        (or (>= span (- length 1e-8))
            (<= (+ offset (- (cadr zone) (car zone))) (+ span 1e-8)))))

    (define (overlaps-stretch? c stretch zone)
      (let* ((length (list-ref c 1))
             (from (list-ref stretch 1))
             (to (list-ref stretch 2)))
        (or (inside? c (list from to) (car zone))
            (inside? c (list from to) (cadr zone))
            (inside? c zone from)
            (inside? c zone to))))

    ;; Common ownership/corridor admission for a tracer or Void's wake.
    ;; until includes the hazard's life PLUS a bar. Extra zones are other
    ;; dynamic hazards already announced or live; prior reservations cover
    ;; their whole merged stretch, not just their visible footprint.
    (define (ice-zone-reservation c crossings seed tick until zone . more)
      (let ((reservations (if (pair? more) (car more) '()))
            (extra (if (> (length more) 1) (cadr more) '()))
            (live-until (if (> (length more) 2) (caddr more) until)))
        (and (car crossings)
             (integer? seed)
             (>= seed 0)
             (> until tick)
             (<= (car zone) (cadr zone))
             (<= -1.0 (caddr zone)) (< (caddr zone) (cadddr zone))
             (<= (cadddr zone) 1.0)
             (or (not (list-ref crossings 3)) (< tick (list-ref crossings 3)))
             (let find ((stretches (list-ref c 5)))
               (and (pair? stretches)
                    (let ((stretch (car stretches)))
                      (if (not (contains-zone? c stretch zone))
                          (find (cdr stretches))
                          (and
                            (let unknown ((layers (list-ref c 6)))
                              (or (null? layers)
                                  (let ((layer (car layers)))
                                    (and (not (and (not (string=? (cadr layer) "seeded-static"))
                                                   (member (car layer) (list-ref stretch 3))
                                                   (not (list-ref crossings (- (list-ref layer 2) 1)))))
                                         (unknown (cdr layers))))))
                            (let reserve ((at tick))
                              (or (>= at until)
                                  (and
                                    (let owners ((zones (ice-zones-at c crossings seed at)))
                                      (or (null? zones)
                                          (and (not (and (member (caar zones) (list-ref stretch 3))
                                                         (overlaps-stretch? c stretch (list-ref (car zones) 3))))
                                               (owners (cdr zones)))))
                                    (or (>= at live-until)
                                        (ice-corridor? c
                                          (cons (list "$dynamic" "dynamic" "target" zone)
                                                (append extra (ice-zones-at c crossings seed at)))))
                                    (reserve (ice-bar->tick c (+ (ice-tick->bar c at) 1))))))
                            (let dynamic ((remaining extra))
                              (or (null? remaining)
                                  (and (not (overlaps-stretch? c stretch (list-ref (car remaining) 3)))
                                       (dynamic (cdr remaining)))))
                            (let prior ((remaining reservations))
                              (or (null? remaining)
                                  (and (not (and (= (list-ref (car remaining) 2) (car stretch))
                                                 (< (caar remaining) until)
                                                 (< tick (cadar remaining))))
                                       (prior (cdr remaining)))))
                            (list (car stretch) until)))))))))

    ;; Returns #f (wait) or (stretch-id reserved-until centre telegraph-tick).
    ;; Prior reservations are (strike-tick reserved-until stretch-id).
    (define (ice-tracer-slot c crossings seed tick target-s u . more)
      (let* ((settings (list-ref c 7))
             (bar (ice-tick->bar c tick))
             (crossing (list-ref crossings (- (cadr settings) 1)))
             (start (and crossing (+ (first-bar c crossing) (rule c 7))))
             (center (wrap (+ target-s (rule c 5)) (list-ref c 1)))
             (until (+ (ice-bar->tick c (+ bar (rule c 8))) (rule c 6)))
             (reservations (if (pair? more) (car more) '()))
             (extra (if (> (length more) 1) (cadr more) '()))
             (zone (list (- center (rule c 3)) (+ center (rule c 3))
                         (max -1.0 (- u (/ (rule c 4) (list-ref c 2))))
                         (min 1.0 (+ u (/ (rule c 4) (list-ref c 2)))))))
        (and (car settings) crossing
             (<= (abs u) (+ (- 1.0 (/ 9.0 (list-ref c 2))) 1e-8))
             (= tick (ice-bar->tick c bar))
             (>= bar start)
             (= (modulo (- bar start) (caddr settings)) 0)
             (let ((slot (ice-zone-reservation c crossings seed tick until zone reservations extra
                                              (+ tick (rule c 6)))))
               (and slot
                    (list (car slot) (cadr slot) center
                          (ice-bar->tick c (- bar (rule c 7)))))))))))
