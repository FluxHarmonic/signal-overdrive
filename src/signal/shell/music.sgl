;;; Device adapter for the simulation-owned song. The engine and cues
;;; share its context but keep their own output paths. No device opens
;;; here: the shell passes an already-open context after a user gesture.
(define-library (signal shell music)
  (import (sigil math)
          (sigil list)
          (sigil time)
          (sigil audio sink)
          (motif tune)
          (signal music score)
          (signal music conductor)
          (signal music clock)
          (signal music transport)
          (signal music playback)
          (signal music inserts))
  (export music-start! music-frame! music-close! music-reset! music-running?
          music-audible-seconds music-depth! music-latency! music-readout
          music-request-resync! music-resync-in-flight? music-log music-sabotage! music-generation
          music-hold! music-release-at!)
  (begin
    (define PUSH 256)
    (define *ctx* #f)
    (define *stream* #f)
    (define *generation* 0)
    (define *playback* #f)
    (define *tune* #f)
    (define *rate* 44100)
    (define *depth-ms* 250)
    (define *latency* (cond-expand (wasm 0.0) (else 0.035)))
    (define *epoch* 0.0)
    (define *epoch-changes* '())
    (define *resync-pending* #f)
    (define *resyncs* 0)
    (define *resync-cancels* 0)
    (define *last-resync-bar* -1)
    (define *subtract-depth* #t)
    (define *handoff-mode* 'planned)
    (define *delivered* 0)
    (define *silence* 0)
    (define *start-conductor* #f)
    (define *last-tick* -1)
    (define *first-log* #f)
    (define *underruns* 0)
    (define *underruns-all* 0)
    (define *cost-ms* 0.0)
    (define *buf* (make-bytevector (* 8 PUSH) 0))
    (define *zero* (make-bytevector (* 8 PUSH) 0))

    ;; The song's way in after the card: held (silent) until the shell
    ;; names a release time, then a linear fade-in over *fade-secs* from it,
    ;; then done: no envelope, so later restarts and pauses sound as before.
    ;; It is the stream's volume, which both sinks apply as the device plays
    ;; (0 is silence), set each frame from the song time being heard: the
    ;; samples keep flowing, so the song keeps its place against the
    ;; simulation, and none sounds before the release. Times are song
    ;; seconds (the conductor's tick / 60). A release known ahead (the
    ;; card's lock) lands on its frame; one named late (a skip) starts the
    ;; fade at what is heard then. The earliest release named wins. Off
    ;; until music-hold! (the shell's boot).
    (define *env* 'done)          ; held, done, or the release in song seconds
    (define *fade-secs* 0.8)
    (define *volume* #f)          ; the stream's volume as last set
    (define (music-hold!) (set! *env* 'held))
    (define (music-release-at! t fade)
      (unless (eq? *env* 'done)
        (set! *fade-secs* (max 0.0 fade))
        (let* ((heard (music-audible-seconds))
               (t (if heard (max t heard) t)))
          (set! *env* (if (number? *env*) (min *env* t) t)))))
    (define (env-gain t)
      (cond ((eq? *env* 'done) 1.0)
            ((eq? *env* 'held) 0.0)
            ((< t *env*) 0.0)
            ((<= *fade-secs* 0.0) 1.0)
            (else (min 1.0 (/ (- t *env*) *fade-secs*)))))
    ;; The stream's volume for song time heard; past the fade, the envelope
    ;; is done.
    (define (env-volume! heard)
      (when *stream*
        (let ((g (env-gain heard)))
          (when (and (number? *env*) (>= g 1.0)) (set! *env* 'done))
          (unless (eqv? g *volume*)
            (set-audio-stream-volume! *stream* g)
            (set! *volume* g)))))

    (define (music-depth! ms)
      (set! *depth-ms* (max 10 (min 2000 ms))))

    ;; Explicit diagnostic arms; the game ships the normal path by default.
    (define (music-sabotage! arm)
      (set! *subtract-depth* (not (eq? arm 'depth)))
      (set! *handoff-mode* (if (eq? arm 'immediate) 'immediate 'planned)))

    ;; WebAudio reports outputLatency + baseLatency, in seconds.
    (define (music-latency! seconds)
      (set! *latency* (max 0.0 seconds)))

    (define (depth-frames)
      (exact (ceiling (* *rate* *depth-ms* 0.001))))

    (define (music-running?)
      (and *stream* *ctx* (eq? (audio-context-state *ctx*) 'running)))

    (define (music-generation) *generation*)

    (define (music-audible-seconds)
      (and *stream*
           (let ((heard (* *rate* (audible-seconds *delivered*
                                                  (if *subtract-depth* (audio-stream-depth *stream*) 0)
                                                  *rate* *latency* 0))))
             ;; A seek changes time when its first corrected sample
             ;; reaches the ear, after the queue and device latency.
             (let apply-epochs ()
               (when (and (pair? *epoch-changes*)
                          (>= heard (caar *epoch-changes*)))
                 (set! *epoch* (cdar *epoch-changes*))
                 (set! *epoch-changes* (cdr *epoch-changes*))
                 (apply-epochs)))
             (+ *epoch* (/ heard *rate*)))))

    (define (music-request-resync!)
      (when *stream* (set! *resync-pending* #t)))

    ;; A resync is in flight from its request until its first corrected
    ;; sample is heard. Reading the ear first applies any change heard by
    ;; now.
    (define (music-resync-in-flight?)
      (music-audible-seconds)
      (or *resync-pending* (pair? *epoch-changes*)))

    (define (music-log)
      (if *playback* (reverse (playback-log *playback*)) '()))

    (define (music-close!)
      (when *stream*
        (set! *underruns* (+ *underruns* (audio-stream-underruns-sounding *stream*)))
        (set! *underruns-all* (+ *underruns-all* (audio-stream-underruns *stream*)))
        ;; Closing discards queued song time. Paused wall time can never
        ;; drain or advance the new stream's epoch on resume.
        (close-audio-stream! *stream*)
        (set! *stream* #f))
      (when *playback*
        (playback-close! *playback*)
        (set! *playback* #f))
      (set! *resync-pending* #f)
      (set! *epoch-changes* '()))

    ;; A new shell session must bind its own current context. Closing
    ;; alone retains context for ordinary pause/resume within a session.
    (define (music-reset!)
      (music-close!)
      (set! *ctx* #f))

    (define (music-start! ctx c)
      (set! *ctx* ctx)
      (when (and ctx (not *stream*)
                 (eq? (audio-context-state ctx) 'running))
        (unless *tune* (set! *tune* (read-tune-string SCORE-TUNE-TEXT)))
        (set! *rate* (audio-context-sample-rate ctx))
        (let ((plan (transport-start c *rate*)))
          ;; Construct all voice/insert graphs before exposing an empty
          ;; ring to the device callback. This also applies on restart.
          (set! *playback* (playback-open *tune* *rate*
                                        (transport-start-conductor plan) MUSIC-INSERTS
                                        mode: *handoff-mode*))
          (set! *epoch* (transport-start-epoch plan))
          (set! *last-resync-bar* -1)
          (set! *start-conductor* (transport-start-conductor plan))
          (set! *silence* (transport-start-silence plan))
          (set! *delivered* 0)
          (set! *last-tick* (conductor-tick c))
          (set! *first-log* (car (reverse (conductor-log c))))
          (guard (e (#t (music-close!) (raise e)))
            (let* ((frames (depth-frames))
                   (samples (prime-playback! c frames)))
              (set! *stream*
                (open-audio-stream channels: 2 rate: *rate*
                                   buffer-frames: (max 8192 (* 2 frames))))
              (if *stream*
                  (let ((accepted (begin
                                    ;; the envelope's volume before any sample
                                    (set! *volume* #f)
                                    (env-volume! *epoch*)
                                    (push-audio-samples *stream* samples frames))))
                    (unless (= accepted frames)
                      (error "music sink refused initial queue" frames accepted))
                    (set! *delivered* accepted)
                    (set! *generation* (+ *generation* 1)))
                  (begin
                    (playback-close! *playback*)
                    (set! *playback* #f))))))))

    ;; Prepare the initial queue with no published stream. Silence stays
    ;; zero-filled; normal pulls retain the same 256-frame handoff checks.
    (define (prime-playback! c frames)
      (let ((samples (make-bytevector (* 8 frames) 0)))
        (let pull ((offset 0))
          (when (< offset frames)
            (let* ((silence? (> *silence* 0))
                   (n (min PUSH (- frames offset)
                           (if silence? *silence* PUSH))))
              (if silence?
                  (set! *silence* (- *silence* n))
                  (playback-pull! *playback*
                                  (if (< (conductor-tick c) (conductor-tick *start-conductor*))
                                      *start-conductor*
                                      c)
                                  samples (* 8 offset) n))
              (pull (+ offset n)))))
        samples))

    (define (music-frame! c paused?
                          (keys: (clock-fraction 0.0) (frame-jiffy #f)))
      (let ((t0 (current-jiffy)))
        ;; A restart replaces the conductor's initial log even when it
        ;; occurs before another tick. Its tick also returns to zero.
        (when (and *stream*
                   (or paused?
                       (< (conductor-tick c) *last-tick*)
                       (not (eq? *first-log* (car (reverse (conductor-log c)))))))
          (music-close!))
        (unless paused? (music-start! *ctx* c))
        (when (and (music-running?) (not paused?))
          ;; Bound producer work to the deficit observed at frame entry.
          ;; Callback consumption during rendering belongs to the next
          ;; frame, otherwise a slow pull/GC grows this loop's own work.
          (let loop ((remaining (max 0 (- (depth-frames) (audio-stream-depth *stream*)))))
            (let* ((room (audio-stream-room *stream*))
                   (available (min PUSH room remaining))
                   (silence? (> *silence* 0))
                   (seek? (and *resync-pending* (not silence?)
                               (not (= *last-resync-bar* (conductor-bar c)))
                               (playback-can-resync? *playback*)))
                   (boundary (and seek? (playback-bar-distance *playback*)))
                   (n (cond
                        (silence? (min available *silence*))
                        (boundary (min available boundary))
                        (else available))))
              (when (and (> available 0) boundary (= boundary 0))
                ;; Conductor state is dated at frame entry; depth is
                ;; sampled now. Include intervening simulation/refill
                ;; work so callback consumption cannot bias the seek.
                (let* ((elapsed (/ (- (current-jiffy) (or frame-jiffy t0))
                                   (* 1.0 (jiffies-per-second))))
                       ;; The request can be up to a bar old, and the
                       ;; nudge may have closed the gap since: measure it
                       ;; again, heard now against the simulation now.
                       (gap (- (music-audible-seconds)
                               (+ (/ (conductor-tick c) 60.0) clock-fraction elapsed))))
                  (if (> (abs gap) RESYNC-GAP)
                      (let* ((ahead (+ (/ (audio-stream-depth *stream*) (* 1.0 *rate*))
                                       *latency* clock-fraction elapsed))
                             (target (transport-render-target c ahead))
                             (frame (playback-resync! *playback* target)))
                        (set! *epoch-changes*
                          (append *epoch-changes* (list (cons *delivered* (/ (- frame *delivered*) (* 1.0 *rate*))))))
                        (set! *start-conductor* target)
                        (set! *resync-pending* #f)
                        (set! *last-resync-bar* (conductor-bar c))
                        (set! *resyncs* (+ *resyncs* 1)))
                      (begin
                        (set! *resync-pending* #f)
                        (set! *resync-cancels* (+ *resync-cancels* 1)))))
                (loop remaining))
              (when (> n 0)
                (unless silence?
                  ;; The render head can reach the joining bar before
                  ;; the simulation does. Use the projected start plan
                  ;; until the simulation has caught up to that bar.
                  (playback-pull! *playback*
                                  (if (< (conductor-tick c) (conductor-tick *start-conductor*))
                                      *start-conductor*
                                      c)
                                  *buf* 0 n))
                (let ((accepted (push-audio-samples *stream* (if silence? *zero* *buf*) n)))
                  ;; Room can only increase while the callback drains;
                  ;; a short write indicates an unusable/closed stream.
                  (unless (= accepted n)
                    (music-close!)
                    (error "music sink refused reserved frames" n accepted))
                  (set! *delivered* (+ *delivered* accepted))
                  (when silence? (set! *silence* (- *silence* accepted))))
                (loop (- remaining n)))))
          (env-volume! (or (music-audible-seconds) *epoch*))
          (set! *last-tick* (conductor-tick c)))
        (set! *cost-ms* (/ (* 1000.0 (- (current-jiffy) t0)) (jiffies-per-second)))))

    ;; (running target-ms queued-ms sounding-underruns all-underruns cost-ms missed resyncs pending? cancels)
    (define (music-readout)
      (list (and (music-running?) #t)
            *depth-ms*
            (if *stream* (/ (* 1000.0 (audio-stream-depth *stream*)) *rate*) 0.0)
            (+ *underruns* (if *stream* (audio-stream-underruns-sounding *stream*) 0))
            (+ *underruns-all* (if *stream* (audio-stream-underruns *stream*) 0))
            *cost-ms*
            (if *playback* (playback-missed *playback*) 0)
            *resyncs* *resync-pending* *resync-cancels*))))
