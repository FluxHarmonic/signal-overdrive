;;; (signal shell core) - What both shells share: the race on Substratic's
;;; fixed clock, the input it reads (keys, a gamepad, the page's touch
;;; schemes), the tuning and its overlay, the best lap in the store, the
;;; camera's lag, and the frame.
;;;
;;; Controls (the README has them all):
;;;   steer       Left/Right or A/D; a pad's left stick or d-pad
;;;   accelerate  Up or W; a pad's A or right trigger
;;;   brake       Down or S; a pad's B or left trigger
;;;   boost       Space; a pad's X (from lap 2)
;;;   drift       Shift or C; a pad's LB or RB
;;;   start       Enter or Space; a pad's Start or A; a tap on a phone
;;;   restart     R; a pad's Back
;;;   tuning      Tab: the overlay (Up/Down pick a knob, Left/Right set
;;;               it, 0 resets it); P the palette (the district's, crash,
;;;               embers); / the dither

(define-library (signal shell core)
  (import (sigil math)
          (sigil string)
          (sigil list)
          (sigil time)
          (sigil gc)
          (substratic time clock)
          (substratic input keys)
          (substratic input sticks)
          (substratic input pad)
          (substratic store kv)
          (signal track)
          (signal handling)
          (signal race)
          (signal tuning)
          (signal scene)
          (signal title)
          (signal intro)
          (signal flow)
          (signal flow draw)
          (signal flow save)
          (only (signal flow tierdata) tier-race-tuning tier-race-mode)
          (signal shell audio)
          (signal shell updates)
          (signal fx beat)
          (signal fx state)
          (signal fx showcase)
          (signal fx district)
          (signal shell music)
          (signal shell theme)
          (signal music conductor)
          (signal music clock)
          (only (signal music song) SONG-BPM song-id song-override!)
          (only (signal sfx) HIT-IMPACT))

  (export core-boot! core-frame! core-keys core-sticks core-pad core-param! core-touch!
          core-tap! core-race core-tuning core-describe core-probe core-knobs-markdown GAME-NAME
          core-audio-start! core-focus! core-paused? core-advance! core-headless-frame! core-gesture!
          core-startup-mark! core-visible! core-escape-quits? core-flow
          core-test-forget-dev!)

  (begin
    (define GAME-NAME "signal-overdrive")
    ;; the best lap, one per track
    (define (best-key) (string-append "best-lap-" (symbol->string (track-name (race-track *race*)))))
    (define *best-track* #f)
    (define (load-best!)
      (set! *best-track* (track-name (race-track *race*)))
      (set! *best* (let ((b (store-read-datum (best-key)))) (and (exact-integer? b) b))))

    (define *tuning* (tuning-defaults))
    (define *race* #f)
    ;; the title screen ((signal title)): until it is done, a start goes to
    ;; it, not to the race
    (define *title* (title-new))
    ;; the game's flow ((signal flow)): the menus over the title, each
    ;; delivery's results, the cup's standings and its end, TIME TRIAL. Off
    ;; (the race as before) with the start parameter or the title knob at 0.
    (define *flow* (flow-new (save-new)))
    (define *flow-base* #f)       ; the session's rivals, before the flow set any
    (define *launch* #f)          ; the flow asked the title to fade into a race
    (define *flow-began* #f)      ; the flow started a countdown this tick
    (define *tap-at* #f)          ; this frame's tap, in view pixels
    (define *bare-tap* #f)        ; a tap that did not say where
    (define *stick-latch* 0)      ; the pad stick's last menu direction
    (define (core-flow) *flow*)
    ;; before it, the start gate and the card ((signal intro)); made at the
    ;; boot, when the platform is known
    (define *intro* (intro-none))
    (define *gestured* #f)        ; the gate is open: a gesture the browser counts, or a pad press
    (define *touch-device* #f)    ; the page says the pointer is coarse
    (define *reduce-motion* #f)   ; the page says the player prefers reduced motion
    (define *clock* (clock-new))
    (define *pacing* (pacing-new))
    (define *paused* #f)
    (define *music-generation* 0)
    (define *focused* #t)
    (define *skip-interval* #f)
    (define *resync-requests* 0)
    (define *music-trace* #f)
    (define *music-trace-first* #f)
    (define *music-trace-log* '())
    (define *frame-wall* 0.0)
    (define *frame-jiffy* 0)
    (define *frame-ear* #f)
    (define *skew-arm* #f)
    ;; The depth arm's defect is an audible clock 250 ms ahead. A resync
    ;; projects with the real queue depth and would hide it, so that arm
    ;; counts resync requests but never executes them. Arms only.
    (define *depth-arm* #f)

    ;; The flow's pause menu holds the race as F5 and a blur do: the clock
    ;; frozen, the race song closed, the theme's menu version playing.
    (define (core-paused?) (or *paused* (not *focused*) (and *flow* (flow-paused? *flow*))))

    ;; Whether anyone can see the game: the web page says when its tab is
    ;; hidden (a hidden tab is paused and silent; a blurred but visible
    ;; one shows PAUSED and plays the pause music). Natively, always.
    (define *visible* #t)
    ;; Hidden, the page draws no frames, so the theme stops here, not in
    ;; the next frame's service.
    (define (core-visible! visible?)
      (set! *visible* visible?)
      (unless visible? (theme-stop! 0)))

    ;; The title's music is the main theme, from the card's lock through
    ;; the title's attract; the race song waits for the race. With the
    ;; title skipped or off, the race song plays as before.
    (define (title-owns-music?)
      (and *race* (eq? (race-phase *race*) 'title)
           ;; with the title off, never: before its first tick a title
           ;; still reads as showing
           (>= (tuning-ref *tuning* 'title) 0.5)
           (title-active? *title*)
           (or (intro-active? *intro*) (eq? (title-phase *title*) 'attract))))
    ;; The race song is silent while paused, while the title owns the
    ;; music, and through the title's fade-out after a start (the theme
    ;; fades then; the race song opens at the race's tick 0): closed, with
    ;; ticks on wall time, as before a gesture.
    (define (music-held?)
      (or (core-paused?)
          (title-owns-music?)
          (and *theme-session* *race* (eq? (race-phase *race*) 'title)
               (title-active? *title*) (eq? (title-phase *title*) 'out))))

    ;; The theme's part, decided each frame from where the game is:
    ;;   - a hidden page: silence;
    ;;   - PAUSED showing: the menu version, faded in; on the title the
    ;;     title's own player ramps to it, elsewhere it starts at calm;
    ;;   - the title owning the music: the full version, from the top at
    ;;     the card's lock (silence queued until then), fading in over the
    ;;     card's song fade; the gate holds it;
    ;;   - otherwise off: faded over the title's fade-out at a start,
    ;;     quickly at a resume.
    ;; *theme-session*: the title has owned the music since the boot, so
    ;; the card's release went to the theme and the race song needs none.
    (define *theme-session* #f)
    (define *damage-on* #t)
    (define PAUSE-FADE-IN 0.6)
    (define PAUSE-FADE-OUT 0.25)
    (define (theme-service!)
      (let ((ctx (music-context))
            (owns? (title-owns-music?)))
        (when owns? (set! *theme-session* #t))
        (cond
          ((not *visible*) (theme-stop! 0))
          ;; The card freezes with the race while paused, so before its
          ;; lock the theme must not run on: closed, it starts again on
          ;; the resume with the preroll left.
          ((and (core-paused?) owns?
                (let ((wait (intro-song-wait *intro* *tuning*))) (or (not wait) (> wait 0))))
           (theme-stop! 0))
          ((core-paused?)
           (theme-play! ctx 'menu (if (or owns? (theme-playing?)) #f 'calm) PAUSE-FADE-IN 0.0))
          (owns?
           (let ((wait (intro-song-wait *intro* *tuning*))
                 (fade (tuning-ref *tuning* 'card-song-fade)))
             (when wait
               (when (= wait 0) (theme-release-now!))
               (theme-play! ctx 'full #f fade (/ wait 60.0)))))
          (else
           (theme-stop! (if (eq? (title-phase *title*) 'out)
                            (tuning-ref *tuning* 'title-out)
                            PAUSE-FADE-OUT))))
        (theme-frame!)))

    ;; focus=ignore: run on without the window's focus (for frame-time runs
    ;; on a machine whose display is locked, where no window gets focus;
    ;; unfocused, the game pauses and a run would time a still frame). A
    ;; development parameter: on the web it waits for ?dev (rule D), like
    ;; track= and song=; natively (--focus=ignore) it applies at once.
    (define *focus-ignore* #f)
    (define *focus-request* #f)
    (define (focus-request!)
      (when (and *focus-request* (dev-keys?))
        (set! *focus-request* #f)
        (set! *focus-ignore* #t)
        ;; the page sends focus only on a change: already unfocused, the
        ;; game would stay paused until the next one
        (core-focus! *focused*)
        (say "focus ignored: runs unfocused")))
    (define (core-focus! focused-in?)
      (let ((focused? (or focused-in? *focus-ignore*)))
        (unless (eq? focused? *focused*)
          (set! *focused* focused?)
          (unless focused?
            (keys-clear! *keys*)
            (set! *touch* (list 0.0 0.0 0.0 #f #f))
            (set! *touch-boost-pending* #f))
          ;; The first returning frame includes the hidden interval. It
          ;; must not owe catch-up ticks after the race was paused.
          (set! *skip-interval* #t)
          (audio-pause! (core-paused?))
          (when *race* (music-frame! (race-song *race*) (music-held?))))))
    (define *keys* (make-keys))
    (define *sticks* (make-sticks))
    (define *pad* (make-pad))
    (define *best* #f)
    (define *cam-heading* #f)
    (define *flash* 0)
    (define *spark* #f)          ; (age-in-ticks . side) since the last wall hit
    ;; pass 3's frame effects, eased per tick
    (define *kick* 0.0)          ; a boost's camera punch, 1 then decaying
    (define *glitch* 0.0)        ; the screen's glitch: wall hits, ICE
    (define *corrupt* 0.0)       ; corrupt cargo, ramping to 1
    (define *popups* '())        ; ((text colour age slot) ...) by the meter
    (define (popup! text colour) (set! *popups* (popups-add *popups* text colour *reduce-motion*)))

    ;; The best lap's ghost. The player's positions are recorded every tick
    ;; of the lap being driven; when a lap ends as the best yet on this
    ;; track, its record becomes the ghost, replayed tick by tick against
    ;; the current lap's clock. Positions, not inputs: replaying inputs
    ;; would diverge the first time a rival bumped the live machine, since
    ;; the ghost has no rivals to bump it. In memory only, per run.
    (define *trail* '())
    (define *ghost* #f)          ; a vector of (x y heading), one per tick
    (define *ghost-track* #f)
    (define *ghost-best* #f)
    (define *ghosts* '())        ; (track ghost best) for the tracks not being raced

    ;; was: the phase before this tick (the last lap ends in the tick that
    ;; turns the phase to finished, and must count too)
    (define (ghost-tick! r was)
      (let* ((p (race-player r)) (m (racer-machine p)) (name (track-name (race-track r))))
        (unless (eq? name *ghost-track*)
          ;; each track keeps its own ghost for the session
          (when *ghost-track*
            (set! *ghosts* (cons (list *ghost-track* *ghost* *ghost-best*)
                                 (filter (lambda (g) (not (eq? (car g) *ghost-track*))) *ghosts*))))
          (let ((g (assq name *ghosts*)))
            (set! *ghost-track* name) (set! *ghost* (and g (cadr g))) (set! *ghost-best* (and g (caddr g)))
            (set! *trail* '())))
        (when (or (eq? (race-phase r) 'race) (eq? was 'race))
          ;; a new lap began this tick: was the one before it the best?
          (when (= (racer-lap-start p) (race-tick r))
            (let ((b (racer-best-lap p)))
              (when (and b (equal? b (racer-last-lap p)) (pair? *trail*)
                         (or (not *ghost-best*) (< b *ghost-best*)))
                (set! *ghost* (list->vector (reverse *trail*)))
                (set! *ghost-best* b)
                (say "ghost: a new best lap, " (lap-clock b))))
            (set! *trail* '()))
          (when (> (racer-lap p) 0)
            (set! *trail* (cons (list (machine-x m) (machine-y m) (machine-heading m)) *trail*))))))

    (define (ghost-now r)
      (let ((p (race-player r)))
        (and *ghost* (eq? (race-phase r) 'race) (> (racer-lap p) 0)
             (let ((i (- (race-tick r) (racer-lap-start p))))
               (and (< i (vector-length *ghost*)) (vector-ref *ghost* i))))))

    ;; The frame effects from this tick's events.
    (define (effects-tick! r)
      (let ((m (racer-machine (race-player r))))
        (for-each (lambda (e)
                    (when (eq? (car e) 'player)
                      (let ((ev (cdr e)))
                        (cond ((memq ev '(boost)) (set! *kick* 1.0)
                               (popup! (string-append "-" (number->string (exact (round (handling-ref *tuning* 'boost-cost))))) "#F2731A"))   ; orange: speed (P16)
                              ((eq? ev 'pad) (set! *kick* 0.8) (popup! "PAD" "#F2731A"))
                              ((eq? ev 'ice) (popup! "ICE" "#FF9F1A"))   ; amber: ICE (P16)
                              ((and (pair? ev) (eq? (car ev) 'wall))
                               (let ((cost (exact (round (* (cdr ev) (handling-ref *tuning* 'wall-damage))))))
                                 (when (>= cost 1) (popup! (string-append "-" (number->string cost)) "#FF5959"))))))))
                  (race-events r))
        (when (and (machine-on-repair m) (= 0 (modulo (race-tick r) 20)))
          (popup! "+" "#4DF2D9"))
        ;; the glitch is (signal fx state)'s: at most 6 ticks a hit (P15); the
        ;; scramble's lasting sign is the HUD's, never the road's
        (set! *kick* (* *kick* 0.92))
        (set! *glitch* (fx-glitch-now *fx*))
        (set! *corrupt* (if (eq? (race-phase r) 'corrupt) (min 1.0 (+ *corrupt* 0.03)) 0.0))
        (set! *popups* (let keep ((ps *popups*))
                         (cond ((null? ps) '())
                               ((> (caddr (car ps)) 50) (keep (cdr ps)))
                               (else (let ((p (car ps)))
                                       (cons (list (car p) (cadr p) (+ 1 (caddr p)) (cadddr p)) (keep (cdr ps))))))))))
    ;; --- the 0.1 effects ---------------------------------------------------------------
    ;; (signal fx state), stepped every tick from the stub's pulse (the
    ;; conductor's later: see (signal fx beat)), the player's events and
    ;; the integrity. Fires come from the page's panel ("fx-fire=wall"),
    ;; the F-keys and the showcase.
    (define *fx* (fx-new))
    (define *fx-fires* '())
    (define *traced-at* #f)       ; the tick the player started the final lap
    (define *fx-caption* #f)
    (define *showcase-solo* 1)    ; the showcase's solo, worked out once a tick
    (define *fx-ms* 0.0)          ; fx-tick!'s CPU ms a frame, smoothed (in SIM)
    (define *fx-frame-ms* 0.0)
    (define FX-ORDER '(fx-dip fx-pools fx-chase fx-sky fx-glitch fx-warp fx-interf fx-reflect fx-wet fx-rain))
    (define (fx-param? kv) (and (> (string-length kv) 3) (string=? (substring kv 0 3) "fx-")))
    (define (showcase?) (> (tuning-ref *tuning* 'fx-showcase) 0.5))
    (define (fx-solo)
      (if (showcase?)
          *showcase-solo*
          (exact (round (tuning-ref *tuning* 'fx-solo)))))
    ;; an effect's intensity as the effects see it: 0 when another is solo
    (define (fx-knob key)
      (let ((solo (fx-solo))
            (k (let find ((ks FX-ORDER) (i 1)) (cond ((null? ks) 0) ((eq? (car ks) key) i) (else (find (cdr ks) (+ i 1)))))))
        (if (and (> solo 0) (> k 0) (not (= solo k))) 0.0 (tuning-ref *tuning* key))))

    (define (fx-tick! r)
      (let* ((p (race-player r))
             (m (racer-machine p))
             (laps (exact (round (race-tuning-ref *tuning* 'laps))))
             (section (stub-section (race-phase r) (racer-lap p) laps (racer-halfway p))))
        (if (eq? section 'traced)
            (unless *traced-at* (set! *traced-at* (race-tick r)))
            (set! *traced-at* #f))
        (let* ((pl (stub-pulse (race-tick r) section *traced-at*))
               (sc (and (showcase?) (showcase-at (race-tick r) pl)))
               (pl (if (and sc (cadddr sc)) (pulse-with-section pl 'traced) pl))
               (events (let loop ((es (race-events r)) (acc '()))
                         (cond ((null? es) acc)
                               ((eq? (caar es) 'player) (loop (cdr es) (cons (cdar es) acc)))
                               (else (loop (cdr es) acc)))))
               (fires (append *fx-fires* (if sc (cadr sc) '())))
               (tier (tuning-ref *tuning* 'fx-tier))
               (integrity (cond ((and sc (caddr sc)) (caddr sc))
                                ((>= tier 0.0) tier)
                                (else (machine-integrity m)))))
          (set! *fx-fires* (quote ()))
          (when sc (set! *showcase-solo* (car sc)))
          ;; a restart (the countdown) clears the last race's tracer and glitch
          (when (eq? (race-phase r) (quote countdown)) (fx-clear-transients! *fx*))
          (set! *fx-caption*
                (let ((what (cond (sc (list-ref sc 4))
                                  ((> (fx-solo) 0) (string-append "SOLO: " (vector-ref FX-NAMES (fx-solo))))
                                  (else #f)))
                      (forced (and (>= tier 0.0) (not (and sc (caddr sc)))
                                   (string-append "TIER " (tier-name (integrity-tier tier)) " (FORCED)"))))
                  (cond ((and what forced) (string-append what "  " forced))
                        (else (or what forced)))))
          (set! *fx* (fx-step *fx* pl events integrity
                              (list (machine-x m) (machine-y m) (machine-heading m))
                              fires fx-knob
                              ;; the district's rain for this section (the showcase forces a downpour)
                              (rain-target (and sc (> (length sc) 5) (list-ref sc 5))
                                           (tuning-ref *tuning* 'fx-weather)
                                           (district-look (track-district (race-track r)))
                                           (pulse-section pl))))
          ;; the drop kicks the camera too (§3.3)
          (when (and (fx-drop-now *fx*) (> (fx-knob 'fx-dip) 0.0)) (set! *kick* 1.0)))))

    (define (fx-fire! what)
      (cond ((eq? what 'tier)
             ;; the integrity the effects see: real, then each tier down
             (let* ((t (tuning-ref *tuning* 'fx-tier))
                    (next (cond ((< t 0.0) 70.0) ((> t 50.0) 45.0) ((> t 25.0) 20.0) ((> t 7.0) 5.0) (else -1.0))))
               (set! *tuning* (tuning-set *tuning* 'fx-tier next))
               (say "fx tier " (if (< next 0.0) "real" (tier-name (integrity-tier next))))))
            (else (set! *fx-fires* (cons what *fx-fires*)) (say "fx fire " (symbol->string what)))))

    ;; Natively, E opens the tuning overlay at the effects' knobs (on the
    ;; web, E is the page's panel instead, with ?dev in the URL). On both,
    ;; F6 solos the next effect, F7 the showcase, F8 a wall hit, F9 an ICE
    ;; strike (a tracer: marked on the next downbeat, striking on the one
    ;; after), F10 the drop, F2 the next integrity tier. All of them are
    ;; development keys (dev-keys?): on the web they need ?dev.
    (define (fx-keys!)
      (when (dev-keys?)
        (when (and (pressed? 'e) (not (eq? *platform* 'web)))
          (set! *overlay* (if *overlay* #f
                              (let find ((ks KNOBS) (i 0))
                                (cond ((null? ks) 0) ((eq? (knob-group (car ks)) 'fx) i) (else (find (cdr ks) (+ i 1))))))))
        (when (pressed? 'f6)
          (set! *tuning* (tuning-set *tuning* 'fx-solo (modulo (+ 1 (exact (round (tuning-ref *tuning* 'fx-solo)))) 8)))
          (say "fx solo " (number->string (exact (round (tuning-ref *tuning* 'fx-solo))))))
        (when (pressed? 'f7)
          (set! *tuning* (tuning-set *tuning* 'fx-showcase (if (showcase?) 0.0 1.0))))
        (when (pressed? 'f8) (fx-fire! 'wall))
        (when (pressed? 'f9) (fx-fire! 'ice))
        (when (pressed? 'f10) (fx-fire! 'drop))
        (when (pressed? 'f2) (fx-fire! 'tier))))

    (define (fx-describe)
      (string-append " fx-ms " (number->string (/ (round (* 100.0 *fx-ms*)) 100.0))
                     " fx-tier " (number->string (fx-tier *fx*))
                     " fx-interf " (number->string (/ (round (* 100.0 (fx-interf *fx*))) 100.0))
                     " fx-section " (symbol->string (fx-section *fx*))
                     " fx-bar " (number->string (fx-bar *fx*))
                     " fx-chase " (number->string (fx-chase *fx*))
                     " fx-solo " (number->string (fx-solo))))

    (define *overlay* #f)         ; the selected knob's row while the overlay is open
    (define *platform* 'desktop)
    ;; The development keys (Tab's overlay, F2 to F10) are always on
    ;; natively; on the web only with ?dev in the URL (any value, as the
    ;; page's effects panel reads it), so a player can't trip them.
    (define *dev* #f)
    (define (dev-keys?) (or *dev* (not (eq? *platform* 'web))))
    ;; tests only: ?dev as if never given. A page boots once, so core-boot!
    ;; keeps ?dev; the test files share one process, and a test of a
    ;; development parameter's wait for ?dev must not see an earlier file's.
    (define (core-test-forget-dev!) (set! *dev* #f))
    (define *tapped* #f)
    ;; the page's touch scheme sends its whole state at once:
    ;; steer throttle brake boost drift
    (define *touch* (list 0.0 0.0 0.0 #f #f))
    (define *touch-boost-was* #f)
    (define *repeat* 0)

    (define (core-keys) *keys*)
    (define (core-sticks) *sticks*)
    (define (core-pad) *pad*)
    (define (core-race) *race*)
    (define (core-tuning) *tuning*)

    (define (say . parts) (display (apply string-append "signal-overdrive: " parts)) (newline))

    (define (core-boot! platform)
      (set! *platform* platform)
      (update-menu! #f)
      (set! *clock* (clock-new))
      (set! *pacing* (pacing-new))
      (set! *paused* #f)
      (set! *focused* #t)
      ;; a new session: focus=ignore is asked for again, after the boot
      (set! *focus-ignore* #f)
      (set! *focus-request* #f)
      (set! *skip-interval* #f)
      (set! *resync-requests* 0)
      (music-reset!)
      (theme-reset!)
      (set! *theme-session* #f)
      (music-prepare!)
      ;; the song waits for the card (song-gate!)
      (music-hold!)
      (set! *music-generation* (music-generation))
      (audio-pause! #f)
      (set-store-app! GAME-NAME)
      (set-store-prefix! "signal-overdrive:")
      (set! *race* (race-new *tuning*))
      ;; the race song its track binds, parsed now, not at the first gesture
      (music-prepare!)
      (set! *intro* (intro-new *tuning* (eq? platform 'web)))
      ;; a boot is a new session, its title too: a start or a skip from an
      ;; earlier boot in the same process does not carry over
      (set! *title* (title-new))
      ;; the save: unlocks and best times, from the store
      (set! *flow* (flow-new (save-load)))
      ;; *flow-base* stays: *tuning* lives across boots too, and may hold a
      ;; TIME TRIAL's empty field the base must not take as the session's
      (set! *launch* #f)
      (load-best!))

    ;; A URL parameter or a command-line --key=value: a knob; or
    ;; autopilot (the player drives the racing line, for checks and
    ;; screenshots) or start (no title: the countdown at once); or ignored.
    (define *autopilot* #f)
    (define *start-now* #f)
    ;; the track=... asked for, applied once the development controls are on
    (define *track-request* #f)
    ;; unlock=all given before ?dev, applied with it
    (define *unlock-request* #f)
    (define (track-request!)
      (when (and *track-request* (dev-keys?))
        (let ((kv *track-request*))
          (set! *track-request* #f)
          (core-param! kv))))
    ;; the song=ID asked for, applied once the development controls are on
    (define *song-request* #f)
    (define (song-request!)
      (when *song-request*
        (if (dev-keys?)
            (begin
              (song-override! *song-request*)
              (set! *song-request* #f)
              (set! *race* (race-rebuild))
              (music-prepare!)
              (say "song " (symbol->string (song-id))))
            (say "song=" (symbol->string *song-request*) " waits for ?dev"))))
    (define (core-param! kv)
      (cond ((string=? kv "autopilot") (set! *autopilot* #t) (say "autopilot on"))
            ((string=? kv "start") (set! *start-now* #t) (intro-skip!) (title-skip!) (set! *flow* (flow-off *flow*)))
            ;; development: every tier and cup open, for this session only
            ((string=? kv "unlock=all")
             (if (dev-keys?)
                 (begin (set! *flow* (flow-unlock-all *flow*)) (say "unlock all (this session, not saved)"))
                 (begin (set! *unlock-request* #t) (say "unlock=all waits for ?dev"))))
            ((string=? kv "focus=ignore")
             (set! *focus-request* #t)
             (focus-request!)
             (when *focus-request* (say "focus=ignore waits for ?dev")))
            ((string=? kv "pointer=coarse") (set! *touch-device* #t))
            ((string=? kv "pointer=fine") (set! *touch-device* #f))
            ((string=? kv "motion=reduce") (set! *reduce-motion* #t))
            ((string=? kv "motion=full") (set! *reduce-motion* #f))
            ;; the effects panel's triggers: fx-fire=wall|ice|drop|tier
            ((and (> (string-length kv) 8) (string=? (substring kv 0 8) "fx-fire="))
             (fx-fire! (string->symbol (substring kv 8 (string-length kv)))))
            ((string=? kv "showcase") (core-param! "fx-showcase=1"))
            ((string=? kv "fps") (set! *fps-on* #t) (say "fps readout on"))
            ((or (string=? kv "dev") (and (> (string-length kv) 3) (string=? (substring kv 0 4) "dev=")))
             (set! *dev* #t) (say "dev keys on")
             (song-request!)
             (focus-request!)
             (track-request!)
             (when *unlock-request* (set! *unlock-request* #f) (core-param! "unlock=all")))
            ;; no HUD: clean captures, and the P15 gate's static frame
            ((string=? kv "nohud") (set! *no-hud* #t))
            ;; no machines or gate: the P15 gate's frame must not move, and the
            ;; thrusters flicker even on the race's title phase
            ((string=? kv "nosprites") (set! *no-sprites* #t))
            ((string=? kv "mute") (audio-mute!))
            ((string=? kv "hitchlog") (set! *hitch-print* #t))
            ((string=? kv "musiclog") (set! *music-trace* #t))
            ((and (> (string-length kv) 15) (string=? (substring kv 0 15) "music-sabotage="))
             (let ((arm (string->symbol (substring kv 15 (string-length kv)))))
               (unless (memq arm '(none depth immediate skew))
                 (error "unknown music sabotage arm" arm))
               (set! *skew-arm* (eq? arm 'skew))
               (set! *depth-arm* (eq? arm 'depth))
               (music-sabotage! arm)))
            ((string=? kv "cues=0") (audio-cues! #f))
            ((string=? kv "sfx=0") (audio-sfx! #f) (say "sfx off: engine silent, no one-shots"))
            ;; a diagnostic for timing checks (the drift gate): the song stays
            ;; clean, with no dips, whatever the integrity
            ((string=? kv "damage=0") (set! *damage-on* #f) (say "damage off: the song stays clean"))
            ((and (> (string-length kv) 14) (string=? (substring kv 0 14) "audio-latency="))
             (let ((v (string->number (substring kv 14 (string-length kv)))))
               (when v (music-latency! (/ v 1000.0)) (theme-latency! (/ v 1000.0)))))
            ((and (> (string-length kv) 11) (string=? (substring kv 0 11) "musicdepth="))
             (let ((v (string->number (substring kv 11 (string-length kv)))))
               (when v (music-depth! v))))
            ((and (> (string-length kv) 11) (string=? (substring kv 0 11) "audiodepth="))
             (let ((v (string->number (substring kv 11 (string-length kv)))))
               (when v (audio-depth! v) (say "audio depth " (number->string v) " ms"))))
            ;; the page's own report: the audio bridge's stream mode as the
            ;; page infers it (an AudioWorklet and cross-origin isolation:
            ;; worklet-sab; a worklet only: worklet-msg; else scriptprocessor)
            ((and (> (string-length kv) 11) (string=? (substring kv 0 11) "audio-mode="))
             (set! *audio-mode* (substring kv 11 (string-length kv))))
            ;; ?track= is a development control like the keys: on the web it
            ;; needs ?dev, given before or after it, by name or by index.
            ;; A player's race is on the track picked in the app.
            ((and (> (string-length kv) 6) (string=? (substring kv 0 6) "track=")
                  (not (dev-keys?)))
             (set! *track-request* kv)
             (say kv " waits for ?dev"))
            ;; ?song=ID: every track plays that race song (checks, auditions).
            ;; A development control like the keys: on the web it needs ?dev,
            ;; given before or after it. A player's race plays the song its
            ;; track binds.
            ((and (> (string-length kv) 5) (string=? (substring kv 0 5) "song="))
             (set! *song-request* (string->symbol (substring kv 5 (string-length kv))))
             (song-request!))
            ;; Development shortcut: registered names as well as indices.
            ((and (> (string-length kv) 6) (string=? (substring kv 0 6) "track=")
                  (memq (string->symbol (substring kv 6 (string-length kv))) TRACKS))
             (core-param! (string-append "track=" (number->string (track-index-of (string->symbol (substring kv 6 (string-length kv))))))))
            (else
             (let ((t (tuning-parse! *tuning* kv)))
               (when t
                 (set! *tuning* t)
                 (flow-base-note! kv t)
                 (unless (fx-param? kv) (set! *race* (race-rebuild)) (music-prepare!))
                 (say "tuning " kv))))))

    ;; "steer,throttle,brake,boost,drift" from the page (0/1 for the last two).
    (define (core-touch! payload)
      (let* ((parts (let split ((s payload) (acc '()))
                      (let ((i (let find ((k 0)) (cond ((>= k (string-length s)) #f) ((char=? (string-ref s k) #\,) k) (else (find (+ k 1)))))))
                        (if i (split (substring s (+ i 1) (string-length s)) (cons (substring s 0 i) acc))
                            (reverse (cons s acc))))))
             (num (lambda (k) (or (and (> (length parts) k) (string->number (list-ref parts k))) 0.0)))
             (boost (> (num 3) 0.5)))
        ;; a boost that goes on is kept for the next tick even if it goes
        ;; off again first (a tap's on and off can both land between ticks)
        (when (and boost (not (cadddr *touch*))) (set! *touch-boost-pending* #t))
        (set! *touch* (list (num 0) (num 1) (num 2) boost (> (num 4) 0.5)))))
    (define *touch-boost-pending* #f)

    ;; A tap on the page (a start on the title and end screens). The page
    ;; may say where, as "fx,fy", fractions of the canvas: the menus and
    ;; panels then take the row it lands on.
    (define (core-tap! . payload)
      (set! *tapped* #t)
      (let* ((xy (and (pair? payload) (parse-xy (car payload))))
             (v (and xy (scene-view-point (car xy) (cdr xy)))))
        (if v (set! *tap-at* v) (set! *bare-tap* #t))))
    (define (parse-xy s)
      (let ((i (let find ((k 0)) (cond ((>= k (string-length s)) #f) ((char=? (string-ref s k) #\,) k) (else (find (+ k 1)))))))
        (and i
             (let ((x (string->number (substring s 0 i)))
                   (y (string->number (substring s (+ i 1) (string-length s)))))
               (and x y (cons (exact->inexact x) (exact->inexact y)))))))

    ;; --- input ------------------------------------------------------------------------------

    (define (axis neg pos)
      (cond ((and (keys-held? *keys* neg) (not (keys-held? *keys* pos))) -1.0)
            ((and (keys-held? *keys* pos) (not (keys-held? *keys* neg))) 1.0)
            (else 0.0)))
    (define (held? . ks) (let loop ((ks ks)) (and (pair? ks) (or (keys-held? *keys* (car ks)) (loop (cdr ks))))))
    (define (pressed? . ks) (let loop ((ks ks)) (and (pair? ks) (or (keys-pressed? *keys* (car ks)) (loop (cdr ks))))))
    (define (clamp1 v) (max -1.0 (min 1.0 v)))
    (define (trigger name) (max 0.0 (/ (+ 1.0 (pad-axis *pad* name)) 2.0)))   ; -1..1 at rest -1

    (define *boost-latch* #f)
    (define *last-throttle* 0.0)
    (define *frame-events* '())   ; the player's events over this frame's ticks, for the sound
    ;; Startup timing under musiclog: how long each step took and the
    ;; music's sounding underruns by its end, so a startup stall that
    ;; drains the ring names its step.
    (define *startup-mark* #f)
    (define (core-startup-mark! label)
      (when *music-trace*
        (let ((now (current-jiffy)))
          (say "startup " label " +"
               (number->string (if *startup-mark*
                                   (exact (round (/ (* 1000.0 (- now *startup-mark*)) (jiffies-per-second))))
                                   0))
               " ms music-underruns " (number->string (list-ref (music-readout) 3)))
          (set! *startup-mark* now))))

    ;; The tuning-in sound's knobs, for the cue bank.
    (define (tune-audio!)
      (audio-tune! (tuning-ref *tuning* 'tone-lo) (tuning-ref *tuning* 'tone-hi)
                   (intro-lock *tuning*) (intro-length *tuning*))
      (audio-engine-db! (tuning-ref *tuning* 'engine-db)))
    ;; Open the sound (again, to resume a context the browser suspended).
    (define (core-audio-start!)
      ;; the time since the last step (on the web, the wait for a
      ;; gesture), so the steps below measure the start alone
      (core-startup-mark! "audio-start")
      (tune-audio!)
      (audio-start!)
      (core-startup-mark! "engine-and-cues")
      ;; held or not, the race song gets this context: its frame starts
      ;; it there when the hold ends (the title's theme gives way)
      (music-context! (audio-context))
      (when (and *race* (not (music-held?)))
        (song-gate!)
        (music-start! (audio-context) (race-song *race*))
        (core-startup-mark! "music-start")
        ;; dated like service-audio!'s, so a queued resync measures its
        ;; gap against the simulation now
        (music-frame! (race-song *race*) #f
                      clock-fraction: (clock-acc *clock*)
                      frame-jiffy: *frame-jiffy*)
        (core-startup-mark! "music-frame")))
    ;; The song's release, named before each music frame: at the card's
    ;; lock, in song seconds (a constant while the card runs: the song and
    ;; the card count the same ticks and freeze together), at once when
    ;; the card is skipped, over or off; held at the gate. The music keeps
    ;; the earliest release it is given, and ignores it once faded in.
    (define (song-gate!)
      (let ((wait (intro-song-wait *intro* *tuning*)))
        (when wait
          (music-release-at! (/ (+ (conductor-tick (race-song *race*)) wait) 60.0)
                             (tuning-ref *tuning* 'card-song-fade)))))
    ;; A gesture the browser counts as one (the page checks): it may start
    ;; the sound, and it opens the start gate. Nothing else opens the gate
    ;; but a pad's press (a browser never counts one, so the card then
    ;; plays silent until the next gesture resumes the sound).
    (define (core-gesture!)
      (set! *gestured* #t)
      (core-audio-start!))
    ;; --- the flow ---------------------------------------------------------------------
    ;; One frame's menu input: presses this frame (the pad's stick as a
    ;; press when it crosses 0.6), and the frame's tap.
    ;; A frame that ran no tick (half the frames at 120 Hz) hands its presses
    ;; to the next frame's first tick, as a tap waits.
    ;; *nav-read*: this frame's input was read (a press is read once: the
    ;; pause menu's resume is not carried into a pause on the next tick)
    (define *nav-carry* NAV-NONE)
    (define *nav-read* #f)
    (define (frame-nav)
      (let ((n (nav-merge *nav-carry* (frame-nav-now))))
        (set! *nav-carry* NAV-NONE)
        (set! *nav-read* #t)
        n))
    (define (frame-nav-now)
      (let* ((ly (pad-axis *pad* 'ly)) (lx (pad-axis *pad* 'lx))
             (dir (cond ((< ly -0.6) 'up) ((> ly 0.6) 'down) ((< lx -0.6) 'left) ((> lx 0.6) 'right) (else 0)))
             (stick (and (not (eqv? dir 0)) (not (eq? dir *stick-latch*)) dir))
             ;; a tap that did not say where chooses the selection
             (tap (or *tap-at* (and *bare-tap* 'any))))
        (set! *stick-latch* dir)
        (set! *tap-at* #f)
        (set! *bare-tap* #f)
        (nav up: (or (pressed? 'up 'w) (pad-pressed? *pad* 'up) (eq? stick 'up))
             down: (or (pressed? 'down 's) (pad-pressed? *pad* 'down) (eq? stick 'down))
             left: (or (pressed? 'left 'a) (pad-pressed? *pad* 'left) (eq? stick 'left))
             right: (or (pressed? 'right 'd) (pad-pressed? *pad* 'right) (eq? stick 'right))
             confirm: (or (pressed? 'return 'space) (pad-pressed? *pad* 'start) (pad-pressed? *pad* 'a))
             back: (or (pressed? 'escape 'backspace) (pad-pressed? *pad* 'b))
             ;; a race's pause: never a pad's B, which is also the brake
             pause: (or (pressed? 'escape 'backspace) (pad-pressed? *pad* 'start))
             tap: tap)))
    ;; Natively Escape quits on the title (and with no flow, as before); in
    ;; a race it pauses, and on the menus and panels it is BACK.
    (define (core-escape-quits?) (and (memq (flow-screen *flow*) '(off title)) #t))

    ;; The race the flow names: its track, and the mode and tier
    ;; ((signal flow tierdata)), from the session's own field of rivals.
    (define (flow-config!)
      (unless *flow-base*
        (set! *flow-base* (list (cons 'rivals (tuning-ref *tuning* 'rivals)))))
      (set! *tuning* (tier-race-tuning (tuning-set *tuning* 'track (track-index-of (flow-track *flow*)))
                                       *flow-base* (flow-mode *flow*) (flow-tier *flow*))))
    ;; The one place the flow builds a race (its restarts go through
    ;; race-start, which keeps what race-new was given): the flow's tier and
    ;; mode go to race-new. The flow never sets a number from the tier: the
    ;; race's tier data ((signal tiers)) owns pace, ICE and handling, and
    ;; race-new's time-trial empties the field and the ICE.
    (define (flow-race-new)
      (race-new *tuning* tier: (flow-tier *flow*) mode: (tier-race-mode (flow-mode *flow*))))
    ;; A param, a knob or a song request rebuilding the race: in a flow,
    ;; through the seam, so the race keeps the flow's mode and tier.
    (define (race-rebuild) (if (flow-active? *flow*) (flow-race-new) (race-new *tuning*)))
    ;; A rivals= param after the base was taken is the session's new
    ;; field: the next race the flow names starts from it.
    (define (flow-base-note! kv t)
      (when *flow-base*
        (set! *flow-base*
              (map (lambda (e)
                     (let ((k (symbol->string (car e))))
                       (if (and (> (string-length kv) (string-length k))
                                (string=? (substring kv 0 (+ (string-length k) 1)) (string-append k "=")))
                           (cons (car e) (tuning-ref t (car e)))
                           e)))
                   *flow-base*))))
    (define (flow-command! c)
      (case c
        ((update) (update-choose!))
        ((preview) (flow-config!) (set! *race* (flow-race-new)) (music-prepare!))
        ((launch) (flow-config!) (set! *race* (flow-race-new)) (music-prepare!) (set! *launch* #t))
        ((begin) (flow-config!) (restart-race!) (set! *flow-began* #t))
        ((to-title)
         (set! *race* (race-new *tuning*))
         (music-prepare!)
         (set! *title* (title-new))
         (set! *cam-heading* #f))
        ((store)
         (when (flow-store? *flow*)
           (say (if (save-store! (flow-save *flow*)) "progress saved" "progress NOT saved"))))
        (else #f)))
    ;; nav?: this tick may read the frame's input (its first tick).
    (define (flow-tick! r nav?)
      (when (and (or (eq? (flow-screen *flow*) 'title) (flow-menu? *flow*)) (not (title-active? *title*)))
        (set! *flow* (flow-off *flow*)))
      (let ((was (flow-screen *flow*)))
        (set! *flow* (flow-step *flow* (if nav? (frame-nav) NAV-NONE) r))
        (for-each flow-command! (flow-commands *flow*))
        (unless (eq? was (flow-screen *flow*))
          (when (or (eq? was 'paused) (flow-paused? *flow*)) (pause-changed!))
          (say (flow-describe *flow*)))))
    ;; Into or out of the pause menu, as F5 does: the sound follows, and the
    ;; frame after it owes no ticks for the time spent paused.
    (define (pause-changed!)
      ;; a finger on the pause menu (a boost landing, a held zone) is not
      ;; the race's: the touch state starts over either way
      (set! *touch* (list 0.0 0.0 0.0 #f #f))
      (set! *touch-boost-pending* #f)
      (set! *nav-carry* NAV-NONE)
      (set! *skip-interval* #t)
      (audio-pause! (core-paused?))
      (music-frame! (race-song *race*) (music-held?)))
    ;; A new countdown on the current tuning's track, now: the frame's
    ;; remaining ticks belong to the old race, and the new song opens at
    ;; conductor tick 0 (as R's restart).
    (define (restart-race!)
      (race-begin! *race*)
      (music-prepare!)
      (music-close!)
      (set! *clock* (clock-new))
      (set! *pacing* (pacing-new))
      (set! *skip-interval* #t))
    ;; The ghost belongs to TIME TRIAL, and to the race without the flow.
    (define (ghost-on?) (or (not (flow-active? *flow*)) (eq? (flow-mode *flow*) 'trial)))

    ;; The title ((signal title)): while it shows, a start goes to it; it
    ;; says when the race begins. Its events, and every race's start, go to
    ;; the music through title-emit!.
    (define (title-tick! r start)
      (when (title-active? *title*)
        (set! *title* (title-step *title* *tuning* r start))
        (title-emit! (title-events *title*))
        (when (title-race-due? *title*) (race-begin! r))))
    (define (race-begin! r)
      (set! *race* (race-start *tuning* r))
      (set! *cam-heading* #f)
      (say "phase " (symbol->string (race-phase *race*)))
      (title-emit! (list 'race-start)))
    (define (title-skip!)
      (set! *title* (title-skip *title*))
      (title-emit! (title-events *title*)))
    ;; The gate and the card: while they run, a start skips the card, and the
    ;; title waits. A pad's Start or A opens the gate too. The card's start
    ;; plays the tuning-in sound. Says whether the intro changed phase.
    (define (intro-tick! r start)
      (let ((was (intro-phase *intro*)))
        (when (and (eq? was 'gate) (not *gestured*)
                   (or (pad-pressed? *pad* 'start) (pad-pressed? *pad* 'a)))
          (core-gesture!))
        (set! *intro* (intro-step *intro* *tuning* r *gestured* start))
        (title-emit! (intro-events *intro*))
        (when (memq 'card-start (intro-events *intro*)) (audio-tune-in!))
        (card-cut!)
        (not (eq? was (intro-phase *intro*)))))
    (define (intro-skip!)
      (set! *intro* (intro-skip *intro*))
      (title-emit! (intro-events *intro*))
      (card-cut!))
    ;; A card cut short (a skip) takes its sound with it.
    (define (card-cut!)
      (when (and (memq 'card-end (intro-events *intro*)) (intro-cut? *intro*)) (audio-stop-tune-in!)))
    ;; The card's tearing: as much as the glitch effect may show (the
    ;; fx-glitch knob, 0 when another effect is solo), none for reduced
    ;; motion.
    (define (card-glitch) (intro-glitch *intro* *tuning* (if *reduce-motion* 0.0 (fx-knob 'fx-glitch))))

    ;; One tick's controls: the player's (signal handling) input.
    (define (controls)
      (let* ((ps (stick-analog (pad-axis *pad* 'lx) 0.0 0.18))
             (overlay? *overlay*)
             (steer (clamp1 (+ (if overlay? 0.0 (+ (axis 'left 'right) (axis 'a 'd)))
                               (cond ((pad-held? *pad* 'left) -1.0) ((pad-held? *pad* 'right) 1.0) (else 0.0))
                               (car ps)
                               (car *touch*))))
             (throttle (max (if (and (not overlay?) (held? 'up 'w)) 1.0 0.0)
                            (if (pad-held? *pad* 'a) 1.0 0.0)
                            (trigger 'rt)
                            (if overlay? 0.0 (cadr *touch*))))
             (brake (max (if (and (not overlay?) (held? 'down 's)) 1.0 0.0)
                         (if (pad-held? *pad* 'b) 1.0 0.0)
                         (trigger 'lt)
                         (caddr *touch*)))
             (pending *touch-boost-pending*)
             (boost-now (or (held? 'space) (pad-held? *pad* 'x) (cadddr *touch*)))
             ;; a press is the first tick it is held, or a touch boost that
             ;; went on since the last tick
             (boost (or (and boost-now (not *boost-latch*)) pending))
             (drift (or (held? 'shift 'c) (pad-held? *pad* 'lb) (pad-held? *pad* 'rb) (list-ref *touch* 4))))
        (set! *boost-latch* boost-now)
        (set! *touch-boost-pending* #f)
        (set! *last-throttle* throttle)
        (if (or *autopilot* (showcase?))
            (let ((m (racer-machine (race-player *race*))))
              (ai-input (race-track *race*) m 0.0 #t))
            (make-input steer throttle brake boost drift))))

    (define (start-asked?)
      (let ((t (or *tapped* *start-now*)))
        (set! *tapped* #f)
        (set! *start-now* #f)
        (or t (and (showcase?) (memq (race-phase *race*) (quote (title finished corrupt))))
            (pressed? (quote return) (quote space)) (pad-pressed? *pad* (quote start)) (pad-pressed? *pad* (quote a)))))

    ;; --- the overlay and the other keys ------------------------------------------------------

    (define (overlay-keys!)
      (when (and (dev-keys?) (pressed? 'tab))
        (set! *overlay* (if *overlay* #f 0))
        (say "overlay " (if *overlay* "on" "off")))
      (when (pressed? 'p)
        (set! *tuning* (tuning-set *tuning* 'palette (exact->inexact (modulo (+ 1 (exact (round (tuning-ref *tuning* 'palette)))) 3)))))
      (when (pressed? 'slash)
        (set! *tuning* (tuning-set *tuning* 'dither (if (> (tuning-ref *tuning* 'dither) 0.5) 0.0 1.0))))
      (when *overlay*
        (let ((n (length KNOBS)))
          (when (pressed? 'up) (set! *overlay* (modulo (- *overlay* 1) n)))
          (when (pressed? 'down) (set! *overlay* (modulo (+ *overlay* 1) n)))
          (let* ((k (list-ref KNOBS *overlay*))
                 (key (knob-key k))
                 (dir (cond ((held? 'left) -1) ((held? 'right) 1) (else 0))))
            ;; a press steps once; holding repeats after a quarter second
            (if (= dir 0)
                (set! *repeat* 0)
                (begin
                  (when (or (= *repeat* 0) (and (> *repeat* 15) (even? *repeat*)))
                    (set! *tuning* (tuning-step *tuning* key dir))
                    (after-knob! key))
                  (set! *repeat* (+ *repeat* 1))))
            (when (pressed? '0)
              (set! *tuning* (tuning-set *tuning* key (knob-default k)))
              (after-knob! key))))))

    ;; A knob the race is built from (laps, rivals, their pace) restarts it
    ;; on the grid; the rest apply at once.
    (define (after-knob! key)
      (say "tuning " (symbol->string key) "=" (tuning-format-value (tuning-ref *tuning* key))
           " query ?" (tuning-query *tuning*))
      ;; the overlay's rivals are the session's field, as a rivals= param's
      (when (eq? key 'rivals) (flow-base-note! "rivals=" *tuning*))
      (when (memq key '(track laps rivals rival-pace))
        (set! *race* (race-rebuild))
        (music-prepare!)))

    ;; --- a frame ----------------------------------------------------------------------------

    (define (record-best!)
      (unless (eq? *best-track* (track-name (race-track *race*))) (load-best!))
      (let ((b (racer-best-lap (race-player *race*))))
        (when (and b (or (not *best*) (< b *best*)))
          (set! *best* b)
          (store-write-datum! (best-key) b)
          (say "best lap " (lap-clock b)))))

    ;; Every tick of a frame sees the frame's presses: once one has moved
    ;; the gate or the card on, it is spent until the next frame (one press
    ;; must not skip the card and then the title).
    (define *start-spent* #f)

    ;; A start (title or results to the countdown) begins a new song at
    ;; conductor tick 0. The rest of that frame's ticks belong to the old
    ;; race: running them would open the new song's music at tick 2 or 3,
    ;; a late join that waits silent for bar 1 (1.7 s) and keeps the
    ;; frame's setup interval. Stop there; the next frame starts the song.
    (define (step! n)
      (set! *start-spent* #f)
      (let loop ((i 0))
        ;; a pause opened on this tick holds the frame's later ticks
        (when (and (< i n) (not (flow-paused? *flow*)))
          (let ((started?
          (let* ((was (race-phase *race*))
                 (start (and (start-asked?) (not *start-spent*)))
                 (in (controls))
                 (r (race-step *tuning* *race* in (and start (not (flow-owns-start? *flow*))
                                                       (not (title-active? *title*)))))
                 (started? (and (eq? (race-phase r) (quote countdown))
                                (not (eq? was (quote countdown))))))
            (set! *race* r)
            (when (and (eq? (race-phase r) 'countdown) (not (eq? was 'countdown)))
              (title-emit! (list 'race-start)))
            (if (intro-active? *intro*)
                (when (intro-tick! r start) (set! *start-spent* #t))
                (begin
                  ;; tick 0 reads the frame's input unless the pause menu already
                  ;; read it this frame (a press is read once)
                  (when (flow-active? *flow*) (flow-tick! *race* (and (= i 0) (not *start-spent*) (not *nav-read*))))
                  ;; with the flow on, the title starts only when the flow launches
                  (title-tick! *race* (if (flow-active? *flow*) (let ((l *launch*)) (set! *launch* #f) l) start))
                  ;; after the card: the mark goes once the attract camera passes it
                  (set! *intro* (intro-follow *intro* (title-camera *title* *tuning* (race-track *race*) VIEW-W VIEW-H)
                                              *race*))))
            (for-each (lambda (e) (when (eq? (car e) 'player) (set! *frame-events* (cons (cdr e) *frame-events*))))
                      (race-events r))
            (when (and (eq? (race-phase r) 'corrupt) (not (eq? was 'corrupt)))
              (set! *frame-events* (cons 'corrupt *frame-events*)))
            (for-each (lambda (e)
                        (when (and (eq? (car e) 'player) (pair? (cdr e)) (eq? (cadr e) 'wall))
                          (set! *flash* 6)
                          ;; sparks on the side of the wall it hit
                          (set! *spark* (cons 0 (if (> (machine-d (racer-machine (race-player r))) 0.0) 1 -1)))))
                      (race-events r))
            ;; the autopilot's laps (the showcase drives on it) are not the
            ;; player's: no stored best lap, no ghost
            (unless (or *autopilot* (showcase?))
              (record-best!)
              (when (ghost-on?) (ghost-tick! r was)))
            (let ((t0 (current-jiffy)))
              (fx-tick! r)
              (set! *fx-frame-ms* (+ *fx-frame-ms* (ms-since t0))))
            (effects-tick! r)
            (unless (eq? was (race-phase r))
              (say "phase " (symbol->string (race-phase r))
                   (if (memq (race-phase r) '(finished corrupt))
                       (string-append " place " (number->string (racer-place (race-player r)))
                                      " best " (lap-clock (racer-best-lap (race-player r))))
                       "")))
            ;; the camera eases toward the machine's heading
            (let* ((h (machine-heading (racer-machine (race-player r))))
                   (ch (or *cam-heading* h))
                   (lag (tuning-ref *tuning* 'cam-lag)))
              (set! *cam-heading* (if (eq? (race-phase r) 'title) h (+ ch (* (- h ch) (- 1.0 lag))))))
            (or started? *flow-began*))))
          (set! *flash* (max 0 (- *flash* 1)))
          (when *spark* (set! *spark* (cons (+ 1 (car *spark*)) (cdr *spark*))))
          (if started?
              (begin
                (set! *clock* (clock-new))
                (set! *skip-interval* #t)
                ;; the flow's countdown: the camera starts behind the new race
                (when *flow-began* (set! *flow-began* #f) (set! *cam-heading* #f)))
              (loop (+ i 1))))))
      ;; A tap waits for a tick, as *tapped* does, but no longer: one the
      ;; flow did not read by then (the gate's click, a tap that skipped the
      ;; card) never reaches a menu later.
      (if (> n 0)
          (begin (set! *tap-at* #f) (set! *bare-tap* #f))
          ;; no tick: the presses wait for the next frame's (not through the
          ;; card, whose press is its own, nor the pause menu, read each frame)
          (when (and (not *nav-read*) (flow-active? *flow*) (not (flow-paused? *flow*)) (not (intro-active? *intro*)))
            (set! *nav-carry* (frame-nav)))))

    ;; The player, for the touch check: what a gesture did, from the game.
    (define (core-probe)
      (let ((m (racer-machine (race-player *race*)))
            (r3 (lambda (v) (number->string (/ (round (* v 1000.0)) 1000.0)))))
        (string-append "probe heading " (r3 (machine-heading m))
                       " speed " (number->string (exact (round (machine-speed m))))
                       " boost " (r3 (machine-boost m))
                       " integrity " (r3 (machine-integrity m))
                       ;; the title's phase and fade, for headless checks
                       " phase " (symbol->string (race-phase *race*))
                       " title " (symbol->string (title-phase *title*)) " fade " (r3 (title-fade *title* *tuning*))
                       " intro " (symbol->string (intro-phase *intro*))
                       " " (flow-describe *flow*)
                       " rivals " (number->string (length (race-rivals *race*)))
                       " race-track " (symbol->string (track-name (race-track *race*)))
                       " race-tick " (number->string (race-tick *race*))
                       " glitch " (r3 (max *glitch* (card-glitch))) " card-fade " (r3 (intro-fade *intro* *tuning*))
                       " motion " (if *reduce-motion* "reduce" "full")
                       ;; the sound, for the audio check
                       (let ((a (audio-readout)))
                         (string-append " audio " (if (car a) "on" "off") " depth " (number->string (cadr a))
                                        " underruns " (number->string (caddr a)) " underruns-all " (number->string (cadddr a))
                                        " mode " *audio-mode*
                                        " cues " (let ((m (list-ref a 4))) (if (symbol? m) (symbol->string m) "?"))
                                        " cue-lag " (number->string (list-ref a 5)) " cue-plays " (number->string (list-ref a 7))
                                        " cue-stops " (number->string (list-ref a 8))
                                        " hitches " (number->string *hitch-count*) " audio-ms " (r3 *audio-ms*)))
                       (music-text)
                       " paused " (if (core-paused?) "1" "0"))))

    (define (music-text)
      (let ((m (music-readout)))
        (string-append " music " (if (car m) "on" "off")
                       " music-depth " (r1 (list-ref m 2))
                       " music-underruns " (number->string (list-ref m 3))
                       " music-ms " (r1 (list-ref m 5))
                       " music-missed " (number->string (list-ref m 6))
                       " clock-gap-ms " (r1 (* 1000.0 (pacing-gap *pacing*)))
                       " resync-requests " (number->string *resync-requests*)
                       " resyncs " (number->string (list-ref m 7))
                       " resync-cancels " (number->string (list-ref m 9))
                       " resync-replans " (number->string (list-ref m 10))
                       " dropped-ms " (r1 (* 1000.0 (clock-dropped *clock*)))
                       " tier " (symbol->string (music-tier))
                       (theme-text))))

    ;; The main theme's stream: on (or fading, or off), its version, its
    ;; sounding underruns and how many times it has opened.
    (define (theme-text)
      (let ((t (theme-readout)))
        (string-append " theme " (cond ((not (car t)) "off") ((cadr t) "fading") (else "on"))
                       " theme-version " (symbol->string (list-ref t 2))
                       " theme-underruns " (number->string (list-ref t 4))
                       " theme-opens " (number->string (list-ref t 5)))))

    ;; The reference uses these simulation landings, never driver landings.
    ;; Clock samples are dated at frame advancement, before draw/render CPU.
    (define (music-trace!)
      (when *music-trace*
        (let* ((c (race-song *race*))
               (first (car (reverse (conductor-log c)))))
          (unless (eq? first *music-trace-first*)
            (set! *music-trace-first* first)
            (set! *music-trace-log* '())
            (say "conductor reset wall " (number->string *frame-wall*)
                 " mark " (symbol->string (conductor-section c))
                 " song " (symbol->string (song-id))))
          (for-each
            (lambda (entry)
              (unless (memq entry *music-trace-log*)
                (say "conductor intended tick " (number->string (vector-ref entry 0))
                     " bar " (number->string (vector-ref entry 1))
                     " mark " (symbol->string (vector-ref entry 2)))))
            (reverse (conductor-log c)))
          (set! *music-trace-log* (conductor-log c))
          (say "conductor clock wall " (number->string *frame-wall*)
               " song " (number->string (+ (/ (conductor-tick c) 60.0) (clock-acc *clock*)))
               " audio " (if *frame-ear* (number->string *frame-ear*) "-")
               " tick " (number->string (conductor-tick c))
               " phase " (symbol->string (race-phase *race*))
               (music-text)))))

    ;; The knob table as markdown, for the README (native --knobs).
    (define (core-knobs-markdown)
      (apply string-append
             "| Knob (URL parameter) | Group | Default | Range | Step |\n|---|---|---|---|---|\n"
             (map (lambda (k)
                    (string-append "| `" (symbol->string (knob-key k)) "` " (knob-label k)
                                   " | " (symbol->string (knob-group k))
                                   " | " (tuning-format-value (knob-default k))
                                   " | " (tuning-format-value (knob-min k)) " to " (tuning-format-value (knob-max k))
                                   " | " (tuning-format-value (knob-step k)) " |\n"))
                  KNOBS)))

    ;; Frames per second, smoothed, for the F3 readout (?fps shows it from the start).
    (define *fps-on* #f)
    (define *no-hud* #f)
    (define *no-sprites* #f)
    (define *fps* 60.0)
    (define *frame-ms* 16.7)
    (define *sim-ms* 0.0)        ; the race's steps this frame, CPU
    (define *draw-ms* 0.0)       ; building and submitting the frame, CPU
    (define (ms-since t0) (/ (* 1000.0 (- (current-jiffy) t0)) (jiffies-per-second)))

    ;; The frame-time instruments (F3): the last 180 frames' intervals, and
    ;; the hitch log, every frame over 33 ms with its SIM and DRAW and the
    ;; collections run since the frame before. F4 prints the log;
    ;; ?hitchlog prints each hitch as it happens.
    (define HISTORY 180)
    (define *history* (make-vector HISTORY 16.7))
    (define *hist-i* 0)
    (define *hitches* '())        ; newest first, at most 60
    (define *hitch-count* 0)
    (define *hitch-print* #f)
    (define *audio-mode* (cond-expand (wasm "unknown") (else "native")))
    (define *gc-last* #f)
    ;; (collections . ns spent collecting) since start, from gc-stats: the
    ;; generational backend's minor and major counters, else the plain count
    (define (gc-now)
      (let* ((st (gc-stats))
             (g (lambda (k) (let ((e (assq k st))) (if (and e (number? (cdr e))) (cdr e) 0)))))
        (if (assq 'minor-collections st)
            (cons (+ (g 'minor-collections) (g 'major-collections)) (+ (g 'minor-time-ns) (g 'major-time-ns)))
            (cons (g 'collections) 0))))
    (define *audio-ms* 0.0)
    (define (frame-record! ms sim draw)
      (vector-set! *history* *hist-i* ms)
      (set! *hist-i* (modulo (+ *hist-i* 1) HISTORY))
      (when (or *fps-on* *hitch-print*)
        (let* ((gcs (gc-now))
               (dgc (if *gc-last* (- (car gcs) (car *gc-last*)) 0))
               (dgc-ms (if *gc-last* (/ (- (cdr gcs) (cdr *gc-last*)) 1000000.0) 0.0)))
          (set! *gc-last* gcs)
          (when (> ms 33.0)
            (set! *hitch-count* (+ *hitch-count* 1))
            (let ((h (list (race-tick *race*) ms sim draw dgc dgc-ms *audio-ms*)))
              (set! *hitches* (let take ((l (cons h *hitches*)) (k 0))
                                (if (or (null? l) (>= k 60)) '() (cons (car l) (take (cdr l) (+ k 1))))))
              (when *hitch-print* (say "hitch " (hitch-text h)))))))
      (when (and (dev-keys?) (pressed? 'f4))
        (say "hitch log: " (number->string *hitch-count*) " hitches; newest first")
        (for-each (lambda (h) (say "  " (hitch-text h))) *hitches*)))
    (define (r1 v) (number->string (/ (round (* 10.0 v)) 10.0)))
    (define (hitch-text h)
      (string-append "tick " (number->string (car h)) " frame " (r1 (cadr h)) " ms sim " (r1 (caddr h))
                     " draw " (r1 (cadddr h)) " audio " (r1 (list-ref h 6))
                     " gc " (number->string (list-ref h 4)) " (" (r1 (list-ref h 5)) " ms)"))
    (define (history-max)
      (let loop ((i 0) (m 0.0)) (if (= i HISTORY) m (loop (+ i 1) (max m (vector-ref *history* i))))))
    (define (ease old new) (+ (* 0.9 old) (* 0.1 new)))

    (define (core-describe)
      (let ((m (racer-machine (race-player *race*))))
        (string-append "fps " (number->string (exact (round *fps*)))
                       " audio-ms " (number->string (/ (round (* 10.0 *audio-ms*)) 10.0))
                       " underruns " (number->string (caddr (audio-readout)))
                       " hitches " (number->string *hitch-count*)
                       " sim-ms " (number->string (/ (round (* 10.0 *sim-ms*)) 10.0))
                       " draw-ms " (number->string (/ (round (* 10.0 *draw-ms*)) 10.0))
                       " phase " (symbol->string (race-phase *race*))
                       " " (flow-describe *flow*)
                       " lap " (number->string (racer-lap (race-player *race*)))
                       " s " (number->string (exact (round (machine-s m))))
                       " speed " (number->string (speed-kmh m))
                       " integrity " (number->string (exact (round (machine-integrity m))))
                       (fx-describe)
                       (music-text))))

    ;; Advance a frame without drawing. Headless checks exercise this
    ;; same input, pacing and fixed-tick path as both graphical shells.
    (define (core-advance! dt)
      ;; Web availability is presentation state; native sessions never gain
      ;; an update row. The flow emits a command only on an actual choice.
      (set! *flow* (flow-with-update *flow*
                                    (and (eq? *platform* 'web) (update-waiting?))))
      (update-menu! (and (eq? *platform* 'web)
                         (eq? (flow-screen *flow*) 'mode)
                         (not (intro-active? *intro*))))
      (set! *frame-jiffy* (current-jiffy))
      (set! *frame-wall* (* 1000.0 (current-second)))
      (when (and (dev-keys?) (pressed? 'f5))
        (set! *paused* (not *paused*))
        (audio-pause! (core-paused?))
        (music-frame! (race-song *race*) (music-held?)))
      ;; The pause menu runs no race ticks, so it reads this frame's input here.
      (set! *nav-read* #f)
      (when (flow-paused? *flow*) (flow-tick! *race* #t))
      (when (> dt 0.0)
        (set! *fps* (+ (* 0.95 *fps*) (* 0.05 (/ 1.0 dt))))
        (set! *frame-ms* (+ (* 0.95 *frame-ms*) (* 0.05 (* 1000.0 dt)))))
      ;; ?fps turns the readout on for anyone; F3 toggles it with ?dev
      (when (and (dev-keys?) (pressed? 'f3))
        (set! *fps-on* (not *fps-on*))
        (say "fps readout " (if *fps-on* "on" "off")))
      (overlay-keys!)
      (fx-keys!)
      (when (and (or (pressed? 'r) (pad-pressed? *pad* 'back))
                 (eq? (flow-screen *flow*) 'racing) (eq? (flow-mode *flow*) 'trial))
        (set! *flow* (flow-retry *flow*))
        (restart-race!)
        (say "restart"))
      (when (and (or (pressed? 'r) (pad-pressed? *pad* 'back)) (not (flow-active? *flow*)))
        (intro-skip!)
        (title-skip!)
        (race-begin! *race*)
        (music-close!)
        (set! *clock* (clock-new))
        (set! *pacing* (pacing-new))
        ;; No ticks this frame: the new song opens at conductor tick 0.
        (set! *skip-interval* #t)
        (say "restart"))
      (let* ((interval (if *skip-interval* 0.0 (* dt (if *skew-arm* 1.01 1.0))))
             ;; No interval reaches back before the music stream opened:
             ;; the ear heard none of that time. Counting it charged a
             ;; mid-song start for the work before it (the web's first
             ;; gesture: about a second), caught up the ring's 15 ticks of
             ;; it, and opened a 300 ms gap that cost a resync. The work
             ;; can land in the second frame after the opening, not the
             ;; first: a browser stamps a frame before it runs the input
             ;; handlers queued in it.
             (opened (music-opened-jiffy))
             (interval (if opened
                           (min interval (max 0.0 (/ (- *frame-jiffy* opened)
                                                     (* 1.0 (jiffies-per-second)))))
                           interval))
             (c (race-song *race*))
             ;; A song at tick zero waits for its device to start: the
             ;; simulation does not pass the ear until the first tick, for
             ;; at most START-HOLD-CAP s after the opening.
             (hold-ear (and opened (music-running?) (not (core-paused?)) (music-audible-seconds)))
             (since-open (if opened (/ (- *frame-jiffy* opened) (* 1.0 (jiffies-per-second))) 0.0))
             (holding (start-holding? (conductor-tick c) hold-ear since-open))
             (interval (start-hold-interval interval (conductor-tick c) hold-ear (clock-acc *clock*) since-open))
             ;; With the song playing, a long frame catches up to the
             ;; catchup-ticks knob (the ring's depth by default); without
             ;; it, Substratic's six-tick cap.
             (cap (if (music-running?)
                      (exact (round (tuning-ref *tuning* (quote catchup-ticks))))
                      MAX-STEPS-PER-FRAME))
             ;; The ear is sampled at this frame's time. Compare it to
             ;; the simulation this interval would produce, respecting
             ;; the stall cap rather than hiding stalls.
             (candidate (clock-advance-capped *clock* (if (core-paused?) 0.0 interval) cap))
             (sim (+ (/ (+ (conductor-tick c) (clock-steps candidate)) 60.0)
                     (clock-acc candidate)))
             (ear (music-audible-seconds)))
        (set! *skip-interval* #f)
        (set! *frame-ear* ear)
        (set! *pacing* (pace-frame *pacing* interval sim (or ear sim)
                                 (and (music-running?) (not holding)) (core-paused?) (conductor-bar c)
                                 in-flight: (music-resync-in-flight?)))
        (when (pacing-resync? *pacing*)
          (set! *resync-requests* (+ *resync-requests* 1))
          (unless *depth-arm* (music-request-resync!)))
        (set! *clock* (clock-advance-capped *clock*
                                            (if (and *skew-arm* (not (core-paused?)))
                                                interval
                                                (pacing-dt *pacing*))
                                            cap)))
      (let ((t0 (current-jiffy)))
        (set! *fx-frame-ms* 0.0)
        (step! (clock-steps *clock*))
        (set! *fx-ms* (ease *fx-ms* *fx-frame-ms*))
        (set! *sim-ms* (ease *sim-ms* (ms-since t0))))
      ;; Revoke permission in the same frame that leaves the mode menu;
      ;; a pause, result panel, countdown or race is never an update menu.
      (update-menu! (and (eq? *platform* 'web)
                         (eq? (flow-screen *flow*) 'mode)
                         (not (intro-active? *intro*)))))

    (define *startup-frames* 0)
    (define (core-frame! dt win-w win-h integer-only)
      (let ((marking? (< *startup-frames* 4)))
        (set! *startup-frames* (+ *startup-frames* 1))
        (core-advance! dt)
        (when marking? (core-startup-mark! "advance"))
        (service-audio!)
        (when marking? (core-startup-mark! "audio")))
      (let ((t0 (current-jiffy)))
       (scene-frame! *tuning* *race* (or *cam-heading* 0.0)
                    (list (cons 'best (if (memq (flow-screen *flow*) '(racing paused launch fade results trial-results))
                                          (let ((a (flow-hud-best *flow*)) (b (racer-best-lap (race-player *race*))))
                                            (if (and a b) (min a b) (or a b)))
                                          *best*))
                          (cons 'flow-panel (flow-panel? *flow*))
                          (cons 'start-card (flow-start-card *flow*))
                          (cons 'draw-ui (and (not *no-hud*) (not (intro-active? *intro*))
                                              (memq (flow-screen *flow*) '(mode tier cup trial results standings cup-end trial-results paused racing))
                                              (lambda (kit)
                                                (flow-draw! *flow* kit *race*
                                                            (list (cons 'calm *reduce-motion*) (cons 'touch *touch-device*)
                                                                  (cons 'update-blocked (update-blocked?))
                                                                  (cons 'web (eq? *platform* 'web)))))))
                          (cons 'flash *flash*)
                          (cons 'spark *spark*)
                          (cons 'kick *kick*)
                          (cons (quote glitch) (max *glitch* (card-glitch)))
                          (cons (quote fx) *fx*)
                          (cons (quote fx-knob) fx-knob)
                          (cons (quote fx-caption) *fx-caption*)
                          (cons (quote traced-age) (and *traced-at* (eq? (race-phase *race*) (quote race))
                                                        (- (race-tick *race*) *traced-at*)))
                          (cons (quote fx-hint) (if (eq? *platform* (quote web)) #f "E EFFECTS  F6 SOLO  F7 SHOWCASE"))
                          (cons (quote hud) (and (not *no-hud*) (title-hud? *title*) (not (intro-active? *intro*))))
                          (cons (quote camera) (or (intro-camera *intro* *tuning* *race* VIEW-W VIEW-H)
                                                   (title-camera *title* *tuning* (race-track *race*) VIEW-W VIEW-H)))
                          (cons (quote fade) (max (intro-fade *intro* *tuning*) (title-fade *title* *tuning*) (flow-fade *flow*)))
                          (cons (quote draw-ground) (and (intro-mark-shown? *intro*)
                                                         (or (intro-active? *intro*) (memq (title-phase *title*) '(attract out)))
                                                         (lambda (c) (intro-draw-mark! c *race*))))
                          (cons (quote draw-3d) (and (title-active? *title*) (not (intro-active? *intro*))
                                                     (lambda () (title-draw-logo! *title* (or (theme-beat) (title-beat (conductor-tick (race-song *race*))))))))
                          (cons (quote draw-2d) (cond ((eq? (intro-phase *intro*) 'gate)
                                                       (lambda (centred!) (centred! (intro-gate-line *touch-device*) 130 "#4DF2D9" 2)))
                                                      ((intro-active? *intro*) #f)
                                                      ;; the prompt blinks; with reduced motion, steady
                                                      ((and (not (flow-owns-start? *flow*))
                                                            (or (title-prompt? *title*)
                                                                (and *reduce-motion* (eq? (title-phase *title*) 'attract)))
                                                            (not *no-hud*))
                                                       (lambda (centred!)
                                                         (centred! (if (eq? *platform* 'web) "PRESS ENTER, START OR TAP" "PRESS ENTER OR START")
                                                                   206 "#FFCC33" 2)))
                                                      (else #f)))
                          (cons (quote sprites) (not *no-sprites*))
                          (cons 'corrupt *corrupt*)
                          (cons 'popups *popups*)
                          (cons 'ghost (and (ghost-on?) (ghost-now *race*)))
                          (cons 'time (/ (race-tick *race*) 60.0))
                          (cons 'start-line (if (eq? *platform* 'web) "PRESS ENTER OR TAP" "PRESS ENTER"))
                          (cons 'restart-line (if (eq? *platform* 'web) "ENTER OR TAP TO RUN IT AGAIN" "ENTER TO RUN IT AGAIN"))
                          (cons 'overlay *overlay*)
                          (cons 'paused (core-paused?))
                          (cons 'motion (if *reduce-motion* 'reduce 'full))
                          (cons 'fps (and *fps-on* (list *fps* *frame-ms* *sim-ms* *draw-ms*)))
                          (cons 'instruments (and *fps-on* (list *history* *hist-i* (history-max) *hitch-count*
                                                                 *audio-mode* (audio-readout) *audio-ms*))))
                    win-w win-h integer-only)
       (set! *draw-ms* (ease *draw-ms* (ms-since t0))))
      (frame-record! (* 1000.0 dt) *sim-ms* *draw-ms*)
      (finish-frame!))

    ;; Actual race/audio path without drawing, for headless diagnostics.
    ;; The host supplies measured wall intervals, exactly as core-frame!.
    (define (core-headless-frame! dt)
      (core-advance! dt)
      (service-audio!)
      (finish-frame!))

    (define (service-audio!)
      (let ((m (racer-machine (race-player *race*))) (t0 (current-jiffy)))
        (theme-service!)
        ;; the theme took the card's release: the race song needs none
        (if *theme-session* (music-unhold!) (song-gate!))
        ;; the immediate path: a hard wall hit dips the song to 40% for
        ;; 40 ms, an ICE strike drops it for a 16th, CORRUPT fades it out
        (when *damage-on*
        (for-each (lambda (e)
                    (cond ((and (pair? e) (eq? (car e) 'wall) (>= (cdr e) HIT-IMPACT))
                           (music-dip! 0.04 0.4))
                          ((eq? e 'ice) (music-dip! (/ 15.0 SONG-BPM) 0.0))
                          ((eq? e 'corrupt) (music-fade-out! 0.5))
                          (else #f)))
                  *frame-events*))
        (music-frame! (race-song *race*) (music-held?)
                      clock-fraction: (clock-acc *clock*)
                      frame-jiffy: *frame-jiffy*
                      integrity: (if *damage-on* (machine-integrity m) 100.0)
                      dead-air: (and *damage-on* (eq? (race-phase *race*) 'race)
                                     (racer-dead-air (race-player *race*)))
                      boost: (and *damage-on* (> (machine-boost m) 0.0)))
        ;; a repair's snap, as it reaches the ear: the lock
        (when (music-lock-due!) (audio-lock!))
        (unless (= *music-generation* (music-generation))
          (set! *music-generation* (music-generation))
          ;; A new stream bounds the next interval at its opening (in
          ;; core-advance!), so a skip asked for it (a race start: the
          ;; rest of the frame was the old race's) would only drop what
          ;; the ear hears after the opening: a 628 ms frame after a native
          ;; race start left the simulation 104 ms behind and cost a
          ;; resync at the countdown. Without music the skip stands.
          (set! *skip-interval* #f)
          (when (= 0 (conductor-tick (race-song *race*)))
            ;; A new song's stream: the clock and pacing start over. The
            ;; setup before it opened is never counted (no interval
            ;; reaches back past the opening, in core-advance!), and the
            ;; time since is: skipping the next interval outright lost what
            ;; the ear had already heard (127 ms at a native boot, and a
            ;; resync request).
            (set! *clock* (clock-new))
            (set! *pacing* (pacing-new))
            ;; The frame-start reading belonged to the old stream.
            (set! *frame-ear* #f)))
        (audio-frame! (if (memq (race-phase *race*) '(title countdown)) 0.0
                          (/ (machine-speed m) (handling-ref *tuning* 'top)))
                      (if (eq? (race-phase *race*) 'race) *last-throttle* 0.0)
                      (> (machine-boost m) 0.0)
                      *frame-events*)
        ;; The cue bank, a few milliseconds a frame: more before the sound
        ;; starts (on the web's start gate, which opens a suspended context
        ;; for its rate), less once the music plays. On the web the music's
        ;; player is built there too, in one frame, while the music is off.
        (tune-audio!)
        (audio-prepare! (if (audio-started?) 3.0 8.0) (eq? *platform* 'web))
        ;; The theme's player first (the title plays it first), the race
        ;; song's on a later frame: each build is about a frame's work.
        (when (and (eq? *platform* 'web)
                   (not (theme-prepare! (audio-context))))
          (music-prepare-playback! (audio-context) (race-song *race*)))
        (set! *audio-ms* (ease *audio-ms* (ms-since t0)))))

    (define (finish-frame!)
      (music-trace!)
      (set! *frame-events* '())
      (keys-end-frame! *keys*)
      (pad-end-frame! *pad*))))
