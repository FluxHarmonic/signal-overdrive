;;; (signal shell core) - What both shells share: the race on Substratic's
;;; fixed clock, the input it reads (keys, a gamepad, the page's touch
;;; schemes), the tuning and its overlay, the best lap in the store, the
;;; camera's lag, and the frame.
;;;
;;; Controls (the README has them all):
;;;   steer       Left/Right or A/D; a pad's left stick or d-pad
;;;   accelerate  Up or W; a pad's A or right trigger
;;;   brake       Down or S; a pad's B or left trigger
;;;   boost       Space; a pad's X (from lap 2)
;;;   drift       Shift or C; a pad's LB or RB
;;;   start       Enter or Space; a pad's Start or A; a tap on a phone
;;;   restart     R; a pad's Back
;;;   tuning      Tab: the overlay (Up/Down pick a knob, Left/Right set
;;;               it, 0 resets it); P the palette; / the dither

(define-library (signal shell core)
  (import (sigil core)
          (sigil math)
          (sigil string)
          (sigil list)
          (sigil time)
          (sigil gc)
          (substratic time clock)
          (substratic input keys)
          (substratic input sticks)
          (substratic input pad)
          (substratic store kv)
          (signal track)
          (signal handling)
          (signal race)
          (signal tuning)
          (signal scene)
          (signal shell audio)
          (signal fx beat)
          (signal fx state)
          (signal fx showcase))

  (export core-boot! core-frame! core-keys core-sticks core-pad core-param! core-touch!
          core-tap! core-race core-tuning core-describe core-probe core-knobs-markdown GAME-NAME
          core-audio-start!)

  (begin
    (define GAME-NAME "signal-overdrive")
    ;; the best lap, one per track
    (define (best-key) (string-append "best-lap-" (symbol->string (track-name (race-track *race*)))))
    (define *best-track* #f)
    (define (load-best!)
      (set! *best-track* (track-name (race-track *race*)))
      (set! *best* (let ((b (store-read-datum (best-key)))) (and (exact-integer? b) b))))

    (define *tuning* (tuning-defaults))
    (define *race* #f)
    (define *clock* (clock-new))
    (define *keys* (make-keys))
    (define *sticks* (make-sticks))
    (define *pad* (make-pad))
    (define *best* #f)
    (define *cam-heading* #f)
    (define *flash* 0)
    (define *spark* #f)          ; (age-in-ticks . side) since the last wall hit
    ;; pass 3's frame effects, eased per tick
    (define *kick* 0.0)          ; a boost's camera punch, 1 then decaying
    (define *glitch* 0.0)        ; the screen's glitch: wall hits, ICE
    (define *corrupt* 0.0)       ; corrupt cargo, ramping to 1
    (define *popups* '())        ; ((text colour age) ...) by the meter
    (define (popup! text colour) (set! *popups* (cons (list text colour 0) *popups*)))

    ;; The best lap's ghost. The player's positions are recorded every tick
    ;; of the lap being driven; when a lap ends as the best yet on this
    ;; track, its record becomes the ghost, replayed tick by tick against
    ;; the current lap's clock. Positions, not inputs: replaying inputs
    ;; would diverge the first time a rival bumped the live machine, since
    ;; the ghost has no rivals to bump it. In memory only, per run.
    (define *trail* '())
    (define *ghost* #f)          ; a vector of (x y heading), one per tick
    (define *ghost-track* #f)
    (define *ghost-best* #f)

    ;; was: the phase before this tick (the last lap ends in the tick that
    ;; turns the phase to finished, and must count too)
    (define (ghost-tick! r was)
      (let* ((p (race-player r)) (m (racer-machine p)) (name (track-name (race-track r))))
        (unless (eq? name *ghost-track*)
          (set! *ghost-track* name) (set! *ghost* #f) (set! *ghost-best* #f) (set! *trail* '()))
        (when (or (eq? (race-phase r) 'race) (eq? was 'race))
          ;; a new lap began this tick: was the one before it the best?
          (when (= (racer-lap-start p) (race-tick r))
            (let ((b (racer-best-lap p)))
              (when (and b (equal? b (racer-last-lap p)) (pair? *trail*)
                         (or (not *ghost-best*) (< b *ghost-best*)))
                (set! *ghost* (list->vector (reverse *trail*)))
                (set! *ghost-best* b)
                (say "ghost: a new best lap, " (lap-clock b))))
            (set! *trail* '()))
          (when (> (racer-lap p) 0)
            (set! *trail* (cons (list (machine-x m) (machine-y m) (machine-heading m)) *trail*))))))

    (define (ghost-now r)
      (let ((p (race-player r)))
        (and *ghost* (eq? (race-phase r) 'race) (> (racer-lap p) 0)
             (let ((i (- (race-tick r) (racer-lap-start p))))
               (and (< i (vector-length *ghost*)) (vector-ref *ghost* i))))))

    ;; The frame effects from this tick's events.
    (define (effects-tick! r)
      (let ((m (racer-machine (race-player r))))
        (for-each (lambda (e)
                    (when (eq? (car e) 'player)
                      (let ((ev (cdr e)))
                        (cond ((memq ev '(boost)) (set! *kick* 1.0)
                               (popup! (string-append "-" (number->string (exact (round (handling-ref *tuning* 'boost-cost))))) "#F2731A"))   ; orange: speed (P16)
                              ((eq? ev 'pad) (set! *kick* 0.8) (popup! "PAD" "#F2731A"))
                              ((eq? ev 'ice) (popup! "ICE" "#FF9F1A"))   ; amber: ICE (P16)
                              ((and (pair? ev) (eq? (car ev) 'wall))
                               (let ((cost (exact (round (* (cdr ev) (handling-ref *tuning* 'wall-damage))))))
                                 (when (>= cost 1) (popup! (string-append "-" (number->string cost)) "#FF5959"))))))))
                  (race-events r))
        (when (and (machine-on-repair m) (= 0 (modulo (race-tick r) 20)))
          (popup! "+" "#4DF2D9"))
        ;; the glitch is (signal fx state)'s: at most 6 ticks a hit (P15); the
        ;; scramble's lasting sign is the HUD's, never the road's
        (set! *kick* (* *kick* 0.92))
        (set! *glitch* (fx-glitch-now *fx*))
        (set! *corrupt* (if (eq? (race-phase r) 'corrupt) (min 1.0 (+ *corrupt* 0.03)) 0.0))
        (set! *popups* (let keep ((ps *popups*))
                         (cond ((null? ps) '())
                               ((> (caddr (car ps)) 50) (keep (cdr ps)))
                               (else (cons (list (car (car ps)) (cadr (car ps)) (+ 1 (caddr (car ps)))) (keep (cdr ps)))))))))
    ;; --- the 0.1 effects ---------------------------------------------------------------
    ;; (signal fx state), stepped every tick from the stub's pulse (the
    ;; conductor's later: see (signal fx beat)), the player's events and
    ;; the integrity. Fires come from the page's panel ("fx-fire=wall"),
    ;; the F-keys and the showcase.
    (define *fx* (fx-new))
    (define *fx-fires* '())
    (define *traced-at* #f)       ; the tick the player started the final lap
    (define *fx-caption* #f)
    (define *fx-ms* 0.0)          ; fx-tick!'s CPU ms a frame, smoothed (in SIM)
    (define *fx-frame-ms* 0.0)
    (define FX-ORDER '(fx-dip fx-pools fx-chase fx-sky fx-glitch fx-warp fx-interf))
    (define (fx-param? kv) (and (> (string-length kv) 3) (string=? (substring kv 0 3) "fx-")))
    (define (showcase?) (> (tuning-ref *tuning* 'fx-showcase) 0.5))
    (define (fx-solo)
      (if (showcase?)
          (car (showcase-at (race-tick *race*) (stub-pulse (race-tick *race*) 'lap1 #f)))
          (exact (round (tuning-ref *tuning* 'fx-solo)))))
    ;; an effect's intensity as the effects see it: 0 when another is solo
    (define (fx-knob key)
      (let ((solo (fx-solo))
            (k (let find ((ks FX-ORDER) (i 1)) (cond ((null? ks) 0) ((eq? (car ks) key) i) (else (find (cdr ks) (+ i 1)))))))
        (if (and (> solo 0) (> k 0) (not (= solo k))) 0.0 (tuning-ref *tuning* key))))

    (define (fx-tick! r)
      (let* ((p (race-player r))
             (m (racer-machine p))
             (laps (exact (round (race-tuning-ref *tuning* 'laps))))
             (section (stub-section (race-phase r) (racer-lap p) laps (racer-halfway p))))
        (if (eq? section 'traced)
            (unless *traced-at* (set! *traced-at* (race-tick r)))
            (set! *traced-at* #f))
        (let* ((pl (stub-pulse (race-tick r) section *traced-at*))
               (sc (and (showcase?) (showcase-at (race-tick r) pl)))
               (pl (if (and sc (cadddr sc)) (pulse-with-section pl 'traced) pl))
               (events (let loop ((es (race-events r)) (acc '()))
                         (cond ((null? es) acc)
                               ((eq? (caar es) 'player) (loop (cdr es) (cons (cdar es) acc)))
                               (else (loop (cdr es) acc)))))
               (fires (append *fx-fires* (if sc (cadr sc) '())))
               (tier (tuning-ref *tuning* 'fx-tier))
               (integrity (cond ((and sc (caddr sc)) (caddr sc))
                                ((>= tier 0.0) tier)
                                (else (machine-integrity m)))))
          (set! *fx-fires* '())
          (set! *fx-caption*
                (let ((what (cond (sc (list-ref sc 4))
                                  ((> (fx-solo) 0) (string-append "SOLO: " (vector-ref FX-NAMES (fx-solo))))
                                  (else #f)))
                      (forced (and (>= tier 0.0) (not (and sc (caddr sc)))
                                   (string-append "TIER " (tier-name (integrity-tier tier)) " (FORCED)"))))
                  (cond ((and what forced) (string-append what "  " forced))
                        (else (or what forced)))))
          (set! *fx* (fx-step *fx* pl events integrity
                              (list (machine-x m) (machine-y m) (machine-heading m))
                              fires fx-knob))
          ;; the drop kicks the camera too (§3.3)
          (when (and (fx-drop-now *fx*) (> (fx-knob 'fx-dip) 0.0)) (set! *kick* 1.0)))))

    (define (fx-fire! what)
      (cond ((eq? what 'tier)
             ;; the integrity the effects see: real, then each tier down
             (let* ((t (tuning-ref *tuning* 'fx-tier))
                    (next (cond ((< t 0.0) 70.0) ((> t 50.0) 45.0) ((> t 25.0) 20.0) ((> t 7.0) 5.0) (else -1.0))))
               (set! *tuning* (tuning-set *tuning* 'fx-tier next))
               (say "fx tier " (if (< next 0.0) "real" (tier-name (integrity-tier next))))))
            (else (set! *fx-fires* (cons what *fx-fires*)) (say "fx fire " (symbol->string what)))))

    ;; Natively, and on the web too: E opens the tuning overlay at the
    ;; effects' knobs (the web page has its own panel on E as well), F6
    ;; solos the next effect, F7 the showcase, F8 a wall hit, F9 an ICE
    ;; strike (a tracer: marked on the next downbeat, striking on the one
    ;; after), F10 the drop, F2 the next integrity tier.
    (define (fx-keys!)
      (when (and (pressed? 'e) (not (eq? *platform* 'web)))
        (set! *overlay* (if *overlay* #f
                            (let find ((ks KNOBS) (i 0))
                              (cond ((null? ks) 0) ((eq? (knob-group (car ks)) 'fx) i) (else (find (cdr ks) (+ i 1))))))))
      (when (pressed? 'f6)
        (set! *tuning* (tuning-set *tuning* 'fx-solo (modulo (+ 1 (exact (round (tuning-ref *tuning* 'fx-solo)))) 8)))
        (say "fx solo " (number->string (exact (round (tuning-ref *tuning* 'fx-solo))))))
      (when (pressed? 'f7)
        (set! *tuning* (tuning-set *tuning* 'fx-showcase (if (showcase?) 0.0 1.0))))
      (when (pressed? 'f8) (fx-fire! 'wall))
      (when (pressed? 'f9) (fx-fire! 'ice))
      (when (pressed? 'f10) (fx-fire! 'drop))
      (when (pressed? 'f2) (fx-fire! 'tier)))

    (define (fx-describe)
      (string-append " fx-ms " (number->string (/ (round (* 100.0 *fx-ms*)) 100.0))
                     " fx-tier " (number->string (fx-tier *fx*))
                     " fx-interf " (number->string (/ (round (* 100.0 (fx-interf *fx*))) 100.0))
                     " fx-section " (symbol->string (fx-section *fx*))
                     " fx-bar " (number->string (fx-bar *fx*))
                     " fx-chase " (number->string (fx-chase *fx*))
                     " fx-solo " (number->string (fx-solo))))

    (define *overlay* #f)         ; the selected knob's row while the overlay is open
    (define *platform* 'desktop)
    (define *tapped* #f)
    ;; the page's touch scheme sends its whole state at once:
    ;; steer throttle brake boost drift
    (define *touch* (list 0.0 0.0 0.0 #f #f))
    (define *touch-boost-was* #f)
    (define *repeat* 0)

    (define (core-keys) *keys*)
    (define (core-sticks) *sticks*)
    (define (core-pad) *pad*)
    (define (core-race) *race*)
    (define (core-tuning) *tuning*)

    (define (say . parts) (display (apply string-append "signal-overdrive: " parts)) (newline))

    (define (core-boot! platform)
      (set! *platform* platform)
      (set-store-app! GAME-NAME)
      (set-store-prefix! "signal-overdrive:")
      (set! *race* (race-new *tuning*))
      (load-best!))

    ;; A URL parameter or a command-line --key=value: a knob; or
    ;; autopilot (the player drives the racing line, for checks and
    ;; screenshots) or start (no title: the countdown at once); or ignored.
    (define *autopilot* #f)
    (define *start-now* #f)
    (define (core-param! kv)
      (cond ((string=? kv "autopilot") (set! *autopilot* #t) (say "autopilot on"))
            ((string=? kv "start") (set! *start-now* #t))
            ;; the effects panel's triggers: fx-fire=wall|ice|drop|tier
            ((and (> (string-length kv) 8) (string=? (substring kv 0 8) "fx-fire="))
             (fx-fire! (string->symbol (substring kv 8 (string-length kv)))))
            ((string=? kv "showcase") (core-param! "fx-showcase=1"))
            ((string=? kv "fps") (set! *fps-on* #t))
            ;; no HUD: clean captures, and the P15 gate's static frame
            ((string=? kv "nohud") (set! *no-hud* #t))
            ((string=? kv "mute") (audio-mute!))
            ((string=? kv "hitchlog") (set! *hitch-print* #t))
            ((string=? kv "cues=0") (audio-cues! #f))
            ((and (> (string-length kv) 11) (string=? (substring kv 0 11) "audiodepth="))
             (let ((v (string->number (substring kv 11 (string-length kv)))))
               (when v (audio-depth! v) (say "audio depth " (number->string v) " ms"))))
            ;; the page's own report: the audio bridge's stream mode as the
            ;; page infers it (an AudioWorklet and cross-origin isolation:
            ;; worklet-sab; a worklet only: worklet-msg; else scriptprocessor)
            ((and (> (string-length kv) 11) (string=? (substring kv 0 11) "audio-mode="))
             (set! *audio-mode* (substring kv 11 (string-length kv))))
            ;; ?track=oval|loop as well as ?track=0|1
            ((and (> (string-length kv) 6) (string=? (substring kv 0 6) "track=")
                  (memq (string->symbol (substring kv 6 (string-length kv))) TRACKS))
             (core-param! (string-append "track=" (number->string (track-index-of (string->symbol (substring kv 6 (string-length kv))))))))
            (else
             (let ((t (tuning-parse! *tuning* kv)))
               (when t
                 (set! *tuning* t)
                 (unless (fx-param? kv) (set! *race* (race-new *tuning*)))
                 (say "tuning " kv))))))

    ;; "steer,throttle,brake,boost,drift" from the page (0/1 for the last two).
    (define (core-touch! payload)
      (let* ((parts (let split ((s payload) (acc '()))
                      (let ((i (let find ((k 0)) (cond ((>= k (string-length s)) #f) ((char=? (string-ref s k) #\,) k) (else (find (+ k 1)))))))
                        (if i (split (substring s (+ i 1) (string-length s)) (cons (substring s 0 i) acc))
                            (reverse (cons s acc))))))
             (num (lambda (k) (or (and (> (length parts) k) (string->number (list-ref parts k))) 0.0)))
             (boost (> (num 3) 0.5)))
        ;; a boost that goes on is kept for the next tick even if it goes
        ;; off again first (a tap's on and off can both land between ticks)
        (when (and boost (not (cadddr *touch*))) (set! *touch-boost-pending* #t))
        (set! *touch* (list (num 0) (num 1) (num 2) boost (> (num 4) 0.5)))))
    (define *touch-boost-pending* #f)

    ;; A tap on the page (a start on the title and end screens).
    (define (core-tap!) (set! *tapped* #t))

    ;; --- input ------------------------------------------------------------------------------

    (define (axis neg pos)
      (cond ((and (keys-held? *keys* neg) (not (keys-held? *keys* pos))) -1.0)
            ((and (keys-held? *keys* pos) (not (keys-held? *keys* neg))) 1.0)
            (else 0.0)))
    (define (held? . ks) (let loop ((ks ks)) (and (pair? ks) (or (keys-held? *keys* (car ks)) (loop (cdr ks))))))
    (define (pressed? . ks) (let loop ((ks ks)) (and (pair? ks) (or (keys-pressed? *keys* (car ks)) (loop (cdr ks))))))
    (define (clamp1 v) (max -1.0 (min 1.0 v)))
    (define (trigger name) (max 0.0 (/ (+ 1.0 (pad-axis *pad* name)) 2.0)))   ; -1..1 at rest -1

    (define *boost-latch* #f)
    (define *last-throttle* 0.0)
    (define *frame-events* '())   ; the player's events over this frame's ticks, for the sound
    (define (core-audio-start!) (audio-start!))
    ;; One tick's controls: the player's (signal handling) input.
    (define (controls)
      (let* ((ps (stick-analog (pad-axis *pad* 'lx) 0.0 0.18))
             (overlay? *overlay*)
             (steer (clamp1 (+ (if overlay? 0.0 (+ (axis 'left 'right) (axis 'a 'd)))
                               (cond ((pad-held? *pad* 'left) -1.0) ((pad-held? *pad* 'right) 1.0) (else 0.0))
                               (car ps)
                               (car *touch*))))
             (throttle (max (if (and (not overlay?) (held? 'up 'w)) 1.0 0.0)
                            (if (pad-held? *pad* 'a) 1.0 0.0)
                            (trigger 'rt)
                            (if overlay? 0.0 (cadr *touch*))))
             (brake (max (if (and (not overlay?) (held? 'down 's)) 1.0 0.0)
                         (if (pad-held? *pad* 'b) 1.0 0.0)
                         (trigger 'lt)
                         (caddr *touch*)))
             (pending *touch-boost-pending*)
             (boost-now (or (held? 'space) (pad-held? *pad* 'x) (cadddr *touch*)))
             ;; a press is the first tick it is held, or a touch boost that
             ;; went on since the last tick
             (boost (or (and boost-now (not *boost-latch*)) pending))
             (drift (or (held? 'shift 'c) (pad-held? *pad* 'lb) (pad-held? *pad* 'rb) (list-ref *touch* 4))))
        (set! *boost-latch* boost-now)
        (set! *touch-boost-pending* #f)
        (set! *last-throttle* throttle)
        (if (or *autopilot* (showcase?))
            (let ((m (racer-machine (race-player *race*))))
              (ai-input (race-track *race*) m 0.0 #t))
            (make-input steer throttle brake boost drift))))

    (define (start-asked?)
      (let ((t (or *tapped* *start-now*)))
        (set! *tapped* #f)
        (set! *start-now* #f)
        (or t (and (showcase?) (memq (race-phase *race*) (quote (title finished corrupt))))
            (pressed? (quote return) (quote space)) (pad-pressed? *pad* (quote start)) (pad-pressed? *pad* (quote a)))))

    ;; --- the overlay and the other keys ------------------------------------------------------

    (define (overlay-keys!)
      (when (pressed? 'tab)
        (set! *overlay* (if *overlay* #f 0))
        (say "overlay " (if *overlay* "on" "off")))
      (when (pressed? 'p)
        (set! *tuning* (tuning-set *tuning* 'palette (if (> (tuning-ref *tuning* 'palette) 0.5) 0.0 1.0))))
      (when (pressed? 'slash)
        (set! *tuning* (tuning-set *tuning* 'dither (if (> (tuning-ref *tuning* 'dither) 0.5) 0.0 1.0))))
      (when *overlay*
        (let ((n (length KNOBS)))
          (when (pressed? 'up) (set! *overlay* (modulo (- *overlay* 1) n)))
          (when (pressed? 'down) (set! *overlay* (modulo (+ *overlay* 1) n)))
          (let* ((k (list-ref KNOBS *overlay*))
                 (key (knob-key k))
                 (dir (cond ((held? 'left) -1) ((held? 'right) 1) (else 0))))
            ;; a press steps once; holding repeats after a quarter second
            (if (= dir 0)
                (set! *repeat* 0)
                (begin
                  (when (or (= *repeat* 0) (and (> *repeat* 15) (even? *repeat*)))
                    (set! *tuning* (tuning-step *tuning* key dir))
                    (after-knob! key))
                  (set! *repeat* (+ *repeat* 1))))
            (when (pressed? '0)
              (set! *tuning* (tuning-set *tuning* key (knob-default k)))
              (after-knob! key))))))

    ;; A knob the race is built from (laps, rivals, their pace) restarts it
    ;; on the grid; the rest apply at once.
    (define (after-knob! key)
      (say "tuning " (symbol->string key) "=" (tuning-format-value (tuning-ref *tuning* key))
           " query ?" (tuning-query *tuning*))
      (when (memq key '(track laps rivals rival-pace))
        (set! *race* (race-new *tuning*))))

    ;; --- a frame ----------------------------------------------------------------------------

    (define (record-best!)
      (unless (eq? *best-track* (track-name (race-track *race*))) (load-best!))
      (let ((b (racer-best-lap (race-player *race*))))
        (when (and b (or (not *best*) (< b *best*)))
          (set! *best* b)
          (store-write-datum! (best-key) b)
          (say "best lap " (lap-clock b)))))

    (define (step! n)
      (let loop ((i 0))
        (when (< i n)
          (let* ((was (race-phase *race*))
                 (start (start-asked?))
                 (in (controls))
                 (r (race-step *tuning* *race* in start)))
            (set! *race* r)
            (for-each (lambda (e) (when (eq? (car e) 'player) (set! *frame-events* (cons (cdr e) *frame-events*))))
                      (race-events r))
            (when (and (eq? (race-phase r) 'corrupt) (not (eq? was 'corrupt)))
              (set! *frame-events* (cons 'corrupt *frame-events*)))
            (for-each (lambda (e)
                        (when (and (eq? (car e) 'player) (pair? (cdr e)) (eq? (cadr e) 'wall))
                          (set! *flash* 6)
                          ;; sparks on the side of the wall it hit
                          (set! *spark* (cons 0 (if (> (machine-d (racer-machine (race-player r))) 0.0) 1 -1)))))
                      (race-events r))
            (record-best!)
            (ghost-tick! r was)
            (let ((t0 (current-jiffy)))
              (fx-tick! r)
              (set! *fx-frame-ms* (+ *fx-frame-ms* (ms-since t0))))
            (effects-tick! r)
            (unless (eq? was (race-phase r))
              (say "phase " (symbol->string (race-phase r))
                   (if (memq (race-phase r) '(finished corrupt))
                       (string-append " place " (number->string (racer-place (race-player r)))
                                      " best " (lap-clock (racer-best-lap (race-player r))))
                       "")))
            ;; the camera eases toward the machine's heading
            (let* ((h (machine-heading (racer-machine (race-player r))))
                   (ch (or *cam-heading* h))
                   (lag (tuning-ref *tuning* 'cam-lag)))
              (set! *cam-heading* (if (eq? (race-phase r) 'title) h (+ ch (* (- h ch) (- 1.0 lag)))))))
          (set! *flash* (max 0 (- *flash* 1)))
          (when *spark* (set! *spark* (cons (+ 1 (car *spark*)) (cdr *spark*))))
          (loop (+ i 1)))))

    ;; The player, for the touch check: what a gesture did, from the game.
    (define (core-probe)
      (let ((m (racer-machine (race-player *race*)))
            (r3 (lambda (v) (number->string (/ (round (* v 1000.0)) 1000.0)))))
        (string-append "probe heading " (r3 (machine-heading m))
                       " speed " (number->string (exact (round (machine-speed m))))
                       " boost " (r3 (machine-boost m))
                       " integrity " (r3 (machine-integrity m))
                       ;; the sound, for the audio check
                       (let ((a (audio-readout)))
                         (string-append " audio " (if (car a) "on" "off") " depth " (number->string (cadr a))
                                        " underruns " (number->string (caddr a)) " underruns-all " (number->string (cadddr a))
                                        " mode " *audio-mode*
                                        " cues " (let ((m (list-ref a 4))) (if (symbol? m) (symbol->string m) "?"))
                                        " cue-lag " (number->string (list-ref a 5)) " cue-plays " (number->string (list-ref a 7))
                                        " hitches " (number->string *hitch-count*) " audio-ms " (r3 *audio-ms*))))))

    ;; The knob table as markdown, for the README (native --knobs).
    (define (core-knobs-markdown)
      (apply string-append
             "| Knob (URL parameter) | Group | Default | Range | Step |\n|---|---|---|---|---|\n"
             (map (lambda (k)
                    (string-append "| `" (symbol->string (knob-key k)) "` " (knob-label k)
                                   " | " (symbol->string (knob-group k))
                                   " | " (tuning-format-value (knob-default k))
                                   " | " (tuning-format-value (knob-min k)) " to " (tuning-format-value (knob-max k))
                                   " | " (tuning-format-value (knob-step k)) " |\n"))
                  KNOBS)))

    ;; Frames per second, smoothed, for the F3 readout (?fps shows it from the start).
    (define *fps-on* #f)
    (define *no-hud* #f)
    (define *fps* 60.0)
    (define *frame-ms* 16.7)
    (define *sim-ms* 0.0)        ; the race's steps this frame, CPU
    (define *draw-ms* 0.0)       ; building and submitting the frame, CPU
    (define (ms-since t0) (/ (* 1000.0 (- (current-jiffy) t0)) (jiffies-per-second)))

    ;; The frame-time instruments (F3): the last 180 frames' intervals, and
    ;; the hitch log, every frame over 33 ms with its SIM and DRAW and the
    ;; collections run since the frame before. F4 prints the log;
    ;; ?hitchlog prints each hitch as it happens.
    (define HISTORY 180)
    (define *history* (make-vector HISTORY 16.7))
    (define *hist-i* 0)
    (define *hitches* '())        ; newest first, at most 60
    (define *hitch-count* 0)
    (define *hitch-print* #f)
    (define *audio-mode* (cond-expand (wasm "unknown") (else "native")))
    (define *gc-last* #f)
    ;; (collections . ns spent collecting) since start, from gc-stats: the
    ;; generational backend's minor and major counters, else the plain count
    (define (gc-now)
      (let* ((st (gc-stats))
             (g (lambda (k) (let ((e (assq k st))) (if (and e (number? (cdr e))) (cdr e) 0)))))
        (if (assq 'minor-collections st)
            (cons (+ (g 'minor-collections) (g 'major-collections)) (+ (g 'minor-time-ns) (g 'major-time-ns)))
            (cons (g 'collections) 0))))
    (define *audio-ms* 0.0)
    (define (frame-record! ms sim draw)
      (vector-set! *history* *hist-i* ms)
      (set! *hist-i* (modulo (+ *hist-i* 1) HISTORY))
      (when (or *fps-on* *hitch-print*)
        (let* ((gcs (gc-now))
               (dgc (if *gc-last* (- (car gcs) (car *gc-last*)) 0))
               (dgc-ms (if *gc-last* (/ (- (cdr gcs) (cdr *gc-last*)) 1000000.0) 0.0)))
          (set! *gc-last* gcs)
          (when (> ms 33.0)
            (set! *hitch-count* (+ *hitch-count* 1))
            (let ((h (list (race-tick *race*) ms sim draw dgc dgc-ms *audio-ms*)))
              (set! *hitches* (let take ((l (cons h *hitches*)) (k 0))
                                (if (or (null? l) (>= k 60)) '() (cons (car l) (take (cdr l) (+ k 1))))))
              (when *hitch-print* (say "hitch " (hitch-text h)))))))
      (when (pressed? 'f4)
        (say "hitch log: " (number->string *hitch-count*) " hitches; newest first")
        (for-each (lambda (h) (say "  " (hitch-text h))) *hitches*)))
    (define (r1 v) (number->string (/ (round (* 10.0 v)) 10.0)))
    (define (hitch-text h)
      (string-append "tick " (number->string (car h)) " frame " (r1 (cadr h)) " ms sim " (r1 (caddr h))
                     " draw " (r1 (cadddr h)) " audio " (r1 (list-ref h 6))
                     " gc " (number->string (list-ref h 4)) " (" (r1 (list-ref h 5)) " ms)"))
    (define (history-max)
      (let loop ((i 0) (m 0.0)) (if (= i HISTORY) m (loop (+ i 1) (max m (vector-ref *history* i))))))
    (define (ease old new) (+ (* 0.9 old) (* 0.1 new)))

    (define (core-describe)
      (let ((m (racer-machine (race-player *race*))))
        (string-append "fps " (number->string (exact (round *fps*)))
                       " audio-ms " (number->string (/ (round (* 10.0 *audio-ms*)) 10.0))
                       " underruns " (number->string (caddr (audio-readout)))
                       " hitches " (number->string *hitch-count*)
                       " sim-ms " (number->string (/ (round (* 10.0 *sim-ms*)) 10.0))
                       " draw-ms " (number->string (/ (round (* 10.0 *draw-ms*)) 10.0))
                       " phase " (symbol->string (race-phase *race*))
                       " lap " (number->string (racer-lap (race-player *race*)))
                       " s " (number->string (exact (round (machine-s m))))
                       " speed " (number->string (speed-kmh m))
                       " integrity " (number->string (exact (round (machine-integrity m))))
                       (fx-describe))))

    (define (core-frame! dt win-w win-h integer-only)
      (set! *clock* (clock-advance *clock* dt))
      (when (> dt 0.0)
        (set! *fps* (+ (* 0.95 *fps*) (* 0.05 (/ 1.0 dt))))
        (set! *frame-ms* (+ (* 0.95 *frame-ms*) (* 0.05 (* 1000.0 dt)))))
      (when (pressed? 'f3) (set! *fps-on* (not *fps-on*)))
      (overlay-keys!)
      (fx-keys!)
      (when (or (pressed? 'r) (pad-pressed? *pad* 'back))
        (set! *race* (race-start *tuning* *race*))
        (set! *cam-heading* #f)
        (say "restart"))
      (let ((t0 (current-jiffy)))
        (set! *fx-frame-ms* 0.0)
        (step! (clock-steps *clock*))
        (set! *fx-ms* (ease *fx-ms* *fx-frame-ms*))
        (set! *sim-ms* (ease *sim-ms* (ms-since t0))))
      (let ((t0 (current-jiffy)))
       (scene-frame! *tuning* *race* (or *cam-heading* 0.0)
                    (list (cons 'best *best*)
                          (cons 'flash *flash*)
                          (cons 'spark *spark*)
                          (cons 'kick *kick*)
                          (cons (quote glitch) *glitch*)
                          (cons (quote fx) *fx*)
                          (cons (quote fx-knob) fx-knob)
                          (cons (quote fx-caption) *fx-caption*)
                          (cons (quote traced-age) (and *traced-at* (eq? (race-phase *race*) (quote race))
                                                        (- (race-tick *race*) *traced-at*)))
                          (cons (quote fx-hint) (if (eq? *platform* (quote web)) #f "E EFFECTS  F6 SOLO  F7 SHOWCASE"))
                          (cons (quote hud) (not *no-hud*))
                          (cons 'corrupt *corrupt*)
                          (cons 'popups *popups*)
                          (cons 'ghost (ghost-now *race*))
                          (cons 'time (/ (race-tick *race*) 60.0))
                          (cons 'start-line (if (eq? *platform* 'web) "PRESS ENTER OR TAP" "PRESS ENTER"))
                          (cons 'restart-line (if (eq? *platform* 'web) "ENTER OR TAP TO RUN IT AGAIN" "ENTER TO RUN IT AGAIN"))
                          (cons 'overlay *overlay*)
                          (cons 'fps (and *fps-on* (list *fps* *frame-ms* *sim-ms* *draw-ms*)))
                          (cons 'instruments (and *fps-on* (list *history* *hist-i* (history-max) *hitch-count*
                                                                 *audio-mode* (audio-readout) *audio-ms*))))
                    win-w win-h integer-only)
       (set! *draw-ms* (ease *draw-ms* (ms-since t0))))
      (frame-record! (* 1000.0 dt) *sim-ms* *draw-ms*)
      (let ((m (racer-machine (race-player *race*))) (t0 (current-jiffy)))
        (audio-frame! (if (memq (race-phase *race*) '(title countdown)) 0.0
                          (/ (machine-speed m) (handling-ref *tuning* 'top)))
                      (if (eq? (race-phase *race*) 'race) *last-throttle* 0.0)
                      (> (machine-boost m) 0.0)
                      *frame-events*)
        (set! *audio-ms* (ease *audio-ms* (ms-since t0))))
      (set! *frame-events* '())
      (keys-end-frame! *keys*)
      (pad-end-frame! *pad*))))
