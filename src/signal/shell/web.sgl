;;; (signal shell web) - The browser: one frame per requestAnimationFrame
;;; dispatch, the page's events in between.
;;;
;;; The page forwards every URL parameter as ("param", "KEY=VALUE"); a
;;; knob's name sets the knob (?grip=8.5&top=600). The page's touch scheme
;;; (index.template.html) sends ("touch", "steer,throttle,brake,boost,drift")
;;; whenever it changes, and ("tap", "") for a tap.
;;;
;;; The textures are fetched at boot; the game draws from the first frame
;;; after all five have arrived, and then prints "signal-overdrive: ready".

(define-library (signal shell web)
  (import (sigil string)
          (sigil graphics)
          (sigil graphics image)
          (sigil browser gles3)
          (substratic input events)
          (substratic input pad)
          (signal scene)
          (signal title)
          (signal intro)
          (signal mode7 decal)
          (signal track)
          (signal shell updates)
          (signal shell core))

  (export web-main web-dispatch)

  (begin
    (define (track-files t)
      (let ((n (symbol->string t)))
        (list (string-append n "-atlas.png") (string-append n "-map.png") (string-append n "-avg.png"))))
    (define NAMES (append (apply append (map track-files TRACKS)) '("sky.png" "machines.png" "lut-embers.png" "lut-crash.png" "title-logo.png" "fh-mark.png")))
    (define *fetches* '())
    (define *started* #f)
    (define *last-ms* #f)
    (define *frames* 0)
    (define *trace-touch* #f)
    (define *pwa-locked* #f)

    ;; Shell lifecycle only: a paused race is still a race. The page waits
    ;; for boot textures and two rendered frames before registering a worker.
    (define (pwa-state)
      (cond ((or (not *started*) (< *frames* 2)) 0)
            ((update-menu?) 1)
            (else 2)))

    (define (say . parts) (display (apply string-append "signal-overdrive: " parts)) (newline))

    (define (frame-dt payload)
      (let* ((ms (or (string->number payload) 0.0))
             (dt (if *last-ms* (/ (- ms *last-ms*) 1000.0) (/ 1.0 60.0))))
        (set! *last-ms* ms)
        (max 0.0 dt)))

    (define (texture name)
      (let* ((h (cdr (assoc name *fetches*)))
             (img (load-image-from-memory (gles3-image-ptr h) (gles3-image-size h)))
             (tex (load-texture img)))
        (image-free! img)
        tex))

    (define (fetched?)
      (let loop ((fs *fetches*))
        (or (null? fs) (and (gles3-image-ready? (cdar fs)) (loop (cdr fs))))))

    (define (tick! payload)
      (gles3-resize-to-display)
      (let ((dt (frame-dt payload)))
        (cond (*started*
               (core-frame! dt (gles3-canvas-width) (gles3-canvas-height) #f)
               (set! *frames* (+ *frames* 1))
               (when (= *frames* 2) (say "ready"))
               (when (= 0 (modulo *frames* 600)) (say (core-describe))))
              ((fetched?)
               (scene-init! (map (lambda (t) (cons t (map texture (track-files t)))) TRACKS)
                            (texture "sky.png") (texture "machines.png")
                            (list (cons 'embers (texture "lut-embers.png")) (cons 'crash (texture "lut-crash.png"))))
               (title-set-logo! (texture "title-logo.png"))
               (decal-init! VIEW-W VIEW-H)
               (intro-set-mark! (texture "fh-mark.png"))
               (set! *started* #t)))))

    (define (web-main)
      (unless (gles3-use-canvas "#stage")
        (error "signal-overdrive: no WebGL2 context for #stage"))
      (core-boot! 'web)
      (gles3-resize-to-display)
      (gfx-setup)
      (set! *fetches* (map (lambda (n) (cons n (gles3-fetch-image (string-append "assets/signal/" n)))) NAMES))
      (gles3-start-loop "signal-overdrive-tick")
      0)

    ;; the sound starts on a gesture the browser counts (autoplay policy):
    ;; the page sends ("gesture", "") for one, which also opens the start
    ;; gate. Every key, pointer or touch message tries to resume the sound
    ;; too (a context the browser suspended), but opens nothing.
    (define (gesture! type)
      (cond ((string=? type "gesture") (core-gesture!))
            ((member type (quote ("keydown" "pointerdown" "touch" "tap"))) (core-audio-start!))))

    (define (web-dispatch type payload)
      (unless *pwa-locked* (gesture! type))
      (cond ((string=? type "pwa-state") (pwa-state))
            ((string=? type "update")
             (if (string=? payload "chosen?")
                 (if (update-take-choice!) 1 0)
                 (begin (update-notify! payload) 1)))
            ((string=? type "pwa-unlock")
             (set! *pwa-locked* #f)
             (set! *last-ms* #f)
             1)
            ((string=? type "pwa-lock")
             (if (= (pwa-state) 1)
                 (begin (set! *pwa-locked* #t) 1)
                 0))
            (*pwa-locked* 0)
            ((string=? type "frame") (tick! payload) 0)
            ((string=? type "param")
             (say "param " payload)
             (when (string=? payload "trace-touch") (set! *trace-touch* #t))
             (core-param! payload) 0)
            ((string=? type "focus")
             ;; "1" focused, "0" blurred, "h" hidden (blurred too)
             (core-visible! (not (string=? payload "h")))
             (core-focus! (string=? payload "1")) 1)
            ((string=? type "audio-latency")
             (core-param! (string-append "audio-latency=" payload)) 1)
            ((string=? type "touch")
             (when *trace-touch* (say "touch " payload))
             (core-touch! payload) 1)
            ;; the touch check's question: what is the player doing now?
            ((string=? type "probe") (say (core-probe)) 1)
            ((string=? type "tap") (core-tap! payload) 1)
            ((string=? type "gesture") 1)
            ((string=? type "pointerdown") (core-tap!) 0)
            ((pad-dispatch! (core-pad) type payload) 1)
            ((input-dispatch! (core-keys) (core-sticks) type payload) 1)
            (else 0)))))
