;;; (signal shell native) - The desktop: a sigil-desktop window at whole
;;; scales of the 480x270 view (x3 the first time, then remembered), the
;;; textures read from assets/signal/ (run it from the package root).
;;;
;;;   signal-overdrive [--KNOB=VALUE ...] [--autopilot] [--start] [--quit-after S]
;;;                    [--shots DIR --shot-times "T1,T2,..."] [--knobs]
;;;
;;; Every knob of (signal tuning) can be set from the command line exactly
;;; as from the URL: --grip=8.5 --top=600. --autopilot drives the player on
;;; the racing line (for checks); --start skips the title; --quit-after
;;; quits after S seconds of wall time. --shots writes DIR/shot-T.png when
;;; the race clock passes each T seconds (so an autopilot run shoots the same
;;; places every time), then quits. --knobs prints the knob table as markdown.

(define-library (signal shell native)
  (import (sigil io)
          (sigil process)
          (sigil string)
          (sigil time)
          (sigil audio)
          (sigil desktop)
          (sigil desktop focus)
          (sigil graphics)
          (sigil graphics image)
          (substratic view window)
          (substratic input keys)
          (substratic input pad)
          (substratic store kv)
          (substratic image capture)
          (sigil fs)
          (signal race)
          (signal scene)
          (signal title)
          (signal intro)
          (signal mode7 decal)
          (signal track)
          (signal music reference)
          (signal shell core))

  (export native-main)

  (begin
    (define KEYS '(left right up down a d w s c space return shift tab p slash r 0 escape f3 f4 f5 e f2 f6 f7 f8 f9 f10))

    (define (texture name)
      (let* ((img (load-image (string-append "assets/signal/" name)))
             (tex (load-texture img)))
        (image-free! img)
        tex))

    (define (split-commas s)
      (let loop ((cs (string->list s)) (cur '()) (acc '()))
        (cond ((null? cs) (reverse (if (null? cur) acc (cons (list->string (reverse cur)) acc))))
              ((char=? (car cs) #\,) (loop (cdr cs) '() (cons (list->string (reverse cur)) acc)))
              (else (loop (cdr cs) (cons (car cs) cur) acc)))))

    ;; the shots still to take: (seconds ...), and where
    (define *shots* '())
    (define *shot-dir* #f)
    (define (shots! w h)
      (when (and *shot-dir* (pair? *shots*)
                 (>= (race-clock (core-race)) (* 60 (car *shots*))))
        (let ((png (capture-frame-png w h))
              (f (string-append *shot-dir* "/shot-" (number->string (car *shots*)) ".png")))
          (when png (write-file-bytes f png))
          (display (string-append "signal-overdrive: shot " f (if png "" " FAILED"))) (newline)
          (set! *shots* (cdr *shots*))
          (when (null? *shots*) (request-quit)))))

    ;; Cleanup must run inside the game coroutine, while GLFW still owns
    ;; a current GL context. VM texture finalizers run after the window
    ;; closes and must see an already-shut-down graphics subsystem.
    (define (loop scaler quit-after)
      (let ((run (race-loop scaler quit-after)))
        (lambda ()
          (gfx-setup)
          (run)
          (core-focus! #f)
          (gfx-shutdown))))

    (define (race-loop scaler quit-after)
      (lambda ()
        (set-viewport #f)
        (set-letterbox-color 0.0 0.0 0.0)
        (scene-init! (map (lambda (t)
                            (let ((n (symbol->string t)))
                              (list t (texture (string-append n "-atlas.png")) (texture (string-append n "-map.png"))
                                    (texture (string-append n "-avg.png")))))
                          TRACKS)
                     (texture "sky.png") (texture "machines.png")
                     (list (cons 'embers (texture "lut-embers.png")) (cons 'crash (texture "lut-crash.png"))))
        (title-set-logo! (texture "title-logo.png"))
        (decal-init! VIEW-W VIEW-H)
        (intro-set-mark! (texture "fh-mark.png"))
        ;; Warm everything the frame loop does before publishing music: draw
        ;; AND present two zero-dt frames, and make the loop's own slow
        ;; first calls once. A drawn frame is compiled and run at the
        ;; present, and the first gamepad read initializes the joystick
        ;; backend (674 ms measured). After audio start a stall longer than
        ;; the 250 ms music ring is heard as a gap: 17647-19695 sounding
        ;; underrun frames at the title in native races. Zero-dt frames
        ;; cannot advance the simulation or open audio, and keys are not
        ;; read here, so nothing pressed during startup acts.
        (let warm ((n 0))
          (when (< n 2)
            (core-frame! 0.0 (frame-width) (frame-height) #t)
            (wait-frame)
            (core-startup-mark! "warm-present")
            (window-scaler-frame! scaler)
            (pad-poll! (core-pad))
            (core-startup-mark! "warm-scaler-and-pad")
            (warm (+ n 1))))
        (keys-clear! (core-keys))
        ;; Device/streams start after window, textures and warm drawing.
        (core-audio-start!)
        (let ((t0 (current-second)))
          (let frame ((n 0))
            (let ((dt (wait-frame)))
              (when (< n 4) (core-startup-mark! (string-append "present-" (number->string n))))
              (window-scaler-frame! scaler)
              (pad-poll! (core-pad))
              (when (< n 4) (core-startup-mark! (string-append "scaler-and-pad-" (number->string n))))
              (let ((focused? (window-focused?)))
                (core-focus! focused?)
                (if focused?
                    (keys-poll! (core-keys) KEYS)
                    (keys-clear! (core-keys))))
              (when (< n 4) (core-startup-mark! (string-append "focus-and-keys-" (number->string n))))
              (when (keys-pressed? (core-keys) 'escape) (request-quit))
              (when (and quit-after (> (- (current-second) t0) quit-after)) (request-quit))
              (core-frame! dt (frame-width) (frame-height) #t)
              (when (< n 4) (core-startup-mark! (string-append "frame-" (number->string n))))
              (shots! (frame-width) (frame-height))
              (when (= n 1) (display "signal-overdrive: ready") (newline))
              (when (= 0 (modulo n 300)) (display (string-append "signal-overdrive: " (core-describe))) (newline))
              (unless (quit-requested?) (frame (+ n 1))))))))

    ;; A real race using the shared simulation/music/cue path, with no
    ;; window, drawing, synthetic clock, or alternate player driver.
    (define (headless-race! seconds)
      (define (now) (/ (current-jiffy) (* 1.0 (jiffies-per-second))))
      (core-audio-start!)
      (display "signal-overdrive: headless race; drawing disabled")
      (newline)
      (let ((start (now)))
        (let frame ((previous start))
          (let ((before (now)))
            (when (< (- before start) seconds)
              (core-headless-frame! (- before previous))
              (let ((remaining (- (/ 1.0 60.0) (- (now) before))))
                (when (> remaining 0.0) (sleep remaining)))
              (frame before)))))
      (core-focus! #f))

    (define (native-main . _args)
      (let ((args (cdr (command-line))))
        ;; Offline command: exit before booting the shell, opening its
        ;; context, or creating a window. A null backend is not a render.
        (let ((reference (member "--music-reference" args)))
          (when reference
            (unless (or (= (length reference) 4) (= (length reference) 5))
              (error "usage: --music-reference PLAN PCM FRAMES [RATE]"))
            (when (audio-initialized?)
              (error "offline reference must not initialize audio"))
            (reference-render! (cadr reference) (caddr reference)
                               (string->number (cadddr reference))
                               rate: (if (= (length reference) 5)
                                         (string->number (list-ref reference 4))
                                         48000))
            (when (audio-initialized?)
              (error "reference unexpectedly initialized audio"))
            (display "signal-overdrive: offline reference complete; audio uninitialized")
            (newline)
            (exit 0)))
        (core-boot! 'desktop)
        (when (member "--knobs" args)
          (display (core-knobs-markdown))
          (exit 0))
        (for-each (lambda (a)
                    (when (and (> (string-length a) 2) (string=? (substring a 0 2) "--"))
                      (core-param! (substring a 2 (string-length a)))))
                  args)
        (let ((d (member "--shots" args)) (t (member "--shot-times" args)))
          (when (and d (pair? (cdr d)) t (pair? (cdr t)))
            (set! *shot-dir* (cadr d))
            (set! *shots* (map string->number (split-commas (cadr t))))))
        ;; The loop starts sound after graphics setup. --mute, parsed
        ;; above, still keeps the device closed.
        (when (member "--music-headless" args)
          (let* ((qa (member "--quit-after" args))
                 (seconds (if (and qa (pair? (cdr qa)))
                              (string->number (cadr qa))
                              400)))
            (unless (and seconds (> seconds 0))
              (error "positive headless duration required"))
            (headless-race! seconds)
            (when (and (member "--mute" args) (audio-initialized?))
              (error "muted headless race initialized audio"))
            (display "signal-overdrive: headless race complete; audio ")
            (display (if (audio-initialized?) "initialized" "uninitialized"))
            (newline)
            (exit 0)))
        (let* ((qa (member "--quit-after" args))
               (quit-after (and qa (pair? (cdr qa)) (string->number (cadr qa))))
               (scaler (make-window-scaler VIEW-W VIEW-H min-scale: 2 max-scale: 6
                                           remember: (lambda (v) (store-write-datum! "scale" v))))
               (k (window-open-scale scaler (store-read-datum "scale"))))
          (run-game "Signal Overdrive" (* k VIEW-W) (* k VIEW-H) (loop scaler quit-after)))
        0))))
