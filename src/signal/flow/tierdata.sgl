;;; (signal flow tierdata) - The three tiers as the flow sees them, and the
;;; one hook that turns a mode and a tier into the race's tuning.
;;;
;;; LEARNER, COURIER and ELITE rename Crash's ladder (design P24, the 0.2
;;; scope decision), keeping its shape: the tier scales numbers the races
;;; already have, with no new mechanics per tier.
;;;
;;; What the flow owns here: the order, the names, the lines that describe
;;; each tier, and the cup's rules for a corrupt delivery (P24's retries
;;; column). It selects a tier and passes it on; it never sets a number
;;; from it. ONE owner (the leader's ruling, 2026-10-19): the tooling
;;; worker's (signal tiers) data and its race decide rival pace, ICE
;;; density and meter forgiveness from the tier. Until that branch merges,
;;; every tier races at the session's pace on this base.
;;;
;;; The mode and the tier reach the race as two plain entries in the tuning
;;; alist, (race-mode . run|time-trial) and (race-tier . learner|courier|elite):
;;; not knobs, so the overlay and the URL never show them, and the race
;;; constructors keep their signatures. The flow calls TIME TRIAL 'trial;
;;; the race's name for it is 'time-trial (tier-race-mode).
;;;
;;; INTEGRATION SEAM, for when the tooling/runtime branch (signal tiers, and
;;; race-new's tier: and mode: keywords) merges:
;;;   - flow-race-new in (signal shell core) passes tier: and mode: (the
;;;     one place the flow builds a race; race-start keeps them on restarts);
;;;   - tier-race-tuning's rivals 0 in TIME TRIAL can go (that race-new
;;;     empties the field in time-trial itself; until then, P26's empty
;;;     field comes from here). It is the mode's rule, not a tier number;
;;;   - TIER-IDS and tier-label may come from (signal tiers)'s TIERS and
;;;     tier-label.

(define-library (signal flow tierdata)
  (import (sigil core)
          (signal tuning))

  (export TIER-IDS tier-label tier-lines tier-retransmits tier-corrupt-ends-cup?
          tier-race-tuning tier-race-mode tuning-with tier-index)

  (begin
    (define TIER-IDS '(learner courier elite))

    (define (tier-index id)
      (let loop ((ts TIER-IDS) (i 0))
        (cond ((null? ts) 0) ((eq? (car ts) id) i) (else (loop (cdr ts) (+ i 1))))))

    (define (tier-label id)
      (case id ((learner) "LEARNER") ((courier) "COURIER") ((elite) "ELITE") (else "COURIER")))

    ;; Two lines under the tier menu, in the flat system register.
    (define (tier-lines id)
      (case id
        ((learner) '("SLOWER RIVALS. LIGHTER ICE." "RETRANSMIT AS OFTEN AS YOU NEED."))
        ((courier) '("THE CITY AS DESIGNED." "THREE RETRANSMITS A CUP."))
        ((elite) '("FASTER RIVALS. FULL ICE FROM THE FIRST DELIVERY." "NO RETRANSMITS. A CORRUPT DELIVERY ENDS THE CUP."))
        (else '("" ""))))

    ;; RETRANSMITs in a cup: #t for unlimited, else a count.
    (define (tier-retransmits id)
      (case id ((learner) #t) ((courier) 3) (else 0)))

    (define (tier-corrupt-ends-cup? id) (eq? id 'elite))

    ;; The flow's mode to the race's: run, or time-trial for the flow's trial.
    (define (tier-race-mode mode) (if (eq? mode 'trial) 'time-trial 'run))

    ;; The tuning alist with key set to v, added when the knob table does
    ;; not know the key (tuning-set ignores unknown keys).
    (define (tuning-with t key v)
      (cons (cons key v)
            (let drop ((l t))
              (cond ((null? l) '())
                    ((eq? (caar l) key) (drop (cdr l)))
                    (else (cons (car l) (drop (cdr l))))))))

    ;; --- the hook: mode and tier to the race's tuning -----------------------------
    ;; base: (rivals . n), the session's own field (a URL or the overlay may
    ;; have set it), so a TIME TRIAL's empty field never carries into the
    ;; next RUN. The tier only rides along as (race-tier . id): the rival
    ;; pace stays the session's (the race's tier data scales it, not this).
    (define (tier-race-tuning t base mode tier)
      (let* ((rivals (cdr (assq 'rivals base)))
             (t (tuning-set t 'rivals (if (eq? mode 'trial) 0.0 rivals)))
             (t (tuning-with t 'race-mode (tier-race-mode mode))))
        (tuning-with t 'race-tier tier)))))
