;;; Platform-light audible clock and pacing policy. The shell performs
;;; resyncs; this module never moves a simulation or opens a device.
(define-library (signal music clock)
  (import (sigil struct)
          (sigil math)
          (substratic time clock))
  (export audible-seconds pacing pacing-new pace-frame
          pacing-dt pacing-gap pacing-resync? pacing-last-resync-bar
          RESYNC-GAP jump-handoff-window clock-advance-capped CATCH-UP-STEPS
          START-HOLD-CAP start-holding? start-hold-interval splice-outgrown?)
  (begin
    ;; Delivered and queued are DEVICE frames, not Motif render frames.
    ;; Paused frames are frames explicitly inserted as silence on pause.
    (define (audible-seconds delivered queued device-rate latency paused)
      (- (/ (- delivered queued paused) (* 1.0 device-rate)) latency))

    ;; While the song plays from its ring, a single long frame (a
    ;; collection, a slow present) must not cost the race simulation time:
    ;; the audio keeps playing through it, so time the fixed clock drops
    ;; becomes a gap the 2% nudge needs seconds to close. Catch up to the
    ;; ring's depth (250 ms, 15 ticks) instead of Substratic's six.
    ;; Longer stalls drain the ring anyway and still drop and resync.
    (define CATCH-UP-STEPS 15)

    ;; Substratic's clock-advance with the per-frame cap as an argument:
    ;; the same drain, the same drop at the cap. At MAX-STEPS-PER-FRAME it
    ;; returns exactly what clock-advance does.
    (define (clock-advance-capped c dt max-steps)
      (let ((dt (max 0.0 dt)))
        (let loop ((acc (+ (clock-acc c) dt))
                   (steps 0))
          (cond ((>= steps max-steps)
                 (clock c
                        acc: 0.0
                        ticks: (+ (clock-ticks c) steps)
                        steps: steps
                        dropped: (+ (clock-dropped c) acc)
                        alpha: 0.0
                        dt: dt))
                ((>= acc SIM-STEP)
                 (loop (- acc SIM-STEP) (+ steps 1)))
                (else
                 (clock c
                        acc: acc
                        ticks: (+ (clock-ticks c) steps)
                        steps: steps
                        alpha: (/ acc SIM-STEP)
                        dt: dt))))))

    (define-struct pacing
      (dt default: 0.0)
      (gap default: 0.0)
      (resync? default: #f)
      (last-resync-bar default: -1))

    (define (pacing-new) (pacing))

    ;; A gap past this asks the shell for a resync; a queued resync that
    ;; finds the gap back within it when it would run is cancelled.
    (define RESYNC-GAP 0.060)

    ;; in-flight: a resync is queued, or has jumped and its first
    ;; corrected sample is not heard yet. The gap still reads the old
    ;; epoch then, so asking again would repeat the same correction a bar
    ;; later, after the first had already closed the gap.
    (define (pace-frame p wall-dt simulation-seconds audible running? paused? bar
                        (keys: (in-flight #f)))
      (let* ((dt (max 0.0 wall-dt))
             (gap (if running? (- audible simulation-seconds) 0.0))
             (resync? (and running? (not paused?) (not in-flight)
                           (> (abs gap) RESYNC-GAP)
                           (not (= bar (pacing-last-resync-bar p)))))
             ;; Close 10% of the gap per frame, capped at 2% of wall dt.
             (nudge (if running?
                        (max (* -0.02 dt) (min (* 0.02 dt) (* gap 0.1)))
                        0.0)))
        (pacing p dt: (if paused? 0.0 (+ dt nudge))
                  gap: gap resync?: resync?
                  last-resync-bar: (if resync? bar (pacing-last-resync-bar p)))))

    ;; A song starting at tick zero waits for the ear. A device can take
    ;; most of a second to start pulling a new stream (a race start
    ;; measured 0.73 s with nothing consumed), and a simulation counting
    ;; from the opening ran that far ahead of the sound, for resyncs to
    ;; close bars later. So until the song's first tick the simulation may
    ;; not pass the ear: the interval is bounded by the song time heard
    ;; (EAR, negative until the first sample is heard) less the clock's
    ;; remainder (ACC). The race holds on the countdown's first frame, the
    ;; start card with no count shown (the count is in grid bar 3). A
    ;; device that has not started by START-HOLD-CAP seconds after the
    ;; opening (SINCE-OPEN) is waited for no longer: the race starts and
    ;; pacing resyncs. No stream (muted, EAR #f) holds nothing.
    ;; While it holds, pacing neither nudges nor asks for a resync: the gap
    ;; is the device's start, which the hold itself absorbs.
    (define START-HOLD-CAP 1.5)
    (define (start-holding? tick ear since-open)
      (and ear (= tick 0) (< since-open START-HOLD-CAP)))
    (define (start-hold-interval interval tick ear acc since-open)
      (if (start-holding? tick ear since-open)
          (min interval (max 0.0 (- ear acc)))
          interval))

    ;; A drop splice is sized when its resync is asked for, by the gap
    ;; then (with at least twice RESYNC-GAP of room), and runs at a bar
    ;; line later. If the ear fell further behind meanwhile, so that the
    ;; room leaves more than RESYNC-GAP of the gap undropped, the splice is
    ;; planned again with room for all of it: dropping just the room left
    ;; a race start's 730 ms gap at 600 ms, for a second resync 2.8 s later.
    (define (splice-outgrown? gap room-seconds)
      (and (< gap 0) (> (- (- gap) room-seconds) RESYNC-GAP)))

    ;; Motif walks ahead of render. Hand over AFTER N-1's first row was
    ;; walked, BEFORE N's first row; the latter is a missed window, never
    ;; permission to send the jump late. Units here are absolute frames.
    (define (jump-handoff-window walker-frame preceding-bar-frame target-bar-frame)
      (cond
        ((<= walker-frame preceding-bar-frame) 'wait)
        ((>= walker-frame target-bar-frame) 'missed)
        (else 'send)))))
