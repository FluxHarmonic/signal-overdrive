;;; Offline reference from intended simulation landings. It never reads
;;; the player's diagnostic landing log and never opens an audio device.
(define-library (signal music reference)
  (import (sigil math)
          (sigil list)
          (sigil io)
          (sigil fs)
          (motif tune)
          (signal music score)
          (signal music song)
          (signal music conductor)
          (signal music playback)
          (signal music inserts))
  (export reference-validate reference-conductor reference-render!)
  (begin
    (define (reference-validate plan)
      (unless (and (list? plan) (pair? plan))
        (error "reference needs intended landings"))
      (let check ((entries plan) (previous -1))
        (unless (null? entries)
          (let ((entry (car entries)))
            (unless (and (vector? entry) (= 3 (vector-length entry))
                         (exact-integer? (vector-ref entry 0))
                         (exact-integer? (vector-ref entry 1))
                         (> (vector-ref entry 1) previous)
                         (= (vector-ref entry 0) (song-bar->tick (vector-ref entry 1))))
              (error "invalid intended landing" entry))
            (song-section-ref (vector-ref entry 2))
            (check (cdr entries) (vector-ref entry 1)))))
      (unless (equal? (car plan) '#(0 0 grid))
        (error "reference must begin at grid bar zero"))
      plan)

    (define (reference-conductor plan tick)
      (let ((bar (tick->song-bar tick)))
        (let find ((current (car plan)) (remaining (cdr plan)))
          (if (and (pair? remaining) (<= (vector-ref (car remaining) 1) bar))
              (find (car remaining) (cdr remaining))
              (conductor tick: tick
                         section: (vector-ref current 2)
                         entry-bar: (vector-ref current 1)
                         pending: (and (pair? remaining)
                                       (jump mark: (vector-ref (car remaining) 2)
                                             bar: (vector-ref (car remaining) 1)
                                             decided-tick: (vector-ref current 0)))
                         log: (list current))))))

    (define (reference-render! plan-path output-path frames (keys: (rate 48000)))
      (unless (and (exact-integer? frames) (> frames 0))
        (error "reference frame count must be positive" frames))
      (unless (and (exact-integer? rate) (<= 8000 rate 192000))
        (error "invalid reference sample rate" rate))
      (let* ((plan (reference-validate (read (open-input-string (read-file-string plan-path)))))
             (tune (read-tune-string SCORE-TUNE-TEXT))
             (b (playback-open tune rate (reference-conductor plan 0) MUSIC-INSERTS))
             (buffer (make-bytevector (* 8 256) 0))
             (port (open-binary-output-file output-path)))
        (dynamic-wind
          (lambda () #f)
          (lambda ()
            (let pull ((rendered 0))
              (when (< rendered frames)
                (let* ((n (min 256 (- frames rendered)))
                       (tick (exact (floor (* (/ rendered (* 1.0 rate)) 60.0))))
                       (c (reference-conductor plan tick)))
                  (unless (playback-pull! b c buffer 0 n)
                    (error "reference player ended before the intended log" rendered))
                  (write-bytevector (if (= n 256) buffer (bytevector-copy buffer 0 (* 8 n))) port)
                  (pull (+ rendered n)))))
            (when (> (playback-missed b) 0)
              (error "reference missed an intended handoff" (playback-missed b)))
            (let ((landings (reverse (filter (lambda (e) (eq? 'landing (vector-ref e 0)))
                                            (playback-log b)))))
              (unless (= (length landings) (- (length plan) 1))
                (error "reference did not render every intended landing"))
              (for-each
                (lambda (expected actual)
                  (unless (and (eq? (vector-ref expected 2) (vector-ref actual 1))
                               (= (vector-ref expected 1) (vector-ref actual 2))
                               (= (exact (round (* (vector-ref expected 1) (song-bar-seconds) rate)))
                                  (vector-ref actual 3)))
                    (error "reference landing differs from intended log" expected actual)))
                (cdr plan) landings)))
          (lambda ()
            (close-port port)
            (playback-close! b)))))))
