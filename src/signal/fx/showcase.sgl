;;; (signal fx showcase) - The showcase: each effect (0.1's, then 0.2's
;;; district look) alone for eight seconds, its trigger fired on the beat so
;;; it shows without driving into it, then all of them together. Pure: a
;;; function of the tick and the pulse.
;;;
;;; (showcase-at tick p) answers a list:
;;;   solo     the effect shown alone (the fx-solo numbering), 0 for all
;;;   fires    the triggers to fire this tick ('drop 'wall 'ice)
;;;   integrity  the integrity the effects should see, or #f for the cargo's
;;;   traced?  #t to show the effects as if TRACED (the tower)
;;;   caption  what the HUD says
;;;   rain     the rain to force, 0..1 (a downpour for the weather's three), or #f

(define-library (signal fx showcase)
  (import (signal fx beat))

  (export showcase-at SHOWCASE-SEGMENT FX-NAMES)

  (begin
    (define SHOWCASE-SEGMENT 480)      ; ticks, 8 s
    (define FX-NAMES '#("ALL" "HORIZON DIP" "LIGHT POOLS" "RAIL CHASE" "SKYLINE LIFE"
                       "ICE GLITCH" "ICE WARP" "INTERFERENCE" "REFLECTIONS" "WET GROUND" "RAIN"))

    (define (showcase-at tick p)
      (let* ((seg (modulo (quotient tick SHOWCASE-SEGMENT) 11))
             (within (modulo tick SHOWCASE-SEGMENT))
             (downbeat (and (onset? p KICK) (= 0 (pulse-row p))))
             (bar (pulse-bar p))
             (solo (if (= seg 10) 0 (+ seg 1)))
             (fires (case solo
                      ((1) (if (and downbeat (even? bar)) '(drop) '()))
                      ((5) (if downbeat '(wall) '()))
                      ((6) (if (and downbeat (even? bar)) '(ice) '()))
                      ((0) (cond ((and downbeat (= 0 (modulo bar 4))) '(drop))
                                 ((and downbeat (= 2 (modulo bar 4))) '(wall))
                                 (else '())))
                      (else '())))
             (integrity (and (= solo 7)
                             (vector-ref #(70.0 45.0 20.0 5.0) (min 3 (quotient within 120)))))
             (traced (and (= solo 4) (>= within 240))))
        (list solo fires integrity traced
              (string-append "SHOWCASE: " (vector-ref FX-NAMES solo)
                             (cond ((= solo 7) "  INTEGRITY TIER CYCLING")
                                   (traced "  (TRACED)")
                                   (else "")))
              (and (>= solo 8) 1.0))))))
