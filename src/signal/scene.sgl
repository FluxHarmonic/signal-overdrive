;;; (signal scene) - A frame: the Mode 7 pass (sky, ground, the machines as
;;; sprites, far to near) into the 480x270 view, the palette-and-dither post
;;; pass, the view on the window at its fit, then the HUD and the tuning
;;; overlay at the window's own pixel scale.
;;;
;;; The sprite sheet (scripts/art/gen-machines.mjs) is in rows 80 px tall,
;;; a cell's ground point 48 px down and centred across: row 0 the player
;;; from behind in 80 px cells, five lean frames (hard left, left, centre,
;;; right, hard right) then the same five boosting; rows 1-3 one rival
;;; colour each in 128 px cells, 16 directions (0 seen from behind, then
;;; clockwise in 22.5 degree steps: the machine turned that far to its right
;;; of the line of sight); rows 4-6 the same with the thrusters' second
;;; flicker frame (and row 0's cells 10-19 the player's); row 7 the shadow
;;; in an 80 px cell, then four 32x32 spark frames. The player's
;;; body is 64 px wide, a rival's 58 (PLAYER-BODY, RIVAL-BODY): a machine is
;;; drawn sprite-size texels wide whichever cell it comes from.

(define-library (signal scene)
  (import (sigil math)
          (sigil string)
          (sigil list)
          (sigil graphics)
          (substratic view fit)
          (substratic view present)
          (substratic text font)
          (signal mode7 camera)
          (signal mode7 render)
          (signal dither)
          (signal lut)
          (signal track)
          (signal handling)
          (signal race)
          (signal tuning)
          (signal fx state)
          (signal fx lights)
          (signal music conductor))

  (export VIEW-W VIEW-H scene-init! scene-ready? scene-frame! scene-camera
          scene-world-ms speed-kmh lap-clock)

  (begin
    (define VIEW-W 480)
    (define VIEW-H 270)
    (define PLAYER-CELL-W 80)
    (define RIVAL-CELL-W 128)
    (define CELL-H 80)
    (define ANCHOR-Y 48)
    (define PLAYER-BODY 64.0)
    (define RIVAL-BODY 58.0)

    (define *view* #f)
    (define *post* #f)
    (define *view-tex* #f)
    (define *post-pipe* #f)
    (define *tri* #f)
    (define *sheet* #f)
    (define *presenter* #f)
    (define *palette* #f)
    (define *spread* -1.0)
    (define *world-ms* 0.0)
    (define (scene-world-ms) *world-ms*)
    (define (scene-ready?) (and *view* #t))

    (define (bytes-of floats)
      (let ((bv (make-bytevector (* 4 (length floats)) 0)))
        (let loop ((fs floats) (k 0))
          (unless (null? fs)
            (bytevector-ieee-single-set! bv k (exact->inexact (car fs)) 'little)
            (loop (cdr fs) (+ k 4))))
        bv))

    ;; Textures from the shell (each loaded natively or fetched on the web):
    ;; tracks is ((name atlas map avg) ...), one entry per track.
    (define *tracks* '())
    (define *shown* #f)          ; the track whose textures the ground has
    ;; luts: ((embers . texture) (crash . texture)), (signal lut)'s lookups.
    (define *lut-pipe* #f)
    (define *luts* '())
    (define (scene-init! tracks sky sheet luts)
      (set! *luts* luts)
      (for-each (lambda (e) (set-texture-sampling! (cdr e) 'nearest 'clamp)) luts)
      (hud-font-init!)
      (mode7-init! VIEW-W VIEW-H)
      (set! *tracks* tracks)
      (show-track! (caar tracks))
      (mode7-set-sky! sky 96.0 0.30 0.55 0.85)
      (set-texture-sampling! sheet 'nearest 'clamp)
      (set! *sheet* sheet)
      (let ((pl (make-vertex-layout '((position float2)))))
        (set! *tri* (make-mesh pl (bytes-of '(-1.0 -1.0 3.0 -1.0 -1.0 3.0))))
        (set! *post-pipe* (make-pipeline pl
                                         (string-append (glsl-header) POST-VERTEX)
                                         (string-append (glsl-header) POST-FRAGMENT)
                                         '(depth-test #f depth-write #f cull none)))
        (set! *lut-pipe* (make-pipeline pl
                                        (string-append (glsl-header) POST-VERTEX)
                                        (string-append (glsl-header) LUT-FRAGMENT)
                                        '(depth-test #f depth-write #f cull none))))
      (set! *view* (make-render-target VIEW-W VIEW-H 'nearest 'depth))
      (set! *post* (make-render-target VIEW-W VIEW-H 'nearest 'depth))
      (set! *view-tex* (render-target->texture *view*))
      (set! *presenter* (make-presenter VIEW-W VIEW-H)))

    (define (show-track! name)
      (unless (eq? name *shown*)
        (let ((e (or (assq name *tracks*) (car *tracks*))))
          (mode7-set-world! (cadr e) (caddr e) (cadddr e) 32.0 64.0 128.0 3.2)
          (set! *shown* name))))

    ;; The post pass's palette and spread, when they change.
    (define (sync-post! tuning)
      (let ((pal (if (> (tuning-ref tuning 'palette) 0.5) 'crash 'embers))
            (spread (tuning-ref tuning 'spread)))
        (unless (and (eq? pal *palette*) (= spread *spread*))
          (set! *palette* pal)
          (set! *spread* spread)
          (let ((colors (palette-colors pal)))
            (set-pipeline-uniform! *post-pipe* 'pal (palette-uniform colors))
            (set-pipeline-uniform! *post-pipe* 'params
                                   (list spread 4.0 (exact->inexact (length colors)) (exact->inexact VIEW-H)))
            ;; rows counted from the top: the pass's gl_FragCoord row 0 is
            ;; the picture's bottom on a render target (Phantom's finding)
            (set-pipeline-uniform! *post-pipe* 'opts (list 1.0 1.0 0.0 0.0))
            (set-pipeline-uniform! *lut-pipe* 'params (list spread 4.0 (exact->inexact (length colors)) (exact->inexact VIEW-H)))
            (set-pipeline-uniform! *lut-pipe* 'opts (list 1.0 1.0 0.0 0.0))))))

    ;; --- the camera --------------------------------------------------------------------

    ;; The camera behind the player, at cam-heading (the shell eases it
    ;; toward the machine's heading: the cam lag).
    ;; Speed widens the field of view (speed-fov radians at top speed) and
    ;; pulls the camera back (speed-pull texels); a boost's kick (0..1,
    ;; decaying) punches the field of view out a little further.
    (define (scene-camera tuning m cam-heading . more)
      (let* ((v (min 1.4 (/ (machine-speed m) (handling-ref tuning 'top))))
             (kick (if (pair? more) (car more) 0.0)))
        (cam-behind (make-cam 0.0 0.0 (tuning-ref tuning 'cam-height) cam-heading
                              (tuning-ref tuning 'pitch)
                              (+ (tuning-ref tuning 'fov) (* v (tuning-ref tuning 'speed-fov)) (* 0.14 kick))
                              (tuning-ref tuning 'horizon) VIEW-W VIEW-H)
                    (machine-x m) (machine-y m) cam-heading
                    (+ (tuning-ref tuning 'cam-dist) (* v (tuning-ref tuning 'speed-pull))))))

    ;; --- the 0.1 effects -----------------------------------------------------------------

    ;; This frame's horizon dip (rows) and the horizon row: sprites move
    ;; down by what the ground under them moved (bend-screen-row inverts the
    ;; ground shader's bend), so machines stay on the dipped road.
    (define *dip* 0.0)
    (define *horizon* 80.0)
    (define (bend-dy py)
      (if (= *dip* 0.0) 0.0 (- (bend-screen-row py *dip* *horizon* (exact->inexact VIEW-H)) py)))

    ;; each track's light pools, made once
    (define *pools* '())
    (define (pools-of t)
      (let ((e (assq (track-name t) *pools*)))
        (if e (cdr e)
            (let ((v (track-pools t)))
              (set! *pools* (cons (cons (track-name t) v) *pools*))
              v))))

    ;; The effects' uniforms from (signal fx state): fx[0..5] and the
    ;; lights (see (signal mode7 render)'s GROUND-FRAGMENT). knob: the
    ;; shell's effective intensity per effect (0 when off or not the solo).
    ;; hold: fx-hold, every transient effect pinned at its peak (for costs)
    (define *hold* #f)
    (define (fx-uniforms! r c st knob hold)
      (let* ((on (lambda (k) (> (knob k) 0.0)))
             (sky (knob 'fx-sky))
             (h (cam-heading c))
             (lights (if (on 'fx-pools)
                         (pools-for-frame (pools-of (race-track r))
                                          (+ (cam-x c) (* 500.0 (sin h))) (- (cam-y c) (* 500.0 (cos h)))
                                          MODE7-LIGHTS
                                          (lambda (kind)
                                            (case kind
                                              ((city) (+ 0.45 (* 0.75 (fx-kick st))))
                                              ((pad) (+ 0.5 (* 0.8 (max (fx-beat st) (fx-flare st)))))
                                              ((lane) (+ 0.8 (* 0.2 (fx-beat st))))
                                              (else (+ 0.7 (* 0.3 (fx-ice st))))))
                                          (knob 'fx-pools))
                         '()))
             (w (or (fx-warp st)
                    (and hold (list (+ (cam-x c) (* 600.0 (sin h))) (- (cam-y c) (* 600.0 (cos h))) (sin h) (- (cos h)) 460.0 34.0))))
             (wv (lambda (k d) (if w (list-ref w k) d)))
             (flags (+ (if (on 'fx-pools) 1 0) (if (on 'fx-chase) 2 0) (if (on 'fx-sky) 4 0)
                       (if (on 'fx-warp) 8 0) (if (on 'fx-interf) 16 0))))
        (set! *hold* hold)
        (set! *dip* (if hold (* DIP-ROWS (knob (quote fx-dip))) (fx-dip-rows st (knob (quote fx-dip)))))
        (mode7-set-lights! lights)
        (mode7-set-fx!
         (list *dip* (if hold (knob (quote fx-glitch)) (fx-glitch-now st)) (modulo (fx-glitch-seed st) 97) (/ (fx-tick st) 60.0)
               (modulo (fx-chase st) 16) (modulo (fx-padstep st) 12)
               (* (knob 'fx-chase) (min 1.0 (+ (* 0.35 (fx-beat st)) (* 0.6 (fx-flare st)))))
               (* sky (fx-kick st))
               (* sky (fx-snare st)) (modulo (fx-bar st) 997)
               (* sky (fx-traced st) (+ 0.6 (* 0.4 (fx-ice st)))) (* sky (fx-pad st))
               (if hold (knob (quote fx-interf)) (fx-interf st)) (if (and (not hold) (fx-dropout st)) 1.0 0.0) flags (length lights)
               (wv 0 0.0) (wv 1 0.0) (wv 2 0.0) (wv 3 1.0)
               (wv 4 0.0) (wv 5 0.0) (* (knob (quote fx-warp)) (if hold 1.0 (fx-warp-strength st))) 0.0))))

    ;; --- sprites -------------------------------------------------------------------------

    (define PI 3.141592653589793)
    (define (wrap-angle a)
      (cond ((> a PI) (wrap-angle (- a (* 2.0 PI))))
            ((< a (- PI)) (wrap-angle (+ a (* 2.0 PI))))
            (else a)))

    (define (smoothstep a b x)
      (let ((t (max 0.0 (min 1.0 (/ (- x a) (- b a))))))
        (* t t (- 3.0 (* 2.0 t)))))

    ;; (depth draw-thunk) for one machine, or #f when it is not in view.
    ;; after: a thunk drawn just after the machine (the player's sparks), or #f.
    (define (machine-sprite c tuning m cell-col cell-row player? after)
      (let ((p (camera-project c (machine-x m) (machine-y m) 0.0 4.0)))
        (and p
             (let* ((cw (if player? PLAYER-CELL-W RIVAL-CELL-W))
                    (body (if player? PLAYER-BODY RIVAL-BODY))
                    ;; screen pixels per sheet pixel
                    (k (/ (* (projected-scale p) (tuning-ref tuning 'sprite-size)) body))
                    (w (* k cw))
                    (h (* k CELL-H))
                    (x (round (- (projected-x p) (* 0.5 w))))
                    (y (round (+ (- (projected-y p) (* k ANCHOR-Y)) (bend-dy (projected-y p)))))
                    ;; the shadow's cell, the player's size, on the same ground point
                    (sw (round (* k PLAYER-CELL-W)))
                    (sx (round (- (projected-x p) (* 0.5 sw))))
                    (w (round w)) (h (round h))
                    (fog (if (> (tuning-ref tuning 'fog) 0.5)
                             (* 0.85 (smoothstep (tuning-ref tuning 'fog-start) (tuning-ref tuning 'fog-end) (projected-depth p)))
                             0.0))
                    (fc '(0.18 0.11 0.30))
                    (u0 (* cell-col cw)) (v0 (* cell-row CELL-H)))
               (and (> w 1.0) (< x VIEW-W) (> (+ x w) 0.0) (< y VIEW-H) (> (+ y h) 0.0)
                    (list (projected-depth p)
                          (lambda ()
                            (mode7-draw-sprite! *sheet* sx y sw h 0.0 (* 7 CELL-H) PLAYER-CELL-W (* 8 CELL-H) fog fc)
                            (mode7-draw-sprite! *sheet* x y w h u0 v0 (+ u0 cw) (+ v0 CELL-H) fog fc)
                            (when after (after (projected-x p) (+ (projected-y p) (bend-dy (projected-y p))) k)))))))))

    ;; Sparks at the side of the machine that hit the wall: four 32x32
    ;; frames in row 7 from x 80, three ticks each. spark: (age . side),
    ;; side -1 left, 1 right.
    (define (sparks-drawer spark)
      (and spark (< (car spark) 12)
           (lambda (px py k)
             (let* ((fr (quotient (car spark) 3))
                    (side (cdr spark))
                    (size (round (* k 32 1.5)))
                    (x (round (+ px (* side k 30) (- (* 0.5 size)))))
                    (y (round (- py (* k 30))))
                    (u0 (+ PLAYER-CELL-W (* fr 32))))
               ;; mirrored for the left wall, so the burst flies away from it
               (if (> side 0)
                   (mode7-draw-sprite! *sheet* x y size size u0 (* 7 CELL-H) (+ u0 32) (+ (* 7 CELL-H) 32) 0.0 '(0.0 0.0 0.0))
                   (mode7-draw-sprite! *sheet* x y size size (+ u0 32) (* 7 CELL-H) u0 (+ (* 7 CELL-H) 32) 0.0 '(0.0 0.0 0.0)))))))

    (define (player-frame m cam-heading)
      (let* ((yaw (wrap-angle (- (machine-heading m) cam-heading)))
             (v (+ (machine-lean m) (* 2.5 yaw)))
             (k (cond ((< v -0.7) 0) ((< v -0.22) 1) ((<= v 0.22) 2) ((<= v 0.7) 3) (else 4))))
        (+ k (if (> (machine-boost m) 0.0) 5 0))))

    ;; The thrusters' flicker: the second frame every other 3 ticks.
    (define (flick? r) (odd? (quotient (race-tick r) 3)))

    (define (rival-dir c m)
      (let* ((dx (- (machine-x m) (cam-x c)))
             (dy (- (machine-y m) (cam-y c)))
             (view (atan dx (- dy)))
             (rel (wrap-angle (- (machine-heading m) view)))
             (k (exact (round (/ rel (/ PI 8.0))))))
        (modulo k 16)))

    ;; The best lap's ghost: the player's machine where it was at this
    ;; point of the best lap, drawn see-through (every other pixel).
    (define (ghost-item c tuning g)
      (and g
           (let ((it (machine-sprite c tuning (make-machine (car g) (cadr g) (caddr g)) 2 0 #t #f)))
             (and it (list (car it) (lambda () (mode7-sprite-style! #t 0.0 0.0) ((cadr it)) (mode7-sprite-style! #f 0.0 0.0)))))))

    ;; The uplink gate over the start line: two pylons just outside the road
    ;; (row 7 from x 208: 32x80, the foot at the cell's bottom) and a beam
    ;; between their tops (row 7 from x 240: 32x16, wrapped across).
    (define GATE-HEIGHT 70.0)
    (define (gate-items c t)
      (let* ((l (track-point t 0.0 -1.12)) (rp (track-point t 0.0 1.12))
             (a (camera-project c (car l) (cadr l) 0.0 4.0))
             (b (camera-project c (car rp) (cadr rp) 0.0 4.0))
             (at (camera-project c (car l) (cadr l) GATE-HEIGHT 4.0))
             (bt (camera-project c (car rp) (cadr rp) GATE-HEIGHT 4.0)))
        (if (not (and a b at bt))
            '()
            (let* ((pylon (lambda (p top)
                            (let* ((h (- (projected-y p) (projected-y top)))
                                   (w (* h 0.4)))
                              (list (projected-depth p)
                                    (lambda ()
                                      (mode7-draw-sprite! *sheet* (round (- (projected-x p) (* 0.5 w))) (round (+ (projected-y top) (bend-dy (projected-y p))))
                                                          (round w) (round h) 208.0 (* 7 CELL-H) 240.0 (* 8 CELL-H) 0.0 '(0.0 0.0 0.0)))))))
                   (x0 (min (projected-x at) (projected-x bt))) (x1 (max (projected-x at) (projected-x bt)))
                   (y0 (+ (min (projected-y at) (projected-y bt)) (bend-dy (projected-y a))))
                   (bh (max 2.0 (* 0.16 (- (projected-y a) (projected-y at)))))
                   (beam (list (* 0.5 (+ (projected-depth a) (projected-depth b)))
                               (lambda ()
                                 (mode7-sprite-style! #f 32.0 240.0)
                                 (mode7-draw-sprite! *sheet* (round x0) (round y0) (round (- x1 x0)) (round bh)
                                                     240.0 (* 7 CELL-H) (+ 240.0 (* 32.0 (/ (- x1 x0) (* 2.0 bh)))) (+ (* 7 CELL-H) 16)
                                                     0.0 '(0.0 0.0 0.0))
                                 (mode7-sprite-style! #f 0.0 0.0)))))
              (list (pylon a at) (pylon b bt) beam)))))

    (define (draw-machines! c tuning r cam-heading spark . more)
      (let* ((pm (racer-machine (race-player r)))
             (fl (flick? r))
             (ghost (and (pair? more) (car more)))
             (items (cons (machine-sprite c tuning pm (+ (player-frame pm cam-heading) (if fl 10 0)) 0 #t
                                          (sparks-drawer spark))
                          (map (lambda (x)
                                 (let ((m (racer-machine x)))
                                   (machine-sprite c tuning m (rival-dir c m) (+ 1 (racer-colour x) (if fl 3 0)) #f #f)))
                               (race-rivals r))))
             (items (append (filter (lambda (x) x) (cons (ghost-item c tuning ghost) items))
                            (gate-items c (race-track r)))))
        ;; far to near
        (let draw ((items items))
          (unless (null? items)
            (let far ((best (car items)) (rest (cdr items)) (others '()))
              (if (null? rest)
                  (begin ((cadr best)) (draw others))
                  (if (> (car (car rest)) (car best))
                      (far (car rest) (cdr rest) (cons best others))
                      (far best (cdr rest) (cons (car rest) others)))))))))

    ;; --- the HUD ---------------------------------------------------------------------------

    (define (speed-kmh m) (exact (round (* 0.9 (machine-speed m)))))

    (define (two n) (if (< n 10) (string-append "0" (number->string n)) (number->string n)))
    ;; ticks as M:SS.CC
    (define (lap-clock ticks)
      (if (not ticks)
          "-:--.--"
          (let* ((cs (exact (floor (/ (* ticks 100) 60))))
                 (m (quotient cs 6000))
                 (s (quotient (modulo cs 6000) 100))
                 (c (modulo cs 100)))
            (string-append (number->string m) ":" (two s) "." (two c)))))

    (define (ordinal n)
      (string-append (number->string n) (case n ((1) "ST") ((2) "ND") ((3) "RD") (else "TH"))))

    ;; HUD drawing in view pixels, on the window at the fit's scale.
    (define *fit* #f)
    (define (hs) (max 1 (exact (floor (fit-scale *fit*)))))
    (define (hx vx) (+ (fit-x *fit*) (* vx (fit-scale *fit*))))
    (define (hy vy) (+ (fit-y *fit*) (* vy (fit-scale *fit*))))
    ;; Colours by hex, parsed once each.
    (define *rgb* '())
    (define (rgb hex)
      (let ((e (assoc hex *rgb*)))
        (if e
            (apply set-color (cdr e))
            (let* ((d (lambda (k) (/ (string->number (substring hex k (+ k 2)) 16) 255.0)))
                   (c (list (d 1) (d 3) (d 5))))
              (set! *rgb* (cons (cons hex c) *rgb*))
              (apply set-color c)))))
    (define (rect! vx vy w h hex)
      (rgb hex)
      (draw-filled-rect (hx vx) (hy vy) (* w (fit-scale *fit*)) (* h (fit-scale *fit*))))

    ;; The HUD's text: Substratic's 5x7 font, rendered once into a white
    ;; glyph texture and drawn one textured rect per character, tinted by
    ;; the current colour. Substratic's draw-text draws each glyph as a
    ;; rect per run of lit cells (around five a glyph), and on the web every
    ;; drawing call allocates: the HUD was most of DRAW's 9 ms a frame.
    (define *font* #f)
    (define *glyph-index* '())    ; char -> column in the texture
    (define *comb* #f)            ; the meter's cells, 2 lit 1 gap, white
    (define (hud-font-init!)
      (let* ((n (length GLYPHS))
             (w (* n 6)) (h 7)
             (px (make-bytevector (* w h 4) 0)))
        (let loop ((gs GLYPHS) (i 0))
          (unless (null? gs)
            (set! *glyph-index* (cons (cons (char-downcase (caar gs)) i) *glyph-index*))
            (let rows ((rs (cdar gs)) (y 0))
              (unless (null? rs)
                (let cols ((x 0))
                  (when (< x 5)
                    (when (char=? (string-ref (car rs) x) #\#)
                      (let ((k (* 4 (+ (* y w) (* i 6) x))))
                        (bytevector-u8-set! px k 255) (bytevector-u8-set! px (+ k 1) 255)
                        (bytevector-u8-set! px (+ k 2) 255) (bytevector-u8-set! px (+ k 3) 255)))
                    (cols (+ x 1))))
                (rows (cdr rs) (+ y 1))))
            (loop (cdr gs) (+ i 1))))
        (set! *font* (make-texture-from-pixels w h px 'nearest)))
      (let* ((cells 50) (w (* cells 3)) (px (make-bytevector (* w 4) 0)))
        (let loop ((x 0))
          (when (< x w)
            (unless (= 2 (modulo x 3))
              (let ((k (* 4 x)))
                (bytevector-u8-set! px k 255) (bytevector-u8-set! px (+ k 1) 255)
                (bytevector-u8-set! px (+ k 2) 255) (bytevector-u8-set! px (+ k 3) 255)))
            (loop (+ x 1))))
        (set! *comb* (make-texture-from-pixels w 1 px 'nearest))))

    (define (glyphs! s x y scale)
      (let ((adv (* scale 6)) (gw (* scale 5)) (gh (* scale 7)))
        (let loop ((i 0) (x x))
          (when (< i (string-length s))
            (let ((e (assv (char-downcase (string-ref s i)) *glyph-index*)))
              (when e (draw-texture-region *font* x y gw gh (* 6 (cdr e)) 0 5 7)))
            (loop (+ i 1) (+ x adv))))))

    ;; The signal's interference on the HUD (P15: the HUD and the sky
    ;; only): text in the top band (above HUD-BAND, which is sky) jitters
    ;; sideways, bleeds a red copy, and during a dropout tears further and
    ;; flickers. The meter is never touched: it's the one reading a
    ;; struggling player needs.
    (define HUD-BAND 58)
    (define *hud-interf* 0.0)
    (define *hud-dropout* #f)
    (define *hud-frame* 0)
    ;; the rows interference may touch: above HUD-BAND and above the
    ;; horizon, even where the dip's overshoot lifts it
    (define (hud-band) (min HUD-BAND (- (+ *horizon* (min 0.0 *dip*)) 2.0)))
    (define (h2 a b)
      (let ((x (* 43758.5453 (sin (+ (* a 12.9898) (* b 78.233))))))
        (- x (floor x))))

    (define (text! s vx vy hex . size)
      (let* ((k (if (pair? size) (car size) 1))
             ;; the band ends above the horizon whatever the horizon knob says
             (L (if (< (+ vy (* 7 k)) (hud-band)) *hud-interf* 0.0))
             (r (h2 vy *hud-frame*))
             (j (cond ((<= L 0.0) 0)
                      (*hud-dropout* (exact (round (* 8.0 (- (h2 *hud-frame* vy) 0.5)))))
                      ((< r (* 0.35 L)) (exact (round (* 6.0 L (- (h2 *hud-frame* vy) 0.5)))))
                      (else 0)))
             (vx (+ vx j)))
        (unless (and *hud-dropout* (< r 0.45))
          (when (> L 0.3)
            (rgb "#CC3340")
            (glyphs! s (hx (+ vx 1 (exact (round (* 2.0 L))))) (hy vy) (* k (hs))))
          (rgb "#0D0A1A")
          (glyphs! s (+ (hx vx) (hs)) (+ (hy vy) (hs)) (* k (hs)))
          (rgb hex)
          (glyphs! s (hx vx) (hy vy) (* k (hs))))))

    ;; tracking lines rolling down through the HUD's band
    (define (hud-tracking!)
      (when (> *hud-interf* 0.0)
        (let* ((band (exact (floor (hud-band))))
               (y (modulo (* 2 *hud-frame*) (max 1 band))))
          (rect! 0 y VIEW-W 1 "#8A8FA0")
          (when (< (+ y 1) band) (rect! 0 (+ y 1) VIEW-W 1 "#0D0A1A"))
          (when (> *hud-interf* 0.5)
            (let ((y2 (modulo (+ y 23) (max 1 band))))
              (rect! 0 y2 VIEW-W 1 "#2A2D3A"))))))
    (define (text-w s . size) (/ (text-width s (* (if (pair? size) (car size) 1) (hs))) (fit-scale *fit*)))
    (define (centred! s vy hex . size)
      (let ((k (if (pair? size) (car size) 1)))
        (text! s (round (/ (- VIEW-W (text-w s k)) 2)) vy hex k)))

    ;; The integrity meter: a bar of 2-pixel cells, cyan (your live signal,
    ;; P16) down to 30, red below it (the trace's danger), never amber (ICE's);
    ;; flashing white for a few frames after a hit.
    ;; meter-shown: the integrity the meter showed last frame, easing down to
    ;; the real one, so what a hit or a boost spent drains away in white
    (define *meter-shown* 100.0)
    (define (meter! vx vy integrity flash tick)
      (let* ((cells 50)
             (lit (exact (ceiling (* cells (/ integrity INTEGRITY-MAX)))))
             (col (if (>= integrity 30.0) "#4DF2D9" "#FF5959"))
             (col (if (and (< integrity 30.0) (odd? (quotient tick 8))) "#CC3340" col))
             (col (if (> flash 0) "#FAFCFF" col)))
        (rect! (- vx 1) (- vy 1) (+ (* cells 3) 1) 8 "#0D0A1A")
        ;; two textured draws: every cell dim, then the lit ones
        (let ((s (fit-scale *fit*)))
          (rgb "#21173D")
          (draw-texture-region *comb* (hx vx) (hy vy) (* cells 3 s) (* 6 s) 0 0 (* cells 3) 1)
          (set! *meter-shown* (if (< *meter-shown* integrity) integrity (max integrity (- *meter-shown* 0.6))))
          (let ((drain (exact (ceiling (* cells (/ *meter-shown* INTEGRITY-MAX))))))
            (when (> drain lit)
              (rgb "#FAFCFF")
              (draw-texture-region *comb* (hx vx) (hy vy) (* drain 3 s) (* 6 s) 0 0 (* drain 3) 1)))
          (when (> lit 0)
            (rgb col)
            (draw-texture-region *comb* (hx vx) (hy vy) (* lit 3 s) (* 6 s) 0 0 (* lit 3) 1)))))

    (define (hud! tuning r info)
      (let* ((p (race-player r))
             (m (racer-machine p))
             (laps (race-laps tuning))
             (phase (race-phase r))
             (tick (race-tick r)))
        ;; top left: the lap and its time
        (text! (string-append "LAP " (number->string (max 1 (racer-lap p))) "/" (number->string laps)) 8 8 "#CCE6FF" 2)
        (text! (lap-clock (if (and (eq? phase 'race) (> (racer-lap p) 0)) (- tick (racer-lap-start p)) 0)) 8 26 "#CCE6FF")
        (text! (string-append "LAST " (lap-clock (racer-last-lap p))) 8 36 "#7380A6")
        (text! (string-append "BEST " (lap-clock (cdr (assq 'best info)))) 8 46 "#FFCC33")
        ;; top right: place and speed
        (let ((pl (ordinal (racer-place p))))
          (text! pl (- VIEW-W 8 (text-w pl 2)) 8 "#FF59D9" 2))
        (let ((sp (string-append (number->string (speed-kmh m)) " KM/H")))
          (text! sp (- VIEW-W 8 (text-w sp)) 26 "#CCE6FF"))
        ;; the integrity meter, top centre
        (centred! "INTEGRITY" 6 "#7380A6")
        (meter! (- (/ VIEW-W 2) 75) 15 (machine-integrity m) (cdr (assq 'flash info)) tick)
        ;; what the last moments did to the cargo: (text colour age) rising
        (for-each (lambda (pp)
                    (let ((age (caddr pp)))
                      (when (< age 50)
                        (text! (car pp) (+ (/ VIEW-W 2) 80) (- 15 (quotient age 6)) (cadr pp)))))
                  (cdr (assq 'popups info)))
        (cond ((> (machine-scramble m) 0.0)
               (when (odd? (quotient tick 4)) (centred! "ICE: STEERING SCRAMBLED" 25 "#FF9F1A")))   ; amber: ICE (P16)
              ((> (machine-boost m) 0.0) (centred! "BOOST" 25 "#F2731A"))   ; orange: speed
              ((machine-on-repair m) (centred! "CHECKSUM LANE: REPAIRING" 25 "#4DF2D9"))
              ((and (eq? phase 'race) (>= (racer-lap p) (race-tuning-ref tuning 'boost-lap))
                    (> (machine-integrity m) (handling-ref tuning 'boost-cost)))
               (centred! "BOOST READY" 25 "#7380A6")))
        ;; TRACED. on the final lap, red (P16), for its first three seconds
        (let ((age (cdr (assq 'traced-age info))))
          (when (and age (< age 180) (odd? (quotient age 10)))
            (centred! "TRACED." 36 "#FF5959" 2)))
        (hud-tracking!)
        ;; the showcase's or the solo's caption, and the panel's key
        (let ((cap (cdr (assq 'fx-caption info))))
          ;; above the F3 lines when they are showing
          (when cap (centred! cap (if (cdr (assq 'fps info)) (- VIEW-H 52) (- VIEW-H 24)) "#FFCC33")))
        (when (and (cdr (assq 'fx-hint info)) (not (cdr (assq 'fps info))))
          (text! (cdr (assq 'fx-hint info)) 8 (- VIEW-H 11) "#7380A6"))
        (case phase
          ((title)
           (centred! "SIGNAL OVERDRIVE" 70 "#FF59D9" 3)
           (centred! "COURIER ZERO. ONE PACKAGE. DON'T LET IT CORRUPT." 98 "#CCE6FF")
           (when (odd? (quotient tick 30)) (centred! (cdr (assq 'start-line info)) 120 "#FFCC33" 2)))
          ((countdown)
           ;; the start card
           (rect! 70 56 340 26 "#0D0A1A")
           (centred! "DELIVER THE SIGNAL TO THE UPLINK." 60 "#4DF2D9")
           (centred! (string-append (number->string laps) " LAPS. KEEP THE CARGO CLEAN.") 71 "#CCE6FF")
           (let ((n (conductor-count-in (race-song r))))
             (when n (centred! (number->string n) 96 "#FFCC33" 4))))
          ((race)
           (when (< (race-clock r) 60) (centred! "GO" 90 "#4DF2D9" 4)))
          ((finished) (finish-panel! r p (cdr (assq 'restart-line info))))
          ((corrupt)
           (centred! "CARGO CORRUPT." 80 "#FF5959" 3)
           (centred! "THE SIGNAL DIDN'T MAKE IT." 102 "#CCE6FF")
           (centred! (cdr (assq 'restart-line info)) 116 "#FFCC33")))))

    ;; The finish: every machine by place, its race time (or still running)
    ;; and its best lap; the player's row lit.
    (define (finish-panel! r p restart)
      (let* ((all (cons p (race-rivals r)))
             (sorted (let ins ((xs all) (out '()))
                       (if (null? xs) out
                           (ins (cdr xs) (let put ((o out))
                                           (cond ((null? o) (list (car xs)))
                                                 ((< (racer-place (car xs)) (racer-place (car o))) (cons (car xs) o))
                                                 (else (cons (car o) (put (cdr o)))))))))))
        (rect! 100 52 280 (+ 44 (* 10 (length all))) "#0D0A1A")
        (centred! "DELIVERED." 56 "#4DF2D9" 2)
        (let loop ((xs sorted) (y 76))
          (unless (null? xs)
            (let* ((x (car xs))
                   (col (if (eq? x p) "#FFCC33" "#CCE6FF"))
                   (time (if (racer-finished x) (lap-clock (- (racer-finished x) (race-start-tick r))) "RUNNING")))
              (text! (ordinal (racer-place x)) 112 y col)
              (text! (racer-name x) 142 y col)
              (text! time 218 y col)
              (text! (string-append "BEST " (lap-clock (racer-best-lap x))) 290 y col))
            (loop (cdr xs) (+ y 10))))
        (centred! restart (+ 80 (* 10 (length all))) "#FFCC33")))

    ;; --- the tuning overlay ------------------------------------------------------------------

    (define (overlay! tuning sel)
      (let* ((rows 22)
             (n (length KNOBS))
             (top (max 0 (min (- n rows) (- sel (quotient rows 2)))))
             (x 8) (y 40))
        (rect! (- x 4) (- y 6) 196 (+ (* rows 8) 34) "#0D0A1A")
        (text! "TUNING  UP/DOWN PICK  LEFT/RIGHT SET  0 RESET" x (- y 2) "#7380A6")
        (let loop ((i top) (row 0))
          (when (and (< i n) (< row rows))
            (let* ((k (list-ref KNOBS i))
                   (v (tuning-ref tuning (knob-key k)))
                   (changed (> (abs (- v (knob-default k))) 1e-9))
                   (col (cond ((= i sel) "#FFCC33") (changed "#4DF2D9") (else "#CCE6FF"))))
              (when (= i sel) (rect! (- x 2) (+ y 8 (* row 8)) 190 8 "#2E1C4D"))
              (text! (knob-label k) x (+ y 9 (* row 8)) col)
              (text! (tuning-format-value v) (+ x 130) (+ y 9 (* row 8)) col))
            (loop (+ i 1) (+ row 1))))
        (let ((q (tuning-query tuning)))
          (text! (if (string=? q "") "?(DEFAULTS)" (string-append "?" q)) x (+ y 12 (* rows 8)) "#FF59D9"))))

    ;; --- the F3 instruments -----------------------------------------------------------------

    ;; ins: (history index max hitches audio-mode audio-readout). Two lines
    ;; over the FPS line and the last 180 frames as bars (bottom right):
    ;; each bar a frame's interval, 1 px per 2 ms; the dim line is 16.7 ms,
    ;; the red line 33 ms (a frame over it is a hitch, logged).
    (define (instruments! ins)
      (let* ((hist (car ins)) (idx (cadr ins)) (mx (caddr ins)) (hitches (cadddr ins))
             (mode (list-ref ins 4)) (a (list-ref ins 5))
             (r1 (lambda (v) (number->string (/ (round (* 10.0 v)) 10.0))))
             (n (vector-length hist))
             (x0 (- VIEW-W 8 n)) (base (- VIEW-H 8)))
        ;; short, to clear the graph: MAX frame ms, HITCH count, AUD the
        ;; sound's ms a frame; the stream mode (SAB worklet-sab, MSG
        ;; worklet-msg, SPROC scriptprocessor, NATIVE), the queue, UR the
        ;; underruns heard, CUE the cue mode and its lag in frames
        (text! (string-append "MAX " (r1 mx) "MS HITCH " (number->string hitches) " AUD " (r1 (list-ref ins 6)) "MS F4 LOG")
               8 (- VIEW-H 34) "#4DF2D9")
        (text! (string-append (if (car a)
                                  (cond ((string=? mode "worklet-sab") "SAB") ((string=? mode "worklet-msg") "MSG")
                                        ((string=? mode "scriptprocessor") "SPROC") (else (string-upcase mode)))
                                  "OFF")
                              " " (number->string (cadr a)) "MS UR " (number->string (caddr a))
                              " CUE " (string-upcase (let ((m (list-ref a 4))) (if (symbol? m) (symbol->string m) "?")))
                              " " (number->string (list-ref a 5)))
               8 (- VIEW-H 24) "#4DF2D9")
        (graph! hist idx x0 base)))

    ;; The graph as a texture, a ring of columns: each frame rewrites the
    ;; one column for the newest frame and uploads once, and the texture is
    ;; drawn in two pieces (oldest first). A rect per bar would have been
    ;; 180 drawing calls a frame, and on the web each call allocates: the
    ;; graph would have inflated the DRAW time it is there to show.
    (define GRAPH-H 34)
    (define *graph* #f) (define *graph-px* #f) (define *graph-last* -1) (define *graph-new* #f)
    (define (graph-column! k ms)
      (let ((h (max 1 (min GRAPH-H (exact (round (/ ms 2.0)))))))
        (let loop ((y 0))
          (when (< y GRAPH-H)
            (let* ((o (* 4 (+ (* y 180) k)))
                   (from-bottom (- GRAPH-H 1 y))
                   (c (cond ((< from-bottom h) (if (> ms 33.0) '(255 89 89) '(77 242 217)))
                            ((= from-bottom 16) '(204 51 64))
                            ((= from-bottom 8) '(61 64 82))
                            (else '(13 10 26)))))
              (bytevector-u8-set! *graph-px* o (car c))
              (bytevector-u8-set! *graph-px* (+ o 1) (cadr c))
              (bytevector-u8-set! *graph-px* (+ o 2) (caddr c))
              (bytevector-u8-set! *graph-px* (+ o 3) 255))
            (loop (+ y 1))))))
    (define (graph! hist idx x0 base)
      (unless *graph*
        (set! *graph-px* (make-bytevector (* 180 GRAPH-H 4) 0))
        (let loop ((k 0)) (when (< k 180) (graph-column! k (vector-ref hist k)) (loop (+ k 1))))
        ;; the texture is made this frame (that is its upload); updates start next frame
        (set! *graph* (make-texture-from-pixels 180 GRAPH-H *graph-px* 'nearest))
        (set! *graph-new* #t))
      ;; the newest frame is the one before idx
      (let ((k (modulo (- idx 1) 180)))
        (unless (= k *graph-last*)
          (graph-column! k (vector-ref hist k))
          (set! *graph-last* k)
          (if *graph-new* (set! *graph-new* #f) (update-texture *graph* *graph-px*))))
      (let* ((s (fit-scale *fit*)) (y (hy (- base GRAPH-H))))
        (set-color 1.0 1.0 1.0)
        ;; oldest (idx..179) first, then 0..idx-1
        (draw-texture-region *graph* (hx x0) y (* (- 180 idx) s) (* GRAPH-H s) idx 0 (- 180 idx) GRAPH-H)
        (when (> idx 0)
          (draw-texture-region *graph* (hx (+ x0 (- 180 idx))) y (* idx s) (* GRAPH-H s) 0 0 idx GRAPH-H))))

    ;; --- a frame ------------------------------------------------------------------------------

    (define (look! tuning)
      (mode7-set-look! (list (cons 'fog-start (tuning-ref tuning 'fog-start))
                             (cons 'fog-end (tuning-ref tuning 'fog-end))
                             (cons 'fog? (> (tuning-ref tuning 'fog) 0.5))
                             (cons 'far-start (tuning-ref tuning 'far-start))
                             (cons 'fog-color '(0.18 0.11 0.30))
                             (cons 'sky-top '(0.05 0.04 0.10))
                             (cons 'sky-low '(0.18 0.11 0.30))))
      (mode7-set-far! (tuning-ref tuning 'far-end)))

    ;; info: (best . ticks) (flash . frames) (start-line . text)
    ;; (restart-line . text) (overlay . selected-row-or-#f); and, all
    ;; optional, the title's: camera (one to use instead of the race's),
    ;; fade (0..1 toward black), draw-ground (called with the camera after
    ;; the ground, before the machines), draw-3d (a thunk drawn over the
    ;; machines, before the palette pass) and draw-2d (called with centred!
    ;; after the HUD).
    (define (info-get info key) (let ((e (assq key info))) (and e (cdr e))))
    ;; the heading of the camera in use (scene-frame!'s own cam-heading
    ;; argument is the race camera's, and hides the accessor there)
    (define (camera-heading c) (cam-heading c))
    (define (scene-frame! tuning r cam-heading info win-w win-h integer-only)
      (sync-post! tuning)
      (show-track! (track-name (race-track r)))
      (look! tuning)
      (let* ((m (racer-machine (race-player r)))
             (c (or (info-get info 'camera) (scene-camera tuning m cam-heading (cdr (assq 'kick info)))))
             (dither? (> (tuning-ref tuning 'dither) 0.5))
             (f (view-fit win-w win-h VIEW-W VIEW-H integer-only: integer-only)))
        (set! *fit* f)
        (set! *horizon* (tuning-ref tuning 'horizon))
        (let ((st (cdr (assq 'fx info))))
          (fx-uniforms! r c st (cdr (assq 'fx-knob info)) (> (tuning-ref tuning 'fx-hold) 0.5))
          (set! *hud-interf* (* (if (> ((cdr (assq 'fx-knob info)) 'fx-interf) 0.0) 1.0 0.0) (fx-interf st)))
          (set! *hud-dropout* (and (> *hud-interf* 0.0) (fx-dropout st)))
          (set! *hud-frame* (quotient (fx-tick st) 2)))
        (begin-frame)
        (with-3d-pass *view* (list 0.05 0.04 0.10 1.0)
          ;; a frame faded fully out draws nothing (it is black even where
          ;; the fade cannot reach: the dither off, or lut=0)
          (unless (>= (or (info-get info 'fade) 0.0) 1.0)
            ;; fx-passes > 1 draws the ground again, to measure its GPU cost
            (let passes ((k (exact (round (tuning-ref tuning 'fx-passes)))))
              (mode7-draw-ground! c)
              (when (> k 1) (passes (- k 1))))
            (let ((d (info-get info 'draw-ground))) (when d (d c)))
            (when (cdr (assq 'sprites info))
              (draw-machines! c tuning r (camera-heading c) (cdr (assq 'spark info)) (cdr (assq 'ghost info))))
            (let ((d (info-get info 'draw-3d))) (when d (d)))))
        ;; the frame's effects, for the lookup pass
        (let ((v (min 1.0 (/ (machine-speed m) (handling-ref tuning 'top)))))
          (set-pipeline-uniform! *lut-pipe* 'fx
                                 (list (* (tuning-ref tuning 'speed-lines) (max 0.0 (min 1.0 (* 2.5 (- v 0.55)))) (+ 1.0 (cdr (assq 'kick info))))
                                       (cdr (assq 'time info))
                                       (if *hold* ((cdr (assq 'fx-knob info)) 'fx-glitch) (cdr (assq 'glitch info)))
                                       (cdr (assq 'corrupt info))))
          (set-pipeline-uniform! *lut-pipe* 'vp (list (* 0.5 VIEW-W) (+ (tuning-ref tuning 'horizon) *dip*) (or (info-get info 'fade) 0.0) 0.0)))
        (when dither?
          (with-3d-pass *post* #f
            (if (> (tuning-ref tuning 'lut) 0.5)
                (draw-mesh *lut-pipe* *tri* *view-tex* (cdr (assq *palette* *luts*)))
                (draw-mesh *post-pipe* *tri* *view-tex*))))
        (view-present! *presenter* (if dither? *post* *view*) f)
        (set-blend-mode 'normal)
        (when (cdr (assq 'hud info)) (hud! tuning r info))
        (let ((d (info-get info 'draw-2d))) (when d (d centred!)))
        (let ((paused (assq 'paused info)))
          (when (and paused (cdr paused))
            (text! "PAUSED" 216 122 "#4DF2D9")))
        (let ((sel (cdr (assq 'overlay info))))
          (when sel (overlay! tuning sel)))
        ;; F3: frames per second and the frame's interval, smoothed
        (let ((fps (cdr (assq 'fps info))))
          (when fps
            ;; FPS, the frame's interval, and the CPU's share: the race's
            ;; steps (SIM) and building the frame (DRAW). A slow frame with
            ;; small SIM and DRAW is the GPU's.
            (let ((r1 (lambda (v) (number->string (/ (round (* 10.0 v)) 10.0)))))
              (text! (string-append (number->string (exact (round (car fps)))) " FPS  "
                                    (r1 (cadr fps)) " MS  SIM " (r1 (caddr fps)) "  DRAW " (r1 (cadddr fps)))
                     8 (- VIEW-H 14) "#4DF2D9"))))
        (let ((ins (cdr (assq 'instruments info))))
          (when ins (instruments! ins)))
        (end-frame)))))
