;;; (racer lut) - The post pass by lookup: the same ordered dither as
;;; (racer dither)'s POST-FRAGMENT (Bayer 4x4, the threshold added to all
;;; three channels, clamped), then the nearest palette colour read from a
;;; precomputed texture instead of found by comparing against every palette
;;; colour: one texelFetch per pixel instead of up to 60 distance tests.
;;;
;;; The lookups are scripts/art/gen-lut.mjs's (assets/racer/lut-*.png): a
;;; channel value v in 0..255 falls in bin floor(v / 4); bin (r, g, b) is
;;; the texel (r + 64 * (b mod 8), g + 64 * floor(b / 8)) of a 512x512
;;; texture, holding the palette colour nearest the bin's centre (4b + 2). That is an
;;; approximation: a dithered value in a bin straddling the boundary between
;;; two colours can land on the other one. The exact pass stays behind the
;;; lut knob (0).
;;;
;;; Why: headless Chrome (SwiftShader, CPU rendering) ran the game at 8.8
;;; frames a second with the exact pass and 18.7 without it; on a phone's
;;; GPU the 51-colour loop per pixel is the heaviest work in the frame.

(define-library (racer lut)
  (import (sigil core))
  (export LUT-FRAGMENT)
  (begin
    ;; params: x spread, w the frame height. opts: x 1 when row 0 of
    ;; gl_FragCoord is the picture's bottom, y 1 to dither (0 copies).
    (define LUT-FRAGMENT
      "uniform vec4 params;
uniform vec4 opts;
uniform sampler2D src;
uniform sampler2D lut;
out vec4 frag_color;
const int B4[16] = int[16](0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5);
void main() {
  ivec2 p = ivec2(gl_FragCoord.xy);
  vec4 texel = texelFetch(src, p, 0);
  if (opts.y < 0.5) { frag_color = vec4(texel.rgb, 1.0); return; }
  vec3 c = floor(texel.rgb * 255.0 + 0.5);
  int x = p.x;
  int y = opts.x > 0.5 ? int(params.w) - 1 - p.y : p.y;
  float t = ((float(B4[(y % 4) * 4 + (x % 4)]) + 0.5) / 16.0 - 0.5) * params.x;
  vec3 q = clamp(c + vec3(t), 0.0, 255.0);
  ivec3 b = ivec3(min(floor(q / 4.0), vec3(63.0)));
  frag_color = vec4(texelFetch(lut, ivec2(b.r + 64 * (b.b % 8), b.g + 64 * (b.b / 8)), 0).rgb, 1.0);
}
")))
