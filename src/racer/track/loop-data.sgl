    (define LOOP-SAMPLES
      (let* ((n (apply + (map vector-length LOOP-CHUNKS)))
             (v (make-vector n 0.0)))
        (let loop ((cs LOOP-CHUNKS) (k 0))
          (if (null? cs)
              v
              (let ((c (car cs)))
                (let copy ((i 0))
                  (when (< i (vector-length c))
                    (vector-set! v (+ k i) (vector-ref c i))
                    (copy (+ i 1))))
                (loop (cdr cs) (+ k (vector-length c))))))))))
