;;; (carrier damage) - The damage audition (§3.7 deliverable 3, §3.1's table)
;;;
;;; The same 16 bars of Carrier (lap 1's loop, bars 9-16, into lap 2)
;;; rendered through (carrier inserts) on motif's live player, with every
;;; damage parameter set by player-set-insert-param! on the exact frame:
;;; the path 0.1 step 2 will drive.
;;;
;;; Integrity maps to parameters as §3.1 says: subtle ones (cutoffs, the
;;; lead's detune depth) move continuously with integrity inside a tier;
;;; distinctive ones (bit depth, rate, dropouts, stems leaving) switch at
;;; tier edges. FAILING has dropouts only (no stutter node yet, §9).
;;; Dropouts ramp over 3 ms: an instant cut rings through motif's master
;;; DC blocker and high-pass for about 50 ms (measured by the probe).
;;;
;;; The immediate path (§3.2) is mixed at output time, as the game's
;;; sink-native cues are: a wall hit's crackle and the stream's 40 ms dip
;;; to 40%, the boost's whoosh, the repair's lock. Those cues are
;;; synthesized here as stand-ins; the game renders its own at boot.

(define-library (carrier damage)
  (import (sigil core) (sigil math) (sigil list) (sigil string)
          (motif tune) (motif tune player)
          (carrier score) (carrier inserts) (carrier render) (carrier analysis))
  (export render-damage-audition tier-of check-damage-wiring check-clean-transparency)
  (begin
    (define SR 48000)
    (define (say . xs) (for-each display xs) (newline))
    (define (fx x d) (let ((k (expt 10.0 d))) (number->string (/ (round (* x k)) k))))

    ;; the clock: 140 BPM, speed 3, 32 rows a bar
    (define ROW-S (/ (* 3 2.5) 140.0))
    (define BAR-S (* 32 ROW-S))
    (define BEAT-S (* 8 ROW-S))
    (define (frame s) (exact (round (* s SR))))
    (define (at-16th bar s16) (* ROW-S (+ (* 32 bar) (* 2 s16))))
    (define OPEN (* 0.45 SR))

    ;; the 16 bars, looped for longer renders: patterns 8..23 of the audition
    (define (damage-tune nbars)
      (let ((t (audition-tune)))
        (tune-with-order t (let loop ((i 0) (acc '()))
                             (if (>= i nbars) (reverse acc)
                                 (loop (+ i 1) (cons (+ 8 (modulo i 16)) acc)))))))

    ;; ------------------------------------------------------------
    ;; Integrity -> parameters
    ;; ------------------------------------------------------------
    (define (tier-of i)
      (cond ((>= i 80) 'clean) ((>= i 55) 'worn) ((>= i 30) 'damaged)
            ((>= i 10) 'failing) ((> i 0) 'critical) (else 'corrupt)))

    ;; linear from (i0, v0) to (i1, v1), clamped
    (define (lerp i i0 v0 i1 v1)
      (let ((k (max 0.0 (min 1.0 (/ (- i i0) (- i1 i0))))))
        (+ v0 (* k (- v1 v0)))))
    (define (log-lerp i i0 v0 i1 v1)
      (exp (lerp i i0 (log v0) i1 (log v1))))

    ;; -> list of (ch name value); every damage param on every channel, so
    ;; any state can be reached from any other by one call
    (define (params-for i boost?)
      (let* ((tier (tier-of i))
             (rank (cdr (assq tier '((clean . 0) (worn . 1) (damaged . 2) (failing . 3) (critical . 4) (corrupt . 4)))))
             (drum-bits (list-ref '(16.0 12.0 9.0 6.0 6.0) rank))
             (drum-rate (list-ref '(1.0 1.0 2.0 4.0 4.0) rank))
             (drum-bits (if boost? (max 3.0 (- drum-bits 3.0)) drum-bits))
             (drive (if boost? 1.6 0.0))
             (bass-cut (list-ref (list OPEN OPEN 4000.0 2000.0 2000.0) rank))
             (pad-cut (case tier
                        ((clean) OPEN)
                        ((worn) (log-lerp i 80.0 12000.0 55.0 8000.0))
                        (else 3000.0)))
             (pad-chorus (if (>= rank 2) 0.5 0.0))
             (pad-gain (list-ref '(1.0 1.0 1.0 0.5 0.0) rank))
             (lead-depth (case tier
                           ((clean) 0.0)
                           ((worn) (lerp i 80.0 0.6 55.0 1.4))
                           ((damaged) (lerp i 55.0 2.4 30.0 3.6))
                           (else (lerp i 30.0 3.6 10.0 4.0))))
             (lead-mix (if (= rank 0) 0.0 1.0))
             (arp-bits (if (>= rank 2) 8.0 16.0))
             (arp-gain (if (>= rank 3) 0.0 1.0))
             (snare-gain (if (= rank 4) 0.0 1.0)))
        (append
         (map (lambda (ch) (list ch 'bits drum-bits)) '(1 2 3))
         (map (lambda (ch) (list ch 'rate-div drum-rate)) '(1 2 3))
         (map (lambda (ch) (list ch 'drive drive)) '(1 2 3))
         (list (list 2 'gain snare-gain) (list 3 'gain snare-gain)
               (list 4 (quote cutoff) bass-cut)
               (list 5 'cutoff pad-cut) (list 5 'depth (* 3.0 pad-chorus)) (list 5 'mix pad-chorus)
               (list 5 'gain pad-gain)
               (list 6 'rate 0.5) (list 6 'depth lead-depth) (list 6 'mix lead-mix)
               (list 6 'makeup (if (> lead-mix 0.0) 1.38 1.0))
               (list 6 'drive (if boost? 0.9 0.0))
               (list 7 'bits arp-bits) (list 7 'drive (if boost? 1.0 0.0)) (list 7 'gain arp-gain)))))

    ;; the lead's gate for a tier, one bar: list of (from16 to16) that are SILENT
    (define (lead-silences tier)
      (case tier
        ((damaged) '((10 11)))                 ; one 16th dropped per bar
        ((failing) '((4 6) (12 14)))           ; a dropout every other beat (an 8th on 2 and 4)
        ((critical) '((3 16)))                 ; one note per bar: only the downbeat's
        (else '())))

    ;; ------------------------------------------------------------
    ;; Schedules: (frame . thunk)
    ;; ------------------------------------------------------------
    (define (set-all p sets)
      (for-each (lambda (s)
                  (unless (player-set-insert-param! p (car s) (cadr s) (caddr s))
                    (error "damage: set refused" s)))
                sets))

    ;; a gain ramp in 6 steps over 3 ms from a to b, starting at time s
    (define (gain-ramp p ch s a b)
      (map (lambda (k)
             (let ((v (+ a (* (- b a) (/ (+ k 1) 6.0)))))
               (cons (+ (frame s) (* k 24)) (lambda () (player-set-insert-param! p ch 'gain v)))))
           '(0 1 2 3 4 5)))

    ;; lead silences for bars [b0, b1) at tier; each silence ramps down 3 ms
    ;; before its 16th and back up 3 ms before its end
    (define (lead-gate-events p tier b0 b1)
      (let loop ((b b0) (acc '()))
        (if (>= b b1) acc
            (loop (+ b 1)
                  (append acc
                          (apply append
                                 (map (lambda (sil)
                                        (append (gain-ramp p 6 (- (at-16th b (car sil)) 0.003) 1.0 0.0)
                                                (if (< (cadr sil) 16)
                                                    (gain-ramp p 6 (- (at-16th b (cadr sil)) 0.003) 0.0 1.0)
                                                    (gain-ramp p 6 (- (at-16th (+ b 1) 0) 0.003) 0.0 1.0))))
                                      (lead-silences tier))))))))

    ;; ------------------------------------------------------------
    ;; Output-time cues (stand-ins for the game's boot-rendered bank)
    ;; ------------------------------------------------------------
    (define seed 12345)
    (define (rand)   ; -1..1, an LCG: deterministic renders
      (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648))
      (- (* 2.0 (/ seed 2147483648.0)) 1.0))

    (define (add! bv frames start n f)
      (let loop ((k 0))
        (when (and (< k n) (< (+ start k) frames))
          (let* ((i (+ start k)) (v (f k)))
            (bytevector-ieee-single-set! bv (* 8 i) (+ v (bytevector-ieee-single-ref bv (* 8 i) 'little)) 'little)
            (bytevector-ieee-single-set! bv (+ 4 (* 8 i)) (+ v (bytevector-ieee-single-ref bv (+ 4 (* 8 i)) 'little)) 'little))
          (loop (+ k 1)))))

    (define (scale! bv frames start n g)
      (let loop ((k 0))
        (when (and (< k n) (< (+ start k) frames))
          (let ((i (+ start k)))
            (bytevector-ieee-single-set! bv (* 8 i) (* (g k) (bytevector-ieee-single-ref bv (* 8 i) 'little)) 'little)
            (bytevector-ieee-single-set! bv (+ 4 (* 8 i)) (* (g k) (bytevector-ieee-single-ref bv (+ 4 (* 8 i)) 'little)) 'little))
          (loop (+ k 1)))))

    ;; a wall hit: the stream dips to 40% for 40 ms (2 ms edges) and a
    ;; crackle (a noise burst and a few pops, high-passed) plays at once
    (define (wall-hit! bv frames s level)
      (let ((st (frame s)) (n (frame 0.04)) (e (frame 0.002)))
        (scale! bv frames st n (lambda (k) (cond ((< k e) (- 1.0 (* 0.6 (/ k (* 1.0 e)))))
                                                 ((> k (- n e)) (- 1.0 (* 0.6 (/ (- n k) (* 1.0 e)))))
                                                 (else 0.4))))
        (let ((prev 0.0))
          (add! bv frames st (frame 0.16)
                (lambda (k)
                  (let* ((t (/ k (* 1.0 SR)))
                         (x (rand))
                         (hp (- x prev))
                         (pop (if (< (abs (rand)) 0.004) (* 3.0 (rand)) 0.0)))
                    (set! prev x)
                    (* level (+ (* 0.5 hp (exp (/ t -0.025))) (* pop (exp (/ t -0.06)))))))))))

    ;; the boost's whoosh: noise through a one-pole low-pass whose cutoff
    ;; sweeps up and back, 0.15 s up, 0.6 s down
    (define (whoosh! bv frames s level)
      (let ((y 0.0))
        (add! bv frames (frame s) (frame 0.75)
              (lambda (k)
                (let* ((t (/ k (* 1.0 SR)))
                       (env (if (< t 0.15) (/ t 0.15) (exp (/ (- 0.15 t) 0.18))))
                       (fc (+ 300.0 (* 5000.0 env)))
                       (a (- 1.0 (exp (/ (* -2.0 3.141592653589793 fc) SR)))))
                  (set! y (+ y (* a (- (rand) y))))
                  (* level env y))))))

    ;; the lock: a short bright chime in key, D6 and A6
    (define (lock! bv frames s level)
      (add! bv frames (frame s) (frame 0.4)
            (lambda (k)
              (let* ((t (/ k (* 1.0 SR)))
                     (env (* (min 1.0 (/ t 0.002)) (exp (/ t -0.11)))))
                (* level env (+ (sin (* 2.0 3.141592653589793 1174.66 t))
                                (* 0.6 (sin (* 2.0 3.141592653589793 1760.0 t)))
                                (* 0.15 (sin (* 2.0 3.141592653589793 3523.98 t)))))))))

    ;; ------------------------------------------------------------
    ;; Renders
    ;; ------------------------------------------------------------
    (define (open-damage-player nbars)
      (open-tune-player (damage-tune nbars) SR inserts: (carrier-inserts)))

    (define (finish! name p r dir)
      (player-close! p)
      (let* ((bv (car r)) (frames (cdr r)) (mid (bv->mid bv frames)))
        (write-wav16 (string-append dir "/" name ".wav") bv frames SR 1.0)
        (say "  " name ": " (fx (/ frames (* 1.0 SR)) 2) " s, mid peak "
             (fx (* 20 (/ (log (max 1e-9 (peak mid 0 frames))) (log 10.0))) 1) " dBFS, RMS "
             (fx (* 20 (/ (log (max 1e-9 (rms mid 0 frames))) (log 10.0))) 1) " dBFS")))

    ;; one tier, 16 bars, at a fixed integrity
    (define (render-tier name integrity dir)
      (let* ((p (open-damage-player 16))
             (tier (tier-of integrity))
             (sched (cons (cons 0 (lambda () (set-all p (params-for integrity #f))))
                          (lead-gate-events p tier 0 16)))
             (r (render-player p SR sched (frame (+ (* 16 BAR-S) 6.0)))))
        (finish! name p r dir)))

    ;; the tour: 4 bars at each tier, CLEAN to CRITICAL, sets on bar lines
    (define (render-tour dir)
      (let* ((p (open-damage-player 20))
             (levels '(90.0 67.0 42.0 20.0 5.0))
             (sched (apply append
                           (map (lambda (k)
                                  (let ((i (list-ref levels k)) (b (* 4 k)))
                                    (cons (cons (frame (at-16th b 0)) (lambda () (set-all p (params-for i #f))))
                                          (lead-gate-events p (tier-of i) b (+ b 4)))))
                                '(0 1 2 3 4))))
             (r (render-player p SR sched (frame (+ (* 20 BAR-S) 6.0)))))
        (finish! "tour" p r dir)))

    ;; Wall hits from CLEAN: 95 -> 72.5 (WORN) at bar 3, -> 50 (DAMAGED) at
    ;; bar 9. The crackle and dip at once; the music's damage 0.35 s later
    ;; (the sink depth), and the lead's dropouts from the next bar line.
    (define (render-wall-hits dir)
      (let* ((p (open-damage-player 16))
             (h1 (+ (at-16th 2 5) 0.04)) (h2 (+ (at-16th 8 11) 0.02))
             (sched (append
                     (list (cons 0 (lambda () (set-all p (params-for 95.0 #f))))
                           (cons (frame (+ h1 0.35)) (lambda () (set-all p (params-for 72.5 #f))))
                           (cons (frame (+ h2 0.35)) (lambda () (set-all p (params-for 50.0 #f)))))
                     (lead-gate-events p 'damaged 9 16)))
             (r (render-player p SR sched (frame (+ (* 16 BAR-S) 6.0)))))
        (wall-hit! (car r) (cdr r) h1 0.3)
        (wall-hit! (car r) (cdr r) h2 0.3)
        (finish! "wall-hits" p r dir)))

    ;; A boost while DAMAGED: 40 -> 28 (FAILING), at bar 5. The whoosh at
    ;; once; the overdrive (crush drive up, drums 3 bits down) from 0.35 s in
    ;; for the boost's 1.3 s; FAILING's damage from the boost's start + 0.35 s,
    ;; its dropouts from the next bar line.
    (define (render-boost dir)
      (let* ((p (open-damage-player 16))
             (t (+ (at-16th 4 0) 0.11))
             (b-after (+ 1 (exact (floor (/ (+ t 0.35) BAR-S)))))
             (sched (append
                     (list (cons 0 (lambda () (set-all p (params-for 40.0 #f))))
                           (cons (frame (+ t 0.35)) (lambda () (set-all p (params-for 28.0 #t))))
                           (cons (frame (+ t 1.65)) (lambda () (set-all p (params-for 28.0 #f)))))
                     (lead-gate-events p 'damaged 0 (- b-after 1))
                     (lead-gate-events p 'failing b-after 16)))
             (r (render-player p SR sched (frame (+ (* 16 BAR-S) 6.0)))))
        (whoosh! (car r) (cdr r) t 0.22)
        (finish! "boost" p r dir)))

    ;; Repair from DAMAGED: integrity 40, the checksum lane from bar 5 for
    ;; 1.8 s at 24 a second (to 83.2). The subtle parameters ease every 20 ms
    ;; with the music's 0.35 s latency; each tier edge's events stop on the
    ;; first beat at least 0.35 s after the crossing, with the lock there.
    (define (render-repair dir)
      (let* ((p (open-damage-player 16))
             (t0 (at-16th 4 0)) (rate 24.0) (dur 1.8) (i0 40.0)
             (integ (lambda (t) (if (< t t0) i0 (+ i0 (* rate (min dur (- t t0)))))))
             (cross (lambda (edge) (+ t0 (/ (- edge i0) rate))))
             (next-beat (lambda (t) (* BEAT-S (exact (ceiling (/ (+ t 0.35) BEAT-S))))))
             (snap55 (next-beat (cross 55.0)))
             (snap80 (next-beat (cross 80.0)))
             ;; what the music plays at time t: integrity 0.35 s ago, held
             ;; below an edge until that edge's snap
             (music-integ (lambda (t)
                            (let ((i (integ (- t 0.35))))
                              (cond ((and (>= i 80.0) (< t snap80)) 79.9)
                                    ((and (>= i 55.0) (< t snap55)) 54.9)
                                    (else i)))))
             (eases (let loop ((t (+ t0 0.35)) (acc '()))
                      (if (> t (+ t0 dur 0.4)) (reverse acc)
                          (loop (+ t 0.02)
                                (let ((i (music-integ t)))
                                  (cons (cons (frame t) (lambda () (set-all p (params-for i #f)))) acc))))))
             (bar-of (lambda (t) (exact (floor (/ t BAR-S)))))
             (sched (append
                     (list (cons 0 (lambda () (set-all p (params-for i0 #f))))
                           ;; the 55 snap also reopens the lead, in case it lands in a dropout
                           (cons (frame snap55) (lambda () (set-all p (params-for 55.0 #f))
                                                  (player-set-insert-param! p 6 'gain 1.0)))
                           (cons (frame snap80) (lambda () (set-all p (params-for 83.2 #f)))))
                     eases
                     (filter (lambda (e) (< (car e) (frame snap55)))
                             (lead-gate-events p 'damaged 0 (+ 1 (bar-of snap55))))))
             (r (render-player p SR sched (frame (+ (* 16 BAR-S) 6.0)))))
        (lock! (car r) (cdr r) snap55 0.12)
        (lock! (car r) (cdr r) snap80 0.16)
        (say "  repair: lane " (fx t0 2) " s to " (fx (+ t0 dur) 2) " s; 55 crossed at " (fx (cross 55.0) 2)
             " s, snapped on the beat at " (fx snap55 2) " s; 80 crossed at " (fx (cross 80.0) 2)
             " s, snapped at " (fx snap80 2) " s")
        (finish! "repair" p r dir)))

    ;; Each tier's stems, soloed, against CLEAN's: the RMS change per channel
    ;; over 8 bars. Confirms the audition's sets reach the channels they name
    ;; (the probe has already measured what each parameter does).
    (define (check-damage-wiring)
      (say "each channel soloed over the 16 bars, against its CLEAN render (sample-aligned: renders are deterministic)")
      (say "  level = RMS change in dB; diff = RMS of (tier - CLEAN) in dB relative to CLEAN's RMS; out = silent")
      (let* ((n (frame (* 16 BAR-S)))
             (solo (lambda (integrity ch)
                     (let* ((p (open-damage-player 16))
                            (_ (player-solo! p ch))
                            (sched (cons (cons 0 (lambda () (set-all p (params-for integrity #f))))
                                         (lead-gate-events p (tier-of integrity) 0 16)))
                            (r (render-player p SR sched n)))
                       (player-close! p)
                       (bv->mid (car r) (cdr r)))))
             (dbr (lambda (a b) (* 20 (/ (log (/ (max a 1e-12) b)) (log 10.0)))))
             (clean (map (lambda (ch) (solo 90.0 ch)) '(1 2 3 4 5 6 7))))
        (say "  tier      " (apply string-append (map (lambda (ch) (string-append "   ch" (number->string ch) " level/diff")) '(1 2 3 4 5 6 7))))
        (for-each
         (lambda (e)
           (let ((cells (map (lambda (ch c)
                               (let* ((x (solo (cadr e) ch)) (len (min (vector-length x) (vector-length c)))
                                      (rc (rms c 0 len)) (rx (rms x 0 len))
                                      (d (let ((v (make-vector len 0.0)))
                                           (let loop ((k 0)) (when (< k len) (vector-set! v k (- (vector-ref x k) (vector-ref c k))) (loop (+ k 1))))
                                           (rms v 0 len))))
                                 (if (< rx 1e-7) "          out"
                                     (let ((s (string-append (fx (dbr rx rc) 1) "/" (fx (dbr d rc) 1))))
                                       (string-append (make-string (max 1 (- 13 (string-length s))) #\space) s)))))
                             '(1 2 3 4 5 6 7) clean)))
             (say "  " (car e) (apply string-append (map (lambda (s) (string-append "  " s)) cells)))))
         '(("worn    " 67.0) ("damaged " 42.0) ("failing " 20.0) ("critical" 5.0)))
        0))

    ;; CLEAN through the inserts against the same bars with no inserts, the
    ;; whole mix or one channel soloed (solo: ch)
    (define (check-clean-transparency . solo)
      (let* ((n (frame (* 16 BAR-S)))
             (ch (and (pair? solo) (car solo)))
             (a (let* ((p (open-tune-player (damage-tune 16) SR)) (_ (player-solo! p ch)) (r (render-player p SR '() n)))
                  (player-close! p) (bv->mid (car r) (cdr r))))
             (b (let* ((p (open-damage-player 16)) (_ (player-solo! p ch))
                       (r (render-player p SR (list (cons 0 (lambda () (set-all p (params-for 90.0 #f))))) n)))
                  (player-close! p) (bv->mid (car r) (cdr r))))
             (len (min (vector-length a) (vector-length b)))
             (d (let ((v (make-vector len 0.0)))
                  (let loop ((k 0)) (when (< k len) (vector-set! v k (- (vector-ref b k) (vector-ref a k))) (loop (+ k 1))))
                  v))
             (ra (rms a 0 len)))
        (say "CLEAN through the inserts vs no inserts, 16 bars, " (if ch (string-append "ch" (number->string ch) " solo") "the mix") ": level "
             (fx (* 20 (/ (log (/ (rms b 0 len) ra)) (log 10.0))) 2) " dB, difference "
             (fx (* 20 (/ (log (/ (max 1e-12 (rms d 0 len)) ra)) (log 10.0))) 1) " dB re the mix")
        0))

    (define (render-damage-audition dir)
      (say "damage audition: 16 bars (lap 1 bars 9-16, lap 2), through (carrier inserts) at " (number->string SR) " Hz")
      (for-each (lambda (e) (render-tier (car e) (cadr e) dir))
                '(("clean" 90.0) ("worn" 67.0) ("damaged" 42.0) ("failing" 20.0) ("critical" 5.0)))
      (render-tour dir)
      (render-wall-hits dir)
      (render-boost dir)
      (render-repair dir)
      0)))
