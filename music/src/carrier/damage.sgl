;;; (carrier damage) - The damage audition (§3.7 deliverable 3, §3.1's table)
;;;
;;; The same 16 bars of Carrier (lap 1's loop, bars 9-16, into lap 2)
;;; rendered through (carrier inserts) on motif's live player, with every
;;; damage parameter set by player-set-insert-param! on the exact frame:
;;; the path 0.1 step 2 will drive.
;;;
;;; Integrity maps to parameters in §3.1's shape: subtle ones (cutoffs, the
;;; lead's detune depth) move continuously with integrity inside a tier;
;;; distinctive ones (bit depth, rate, dropouts, stems leaving) switch at
;;; tier edges. FAILING has dropouts only (no stutter node yet, §9).
;;; Dropouts ramp over 3 ms: an instant cut rings through motif's master
;;; DC blocker and high-pass for about 50 ms (measured by the probe).
;;;
;;; Round 2 (David, 2026-10-13: the tiers "don't sound damaged enough"):
;;; every tier is pushed well past §3.1's numbers (see params-for), the
;;; lead is crushed and dulled as well as detuned, its dropouts move
;;; around the bar, and two output-time layers join from DAMAGED down:
;;; signal static (hiss and crackle) and, from FAILING, whole-signal
;;; cutouts. Both are the immediate path (§3.2), as stream volume and a
;;; looping cue are in the game.
;;;
;;; The immediate path's cues come from (carrier sfx): stand-ins for the
;;; game's boot-rendered bank, mixed at output time.

(define-library (carrier damage)
  (import (sigil core) (sigil math) (sigil list) (sigil string)
          (motif tune) (motif tune player)
          (carrier score) (carrier inserts) (carrier render) (carrier analysis) (carrier sfx))
  (export render-damage-audition tier-of check-damage-wiring check-clean-transparency check-sfx)
  (begin
    (define SR 48000)
    (define (say . xs) (for-each display xs) (newline))
    (define (fx x d) (let ((k (expt 10.0 d))) (number->string (/ (round (* x k)) k))))

    ;; the clock: 140 BPM, speed 3, 32 rows a bar
    (define ROW-S (/ (* 3 2.5) 140.0))
    (define BAR-S (* 32 ROW-S))
    (define BEAT-S (* 8 ROW-S))
    (define (frame s) (exact (round (* s SR))))
    (define (at-16th bar s16) (* ROW-S (+ (* 32 bar) (* 2 s16))))
    (define OPEN (* 0.45 SR))

    ;; the 16 bars, looped for longer renders: patterns 8..23 of the audition
    (define (damage-tune nbars)
      (let ((t (audition-tune)))
        (tune-with-order t (let loop ((i 0) (acc '()))
                             (if (>= i nbars) (reverse acc)
                                 (loop (+ i 1) (cons (+ 8 (modulo i 16)) acc)))))))

    ;; ------------------------------------------------------------
    ;; Integrity -> parameters
    ;; ------------------------------------------------------------
    (define (tier-of i)
      (cond ((>= i 80) 'clean) ((>= i 55) 'worn) ((>= i 30) 'damaged)
            ((>= i 10) 'failing) ((> i 0) 'critical) (else 'corrupt)))

    ;; linear from (i0, v0) to (i1, v1), clamped
    (define (lerp i i0 v0 i1 v1)
      (let ((k (max 0.0 (min 1.0 (/ (- i i0) (- i1 i0))))))
        (+ v0 (* k (- v1 v0)))))
    (define (log-lerp i i0 v0 i1 v1)
      (exp (lerp i i0 (log v0) i1 (log v1))))

    ;; -> list of (ch name value): every damage param on every channel EXCEPT
    ;; the lead's gate (ch 6 gain), which lead-gate-events owns. A caller that
    ;; moves the lead out of a gated tier between gate events (healing from
    ;; CRITICAL mid-bar, say) must reopen the gate itself, as render-repair does.
    (define (params-for i boost?)
      (let* ((tier (tier-of i))
             (rank (cdr (assq tier '((clean . 0) (worn . 1) (damaged . 2) (failing . 3) (critical . 4) (corrupt . 4)))))
             ;;                       CLEAN  WORN   DAMAGED FAILING CRITICAL
             (drum-bits (list-ref '(16.0   10.0   7.0     5.0     4.0) rank))
             (drum-rate (list-ref '(1.0    1.0    3.0     6.0     8.0) rank))
             (drum-bits (if boost? (max 3.0 (- drum-bits 3.0)) drum-bits))
             (drive (if boost? 1.6 0.0))
             ;; the bass is protected: low-pass only, and later than the rest
             (bass-cut (list-ref (list OPEN OPEN 1500.0 700.0 400.0) rank))
             (pad-cut (case tier
                        ((clean) OPEN)
                        ((worn) (log-lerp i 80.0 8000.0 55.0 5000.0))
                        ((damaged) 2000.0)
                        (else 1200.0)))
             (pad-chorus (if (>= rank 2) 0.7 0.0))
             (pad-gain (list-ref '(1.0 1.0 1.0 0.35 0.0) rank))
             ;; detune depth in ms at 0.5 Hz: 4 x depth x rate is the shift,
             ;; so 2 ms is about +-7 cents, 5 ms +-17, 8 ms +-28
             (lead-depth (case tier
                           ((clean) 0.0)
                           ((worn) (lerp i 80.0 1.5 55.0 2.5))
                           ((damaged) (lerp i 55.0 4.0 30.0 6.0))
                           ((failing) (lerp i 30.0 8.0 10.0 10.0))
                           (else 10.0)))
             (lead-mix (if (= rank 0) 0.0 1.0))
             (lead-bits (list-ref '(16.0 16.0 9.0 6.0 4.0) rank))
             (lead-rate (list-ref '(1.0 1.0 1.0 2.0 3.0) rank))
             (lead-cut (list-ref (list OPEN 7000.0 4000.0 2500.0 2000.0) rank))
             (arp-bits (list-ref '(16.0 12.0 6.0 6.0 6.0) rank))
             (arp-rate (if (>= rank 2) 2.0 1.0))
             (arp-gain (if (>= rank 3) 0.0 1.0))
             (snare-gain (if (= rank 4) 0.0 1.0)))
        (append
         (map (lambda (ch) (list ch 'bits drum-bits)) '(1 2 3))
         (map (lambda (ch) (list ch 'rate-div drum-rate)) '(1 2 3))
         (map (lambda (ch) (list ch 'drive drive)) '(1 2 3))
         (list (list 2 'gain snare-gain) (list 3 'gain snare-gain)
               (list 4 (quote cutoff) bass-cut)
               (list 5 'cutoff pad-cut) (list 5 'depth (* 5.0 pad-chorus)) (list 5 'mix pad-chorus)
               (list 5 'gain pad-gain)
               (list 6 'rate 0.5) (list 6 'depth lead-depth) (list 6 'mix lead-mix)
               (list 6 'makeup (if (> lead-mix 0.0) 1.38 1.0))
               (list 6 'bits lead-bits) (list 6 'rate-div lead-rate) (list 6 'cutoff lead-cut)
               (list 6 'drive (if boost? 0.9 0.0))
               (list 7 'bits arp-bits) (list 7 'rate-div arp-rate)
               (list 7 'drive (if boost? 1.0 0.0)) (list 7 'gain arp-gain)))))

    ;; the lead's gate for a tier in bar b: list of (from16 to16) that are
    ;; SILENT. The holes move around a four-bar cycle, so they read as a
    ;; failing signal and not as a rhythm.
    (define DAMAGED-HOLES '(((5 6) (10 11) (13 14)) ((2 3) (8 9) (14 15))
                            ((6 7) (10 11) (12 13)) ((3 4) (9 10) (15 16))))
    (define FAILING-HOLES '(((2 4) (6 9) (12 15)) ((0 2) (5 8) (10 11) (13 16))
                            ((3 6) (8 10) (12 16)) ((1 3) (6 7) (9 12) (14 16))))
    (define (lead-silences tier b)
      (case tier
        ((damaged) (list-ref DAMAGED-HOLES (modulo b 4)))  ; three 16ths a bar
        ((failing) (list-ref FAILING-HOLES (modulo b 4)))  ; about half the bar
        ((critical) '((3 16)))                             ; one note per bar
        (else '())))

    ;; whole-signal cutouts (the stream's volume, output time): (from16 to16)
    ;; per bar, cycling; FAILING two a bar, CRITICAL three
    (define FAILING-CUTS '(((7 8) (13 14)) ((3 4) (11 12)) ((9 10) (15 16)) ((1 2) (6 7))))
    (define CRITICAL-CUTS '(((2 3) (7 8) (12 14)) ((5 6) (9 10) (14 15)) ((1 2) (8 9) (11 13)) ((4 5) (10 11) (15 16))))

    ;; The output-time damage layers over bars [b0, b1) at integrity i:
    ;; static from DAMAGED down, cutouts from FAILING down.
    (define (post-damage! bv frames b0 b1 i)
      (let ((tier (tier-of i)) (t0 (at-16th b0 0)) (len (* BAR-S (- b1 b0))))
        (case tier
          ((damaged) (static! bv frames t0 len 7.0 0.02 0.22))
          ((failing) (static! bv frames t0 len 20.0 0.06 0.3))
          ((critical) (static! bv frames t0 len 32.0 0.1 0.34))
          (else #f))
        (let ((cuts (case tier ((failing) FAILING-CUTS) ((critical) CRITICAL-CUTS) (else #f))))
          (when cuts
            (let loop ((b b0))
              (when (< b b1)
                (for-each (lambda (c)
                            (dip! bv frames (at-16th b (car c))
                                  (* 1000.0 (- (at-16th b (cadr c)) (at-16th b (car c)))) 0.06))
                          (list-ref cuts (modulo b 4)))
                (loop (+ b 1))))))))

    ;; ------------------------------------------------------------
    ;; Schedules: (frame . thunk)
    ;; ------------------------------------------------------------
    (define (set-all p sets)
      (for-each (lambda (s)
                  (unless (player-set-insert-param! p (car s) (cadr s) (caddr s))
                    (error "damage: set refused" s)))
                sets))

    ;; A change of state at time t, from one params-for list to another:
    ;; everything is set at t except the low-pass cutoffs, which move in 8
    ;; log steps 3 ms apart (24 ms). A cutoff jumped in one sample (1500 Hz
    ;; to fully open, the repair's snap) made a two-sample spike to +11 dBFS
    ;; through the Butterworth pair; measured 2026-10-13.
    (define (lookup sets ch name)
      (let loop ((ss sets))
        (cond ((null? ss) #f)
              ((and (= (car (car ss)) ch) (eq? (cadr (car ss)) name)) (caddr (car ss)))
              (else (loop (cdr ss))))))

    (define (transition p t from-sets to-sets . extra)
      (let* ((f0 (frame t))
             (cutoff? (lambda (s) (eq? (cadr s) 'cutoff)))
             (plain (filter (lambda (s) (not (cutoff? s))) to-sets)))
        (cons (cons f0 (lambda () (set-all p plain) (for-each (lambda (x) (x)) extra)))
              (apply append
                     (map (lambda (s)
                            (let ((old (lookup from-sets (car s) 'cutoff)) (new (caddr s)))
                              (if (or (not old) (= old new))
                                  '()
                                  (map (lambda (k)
                                         (let ((v (* old (expt (/ new old) (/ k 8.0)))))
                                           (cons (+ f0 (* k 144))
                                                 (lambda () (player-set-insert-param! p (car s) 'cutoff v)))))
                                       '(1 2 3 4 5 6 7 8)))))
                          (filter cutoff? to-sets))))))

    ;; a gain ramp from a to b: 6 steps 0.5 ms apart, reaching b 3 ms after s.
    ;; Sub-pull timing: the audition splits pulls at each step. The game pulls
    ;; whole blocks and motif applies sets and ramps only between pulls, so at
    ;; 512-frame pulls these become one step (and click); see the task note.
    (define (gain-ramp p ch s a b)
      (map (lambda (k)
             (let ((v (+ a (* (- b a) (/ k 6.0)))))
               (cons (+ (frame s) (* k 24)) (lambda () (player-set-insert-param! p ch 'gain v)))))
           (quote (1 2 3 4 5 6))))

    ;; lead silences for bars [b0, b1) at tier; each silence ramps down 3 ms
    ;; before its 16th and back up 3 ms before its end
    (define (lead-gate-events p tier b0 b1)
      (let loop ((b b0) (acc '()))
        (if (>= b b1) acc
            (loop (+ b 1)
                  (append acc
                          (apply append
                                 (map (lambda (sil)
                                        (append (gain-ramp p 6 (- (at-16th b (car sil)) 0.003) 1.0 0.0)
                                                (if (< (cadr sil) 16)
                                                    (gain-ramp p 6 (- (at-16th b (cadr sil)) 0.003) 0.0 1.0)
                                                    (gain-ramp p 6 (- (at-16th (+ b 1) 0) 0.003) 0.0 1.0))))
                                      (lead-silences tier b))))))))

    ;; ------------------------------------------------------------
    ;; Renders
    ;; ------------------------------------------------------------
    (define (open-damage-player nbars)
      (open-tune-player (damage-tune nbars) SR inserts: (carrier-inserts)))

    (define (finish! name p r dir)
      (player-close! p)
      (let* ((bv (car r)) (frames (cdr r)) (mid (bv->mid bv frames))
             ;; samples at or over full scale, either channel: the WAV clips them
             (over (let loop ((i 0) (n 0))
                     (if (>= i (* 2 frames)) n
                         (loop (+ i 1) (if (>= (abs (bytevector-ieee-single-ref bv (* 4 i) 'little)) 1.0) (+ n 1) n))))))
        (write-wav16 (string-append dir "/" name ".wav") bv frames SR 1.0)
        (say "  " name ": " (fx (/ frames (* 1.0 SR)) 2) " s, mid peak "
             (fx (* 20 (/ (log (max 1e-9 (peak mid 0 frames))) (log 10.0))) 1) " dBFS, RMS "
             (fx (* 20 (/ (log (max 1e-9 (rms mid 0 frames))) (log 10.0))) 1) " dBFS, samples at full scale: "
             (number->string over))))

    ;; one tier, 16 bars, at a fixed integrity
    (define (render-tier name integrity dir)
      (let* ((p (open-damage-player 16))
             (tier (tier-of integrity))
             (sched (cons (cons 0 (lambda () (set-all p (params-for integrity #f))))
                          (lead-gate-events p tier 0 16)))
             (r (render-player p SR sched (frame (+ (* 16 BAR-S) 6.0)))))
        (post-damage! (car r) (cdr r) 0 16 integrity)
        (finish! name p r dir)))

    ;; the tour: 4 bars at each tier, CLEAN to CRITICAL, sets on bar lines
    (define (render-tour dir)
      (let* ((p (open-damage-player 20))
             (levels '(90.0 67.0 42.0 20.0 5.0))
             (sched (apply append
                           (map (lambda (k)
                                  (let ((i (list-ref levels k)) (b (* 4 k)))
                                    (append (if (= k 0)
                                                (list (cons 0 (lambda () (set-all p (params-for i #f)))))
                                                (transition p (at-16th b 0)
                                                            (params-for (list-ref levels (- k 1)) #f)
                                                            (params-for i #f)))
                                            (lead-gate-events p (tier-of i) b (+ b 4)))))
                                '(0 1 2 3 4))))
             (r (render-player p SR sched (frame (+ (* 20 BAR-S) 6.0)))))
        (for-each (lambda (k) (post-damage! (car r) (cdr r) (* 4 k) (+ 4 (* 4 k)) (list-ref levels k)))
                  '(0 1 2 3 4))
        (finish! "tour" p r dir)))

    ;; Wall contact from CLEAN. At 0:04 a scrape along the wall for 0.9 s
    ;; (95 -> 72, WORN): a sustained grind for as long as the contact. At
    ;; 0:15 a hard hit (72 -> 47, DAMAGED): a thump, a short scrape, and the
    ;; stream dipping to 40% for 40 ms. Each is heard at once; the music's
    ;; damage follows 0.35 s later (the sink depth), the lead's dropouts and
    ;; the static from the next bar line.
    (define (render-wall-hits dir)
      (let* ((p (open-damage-player 16))
             (s1 (+ (at-16th 2 5) 0.04)) (s1-dur 0.9)
             (h2 (+ (at-16th 8 11) 0.02))
             (sched (append
                     (list (cons 0 (lambda () (set-all p (params-for 95.0 #f)))))
                     (transition p (+ s1 0.35) (params-for 95.0 #f) (params-for 84.0 #f))
                     (transition p (+ s1 s1-dur 0.35) (params-for 84.0 #f) (params-for 72.0 #f))
                     (transition p (+ h2 0.35) (params-for 72.0 #f) (params-for 47.0 #f))
                     (lead-gate-events p 'damaged 9 16)))
             (r (render-player p SR sched (frame (+ (* 16 BAR-S) 6.0)))))
        (post-damage! (car r) (cdr r) 9 16 47.0)
        (scrape! (car r) (cdr r) s1 s1-dur 0.32)
        (dip! (car r) (cdr r) h2 40.0 0.4)
        (thump! (car r) (cdr r) h2 0.38)
        (scrape! (car r) (cdr r) (+ h2 0.01) 0.18 0.3)
        (finish! "wall-hits" p r dir)))

    ;; A boost while DAMAGED: 40 -> 28 (FAILING), at bar 5. The whoosh at
    ;; once; the overdrive (crush drive up, drums 3 bits down) from 0.35 s in
    ;; for the boost's 1.3 s; FAILING's damage from the boost's start + 0.35 s,
    ;; its dropouts from the next bar line.
    (define (render-boost dir)
      (let* ((p (open-damage-player 16))
             (t (+ (at-16th 4 0) 0.11))
             (b-after (+ 1 (exact (floor (/ (+ t 0.35) BAR-S)))))
             (sched (append
                     (list (cons 0 (lambda () (set-all p (params-for 40.0 #f)))))
                     (transition p (+ t 0.35) (params-for 40.0 #f) (params-for 28.0 #t))
                     (transition p (+ t 1.65) (params-for 28.0 #t) (params-for 28.0 #f))
                     (lead-gate-events p 'damaged 0 (- b-after 1))
                     (lead-gate-events p 'failing b-after 16)))
             (r (render-player p SR sched (frame (+ (* 16 BAR-S) 6.0)))))
        (post-damage! (car r) (cdr r) 0 b-after 40.0)
        (post-damage! (car r) (cdr r) b-after 16 28.0)
        (whoosh! (car r) (cdr r) t 1.3 0.3)
        (finish! "boost" p r dir)))

    ;; Repair from DAMAGED: integrity 40, the checksum lane from bar 5 for
    ;; 1.8 s at 24 a second (to 83.2). The subtle parameters ease every 20 ms
    ;; with the music's 0.35 s latency; each tier edge's events stop on the
    ;; first beat at least 0.35 s after the crossing, with the lock there.
    (define (render-repair dir)
      (let* ((p (open-damage-player 16))
             (t0 (at-16th 4 0)) (rate 24.0) (dur 1.8) (i0 40.0)
             (integ (lambda (t) (if (< t t0) i0 (+ i0 (* rate (min dur (- t t0)))))))
             (cross (lambda (edge) (+ t0 (/ (- edge i0) rate))))
             (next-beat (lambda (t) (* BEAT-S (exact (ceiling (/ (+ t 0.35) BEAT-S))))))
             (snap55 (next-beat (cross 55.0)))
             (snap80 (next-beat (cross 80.0)))
             ;; what the music plays at time t: integrity 0.35 s ago, held
             ;; below an edge until that edge's snap
             (music-integ (lambda (t)
                            (let ((i (integ (- t 0.35))))
                              (cond ((and (>= i 80.0) (< t snap80)) 79.9)
                                    ((and (>= i 55.0) (< t snap55)) 54.9)
                                    (else i)))))
             ;; eases every 20 ms, except within 30 ms after a snap, where the
             ;; snap's own cutoff steps are still moving
             (near-snap? (lambda (t) (or (and (>= t snap55) (< t (+ snap55 0.03)))
                                         (and (>= t snap80) (< t (+ snap80 0.03))))))
             (eases (let loop ((t (+ t0 0.35)) (acc '()))
                      (if (> t (+ t0 dur 0.4)) (reverse acc)
                          (loop (+ t 0.02)
                                (let ((i (music-integ t)))
                                  (if (near-snap? t)
                                      acc
                                      (cons (cons (frame t) (lambda () (set-all p (params-for i #f)))) acc)))))))
             (bar-of (lambda (t) (exact (floor (/ t BAR-S)))))
             (sched (append
                     (list (cons 0 (lambda () (set-all p (params-for i0 #f)))))
                     ;; the 55 snap also reopens the lead, in case it lands in a dropout
                     (transition p snap55 (params-for 54.9 #f) (params-for 55.0 #f)
                                 (lambda () (player-set-insert-param! p 6 'gain 1.0)))
                     (transition p snap80 (params-for 79.9 #f) (params-for 83.2 #f))
                     eases
                     (filter (lambda (e) (< (car e) (frame snap55)))
                             (lead-gate-events p 'damaged 0 (+ 1 (bar-of snap55))))))
             (r (render-player p SR sched (frame (+ (* 16 BAR-S) 6.0)))))
        ;; DAMAGED's static stops with its dropouts, on the snap
        (static! (car r) (cdr r) 0.0 snap55 7.0 0.02 0.22)
        (lock! (car r) (cdr r) snap55 0.12)
        (lock! (car r) (cdr r) snap80 0.16)
        (say "  repair: lane " (fx t0 2) " s to " (fx (+ t0 dur) 2) " s; 55 crossed at " (fx (cross 55.0) 2)
             " s, snapped on the beat at " (fx snap55 2) " s; 80 crossed at " (fx (cross 80.0) 2)
             " s, snapped at " (fx snap80 2) " s")
        (finish! "repair" p r dir)))

    ;; Each tier's stems, soloed, against CLEAN's: the RMS change per channel
    ;; over 8 bars. Confirms the audition's sets reach the channels they name
    ;; (the probe has already measured what each parameter does).
    (define (check-damage-wiring)
      (say "each channel soloed over the 16 bars, against its CLEAN render (sample-aligned: renders are deterministic)")
      (say "  level = RMS change in dB; diff = RMS of (tier - CLEAN) in dB relative to CLEAN's RMS; out = silent")
      (let* ((n (frame (* 16 BAR-S)))
             (solo (lambda (integrity ch)
                     (let* ((p (open-damage-player 16))
                            (_ (player-solo! p ch))
                            (sched (cons (cons 0 (lambda () (set-all p (params-for integrity #f))))
                                         (lead-gate-events p (tier-of integrity) 0 16)))
                            (r (render-player p SR sched n)))
                       (player-close! p)
                       (bv->mid (car r) (cdr r)))))
             (dbr (lambda (a b) (* 20 (/ (log (/ (max a 1e-12) b)) (log 10.0)))))
             (clean (map (lambda (ch) (solo 90.0 ch)) '(1 2 3 4 5 6 7))))
        (say "  tier      " (apply string-append (map (lambda (ch) (string-append "   ch" (number->string ch) " level/diff")) '(1 2 3 4 5 6 7))))
        (for-each
         (lambda (e)
           (let ((cells (map (lambda (ch c)
                               (let* ((x (solo (cadr e) ch)) (len (min (vector-length x) (vector-length c)))
                                      (rc (rms c 0 len)) (rx (rms x 0 len))
                                      (d (let ((v (make-vector len 0.0)))
                                           (let loop ((k 0)) (when (< k len) (vector-set! v k (- (vector-ref x k) (vector-ref c k))) (loop (+ k 1))))
                                           (rms v 0 len))))
                                 (if (< rx 1e-7) "          out"
                                     (let ((s (string-append (fx (dbr rx rc) 1) "/" (fx (dbr d rc) 1))))
                                       (string-append (make-string (max 1 (- 13 (string-length s))) #\space) s)))))
                             '(1 2 3 4 5 6 7) clean)))
             (say "  " (car e) (apply string-append (map (lambda (s) (string-append "  " s)) cells)))))
         '(("worn    " 67.0) ("damaged " 42.0) ("failing " 20.0) ("critical" 5.0)))
        0))

    ;; CLEAN through the inserts against the same bars with no inserts, the
    ;; whole mix or one channel soloed (solo: ch)
    (define (check-clean-transparency . solo)
      (let* ((n (frame (* 16 BAR-S)))
             (ch (and (pair? solo) (car solo)))
             (a (let* ((p (open-tune-player (damage-tune 16) SR)) (_ (player-solo! p ch)) (r (render-player p SR '() n)))
                  (player-close! p) (bv->mid (car r) (cdr r))))
             (b (let* ((p (open-damage-player 16)) (_ (player-solo! p ch))
                       (r (render-player p SR (list (cons 0 (lambda () (set-all p (params-for 90.0 #f))))) n)))
                  (player-close! p) (bv->mid (car r) (cdr r))))
             (len (min (vector-length a) (vector-length b)))
             (d (let ((v (make-vector len 0.0)))
                  (let loop ((k 0)) (when (< k len) (vector-set! v k (- (vector-ref b k) (vector-ref a k))) (loop (+ k 1))))
                  v))
             (ra (rms a 0 len)))
        (say "CLEAN through the inserts vs no inserts, 16 bars, " (if ch (string-append "ch" (number->string ch) " solo") "the mix") ": level "
             (fx (* 20 (/ (log (/ (rms b 0 len) ra)) (log 10.0))) 2) " dB, difference "
             (fx (* 20 (/ (log (/ (max 1e-12 (rms d 0 len)) ra)) (log 10.0))) 1) " dB re the mix")
        0))

    ;; The cues against David's complaint ("sounded like a single hi hat"):
    ;; each rendered alone, then how long it lasts (until its 10 ms RMS falls
    ;; 40 dB under its loudest 10 ms) and where its energy is (the share
    ;; under 200 Hz, through a one-pole low-pass, and over 4 kHz, through a
    ;; one-pole high-pass). A closed tick from the kit (channel 3 alone,
    ;; its first hit) is the comparison. A report, not a gate.
    (define (check-sfx)
      (let* ((n (frame 2.0))
             (blank (lambda () (make-bytevector (* 8 n) 0)))
             (measure
              (lambda (name bv)
                (let* ((x (bv->mid bv n)) (w (frame 0.01))
                       (rmses (let loop ((k 0) (acc '()))
                                (if (> (* (+ k 1) w) n) (reverse acc)
                                    (loop (+ k 1) (cons (rms x (* k w) w) acc)))))
                       (top (fold-left max 0.0 rmses))
                       (last-loud (let loop ((k 0) (rs rmses) (last 0))
                                    (if (null? rs) last
                                        (loop (+ k 1) (cdr rs) (if (> (car rs) (* top 0.01)) k last)))))
                       (a-lo (- 1.0 (exp (/ (* -2.0 3.141592653589793 200.0) SR))))
                       (a-hi (- 1.0 (exp (/ (* -2.0 3.141592653589793 4000.0) SR))))
                       (shares (let loop ((i 0) (lo 0.0) (hl 0.0) (all 0.0) (e-lo 0.0) (e-hi 0.0))
                                 (if (>= i n) (list (/ e-lo (max all 1e-30)) (/ e-hi (max all 1e-30)))
                                     (let* ((v (vector-ref x i))
                                            (lo2 (+ lo (* a-lo (- v lo))))
                                            (hl2 (+ hl (* a-hi (- v hl))))
                                            (hi (- v hl2)))
                                       (loop (+ i 1) lo2 hl2 (+ all (* v v)) (+ e-lo (* lo2 lo2)) (+ e-hi (* hi hi))))))))
                  (say "  " name ": lasts " (fx (* 10 (+ 1 last-loud)) 0) " ms; energy under 200 Hz "
                       (fx (* 100 (car shares)) 1) "%, over 4 kHz " (fx (* 100 (cadr shares)) 1) "%"))))
             (tick (let* ((p (open-damage-player 1))
                          (_ (player-solo! p 3))
                          (r (render-player p SR '() (frame 0.1))))
                     (player-close! p)
                     (let ((bv (blank)))
                       (let loop ((i 0)) (when (< i (* 2 (cdr r)))
                                           (bytevector-ieee-single-set! bv (* 4 i) (bytevector-ieee-single-ref (car r) (* 4 i) 'little) 'little)
                                           (loop (+ i 1))))
                       bv))))
        (say "cues alone, 2 s each (a report)")
        (measure "kit tick (ch 3, first hit)" tick)
        (let ((bv (blank))) (scrape! bv n 0.0 0.9 0.32) (measure "scrape, 0.9 s contact" bv))
        (let ((bv (blank))) (thump! bv n 0.0 0.38) (scrape! bv n 0.01 0.18 0.3) (measure "hard hit: thump + short scrape" bv))
        (let ((bv (blank))) (whoosh! bv n 0.0 1.3 0.3) (measure "boost whoosh" bv))
        0))

    (define (render-damage-audition dir)
      (say "damage audition: 16 bars (lap 1 bars 9-16, lap 2), through (carrier inserts) at " (number->string SR) " Hz")
      (for-each (lambda (e) (render-tier (car e) (cadr e) dir))
                '(("clean" 90.0) ("worn" 67.0) ("damaged" 42.0) ("failing" 20.0) ("critical" 5.0)))
      (render-tour dir)
      (render-wall-hits dir)
      (render-boost dir)
      (render-repair dir)
      0)))
