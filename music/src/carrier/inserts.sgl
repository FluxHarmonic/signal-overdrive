;;; (carrier inserts) - The per-stem damage inserts the game drives (P5, §3.1)
;;;
;;; One insert per channel, the graphs the damage audition renders through
;;; and the ones 0.1 step 2 wires to integrity. Every input that damage
;;; moves is a g:param, so `player-set-insert-param!` and `player-ramp!`
;;; reach it live. Built values are CLEAN: the chorus mix is 0 (dry is the
;;; input exactly), bits 16 and rate-div 1 (the crush leaves the signal
;;; alone), gain 1, and the low-pass at the top of its range (open to the
;;; ear; motif's Moog ladder is not bit-transparent there).
;;;
;;;   ch 1-3  drums  crush (drive bits rate-div) -> gain
;;;   ch 4    bass   low-pass (cutoff) -> gain                 protected
;;;   ch 5    pad    low-pass (cutoff) -> chorus (rate depth mix) -> gain
;;;   ch 6    lead   chorus (rate depth mix) -> crush (drive bits rate-div)
;;;                  -> low-pass (cutoff) -> gain
;;;   ch 7    arp    crush (drive bits rate-div) -> low-pass (cutoff) -> gain
;;;   ch 8    ICE    none: Gibson is the attacker
;;;
;;; Each builder takes an optional source: the probe passes a test signal
;;; in place of the channel's voices, so it measures these exact graphs.

(define-library (carrier inserts)
  (import (sigil core)
          (only (sigil dsp core) dsp-sample-rate)
          (motif graph))
  (export drum-insert bass-insert pad-insert lead-insert arp-insert
          carrier-inserts open-cutoff)
  (begin
    ;; the low-pass's top, as motif's lowpass-insert: 0.45 of the rate
    (define (open-cutoff) (* 0.45 (dsp-sample-rate)))

    (define (crush-stage x)
      (g:crush x
               (g:param 'drive 0.0 0.0 8.0)
               (g:param 'bits 16.0 1.0 16.0)
               (g:param 'rate-div 1.0 1.0 64.0)))

    (define (lowpass-stage x)
      (let ((hi (open-cutoff)))
        (g:moog x (g:param 'cutoff hi 20.0 hi) (g:param 'resonance 0.1 0.0 0.95))))

    (define (chorus-stage x)
      (g:chorus x
                (g:param 'rate 0.5 0.0 20.0)
                (g:param 'depth 0.0 0.0 20.0)
                (g:param 'mix 0.0 0.0 1.0)))

    (define (gain-stage x) (g:mul x (g:param 'gain 1.0 0.0 1.0)))

    ;; (drum-insert [source]) -> a builder; source, when given, is a
    ;; procedure of no arguments returning a node used instead of the input
    (define (source-or in source) (if source (source) in))

    (define (drum-insert . source)
      (lambda (in) (gain-stage (crush-stage (source-or in (and (pair? source) (car source)))))))

    (define (bass-insert . source)
      (lambda (in) (gain-stage (lowpass-stage (source-or in (and (pair? source) (car source)))))))

    (define (pad-insert . source)
      (lambda (in) (gain-stage (chorus-stage (lowpass-stage (source-or in (and (pair? source) (car source))))))))

    (define (lead-insert . source)
      (lambda (in) (gain-stage (lowpass-stage (crush-stage (chorus-stage (source-or in (and (pair? source) (car source)))))))))

    (define (arp-insert . source)
      (lambda (in) (gain-stage (lowpass-stage (crush-stage (source-or in (and (pair? source) (car source))))))))

    ;; the inserts: list for open-tune-player
    (define (carrier-inserts)
      (list (cons 1 (drum-insert)) (cons 2 (drum-insert)) (cons 3 (drum-insert))
            (cons 4 (bass-insert)) (cons 5 (pad-insert)) (cons 6 (lead-insert))
            (cons 7 (arp-insert))))))
