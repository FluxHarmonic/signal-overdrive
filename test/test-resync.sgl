;;; Real Motif pulls and native ring drain, with no playback device.
(import (sigil test)
        (sigil list)
        (sigil time)
        (sigil audio)
        (motif tune)
        (motif tune player)
        (signal music score)
        (signal music conductor)
        (signal music transport)
        (signal music playback)
        (signal music inserts)
        (signal music clock)
        (substratic store kv)
        (signal race)
        (signal shell music)
        (signal shell core))

(define RATE 44100)
(define tune (read-tune-string SCORE-TUNE-TEXT))
(define buffer (make-bytevector (* 8 256) 0))

(define (advance-to c tick)
  (if (>= (conductor-tick c) tick)
      c
      (advance-to (conductor-step c) tick)))

;; FRAMES of B's output for conductor C, pulled 256 at a time.
(define (pulled b c frames)
  (let ((out (make-bytevector (* 8 frames) 0)))
    (let loop ((off 0))
      (when (< off frames)
        (let ((n (min 256 (- frames off))))
          (playback-pull! b c out (* 8 off) n)
          (loop (+ off n)))))
    out))

(define (reach-next-bar b c)
  (let loop ()
    (let ((distance (playback-bar-distance b)))
      (unless (and distance (= distance 0) (> (playback-rendered b) 0))
        (playback-pull! b c buffer 0 (if (and distance (> distance 0)) (min distance 256) 256))
        (loop)))))

;; Spin until SECONDS of real time have passed since the jiffy FROM.
(define (wait-since from seconds)
  (when (< (- (current-jiffy) from) (* seconds (jiffies-per-second)))
    (wait-since from seconds)))

;; (counts "a" 1 "b" 2) is "a 1 b 2".
(define (counts . kv)
  (let loop ((kv kv) (out ""))
    (if (null? kv)
        out
        (loop (cddr kv)
              (string-append out (if (string=? out "") "" " ")
                             (car kv) " " (number->string (cadr kv)))))))

;; The shell's frame as core-advance! and service-audio! run it, against
;; a device that drains one 60 Hz frame first: the ear read at frame start
;; and paced against the simulation this interval produces, a request on
;; the pacing's flag, the simulation advanced by the paced dt, then the
;; music frame with the clock's remainder. The simulation starts LEAD
;; seconds into lap1 with the ear at its start: ahead of the ear, as after
;; a stalled first frame, or behind it when LEAD is negative. Returns
;; ("requests R resyncs S cancels C" last-gap), the counts as text so
;; a failure prints them.
(define (shell-frames lead frames)
  (let* ((c0 (conductor-new 'lap1))
         (out (make-bytevector (* 8 735) 0))
         (readout (lambda (i) (list-ref (music-readout) i)))
         (resyncs (readout 7))
         (cancels (readout 9)))
    (music-start! 'offline-test-context c0)
    (music-frame! c0 #f)
    (let loop ((frame 0) (s lead) (c (advance-to c0 (exact (floor (* lead 60.0)))))
               (p (pacing-new)) (requests 0))
      (if (= frame frames)
          (let ((result (list (counts "requests" requests
                                      "resyncs" (- (readout 7) resyncs)
                                      "cancels" (- (readout 9) cancels))
                              (pacing-gap p))))
            (music-close!)
            result)
          (begin
            (%audio-stream-drain-for-test out 735 2)
            (let* ((dt (/ 1.0 60.0))
                   (ear (music-audible-seconds))
                   (next (pace-frame p dt (+ s dt) ear #t #f (conductor-bar c)
                                     in-flight: (music-resync-in-flight?)))
                   (s (+ s (pacing-dt next)))
                   (c (advance-to c (exact (floor (* s 60.0))))))
              (when (pacing-resync? next) (music-request-resync!))
              (music-frame! c #f clock-fraction: (- s (/ (conductor-tick c) 60.0)))
              (loop (+ frame 1) s c next
                    (if (pacing-resync? next) (+ requests 1) requests))))))))

(test-group "resync: bar boundary and intended transport"
  (test "splitting a pull reaches the exact bar sample and restores the cue loop"
    (let* ((c (conductor-new 'lap1))
           (b (playback-open tune RATE c MUSIC-INSERTS)))
      (reach-next-bar b c)
      (assert-equal 75600 (playback-rendered b))
      (let* ((target (transport-render-target (advance-to c 90) 0.285))
             (frame (playback-resync! b target)))
        (assert-equal 77963 frame)
        (assert-equal 2363 (playback-origin-frame b))
        (assert-equal '(20 . 28) (player-region (playback-player b)))
        (assert-false (player-pending-mark (playback-player b)))
        (assert-equal (conductor-position target) (player-position (playback-player b) 0)))
      (playback-close! b))
    (assert-false (audio-initialized?)))

  (test "a pending mark blocks resync until it lands, then later plans still land exactly"
    (let* ((c (conductor-plan (conductor-new 'lap1) 'lap2 3))
           (b (playback-open tune RATE c MUSIC-INSERTS)))
      (let loop ()
        (when (<= (playback-walker-frame b) 151200)
          (playback-pull! b c buffer 0 256)
          (loop)))
      (playback-pull! b c buffer 0 256)
      (assert-false (playback-can-resync? b))
      (assert-error (playback-resync! b (advance-to c 200)))
      (reach-next-bar b c)
      (assert-equal 226800 (playback-rendered b))
      (assert-true (playback-can-resync? b))
      (let* ((target (advance-to c (song-bar->tick 3)))
             (planned (conductor-plan target 'hold 5)))
        (playback-resync! b target)
        (let loop ()
          (when (< (playback-walker-frame b) 378000)
            (playback-pull! b planned buffer 0 256)
            (loop)))
        (let ((land (find (lambda (entry)
                           (and (eq? 'landing (vector-ref entry 0))
                                (eq? 'hold (vector-ref entry 1))))
                         (playback-log b))))
          (assert-true land)
          (assert-equal 378000 (vector-ref land 3))))
      (assert-equal 0 (playback-missed b))
      (playback-close! b))
    (assert-false (audio-initialized?)))

  ;; The web builds the music's player on its start gate, where the song
  ;; is somewhere else than when the sound starts; the start moves it.
  ;; A jump does not replay the channel state of the rows it skips, so
  ;; the equality is the score's: bars across every section, half a
  ;; second each, from where the title has the song on the gate.
  (test "a playback built ahead and moved to the start renders as one opened there"
    (let ((gate (advance-to (conductor-new 'calm) 30))
          (differ '()))
      (for-each
        (lambda (section)
          (for-each
            (lambda (bar)
              (let* ((start (transport-start-conductor
                              (transport-start (advance-to (conductor-new section) (song-bar->tick bar))
                                               RATE)))
                     (opened (playback-open tune RATE start MUSIC-INSERTS))
                     (ahead (playback-seek-start! (playback-open tune RATE gate MUSIC-INSERTS) start)))
                (unless (and (= (playback-origin-frame opened) (playback-origin-frame ahead))
                             (equal? (pulled opened start 22050) (pulled ahead start 22050)))
                  (set! differ (cons (list section bar) differ)))
                (assert-false (find (lambda (e) (eq? 'resync (vector-ref e 0))) (playback-log ahead)))
                (assert-error (playback-seek-start! ahead start))
                (playback-close! opened)
                (playback-close! ahead)))
            '(0 2 5)))
        '(calm grid lap1 lap2 hold fill traced uplink results))
      (assert-equal "" (apply string-append
                              (map (lambda (d) (string-append (symbol->string (car d)) " bar "
                                                              (number->string (cadr d)) "; "))
                                   (reverse differ))))))

  (test "the music starts a prepared player with the same samples as a fresh one"
    (let ((c (advance-to (conductor-new 'lap1) 500))
          (out (make-bytevector (* 8 735) 0)))
      (define (heard)
        (music-start! 'offline-test-context c)
        (let loop ((n 0) (acc '()))
          (if (= n 120)
              (begin (music-close!) (apply bytevector-append (reverse acc)))
              (begin
                (%audio-stream-drain-for-test out 735 2)
                (let ((copy (bytevector-copy out)))
                  (music-frame! c #f)
                  (loop (+ n 1) (cons copy acc)))))))
      (let ((fresh (heard)))
        ;; the song sounds in it (the same silence twice would match too)
        (assert-true (let loop ((i 0))
                       (and (< i (bytevector-length fresh))
                            (or (not (= 0 (bytevector-u8-ref fresh i))) (loop (+ i 1))))))
        ;; only before a session's first stream: a new session
        (music-reset!)
        (music-prepare-playback! 'offline-test-context (conductor-new 'calm))
        (assert-true (music-prepared?))
        (let ((prepared (heard)))
          (assert-false (music-prepared?))
          (assert-equal fresh prepared)
          (assert-false (find (lambda (e) (eq? 'resync (vector-ref e 0))) (music-log))))
        ;; a later start builds its own
        (music-prepare-playback! 'offline-test-context (conductor-new 'calm))
        (assert-false (music-prepared?))))
    (assert-false (audio-initialized?)))

  (test "the sink changes its clock epoch only when the corrected sample reaches the ear"
    (let* ((initial (conductor-new 'lap1))
           (out (make-bytevector (* 8 735) 0))
           (before (list-ref (music-readout) 7)))
      (music-start! 'offline-test-context initial)
      (music-frame! initial #f)
      (music-request-resync!)
      (let loop ((frame 1) (c initial) (checked-before #f) (checked-after #f))
        (if (> frame 140)
            (begin
              (assert-true checked-before)
              (assert-true checked-after)
              (assert-equal (+ before 1) (list-ref (music-readout) 7)))
            (let* ((next (advance-to c (exact (floor (* frame 0.9)))))
                   (drained (* frame 735)))
              (%audio-stream-drain-for-test out 735 2)
              (music-frame! next #f)
              (let* ((seek (find (lambda (e) (eq? 'resync (vector-ref e 0))) (music-log)))
                     (heard (- drained (* RATE 0.035)))
                     (changed? (and seek (>= heard (vector-ref seek 4))))
                     (expected (+ (/ heard RATE)
                                  (if changed? (/ (- (vector-ref seek 3) (vector-ref seek 4)) RATE) 0.0))))
                (assert-true (< (abs (- expected (music-audible-seconds))) (/ 1.0 RATE)))
                (loop (+ frame 1) next
                      (or checked-before (and seek (not changed?)))
                      (or checked-after changed?))))))
      (music-close!))
    (assert-false (audio-initialized?))))

(test-group "resync: one correction per gap"
  ;; The ear 200 ms behind the simulation: the jump runs at the next bar
  ;; line with the simulation just short of it, so the simulation enters
  ;; the new bar while the jump is still in the ring and the gap still
  ;; reads -200 ms. Asking again then queued a second jump for the bar
  ;; after, made with the gap already at 0.
  (test "a resync still in the ring is not asked for again from its stale gap"
    (let ((r (shell-frames 0.2 480)))
      (assert-equal "requests 1 resyncs 1 cancels 0" (car r))
      (assert-true (< (abs (cadr r)) 0.005)))
    (assert-false (audio-initialized?)))

  ;; The ear 100 ms ahead: the request is made at +65 ms, and by the bar
  ;; line the 2% nudge has closed the gap to about +36 ms. The jump would
  ;; cut the held notes for nothing; it is cancelled.
  (test "a queued resync re-checks the gap when it would run and is cancelled within 60 ms"
    (let ((r (shell-frames -0.1 480)))
      (assert-equal "requests 1 resyncs 0 cancels 1" (car r))
      (assert-false (list-ref (music-readout) 8))
      (assert-true (< (abs (cadr r)) RESYNC-GAP)))
    (assert-false (audio-initialized?)))

  ;; The same 200 ms lead through the shell's own frame, where
  ;; core-advance! paces and asks and service-audio! runs the jump.
  (test "the shell's frame makes one resync for a 200 ms lead and cancels none"
    (set-store-root! "/tmp/signal-conductor-resync-test-store")
    (core-param! "mute")
    ;; the race song plays on the title only with the title off (the theme
    ;; plays it otherwise): these streams are the race song's
    (core-param! "title=0")
    (core-boot! 'desktop)
    (music-start! 'offline-test-context (race-song (core-race)))
    ;; the new stream resets the clock, and the next interval is skipped
    (core-headless-frame! (/ 1.0 60.0))
    (core-headless-frame! (/ 1.0 60.0))
    (assert-equal 0 (conductor-tick (race-song (core-race))))
    ;; no interval reaches back before the opening: the stall below must
    ;; happen in real time, the ring playing nothing of it
    (wait-since (music-opened-jiffy) 0.25)
    (let ((out (make-bytevector (* 8 735) 0))
          (resyncs (list-ref (music-readout) 7))
          (cancels (list-ref (music-readout) 9)))
      ;; one long frame the ring plays nothing of: the simulation is
      ;; about 200 ms ahead of the ear after it (0.2 s less the nudge's
      ;; 2% is 11 ticks and a remainder)
      (core-headless-frame! 0.2)
      (assert-equal 11 (conductor-tick (race-song (core-race))))
      (let loop ((frame 0))
        (when (< frame 480)
          (%audio-stream-drain-for-test out 735 2)
          (core-headless-frame! (/ 1.0 60.0))
          (loop (+ frame 1))))
      (assert-equal "resyncs 1 cancels 0"
                    (counts "resyncs" (- (list-ref (music-readout) 7) resyncs)
                            "cancels" (- (list-ref (music-readout) 9) cancels)))
      (assert-true (< (abs (- (music-audible-seconds)
                              (/ (conductor-tick (race-song (core-race))) 60.0)))
                      RESYNC-GAP)))
    (music-close!)
    (assert-false (audio-initialized?))))

(test-group "resync: a stream opened at tick zero"
  ;; A native boot opens the title's stream at tick zero, and its next
  ;; frames are long. The time before the opening is not counted; the time
  ;; after it is, because the ear heard it. Skipping the interval after a
  ;; tick-zero opening left the simulation that far behind the ear: +127 ms
  ;; and a resync request at a native boot.
  (test "the frame after a tick-zero start counts the time since the stream opened"
    (set-store-root! "/tmp/signal-conductor-resync-test-store")
    (core-param! "mute")
    ;; the race song plays on the title only with the title off (the theme
    ;; plays it otherwise): these streams are the race song's
    (core-param! "title=0")
    (core-boot! 'desktop)
    (let ((out (make-bytevector (* 8 6615) 0)))
      (music-start! 'offline-test-context (race-song (core-race)))
      (assert-equal 0 (conductor-tick (race-song (core-race))))
      (core-headless-frame! (/ 1.0 60.0))
      ;; 150 ms played, and passed, then a frame that long
      (%audio-stream-drain-for-test out 6615 2)
      (wait-since (music-opened-jiffy) 0.15)
      (core-headless-frame! 0.15)
      ;; 150 ms less the nudge's 2% is 8 ticks and a remainder; the first
      ;; frame's real time since the opening can add one. Skipped, it was 0.
      (let ((ticks (conductor-tick (race-song (core-race)))))
        (assert-equal "8 or 9" (if (memv ticks '(8 9)) "8 or 9" (counts "ticks" ticks))))
      (assert-false (list-ref (music-readout) 8)))
    (music-close!)
    (assert-false (audio-initialized?)))

  ;; A race start restarts the song at tick zero and asks to skip the next
  ;; interval: the rest of that frame was the old race's. The new stream
  ;; opens in the same frame, so the next interval is already bounded at
  ;; the opening, and skipping it dropped what the ear heard after: a long
  ;; frame after a native race start left the simulation 104 ms behind.
  (test "the frame after a race start counts the time since the new stream opened"
    (set-store-root! "/tmp/signal-conductor-resync-test-store")
    (core-param! "mute")
    ;; the race song plays on the title only with the title off (the theme
    ;; plays it otherwise): these streams are the race song's
    (core-param! "title=0")
    (core-boot! 'desktop)
    (let ((out (make-bytevector (* 8 6615) 0)))
      (music-start! 'offline-test-context (race-song (core-race)))
      (let loop ((n 0))
        (when (< n 30)
          (%audio-stream-drain-for-test out 735 2)
          (core-headless-frame! (/ 1.0 60.0))
          (loop (+ n 1))))
      (core-param! "start")
      (core-headless-frame! (/ 1.0 60.0))
      (assert-equal 'countdown (race-phase (core-race)))
      (assert-equal 0 (conductor-tick (race-song (core-race))))
      ;; 150 ms played, and passed, then a frame that long
      (%audio-stream-drain-for-test out 6615 2)
      (wait-since (music-opened-jiffy) 0.15)
      (core-headless-frame! 0.15)
      (let ((ticks (conductor-tick (race-song (core-race)))))
        (assert-equal "8 or 9" (if (memv ticks '(8 9)) "8 or 9" (counts "ticks" ticks))))
      (assert-false (list-ref (music-readout) 8)))
    (music-close!)
    (assert-false (audio-initialized?))))


(test-group "resync: a stream opened mid-song"
  ;; The web opens the music on the first gesture, after the gate and the
  ;; title have run, and the work before the stream opens falls in a
  ;; frame after it. Counted in full, that frame caught up the ring's 15
  ;; ticks of time the ear never heard: a 300 ms gap, and a resync that
  ;; cut the opening's held notes.
  (test "the frame after a mid-song start counts only the time since the stream opened"
    (set-store-root! "/tmp/signal-conductor-resync-test-store")
    (core-param! "mute")
    ;; the race song plays on the title only with the title off (the theme
    ;; plays it otherwise): these streams are the race song's
    (core-param! "title=0")
    (core-boot! 'desktop)
    (let loop ((n 0))
      (when (< n 120) (core-headless-frame! (/ 1.0 60.0)) (loop (+ n 1))))
    (let ((tick (conductor-tick (race-song (core-race))))
          (out (make-bytevector (* 8 735) 0))
          (resyncs (list-ref (music-readout) 7))
          (cancels (list-ref (music-readout) 9)))
      (assert-true (> tick 100))
      (music-start! 'offline-test-context (race-song (core-race)))
      ;; A second of work before the stream opened, in the second frame's
      ;; interval: a browser stamps the frame after a gesture before
      ;; running the gesture's handler, so its interval is short and the
      ;; next one carries the work.
      (let ((t0 (current-jiffy)))
        (core-headless-frame! (/ 1.0 60.0))
        (core-headless-frame! 1.0)
        ;; the ticks real time allows, and the clock's remainder
        (let* ((real (/ (- (current-jiffy) t0) (* 1.0 (jiffies-per-second))))
               (allowed (+ 1 (exact (ceiling (* 60 real))))))
          ;; the test can still tell: counted in full, the frame caught
          ;; up 15 ticks
          (assert-true (< allowed 15))
          (let ((advanced (- (conductor-tick (race-song (core-race))) tick)))
            (assert-equal "within" (if (<= advanced allowed)
                                       "within"
                                       (counts "ticks" advanced "allowed" allowed))))))
      ;; The frames below claim 1/60 s each but run back to back; real
      ;; frames take as long as they claim. Let the opening lie further
      ;; back than any of them, so none is clipped to the real time.
      (wait-since (music-opened-jiffy) 0.25)
      (let loop ((frame 0))
        (when (< frame 480)
          (%audio-stream-drain-for-test out 735 2)
          (core-headless-frame! (/ 1.0 60.0))
          (loop (+ frame 1))))
      (assert-equal "resyncs 0 cancels 0"
                    (counts "resyncs" (- (list-ref (music-readout) 7) resyncs)
                            "cancels" (- (list-ref (music-readout) 9) cancels))))
    (music-close!)
    (assert-false (audio-initialized?))))

;; the knob is module state shared with later files in the suite
(core-param! "title=1")
