;;; Real Motif pulls and native ring drain, with no playback device.
(import (sigil test)
        (sigil list)
        (sigil audio)
        (motif tune)
        (motif tune player)
        (signal music score)
        (signal music conductor)
        (signal music transport)
        (signal music playback)
        (signal music inserts)
        (signal shell music))

(define RATE 44100)
(define tune (read-tune-string SCORE-TUNE-TEXT))
(define buffer (make-bytevector (* 8 256) 0))

(define (advance-to c tick)
  (if (>= (conductor-tick c) tick)
      c
      (advance-to (conductor-step c) tick)))

(define (reach-next-bar b c)
  (let loop ()
    (let ((distance (playback-bar-distance b)))
      (unless (and distance (= distance 0) (> (playback-rendered b) 0))
        (playback-pull! b c buffer 0 (if (and distance (> distance 0)) (min distance 256) 256))
        (loop)))))

(test-group "resync: bar boundary and intended transport"
  (test "splitting a pull reaches the exact bar sample and restores the cue loop"
    (let* ((c (conductor-new 'lap1))
           (b (playback-open tune RATE c MUSIC-INSERTS)))
      (reach-next-bar b c)
      (assert-equal 75600 (playback-rendered b))
      (let* ((target (transport-render-target (advance-to c 90) 0.285))
             (frame (playback-resync! b target)))
        (assert-equal 77963 frame)
        (assert-equal 2363 (playback-origin-frame b))
        (assert-equal '(20 . 28) (player-region (playback-player b)))
        (assert-false (player-pending-mark (playback-player b)))
        (assert-equal (conductor-position target) (player-position (playback-player b) 0)))
      (playback-close! b))
    (assert-false (audio-initialized?)))

  (test "a pending mark blocks resync until it lands, then later plans still land exactly"
    (let* ((c (conductor-plan (conductor-new 'lap1) 'lap2 3))
           (b (playback-open tune RATE c MUSIC-INSERTS)))
      (let loop ()
        (when (<= (playback-walker-frame b) 151200)
          (playback-pull! b c buffer 0 256)
          (loop)))
      (playback-pull! b c buffer 0 256)
      (assert-false (playback-can-resync? b))
      (assert-error (playback-resync! b (advance-to c 200)))
      (reach-next-bar b c)
      (assert-equal 226800 (playback-rendered b))
      (assert-true (playback-can-resync? b))
      (let* ((target (advance-to c (song-bar->tick 3)))
             (planned (conductor-plan target 'hold 5)))
        (playback-resync! b target)
        (let loop ()
          (when (< (playback-walker-frame b) 378000)
            (playback-pull! b planned buffer 0 256)
            (loop)))
        (let ((land (find (lambda (entry)
                           (and (eq? 'landing (vector-ref entry 0))
                                (eq? 'hold (vector-ref entry 1))))
                         (playback-log b))))
          (assert-true land)
          (assert-equal 378000 (vector-ref land 3))))
      (assert-equal 0 (playback-missed b))
      (playback-close! b))
    (assert-false (audio-initialized?)))

  (test "the sink changes its clock epoch only when the corrected sample reaches the ear"
    (let* ((initial (conductor-new 'lap1))
           (out (make-bytevector (* 8 735) 0))
           (before (list-ref (music-readout) 7)))
      (music-start! 'offline-test-context initial)
      (music-frame! initial #f)
      (music-request-resync!)
      (let loop ((frame 1) (c initial) (checked-before #f) (checked-after #f))
        (if (> frame 140)
            (begin
              (assert-true checked-before)
              (assert-true checked-after)
              (assert-equal (+ before 1) (list-ref (music-readout) 7)))
            (let* ((next (advance-to c (exact (floor (* frame 0.9)))))
                   (drained (* frame 735)))
              (%audio-stream-drain-for-test out 735 2)
              (music-frame! next #f)
              (let* ((seek (find (lambda (e) (eq? 'resync (vector-ref e 0))) (music-log)))
                     (heard (- drained (* RATE 0.035)))
                     (changed? (and seek (>= heard (vector-ref seek 4))))
                     (expected (+ (/ heard RATE)
                                  (if changed? (/ (- (vector-ref seek 3) (vector-ref seek 4)) RATE) 0.0))))
                (assert-true (< (abs (- expected (music-audible-seconds))) (/ 1.0 RATE)))
                (loop (+ frame 1) next
                      (or checked-before (and seek (not changed?)))
                      (or checked-after changed?))))))
      (music-close!))
    (assert-false (audio-initialized?))))
