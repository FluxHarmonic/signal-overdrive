;;; Crash-style update choice: the real flow's rows/input and shell bridge.
;;; A waiting version is a menu item, never a race/pause action or auto-start.
(import (sigil test)
        (substratic input keys)
        (signal flow)
        (signal flow save)
        (signal race)
        (signal tuning)
        (signal shell core)
        (signal shell updates))

(define PWA-TEST-RACE (race-new (tuning-defaults)))
(define PWA-CONFIRM (nav confirm: #t))
(define PWA-DOWN (nav down: #t))

(define (pwa-mode)
  (flow-step (flow-new (save-new)) PWA-CONFIRM PWA-TEST-RACE))

(define (pwa-test-frames count . keys)
  (let loop ((left count))
    (when (> left 0)
      (when (= left count)
        (for-each (lambda (key) (keys-down! (core-keys) key)) keys))
      (core-headless-frame! (/ 1.0 60.0))
      (when (= left count)
        (for-each (lambda (key) (keys-up! (core-keys) key)) keys))
      (loop (- left 1)))))

(test-group "PWA update menu"
  (test "without a new version the actual main menu has no update item"
    (let* ((f (pwa-mode))
           (f (flow-step f PWA-DOWN PWA-TEST-RACE))
           (f (flow-step f PWA-DOWN PWA-TEST-RACE)))
      (assert-equal '(run trial) (map car (flow-rows f)))
      (assert-equal 0 (flow-sel f))
      (assert-equal '() (flow-commands f))))

  (test "a waiting version adds INSTALL UPDATE and only confirmation chooses it"
    (let* ((f (flow-with-update (pwa-mode) #t))
           (idle (flow-step f NAV-NONE PWA-TEST-RACE))
           (down (flow-step (flow-step idle PWA-DOWN PWA-TEST-RACE)
                            PWA-DOWN PWA-TEST-RACE))
           (chosen (flow-step down PWA-CONFIRM PWA-TEST-RACE)))
      (assert-equal '(run trial update) (map car (flow-rows f)))
      (assert-equal "INSTALL UPDATE" (cadr (assq 'update (flow-rows f))))
      (assert-equal '() (flow-commands idle))
      (assert-equal 2 (flow-sel down))
      (assert-equal 'mode (flow-screen chosen))
      (assert-equal '(update) (flow-commands chosen))
      (assert-equal (flow-save f) (flow-save chosen))
      (assert-equal 'title (race-phase PWA-TEST-RACE))))

  (test "a tap on the drawn update row follows the same choice path"
    (let* ((f (flow-with-update (pwa-mode) #t))
           (y (+ (flow-row-y f 2) 5))
           (next (flow-step f (nav tap: (cons 240 y)) PWA-TEST-RACE)))
      (assert-equal 'mode (flow-screen next))
      (assert-equal '(update) (flow-commands next))))

  (test "countdown, racing and paused screens never offer or choose UPDATE"
    (for-each
     (lambda (phase)
       (let* ((r (race PWA-TEST-RACE phase: phase))
              (f (flow (flow-with-update (pwa-mode) #t) screen: 'racing))
              (next (flow-step f PWA-CONFIRM r))
              (paused (flow-step f (nav pause: #t) r)))
         (assert-false (assq 'update (flow-rows f)))
         (assert-false (memq 'update (flow-commands next)))
         (assert-equal 'paused (flow-screen paused))
         (assert-false (assq 'update (flow-rows paused)))))
     '(countdown race)))

  (test "withdrawing a candidate clamps the update selection to an existing row"
    (let* ((f (flow (flow-with-update (pwa-mode) #t) sel: 2))
           (next (flow-with-update f #f)))
      (assert-equal '(run trial) (map car (flow-rows next)))
      (assert-true (< (flow-sel next) (length (flow-rows next))))))

  (test "the page consumes a main-menu choice once, and leaving the menu revokes it"
    (update-notify! "none")
    (update-menu! #f)
    (update-notify! "waiting")
    (update-choose!)
    (assert-false (update-take-choice!))
    (update-menu! #t)
    (assert-false (update-take-choice!))
    (update-choose!)
    (assert-true (update-take-choice!))
    (assert-false (update-take-choice!))
    (update-choose!)
    (update-menu! #f)
    (assert-false (update-take-choice!))
    (update-notify! "none"))

  (test "the web shell connects availability and keyboard choice; native stays unchanged"
    (update-notify! "none")
    (core-param! "mute")
    (core-param! "card=0")
    (core-param! "title=1")
    (core-boot! 'web)
    (pwa-test-frames 3)
    (update-notify! "waiting")
    (pwa-test-frames 3 'return)
    (assert-equal 'mode (flow-screen (core-flow)))
    (assert-true (update-menu?))
    (assert-true (pair? (assq 'update (flow-rows (core-flow)))))
    (assert-false (update-take-choice!))
    (pwa-test-frames 3 'down)
    (pwa-test-frames 3 'down)
    (pwa-test-frames 3 'return)
    (assert-equal 'mode (flow-screen (core-flow)))
    (assert-true (update-take-choice!))
    (assert-false (update-take-choice!))
    (pwa-test-frames 3 'escape)
    (assert-false (update-menu?))
    ;; A native session in the same process cannot inherit the web item.
    (core-boot! 'desktop)
    (pwa-test-frames 3)
    (pwa-test-frames 3 'return)
    (assert-equal 'mode (flow-screen (core-flow)))
    (assert-false (assq 'update (flow-rows (core-flow))))
    (assert-false (update-menu?))
    (update-notify! "none")
    (core-param! "card=1")))
