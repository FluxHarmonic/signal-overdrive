;;; The game's flow: a delivery's points, the save and its unlocks, the
;;; menus from the title to a cup's end, a corrupt delivery on each tier,
;;; TIME TRIAL, taps on rows, the tier's tuning, and the shell walking the
;;; menus into a race.

(import (sigil test)
        (sigil list)
        (substratic store kv)
        (substratic input keys)
        (signal track)
        (signal handling)
        (signal race)
        (signal tuning)
        (signal flow)
        (signal flow cup)
        (signal flow save)
        (signal flow tierdata)
        (signal shell core))

(set-store-root! "/tmp/signal-flow-test-store")
(core-param! "mute")
(define TUNING (tuning-defaults))

;; A race on track as it ends: the player at place with integrity (0 is a
;; corrupt delivery), the five rivals in the other places.
(define (ended track place integrity . lap)
  (let* ((r (race-new (tuning-set TUNING 'track (track-index-of track))))
         (p (race-player r))
         (corrupt? (<= integrity 0.0))
         (others (filter (lambda (k) (not (= k place))) '(1 2 3 4 5 6)))
         (rivals (map (lambda (x k) (racer x place: k finished: (+ 5000 (* 60 k))))
                      (race-rivals r) others)))
    (race r phase: (if corrupt? 'corrupt 'finished) start-tick: 100
          player: (racer p place: place finished: (if corrupt? #f (+ 100 5000 (* 60 place)))
                         best-lap: (if (pair? lap) (car lap) 1700)
                         machine: (machine (racer-machine p) integrity: integrity))
          rivals: rivals)))
(define (counting r) (race r phase: 'countdown))
(define (racing r) (race r phase: 'race))

(define CONFIRM (nav confirm: #t))
(define DOWN (nav down: #t))
(define BACK (nav back: #t))
(define (step f n r) (flow-step f n r))
;; ticks with no input
(define (wait f r k) (if (= k 0) f (wait (step f NAV-NONE r) r (- k 1))))
(define R0 (race-new TUNING))

(test-group "a delivery's points (P23)"
  (test "place, then the broadcast's grade"
    (assert-equal 13 (delivery-points 1 85.0))
    (assert-equal 8 (delivery-points 2 50.0))
    (assert-equal 5 (delivery-points 3 10.0))
    (assert-equal 1 (delivery-points 6 29.9))
    (assert-equal 0 (delivery-points 1 0.0))
    (assert-equal 'clean (grade-of 80.0))
    (assert-equal 'noisy (grade-of 79.9))
    (assert-equal 'garbled (grade-of 1.0)))
  (test "standings add up, highest first, ties in first-seen order"
    (let* ((st (standings-add '() '(("ZERO" . 10) ("VEX" . 7) ("NULL" . 5))))
           (st (standings-add st '(("VEX" . 10) ("ZERO" . 7) ("KESTREL" . 3)))))
      (assert-equal '(("ZERO" . 17) ("VEX" . 17) ("NULL" . 5) ("KESTREL" . 3)) (standings-sorted st))
      (assert-equal 1 (standings-place st "ZERO"))
      (assert-equal 3 (standings-place st "NULL")))))

;; The suite loads every file before it runs any test, so a knob or a
;; store root set at another file's top level, or by its tests, stands
;; here: each test that boots or uses the store sets its own.
(define (fresh!)
  (set-store-root! "/tmp/signal-flow-test-store")
  (core-param! "title=1"))

(test-group "the save"
  (test "a new save opens LEARNER and the first cup only"
    (let ((s (save-new)))
      (assert-true (save-tier-open? s 'learner))
      (assert-false (save-tier-open? s 'courier))
      (assert-false (save-tier-open? s 'elite))
      (assert-true (save-cup-open? s '(docklands next) 'docklands))
      (assert-false (save-cup-open? s '(docklands next) 'next))))
  (test "clearing a cup opens the next tier and the next cup, in order"
    (let ((s (save-clear (save-new) 'docklands 'learner)))
      (assert-true (save-tier-open? s 'courier))
      (assert-false (save-tier-open? s 'elite))
      (assert-true (save-cup-open? s '(docklands next) 'next))
      (assert-true (save-tier-open? (save-clear s 'docklands 'courier) 'elite))))
  (test "best times keep the lower of each, and say which improved"
    (let* ((a (save-record-best (save-new) 'run 'learner 'quayside 6000 1900))
           (b (save-record-best (car a) 'run 'learner 'quayside 6100 1800))
           (c (save-record-best (car b) 'run 'learner 'quayside 6200 1850)))
      (assert-equal '(#t #t) (cdr a))
      (assert-equal '(#f #t) (cdr b))
      (assert-equal '(#f #f) (cdr c))
      (assert-equal '(6000 1800) (save-best (car c) 'run 'learner 'quayside))
      (assert-false (save-best (car c) 'run 'courier 'quayside))))
  (test "the best cup finish keeps the higher place, then more points"
    (let* ((s (save-record-cup (save-new) 'docklands 'learner 2 25))
           (s (save-record-cup s 'docklands 'learner 3 30))
           (s2 (save-record-cup s 'docklands 'learner 2 28)))
      (assert-equal '(2 25) (save-cup-best s 'docklands 'learner))
      (assert-equal '(2 28) (save-cup-best s2 'docklands 'learner))))
  (test "it survives the store, and a damaged one reads as new"
    (fresh!)
    (let ((s (car (save-record-best (save-clear (save-new) 'docklands 'learner) 'trial 'trial 'basin 7000 2100))))
      (assert-true (save-store! s))
      (assert-equal s (save-load))
      (store-write-datum! SAVE-KEY '(not a save))
      (assert-equal (save-new) (save-load))
      (store-write-datum! SAVE-KEY '((version . 99)))
      (assert-equal (save-new) (save-load))
      ;; a save the flow writes reads back whole: a cup entry, a cleared
      ;; cup, a corrupt delivery's lap with no race time
      (let* ((sv (save-clear (save-record-cup (save-new) 'docklands 'learner 2 31) 'docklands 'learner))
             (sv (car (save-record-best sv 'run 'learner 'quayside #f 1820)))
             (sv (car (save-record-best sv 'trial 'trial 'basin 7000 2100))))
        (assert-true (save-store! sv))
        (assert-equal sv (save-load)))
      ;; damaged inside: each reads as new, and the readers never see it
      (for-each (lambda (d)
                  (store-write-datum! SAVE-KEY d)
                  (assert-equal (save-new) (save-load))
                  (assert-false (save-tier-open? (save-load) 'courier)))
                '(((version . 1) (cleared docklands) (cups) (best))
                  ((version . 1) (cleared (docklands . learner)) (cups) (best))
                  ((version . 1) (cleared) (cups ((docklands . learner))) (best))
                  ((version . 1) (cleared) (cups) (best ((run learner) 10 20)))
                  ((version . 1) (cleared) (cups) (best ((run learner quayside) "x" 20)))
                  ((version . 1) (cleared) (cups) (best) junk))))))

(test-group "the tier's tuning"
  (test "RUN keeps the field, the tier rides along and never sets the pace; TIME TRIAL empties the field"
    (let* ((base '((rivals . 5.0)))
           (l (tier-race-tuning TUNING base 'run 'learner))
           (e (tier-race-tuning TUNING base 'run 'elite))
           (t (tier-race-tuning l base 'trial 'courier))
           (back (tier-race-tuning t base 'run 'courier)))
      ;; one owner: the race's tier data scales the pace, the flow never does
      (assert-equal (tuning-ref TUNING 'rival-pace) (tuning-ref l 'rival-pace))
      (assert-equal (tuning-ref TUNING 'rival-pace) (tuning-ref e 'rival-pace))
      (assert-equal 'learner (cdr (assq 'race-tier l)))
      (assert-equal 'elite (cdr (assq 'race-tier e)))
      (assert-equal 'run (cdr (assq 'race-mode e)))
      (assert-equal 5.0 (tuning-ref l 'rivals))
      (assert-equal 0.0 (tuning-ref t 'rivals))
      (assert-equal 5.0 (tuning-ref back 'rivals))
      (assert-equal 'time-trial (cdr (assq 'race-mode t)))
      (assert-equal 'courier (cdr (assq 'race-tier back)))
      ;; the entries are not knobs: the query string never names them
      (assert-false (assq 'race-tier (tuning-changed back)))
      (assert-equal 0 (length (race-rivals (race-new t)))))))

;; From the title to the cup's screen on LEARNER.
(define (to-cup f)
  (let* ((f (step f CONFIRM R0))   ; title -> mode
         (f (step f CONFIRM R0))   ; RUN -> tier
         (f (step f CONFIRM R0)))  ; LEARNER -> cup
    f))
;; One delivery from the countdown to its standings.
(define (deliver f track place integrity)
  (let* ((f (step f NAV-NONE (counting (race-new TUNING))))
         (f (step f NAV-NONE (racing (race-new TUNING))))
         (r (ended track place integrity))
         (f (step f NAV-NONE r))
         (f (wait f r RESULTS-DELAY)))
    (step f CONFIRM r)))

(test-group "the menus"
  (test "title, mode, tier and cup; a locked tier stays put; back goes back"
    (let* ((f (flow-new (save-new)))
           (f1 (step f CONFIRM R0))
           (f2 (step f1 CONFIRM R0))
           (locked (step (step f2 DOWN R0) CONFIRM R0))
           (f3 (step f2 CONFIRM R0)))
      (assert-equal 'mode (flow-screen f1))
      (assert-equal 'tier (flow-screen f2))
      (assert-equal 'tier (flow-screen locked))
      (assert-equal 1 (flow-sel locked))
      (assert-equal 'cup (flow-screen f3))
      (assert-equal 'learner (flow-tier f3))
      ;; the cup's first track flies behind the menu
      (assert-equal '(preview) (flow-commands f3))
      (assert-equal 'breakwater (flow-track f3))
      (assert-equal 'tier (flow-screen (step f3 BACK R0)))
      (assert-equal 'mode (flow-screen (step (step f3 BACK R0) BACK R0)))
      (assert-equal 'title (flow-screen (step f1 BACK R0)))))
  (test "the selection wraps"
    (let ((f (step (flow-new (save-new)) CONFIRM R0)))
      (assert-equal 1 (flow-sel (step f DOWN R0)))
      (assert-equal 0 (flow-sel (step (step f DOWN R0) DOWN R0)))
      (assert-equal 1 (flow-sel (step f (nav up: #t) R0)))))
  (test "a tap on a row chooses it; on BACK goes back; elsewhere nothing"
    (let* ((f (step (flow-new (save-new)) CONFIRM R0))
           (row1 (step f (nav tap: (cons 240.0 (+ 4.0 (flow-row-y f 1)))) R0))
           (back (step f (nav tap: (cons 20.0 (+ 2.0 BACK-ROW))) R0))
           (none (step f (nav tap: (cons 240.0 40.0)) R0)))
      (assert-equal 'trial (flow-screen row1))
      (assert-equal 'title (flow-screen back))
      (assert-equal 'mode (flow-screen none)))))

(test-group "a cup"
  (test "three deliveries, standings after each, the uplink, the unlock"
    (let* ((f (to-cup (flow-new (save-new))))
           (f (step f CONFIRM R0)))
      (assert-equal 'launch (flow-screen f))
      (assert-equal '(launch) (flow-commands f))
      (assert-equal "DELIVERY 1 OF 3: BREAKWATER" (flow-start-card f))
      ;; the race's end: results wait for the uplink's first bars
      (let* ((f (step f NAV-NONE (counting (race-new TUNING))))
             (r (ended 'breakwater 2 85.0 1650))
             (f (step f NAV-NONE r)))
        (assert-equal 'results (flow-screen f))
        (assert-equal 10 (cdr (assq 'points (flow-result f))))
        (assert-true (cdr (assq 'new-lap? (flow-result f))))
        (assert-equal '(store) (flow-commands f))
        (assert-equal 'results (flow-screen (step f CONFIRM r)))
        (let* ((f (wait f r RESULTS-DELAY))
               (f (step f CONFIRM r)))
          (assert-equal 'standings (flow-screen f))
          (assert-equal 10 (standings-points (flow-standings f) PLAYER-NAME))
          ;; by place: the rival in first takes 10, the player 10, third 5
          (assert-equal '(10 10 5 3 2 1) (map cdr (flow-awards f)))
          (assert-equal PLAYER-NAME (car (list-ref (flow-awards f) 1)))
          (assert-equal 1 (flow-round f))
          ;; the next delivery: a fade out, then a countdown
          (let* ((f (step f CONFIRM r)))
            (assert-equal 'fade (flow-screen f))
            (assert-equal 'quayside (flow-track f))
            (let ((f (wait f r FADE-TICKS)))
              (assert-equal 'racing (flow-screen f))
              (assert-equal '(begin) (flow-commands f))
              (assert-equal "DELIVERY 2 OF 3: QUAYSIDE" (flow-start-card f))
              (assert-true (> (flow-fade f) 0.9))
              (let* ((f (deliver f 'quayside 1 90.0))
                     (f (wait (step f CONFIRM r) r FADE-TICKS))
                     (f (deliver f 'basin 1 95.0)))
                (assert-equal 'standings (flow-screen f))
                (assert-equal '(uplink "TO THE UPLINK" #t) (car (flow-rows f)))
                (let ((f (step f CONFIRM r)))
                  (assert-equal 'cup-end (flow-screen f))
                  (assert-equal '(store) (flow-commands f))
                  ;; 10 + 13 + 13 = 36, first overall, every delivery clean
                  (assert-equal '(1 36 #t #f) (flow-cup-result f))
                  (assert-equal '("COURIER UNLOCKED.") (flow-unlocks f))
                  (assert-equal "# Catchy. I'll have it removed." (flow-gibson-line f))
                  (assert-true (save-tier-open? (flow-save f) 'courier))
                  (assert-equal '(1 36) (save-cup-best (flow-save f) 'docklands 'learner))
                  (let ((f (step f CONFIRM r)))
                    (assert-equal 'mode (flow-screen f))
                    (assert-equal '(to-title) (flow-commands f)))))))))))
  (test "QUIT CUP between deliveries; BACK only moves to it"
    (let* ((f (step (to-cup (flow-new (save-new))) CONFIRM R0))
           (_ (assert-equal '(("ZERO" . 0)) (flow-standings f)))
           (f (deliver f 'breakwater 2 85.0))
           (r (ended 'breakwater 2 85.0)))
      (assert-equal '((next "NEXT DELIVERY" #t) (quit "QUIT CUP" #t)) (flow-rows f))
      (let ((b (step f BACK r)))
        (assert-equal 'standings (flow-screen b))
        (assert-equal 1 (flow-sel b))
        (let ((q (step b CONFIRM r)))
          (assert-equal 'mode (flow-screen q))
          (assert-equal '(to-title) (flow-commands q))
          (assert-false (save-cup-best (flow-save q) 'docklands 'learner))
          ;; the delivery's best times stay
          (assert-true (save-best (flow-save q) 'run 'learner 'breakwater))))))
  (test "a level total goes to the player"
    ;; a rival seen before the player in a delivery's order, level on points
    (let ((st (standings-add '(("ZERO" . 0)) '(("KESTREL" . 10) ("ZERO" . 10)))))
      (assert-equal 1 (standings-place st "ZERO"))
      (assert-equal 2 (standings-place st "KESTREL"))))
  (test "out of the top three: no unlock, and Gibson isn't impressed"
    (let* ((f (step (to-cup (flow-new (save-new))) CONFIRM R0))
           (f (deliver f 'breakwater 6 10.0))
           (r (ended 'quayside 6 10.0))
           (f (wait (step f CONFIRM r) r FADE-TICKS))
           (f (deliver f 'quayside 6 10.0))
           (f (wait (step f CONFIRM r) r FADE-TICKS))
           (f (deliver f 'basin 6 10.0))
           (f (step f CONFIRM r)))
      (assert-equal 'cup-end (flow-screen f))
      (assert-false (caddr (flow-cup-result f)))
      (assert-equal '() (flow-unlocks f))
      (assert-false (save-tier-open? (flow-save f) 'courier))
      (assert-equal "# Noise. Nobody tuned in." (flow-gibson-line f)))))

;; The results of a corrupt delivery on the cup's first track, tier-steps
;; down the tier menu (every tier open).
(define (corrupt-on tier-steps)
  (let* ((f (step (step (flow-new (save-unlock-all (save-new) (cup-ids))) CONFIRM R0) CONFIRM R0))
         (f (let down ((f f) (k tier-steps)) (if (= k 0) f (down (step f DOWN R0) (- k 1)))))
         (f (step (step f CONFIRM R0) CONFIRM R0))
         (f (step f NAV-NONE (counting (race-new TUNING))))
         (r (ended 'breakwater 3 0.0)))
    (cons (wait (step f NAV-NONE r) r RESULTS-DELAY) r)))
(test-group "a corrupt delivery"
  (test "COURIER: three RETRANSMITs, then only the 0 points"
    (let* ((fr (corrupt-on 1)) (f (car fr)) (r (cdr fr)))
      (assert-equal 'courier (flow-tier f))
      (assert-equal "RETRANSMIT (3 LEFT)" (cadr (car (flow-rows f))))
      (let* ((f (step f CONFIRM r)))
        (assert-equal 'fade (flow-screen f))
        (assert-equal 'breakwater (flow-track f))
        (assert-equal 1 (flow-retransmits f))
        ;; the same delivery again: same round, standings untouched, a new countdown
        (let ((f (wait f r FADE-TICKS)))
          (assert-equal 'racing (flow-screen f))
          (assert-equal '(begin) (flow-commands f))
          (assert-equal 0 (flow-round f))
          (assert-equal '(("ZERO" . 0)) (flow-standings f))
          (assert-equal "DELIVERY 1 OF 3: BREAKWATER" (flow-start-card f))
          (let ((f (wait (step f NAV-NONE r) r RESULTS-DELAY)))
            (assert-equal "RETRANSMIT (2 LEFT)" (cadr (car (flow-rows f))))))
        (let* ((f (flow f screen: 'racing retransmits: 3))
               (f (wait (step f NAV-NONE r) r RESULTS-DELAY)))
          (assert-false (caddr (car (flow-rows f))))
          ;; none left: the selection starts on TAKE 0 POINTS, and the
          ;; locked RETRANSMIT does nothing when chosen
          (assert-equal 1 (flow-sel f))
          (assert-equal 'results (flow-screen (step (step f (nav up: #t) r) CONFIRM r)))
          (let ((f (step f CONFIRM r)))
            (assert-equal 'standings (flow-screen f))
            (assert-equal 0 (standings-points (flow-standings f) PLAYER-NAME))
            ;; the rivals share the places, 1st 2nd 4th 5th 6th taking 10 7 5 3 2
            (assert-equal '(0 10 7 5 3 2) (map cdr (flow-awards f))))))))
  (test "LEARNER: RETRANSMIT without end"
    (let ((f (car (corrupt-on 0))))
      (assert-equal "RETRANSMIT" (cadr (car (flow-rows f))))
      (assert-true (caddr (car (flow-rows f))))))
  (test "ELITE: the cup ends"
    (let* ((fr (corrupt-on 2)) (f (car fr)) (r (cdr fr)))
      (assert-equal '((end "END THE CUP" #t)) (flow-rows f))
      (let ((f (step f CONFIRM r)))
        (assert-equal 'cup-end (flow-screen f))
        (assert-true (cadddr (flow-cup-result f)))
        (assert-equal "# Static suits you." (flow-gibson-line f))))))

;; A cup's first delivery, racing, on tier-steps down the tier menu.
(define (racing-on tier-steps)
  (let* ((f (step (step (flow-new (save-unlock-all (save-new) (cup-ids))) CONFIRM R0) CONFIRM R0))
         (f (let down ((f f) (k tier-steps)) (if (= k 0) f (down (step f DOWN R0) (- k 1)))))
         (f (step (step f CONFIRM R0) CONFIRM R0)))
    (step f NAV-NONE (counting (race-new TUNING)))))
(define RUNNING (racing (race-new TUNING)))
(define PAUSE (nav pause: #t))
(test-group "the pause menu"
  (test "the pause press or the PAUSE button pause a race; BACK alone (a pad's B, the brake) does not"
    (let ((f (racing-on 0)))
      (assert-equal 'racing (flow-screen f))
      (assert-equal 'paused (flow-screen (step f PAUSE RUNNING)))
      (assert-equal 'racing (flow-screen (step f BACK RUNNING)))
      (assert-equal 'paused (flow-screen (step f (nav tap: (cons 20.0 64.0)) RUNNING)))
      ;; taps around the box are the player's steering, not a pause
      (for-each (lambda (xy) (assert-equal 'racing (flow-screen (step f (nav tap: xy) RUNNING))))
                '((240.0 . 64.0) (100.0 . 64.0) (20.0 . 100.0) (20.0 . 40.0)))
      (assert-equal 'racing (flow-screen (step f (nav tap: 'any) RUNNING)))
      ;; the countdown pauses too; a finished race goes to its results
      (assert-equal 'paused (flow-screen (step f PAUSE (counting (race-new TUNING)))))
      (assert-equal 'results (flow-screen (step f PAUSE (ended 'breakwater 2 85.0))))))
  (test "RESUME, BACK or the pause press resume; a pad's Start (confirm and pause) on any row resumes"
    (let ((p (step (racing-on 0) PAUSE RUNNING)))
      (assert-true (flow-paused? p))
      (assert-equal '((resume "RESUME" #t) (restart "RESTART RACE" #t) (quit "QUIT CUP" #t)) (flow-rows p))
      (assert-equal "DELIVERY 1 OF 3: BREAKWATER" (flow-start-card p))
      (for-each (lambda (n) (assert-equal 'racing (flow-screen (step p n RUNNING))))
                (list CONFIRM BACK PAUSE))
      (let ((on-quit (step (step p DOWN RUNNING) DOWN RUNNING)))
        (assert-equal 2 (flow-sel on-quit))
        (assert-equal 'racing (flow-screen (step on-quit (nav confirm: #t pause: #t) RUNNING))))))
  (test "a tap on the pause menu counts on its panel only"
    (let ((p (step (racing-on 0) PAUSE RUNNING)))
      ;; QUIT CUP's row, at the screen's edge: a resting thumb, nothing
      (assert-equal 'paused (flow-screen (step p (nav tap: (cons 30.0 180.0)) RUNNING)))
      (assert-equal 'paused (flow-screen (step p (nav tap: (cons 440.0 160.0)) RUNNING)))
      (assert-equal 'paused (flow-screen (step p (nav tap: (cons 240.0 230.0)) RUNNING)))
      ;; on the panel: the row
      (assert-equal 'mode (flow-screen (step p (nav tap: (cons 240.0 180.0)) RUNNING)))
      (assert-equal 'racing (flow-screen (step p (nav tap: (cons 240.0 142.0)) RUNNING)))))
  (test "RESTART RACE on LEARNER: the same delivery from its countdown at once, fading in"
    (let* ((p (step (racing-on 0) PAUSE RUNNING))
           (r (step (step p DOWN RUNNING) CONFIRM RUNNING)))
      (assert-equal 'racing (flow-screen r))
      (assert-equal '(begin) (flow-commands r))
      (assert-equal 'breakwater (flow-track r))
      (assert-equal 0 (flow-round r))
      (assert-true (> (flow-fade r) 0.9))
      (let ((b (wait r RUNNING FADE-TICKS)))
        (assert-equal 0.0 (flow-fade b))
        ;; paused and resumed after the fade in, it does not fade again
        (let ((back (step (step b PAUSE RUNNING) CONFIRM RUNNING)))
          (assert-equal 'racing (flow-screen back))
          (assert-equal 0.0 (flow-fade back))))))
  (test "on COURIER a restart uses a RETRANSMIT; on ELITE there is none"
    (let* ((p (step (racing-on 1) PAUSE RUNNING)))
      (assert-equal "RESTART RACE (3 LEFT)" (cadr (cadr (flow-rows p))))
      (let ((r (step (step p DOWN RUNNING) CONFIRM RUNNING)))
        (assert-equal 1 (flow-retransmits r))
        (assert-equal '(begin) (flow-commands r))))
    (let* ((p (step (racing-on 2) PAUSE RUNNING)))
      (assert-equal '(restart "RESTART RACE (0 LEFT)" #f) (cadr (flow-rows p)))
      (assert-equal 'paused (flow-screen (step (step p DOWN RUNNING) CONFIRM RUNNING)))))
  (test "QUIT CUP: the menus, no cup result"
    (let* ((p (step (racing-on 0) PAUSE RUNNING))
           (q (step (step (step p DOWN RUNNING) DOWN RUNNING) CONFIRM RUNNING)))
      (assert-equal 'mode (flow-screen q))
      (assert-equal 0 (flow-sel q))
      (assert-equal '(to-title) (flow-commands q))
      (assert-false (save-cup-best (flow-save q) 'docklands 'learner))))
  (test "TIME TRIAL: a free restart, and QUIT TO MENU"
    (let* ((f (step (step (flow-new (save-new)) CONFIRM R0) DOWN R0))
           (f (step (step f CONFIRM R0) CONFIRM R0))
           (f (step f NAV-NONE (counting (race-new TUNING))))
           (p (step f PAUSE RUNNING)))
      (assert-equal '((resume "RESUME" #t) (restart "RESTART RACE" #t) (quit "QUIT TO MENU" #t)) (flow-rows p))
      (let ((r (step (step p DOWN RUNNING) CONFIRM RUNNING)))
        (assert-equal 'racing (flow-screen r))
        (assert-equal '(begin) (flow-commands r))
        (assert-equal 0 (flow-retransmits r)))
      (let ((q (step (step (step p DOWN RUNNING) DOWN RUNNING) CONFIRM RUNNING)))
        (assert-equal 'mode (flow-screen q))
        (assert-equal 1 (flow-sel q))))))

(test-group "TIME TRIAL"
  (test "a track, a run, its records, and RETRY"
    (let* ((f (step (step (flow-new (save-new)) CONFIRM R0) DOWN R0))
           (f (step f CONFIRM R0)))
      (assert-equal 'trial (flow-screen f))
      (assert-equal (cup-tracks 'docklands) (flow-trial-tracks f))
      (assert-equal '(preview) (flow-commands f))
      (let* ((f (step f DOWN R0))
             (_ (assert-equal '(preview) (flow-commands f)))
             (_ (assert-equal 'quayside (flow-track f)))
             (f (step f CONFIRM R0))
             (f (step f NAV-NONE (counting (race-new TUNING))))
             (_ (assert-equal "TIME TRIAL: QUAYSIDE" (flow-start-card f)))
             (r (ended 'quayside 1 88.0 1600))
             (f (step f NAV-NONE r)))
        (assert-equal 'trial-results (flow-screen f))
        (assert-equal '(5060 1600) (save-best (flow-save f) 'trial 'trial 'quayside))
        (assert-equal 1600 (flow-hud-best f))
        (assert-equal 'fade (flow-screen (step f CONFIRM r)))
        (assert-equal 'trial (flow-screen (step (step f DOWN r) CONFIRM r)))
        (assert-equal '(to-title) (flow-commands (step (step f DOWN r) CONFIRM r))))))
  (test "a corrupt run records no time and no lap"
    (let* ((f (step (step (flow-new (save-new)) CONFIRM R0) DOWN R0))
           (f (step (step f CONFIRM R0) CONFIRM R0))
           (f (step f NAV-NONE (counting (race-new TUNING))))
           (r (ended 'breakwater 1 0.0 1500))
           (f (step f NAV-NONE r)))
      (assert-equal 'trial-results (flow-screen f))
      (assert-false (save-best (flow-save f) 'trial 'trial 'breakwater))
      (assert-false (cdr (assq 'new-lap? (flow-result f))))
      (assert-equal '() (flow-commands f)))))

;; The shell: Enter through the menus starts a race on the cup's first
;; track, LEARNER's pace, and no flow with the start parameter.
(define (frames n . keys)
  (let loop ((k 0))
    (when (< k n)
      (for-each (lambda (key) (keys-down! (core-keys) key)) (if (= k 0) keys '()))
      (core-headless-frame! (/ 1.0 60.0))
      (for-each (lambda (key) (keys-up! (core-keys) key)) (if (= k 0) keys '()))
      (loop (+ k 1)))))

;; the probe line has the text
(define (probe-has? text)
  (let ((p (core-probe)) (n (string-length text)))
    (let loop ((i 0))
      (and (<= (+ i n) (string-length p))
           (or (string=? (substring p i (+ i n)) text) (loop (+ i 1)))))))

(test-group "the shell"
  (test "Enter through the menus, then the title's fade into the cup's countdown"
    (fresh!)
    (store-write-datum! SAVE-KEY '(not a save))
    (core-param! "card=0")
    (core-boot! 'desktop)
    (frames 3)
    (assert-equal 'title (flow-screen (core-flow)))
    (frames 3 'return)
    (assert-equal 'mode (flow-screen (core-flow)))
    (assert-false (core-escape-quits?))
    ;; the Enter that opened the menu did not also start the title's fade:
    ;; a second past its 0.5 s, the race is still behind the title
    (frames 60)
    (assert-equal 'mode (flow-screen (core-flow)))
    (assert-equal 'title (race-phase (core-race)))
    (frames 3 'return)
    (frames 3 'return)
    (assert-equal 'cup (flow-screen (core-flow)))
    (assert-equal 'breakwater (track-name (race-track (core-race))))
    (assert-equal 'title (race-phase (core-race)))
    (frames 3 'return)
    (assert-equal 'launch (flow-screen (core-flow)))
    (frames 60)
    (assert-equal 'racing (flow-screen (core-flow)))
    (assert-equal 'countdown (race-phase (core-race)))
    (assert-equal 'breakwater (track-name (race-track (core-race))))
    (assert-equal (tuning-ref TUNING 'rival-pace) (tuning-ref (core-tuning) 'rival-pace))
    (assert-equal 'learner (cdr (assq 'race-tier (core-tuning))))
    ;; Escape pauses a race natively (no quit), and the race holds
    (assert-false (core-escape-quits?))
    ;; in the countdown: it pauses too, and its tick runs in every phase
    (frames 1 'escape)
    (assert-equal 'paused (flow-screen (core-flow)))
    (assert-true (core-paused?))
    (let ((t0 (race-tick (core-race))))
      (frames 30)
      (assert-equal t0 (race-tick (core-race)))
      ;; Escape again: RESUME, and the race runs on
      (frames 1 'escape)
      (assert-equal 'racing (flow-screen (core-flow)))
      (assert-false (core-paused?))
      ;; and stays resumed: the frame after a resume runs no tick, and must
      ;; not carry the press that resumed into a new pause
      (frames 3)
      (assert-equal 'racing (flow-screen (core-flow)))
      (frames 10)
      (assert-true (> (race-tick (core-race)) t0)))
    ;; a frame of three ticks whose first pauses runs no more of them
    (let ((t1 (race-tick (core-race))))
      (keys-down! (core-keys) 'escape)
      (core-headless-frame! (/ 3.0 60.0))
      (keys-up! (core-keys) 'escape)
      (assert-equal 'paused (flow-screen (core-flow)))
      (assert-true (<= (- (race-tick (core-race)) t1) 1)))
    (frames 1 'escape)
    (assert-equal 'racing (flow-screen (core-flow)))
    (frames 3)
    ;; a press on a frame that ran no tick (120 Hz) waits for the next tick
    (keys-down! (core-keys) 'escape)
    (core-headless-frame! 0.0)
    (keys-up! (core-keys) 'escape)
    (assert-equal 'racing (flow-screen (core-flow)))
    (frames 1)
    (assert-equal 'paused (flow-screen (core-flow)))
    (frames 1 'escape)
    (core-param! "card=1"))
  (test "TIME TRIAL on the second track: the preview flies it, the race has no rivals"
    (fresh!)
    ;; breakwater is the default track, so only the second one shows the
    ;; flow chose it
    (core-param! "card=0")
    (core-boot! 'desktop)
    (frames 3)
    (frames 3 'return)
    (frames 3 'down)
    (frames 3 'return)
    (assert-equal 'trial (flow-screen (core-flow)))
    (frames 3 'down)
    (assert-equal 'quayside (track-name (race-track (core-race))))
    (assert-equal 'title (race-phase (core-race)))
    (frames 3 'return)
    (frames 60)
    (assert-equal 'racing (flow-screen (core-flow)))
    (assert-equal 'countdown (race-phase (core-race)))
    (assert-equal 'quayside (track-name (race-track (core-race))))
    (assert-equal 0 (length (race-rivals (core-race))))
    (assert-equal 'time-trial (cdr (assq 'race-mode (core-tuning))))
    ;; R retries it, still in the flow
    (frames 1 'r)
    (assert-equal 'racing (flow-screen (core-flow)))
    (assert-equal 'countdown (race-phase (core-race)))
    (core-param! "card=1"))
  (test "after a TIME TRIAL, a new boot's RUN has the session's rivals; a rivals param moves them"
    (fresh!)
    ;; the TIME TRIAL above left rivals 0 in the tuning, which lives across boots
    (assert-equal 0.0 (tuning-ref (core-tuning) 'rivals))
    (core-param! "card=0")
    (core-boot! 'desktop)
    (frames 3)
    (frames 3 'return)
    (frames 3 'return)
    (frames 3 'return)
    (assert-equal 'cup (flow-screen (core-flow)))
    (assert-equal 5.0 (tuning-ref (core-tuning) 'rivals))
    (assert-equal 5 (length (race-rivals (core-race))))
    (core-param! "rivals=2")
    (frames 3 'escape)
    (assert-equal 'tier (flow-screen (core-flow)))
    (frames 3 'return)
    (assert-equal 'cup (flow-screen (core-flow)))
    (assert-equal 2.0 (tuning-ref (core-tuning) 'rivals))
    (assert-equal 2 (length (race-rivals (core-race))))
    (core-param! "rivals=5")
    (core-param! "card=1"))
  (test "a tap that skips the card is spent: the title still waits, and a new tap opens the menu"
    (fresh!)
    (store-write-datum! SAVE-KEY '(not a save))
    (core-param! "card=1")
    (core-boot! 'desktop)
    (core-tap! "0.5,0.5")
    (frames 1)
    (let loop ((k 0))
      (when (and (< k 900) (not (probe-has? " intro done")))
        (frames 1)
        (loop (+ k 1))))
    (assert-true (probe-has? " intro done"))
    (frames 30)
    (assert-equal 'title (flow-screen (core-flow)))
    (core-tap! "0.5,0.5")
    (frames 1)
    (assert-equal 'mode (flow-screen (core-flow))))
  (test "the start parameter: no flow, the race as before"
    (fresh!)
    (core-boot! 'desktop)
    (core-param! "start")
    (frames 2)
    (assert-equal 'off (flow-screen (core-flow)))
    (assert-equal 'countdown (race-phase (core-race)))))
