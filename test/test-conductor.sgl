(import (sigil test)
        (signal music song)
        (signal music conductor)
        (signal music progress)
        (signal music clock)
        (signal music transport)
        (substratic time clock))

(define (advance c ticks)
  (let loop ((c c) (remaining ticks))
    (if (= remaining 0)
        c
        (loop (conductor-step c) (- remaining 1)))))

(test-group "transport: late audio and frozen epochs"
  (test "initial audio starts immediately without a pre-roll"
    (let ((s (transport-start (conductor-new) 44100)))
      (assert-equal 0 (conductor-tick (transport-start-conductor s)))
      (assert-equal 0 (transport-start-silence s))
      (assert-equal 0.0 (transport-start-epoch s))))

  (test "late audio joins the next bar with device-rate silence"
    (let* ((c (advance (conductor-new 'lap1) 60))
           (s (transport-start c 48000)))
      (assert-equal (song-bar->tick 1) (conductor-tick (transport-start-conductor s)))
      (assert-equal 34286 (transport-start-silence s))
      (assert-equal 1.0 (transport-start-epoch s))
      ;; Latency belongs to the audible clock, not to pre-roll length.
      (assert-true (< (abs (- (song-bar-seconds)
                             (+ (transport-start-epoch s)
                                (audible-seconds (+ (transport-start-silence s) 1680)
                                                 0 48000 0.035 0))))
                      0.00002))))

  (test "joining at GO uses lap1 and never requests grid's expired exit"
    (let* ((c (advance (conductor-new) 400))
           (s (transport-start c 44100))
           (start (transport-start-conductor s)))
      (assert-equal 'lap1 (conductor-section start))
      (assert-equal '(12 . 0) (conductor-position start))
      (assert-false (conductor-next-jump start))))

  (test "resume projection preserves a committed section landing"
    (let* ((planned (conductor-plan (conductor-new 'lap1) 'lap2 3))
           (c (advance planned 300))
           (s (transport-start c 44100))
           (start (transport-start-conductor s)))
      (assert-equal 'lap2 (conductor-section start))
      (assert-equal 3 (conductor-entry-bar start))
      (assert-equal 5.0 (transport-start-epoch s))
      (assert-equal 6300 (transport-start-silence s)))))

(test-group "transport: resync projection"
  (test "the projected render row stays within half a row of the intended ear time"
    (let loop ((tick 0))
      (when (< tick 7200)
        (let* ((c (conductor (conductor-new 'lap1) tick: tick))
               (ahead 0.285)
               (target (transport-render-target c ahead))
               (row-time (* (tick->song-row (conductor-tick target)) (/ (song-bar-seconds) 32)))
               (intended (+ (/ tick 60.0) ahead)))
          (assert-true (<= (abs (- row-time intended)) (/ (song-bar-seconds) 64))))
        (loop (+ tick 7)))))

  (test "projection crosses the committed mark while the original simulation stays unchanged"
    (let* ((c (advance (conductor-plan (conductor-new 'lap1) 'lap2 3) 300))
           (target (transport-render-target c 0.285)))
      (assert-equal 'lap2 (conductor-section target))
      (assert-equal 3 (conductor-entry-bar target))
      (assert-equal 'lap1 (conductor-section c))
      (assert-equal 300 (conductor-tick c))
      (assert-true (conductor-pending c)))))

(test-group "conductor: tick clock"
  (test "row time is computed from ticks without rounded accumulation"
    (assert-equal 0 (tick->song-row 3))
    (assert-equal 1 (tick->song-row 4))
    (assert-equal 2240 (tick->song-row 7200))
    (assert-equal 70 (tick->song-bar 7200))
    (assert-equal 7200 (song-bar->tick 70)))

  (test "score rows map to multi-bar order positions"
    (assert-equal '(0 . 32) (score-row->position '#(0 64 96 160) 32))
    (assert-equal '(1 . 0) (score-row->position '#(0 64 96 160) 64))
    (assert-equal '(2 . 63) (score-row->position '#(0 64 96 160) 159))
    (assert-error (score-row->position '#(0 64 96 160) 160)))

  (test "compiled onsets pulse once per row rather than once per tick"
    (assert-true (> (conductor-onset-mask (conductor-new 'lap1)) 0))
    (assert-equal 0 (conductor-onset-mask (advance (conductor-new 'lap1) 1)))
    (assert-true (> (conductor-onset-mask (advance (conductor-new 'lap1) 7)) 0))
    (assert-equal 0 (conductor-onset-mask (advance (conductor-new 'lap1) 8))))

  (test "grid holds four complete bars and starts lap1 on GO"
    (let* ((go (song-bar->tick 4))
           (before (advance (conductor-new) (- go 1)))
           (after (conductor-step before)))
      (assert-equal 'grid (conductor-section before))
      (assert-equal 'lap1 (conductor-section after))
      (assert-equal '(12 . 0) (conductor-position after))
      (assert-equal go (vector-ref (car (conductor-log after)) 0))))

  (test "count-in is 3, 2, 1 on the last three beats of grid"
    (assert-equal #f (conductor-count-in (advance (conductor-new) 300)))
    (assert-equal 3 (conductor-count-in (advance (conductor-new) 335)))
    (assert-equal 2 (conductor-count-in (advance (conductor-new) 360)))
    (assert-equal 1 (conductor-count-in (advance (conductor-new) 386))))

  (test "lap1 repeats its second eight bars; hold repeats its riser"
    (let ((verse (advance (conductor-new 'lap1) (song-bar->tick 16)))
          (riser (advance (conductor-new 'hold) (song-bar->tick 8))))
      (assert-equal '(20 . 0) (conductor-position verse))
      (assert-equal '(40 . 0) (conductor-position riser))))

  (test "fill ends in traced; uplink ends in results"
    (assert-equal 'traced
                  (conductor-section (advance (conductor-new 'fill) (song-bar->tick 2))))
    (assert-equal 'results
                  (conductor-section (advance (conductor-new 'uplink) (song-bar->tick 8))))))

(test-group "conductor: planned jumps"
  (test "automatic exits are available to the shell before their landing bar"
    (let ((grid (conductor-next-jump (conductor-new 'grid)))
          (fill (conductor-next-jump (conductor-new 'fill))))
      (assert-equal 'lap1 (jump-mark grid))
      (assert-equal 4 (jump-bar grid))
      (assert-equal 'traced (jump-mark fill))
      (assert-equal 2 (jump-bar fill))))

  (test "race predictions wait until near a target, then commit one bar ahead"
    (let* ((c (advance (conductor-new 'lap1) 20))
           (far (conductor-race-plan c 0.0 500.0 30000.0))
           (near (conductor-race-plan c 8700.0 500.0 30000.0))
           (plan (conductor-pending near)))
      (assert-equal #f (conductor-pending far))
      (assert-equal 'lap2 (jump-mark plan))
      (assert-true (>= (- (song-bar->tick (jump-bar plan)) (conductor-tick near)) 103))
      (assert-equal plan (conductor-pending (conductor-race-plan near 0.0 500.0 30000.0)))))

  (test "the fill starts two bars before the predicted drop and stays committed after a crash"
    (let* ((c (advance (conductor-new 'hold) 20))
           (planned (conductor-race-plan c 17200.0 500.0 30000.0))
           (plan (conductor-pending planned)))
      (assert-equal 'fill (jump-mark plan))
      (assert-equal plan (conductor-pending (conductor-race-plan planned 17200.0 0.0 30000.0)))
      (let ((after (advance planned (- (song-bar->tick (+ (jump-bar plan) 2)) (conductor-tick c)))))
        (assert-equal 'traced (conductor-section after)))))

  (test "stopped or backwards motion cannot predict a crossing"
    (assert-equal #f (conductor-pending (conductor-race-plan (conductor-new 'lap1) 9999.0 0.0 30000.0)))
    (assert-equal #f (conductor-pending (conductor-race-plan (conductor-new 'lap1) 9999.0 -500.0 30000.0))))

  (test "late, unknown and already committed jumps are refused"
    (let ((c (advance (conductor-new 'lap1) 20)))
      (assert-error (conductor-plan c 'lap2 1))
      (assert-error (conductor-plan c 'lap2 2.5))
      (assert-error (conductor-plan c 'missing 3))
      (assert-error (conductor-plan (conductor-plan c 'lap2 3) 'hold 4))))

  (test "a committed jump lands on its absolute bar and is logged once"
    (let* ((planned (conductor-plan (conductor-new 'lap1) 'lap2 3))
           (before (advance planned (- (song-bar->tick 3) 1)))
           (after (conductor-step before)))
      (assert-equal 'lap1 (conductor-section before))
      (assert-equal 'lap2 (conductor-section after))
      (assert-equal '(28 . 0) (conductor-position after))
      (assert-equal #f (conductor-pending after))
      (assert-equal 2 (length (conductor-log (conductor-step after))))))

  (test "crossing prediction leaves a full bar to hand over the jump"
    (let ((c (advance (conductor-new 'lap1) 20)))
      (assert-equal 2 (predicted-jump-bar c 0.0))
      (assert-equal 3 (predicted-jump-bar c 4.8))))

  (test "same tick decisions replay the identical positions and log"
    (let ((first (advance (conductor-plan (conductor-new 'hold) 'fill 4) 800))
          (second (advance (conductor-plan (conductor-new 'hold) 'fill 4) 800)))
      (assert-equal (conductor-position first) (conductor-position second))
      (assert-equal (conductor-log first) (conductor-log second))))

  (test "walker handoff excludes both bar boundaries"
    (assert-equal 'wait (jump-handoff-window 999 1000 2000))
    (assert-equal 'wait (jump-handoff-window 1000 1000 2000))
    (assert-equal 'send (jump-handoff-window 1001 1000 2000))
    (assert-equal 'send (jump-handoff-window 1999 1000 2000))
    (assert-equal 'missed (jump-handoff-window 2000 1000 2000))))

(test-group "conductor: audible pacing"
  (test "the nudge absorbs a 1% clock skew over two minutes"
    (let loop ((frame 0) (sim 0.0) (ear 0.0) (p (pacing-new)))
      (if (= frame 7200)
          (assert-true (< (abs (- ear sim)) 0.030))
          (let* ((dt (/ 1.0 60.0))
                 (next (pace-frame p dt sim ear #t #f (quotient frame 103))))
            (assert-equal #f (pacing-resync? next))
            (loop (+ frame 1) (+ sim (pacing-dt next)) (+ ear (* dt 1.01)) next)))))

  (test "audible clock subtracts depth, device latency and pause silence"
    (assert-true (< (abs (- 1.815 (audible-seconds 96000 6000 48000 0.035 1200))) 1e-9)))

  (test "a small error nudges ticks toward the ear without changing song position"
    (let ((p (pace-frame (pacing-new) 1.0 5.0 5.020 #t #f 3)))
      (assert-true (> (pacing-dt p) 1.0))
      (assert-true (<= (pacing-dt p) 1.02))
      (assert-equal #f (pacing-resync? p))))

  (test "large gaps request audio resync at most once per bar, with a 2% cap"
    (let* ((p (pace-frame (pacing-new) 1.0 5.0 6.0 #t #f 3))
           (again (pace-frame p 1.0 5.0 6.0 #t #f 3))
           (next (pace-frame again 1.0 5.0 6.0 #t #f 4)))
      (assert-true (pacing-resync? p))
      (assert-equal 1.02 (pacing-dt p))
      (assert-equal #f (pacing-resync? again))
      (assert-true (pacing-resync? next))))

  ;; Until its first corrected sample is heard, a resync leaves the gap
  ;; reading the old epoch; a new bar must not ask for it again.
  (test "no resync request while one is in flight; the nudge still runs"
    (let* ((p (pace-frame (pacing-new) 1.0 5.0 6.0 #t #f 3))
           (queued (pace-frame p 1.0 5.0 6.0 #t #f 4 in-flight: #t))
           (heard (pace-frame queued 1.0 5.0 6.0 #t #f 4 in-flight: #f)))
      (assert-true (pacing-resync? p))
      (assert-equal #f (pacing-resync? queued))
      (assert-equal 3 (pacing-last-resync-bar queued))
      (assert-equal 1.02 (pacing-dt queued))
      (assert-true (pacing-resync? heard))
      (assert-equal 4 (pacing-last-resync-bar heard))))

  (test "pause freezes pacing; suspended audio uses wall time"
    (assert-equal 0.0 (pacing-dt (pace-frame (pacing-new) 1.0 0.0 4.0 #t #t 0)))
    (let ((p (pace-frame (pacing-new) 1.0 0.0 4.0 #f #f 0)))
      (assert-equal 1.0 (pacing-dt p))
      (assert-equal #f (pacing-resync? p))))

  ;; A collection stalled the frame while the song kept playing from its
  ;; ring. With Substratic's six ticks, every frame past 100 ms threw
  ;; simulation time away and left the race behind the ear.
  (test "at six ticks the capped advance is Substratic's clock, drop for drop"
    (for-each
      (lambda (acc0)
        (for-each
          (lambda (dt)
            (let* ((c (clock-advance (clock-new) acc0))
                   (a (clock-advance c dt))
                   (b (clock-advance-capped c dt MAX-STEPS-PER-FRAME)))
              (assert-equal (clock-steps a) (clock-steps b))
              (assert-equal (clock-ticks a) (clock-ticks b))
              (assert-equal (clock-acc a) (clock-acc b))
              (assert-equal (clock-dropped a) (clock-dropped b))))
          (list 0.0 0.004 (/ 1.0 60.0) 0.05 0.0833 0.0999 0.1 0.12 0.25 2.0)))
      (list 0.0 0.009 0.0166)))

  (test "a 120 ms stall with the song playing loses no simulation time"
    (let* ((c (clock-advance (clock-new) 0.01))
           (six (clock-advance c 0.12))
           (caught (clock-advance-capped c 0.12 CATCH-UP-STEPS)))
      (assert-true (> (clock-dropped six) 0.01))
      (assert-equal 7 (clock-steps caught))
      (assert-equal 0.0 (clock-dropped caught))
      (assert-true (< (abs (- (+ (* 7 SIM-STEP) (clock-acc caught)) 0.13)) 1e-9))))

  (test "past the ring's depth the remainder still drops"
    (let ((c (clock-advance-capped (clock-new) 0.4 CATCH-UP-STEPS)))
      (assert-equal 15 (clock-steps c))
      (assert-true (< (abs (- (clock-dropped c) 0.15)) 1e-9)))))
