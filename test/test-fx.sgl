;;; The effects' state and the beat seam: the stub keeps the conductor's
;;; clock, the drop lands on a downbeat, a glitch never outlasts P15's 100 ms,
;;; the chase steps only on hats, the tracer strikes one bar after it marks,
;;; interference follows the tiers, and the horizon bend inverts.

(import (sigil test)
        (sigil math)
        (sigil list)
        (signal fx beat)
        (signal fx state))

(define (near? a b eps) (< (abs (- a b)) eps))
(define ALL-ON (lambda (k) 1.0))
(define POSE '(1000.0 1000.0 0.0))

;; Run n ticks of the stub from tick t0; ev: (lambda (tick) events),
;; fires: (lambda (tick) fires). Returns the list of states, oldest first.
(define (run n section integrity ev fires . opts)
  (let ((knob (if (pair? opts) (car opts) ALL-ON))
        (traced-at (and (pair? opts) (pair? (cdr opts)) (cadr opts))))
    (let loop ((k 1) (st (fx-new)) (acc '()))
      (if (> k n)
          (reverse acc)
          (let ((st (fx-step st (stub-pulse k section traced-at) (ev k) integrity POSE (fires k) knob)))
            (loop (+ k 1) st (cons (fx-copy st) acc)))))))
(define (none k) '())

(test-group "beat seam"
  (test "the stub's rows are the conductor's: 140 BPM, 8 rows a beat"
    ;; a bar is 32 rows = 4 beats = 60/140*4 s = 102.86 ticks
    (assert-equal 0 (tick->row 0))
    (assert-equal 30 (tick->row 99))
    (assert-equal 31 (tick->row 102))
    (assert-equal 32 (tick->row 103))
    (assert-equal 1 (tick->bar 103))
    (assert-equal 103 (bar->tick 1))
    (assert-equal 206 (bar->tick 2))
    (assert-equal 2 (tick->bar (bar->tick 2)))
    (assert-equal 1 (tick->bar (- (bar->tick 2) 1))))

  (test "each row's onsets are offered on exactly one tick"
    (let loop ((t 1) (kicks 0))
      (if (> t (bar->tick 4))
          (assert-equal 16 kicks)
          (loop (+ t 1) (+ kicks (if (onset? (stub-pulse t 'lap1 #f) KICK) 1 0))))))

  (test "the drop lands on the first downbeat at or after the crossing"
    (let* ((cross 250)
           (drops (let loop ((t 1) (acc '()))
                    (if (> t 600) (reverse acc)
                        (loop (+ t 1) (if (pulse-drop (stub-pulse t 'traced cross)) (cons t acc) acc))))))
      (assert-equal (list (bar->tick 3)) drops)))

  (test "a crossing exactly on a downbeat drops on that downbeat"
    (assert-true (pulse-drop (stub-pulse (bar->tick 5) 'traced (bar->tick 5)))))

  (test "sections follow the race"
    (assert-equal 'calm (stub-section 'title 0 3 #f))
    (assert-equal 'grid (stub-section 'countdown 0 3 #f))
    (assert-equal 'lap1 (stub-section 'race 1 3 #t))
    (assert-equal 'lap2 (stub-section 'race 2 3 #f))
    (assert-equal 'hold (stub-section 'race 2 3 #t))
    (assert-equal 'traced (stub-section 'race 3 3 #f))
    (assert-equal 'uplink (stub-section 'finished 3 3 #t))
    (assert-equal 'hold (stub-section 'race 1 2 #t))
    (assert-equal 'lap1 (stub-section 'race 1 2 #f))))

(test-group "effects state"
  (test "a glitch never runs more than 6 ticks, however hard the hit"
    (for-each
      (lambda (impact)
        (let* ((sts (run 40 'lap1 100.0 (lambda (k) (if (= k 5) (list (cons 'wall impact)) '())) none))
               (on (length (filter (lambda (s) (> (fx-glitch-now s) 0.0)) sts))))
          (assert-true (>= on 2))
          (assert-true (<= on GLITCH-MAX-TICKS))))
      '(20.0 300.0 5000.0)))

  (test "a scrape (a hit every tick) glitches at most 6 ticks in any 30"
    (let* ((n 120)
           (sts (run n 'lap1 100.0 (lambda (k) (if (<= 3 k 95) (list (cons 'wall 250.0)) '())) none))
           (on (list->vector (map (lambda (s) (if (> (fx-glitch-now s) 0.0) 1 0)) sts)))
           (window (lambda (from) (let loop ((k from) (c 0)) (if (or (= k n) (= k (+ from GLITCH-REST))) c (loop (+ k 1) (+ c (vector-ref on k))))))))
      (assert-true (> (apply + (vector->list on)) 0))
      (let loop ((from 0))
        (when (< from n)
          (assert-true (<= (window from) GLITCH-MAX-TICKS))
          (loop (+ from 1))))))

  (test "a harder hit during a glitch makes it harder, not longer"
    (let* ((sts (run 30 'lap1 100.0 (lambda (k) (cond ((= k 2) (list (cons 'wall 30.0))) ((= k 3) (list (cons 'wall 600.0))) (else '()))) none))
           (on (length (filter (lambda (s) (> (fx-glitch-now s) 0.0)) sts))))
      (assert-true (<= on GLITCH-MAX-TICKS))
      (assert-true (near? 1.0 (fx-glitch-now (list-ref sts 2)) 1e-9))))

  (test "a harder hit glitches harder and longer"
    (let ((count (lambda (impact)
                   (length (filter (lambda (s) (> (fx-glitch-now s) 0.0))
                                   (run 30 'lap1 100.0 (lambda (k) (if (= k 2) (list (cons 'wall impact)) '())) none))))))
      (assert-true (< (count 30.0) (count 300.0)))))

  (test "the glitch's knob at 0 turns it off"
    (let ((sts (run 30 'lap1 100.0 (lambda (k) (if (= k 2) (list (cons 'wall 300.0) 'ice) '())) none
                    (lambda (k) (if (eq? k 'fx-glitch) 0.0 1.0)))))
      (assert-true (null? (filter (lambda (s) (> (fx-glitch-now s) 0.0)) sts)))))

  (test "the chase steps once per hat and never otherwise"
    ;; to one tick before bar 2's downbeat: 8 hats but 7 kicks, so a chase
    ;; stepping on the kick (or on every beat) comes out wrong
    (let* ((n (- (bar->tick 2) 1))
           (count (lambda (bit) (let loop ((t 1) (h 0)) (if (> t n) h (loop (+ t 1) (+ h (if (onset? (stub-pulse t 'lap1 #f) bit) 1 0)))))))
           (sts (run n 'lap1 100.0 none none)))
      (assert-equal 8 (count HATS))
      (assert-equal 7 (count KICK))
      (assert-equal 8 (fx-chase (list-ref sts (- n 1))))
      ;; a kick with no hat (bar 1's downbeat) leaves the chase where it was
      (let ((k (bar->tick 1)))
        (assert-true (onset? (stub-pulse k 'lap1 #f) KICK))
        (assert-false (onset? (stub-pulse k 'lap1 #f) HATS))
        (assert-equal (fx-chase (list-ref sts (- k 2))) (fx-chase (list-ref sts (- k 1)))))))

  (test "the dip peaks on the drop and settles"
    (let* ((cross 250)
           (sts (run 600 'traced 100.0 none none ALL-ON cross))
           (at (lambda (t) (fx-dip-rows (list-ref sts (- t 1)) 1.0))))
      (assert-true (near? 0.0 (at (- (bar->tick 3) 1)) 1e-9))
      (assert-true (near? DIP-ROWS (at (bar->tick 3)) 1e-9))
      (assert-true (< (at (+ (bar->tick 3) 35)) 0.0))     ; the crest overshoot
      (assert-true (near? 0.0 (at (+ (bar->tick 3) 130)) 1e-9))))

  (test "the dip is off at intensity 0"
    (let ((sts (run 400 'traced 100.0 none none ALL-ON 250)))
      (assert-true (near? 0.0 (fx-dip-rows (list-ref sts (bar->tick 3)) 0.0) 1e-12))))

  (test "a tracer marks on a downbeat and strikes on the next one"
    (let* ((sts (run 400 'traced 100.0 none (lambda (k) (if (= k 10) '(ice) '()))))
           (placed (let loop ((ss sts) (t 1)) (cond ((null? ss) #f) ((fx-warp (car ss)) t) (else (loop (cdr ss) (+ t 1))))))
           (struck (let loop ((ss sts) (t 1)) (cond ((null? ss) #f) ((fx-warp-struck (car ss)) t) (else (loop (cdr ss) (+ t 1)))))))
      (assert-equal (bar->tick 1) placed)
      (assert-equal (bar->tick 2) struck)
      ;; the ripple is off the road within 6 ticks of the strike (P15)
      (assert-true (> (fx-warp-strength (list-ref sts (- struck 1))) 0.0))
      (assert-false (fx-warp (list-ref sts (+ struck 5))))
      ;; the strike glitches
      (assert-true (> (fx-glitch-now (list-ref sts (- struck 1))) 0.0))
      ;; the strip lies ahead along the heading (0: up the map, -y)
      (let ((w (fx-warp (list-ref sts (- placed 1)))))
        (assert-true (< (cadr w) (cadr POSE))))))

  (test "tiers and their dropouts"
    (assert-equal 0 (integrity-tier 100.0))
    (assert-equal 1 (integrity-tier 79.9))
    (assert-equal 2 (integrity-tier 54.0))
    (assert-equal 3 (integrity-tier 29.0))
    (assert-equal 4 (integrity-tier 9.0))
    (assert-equal 5 (integrity-tier 0.0))
    (assert-false (tier-dropout? 0 30))
    (assert-false (tier-dropout? 1 30))
    ;; DAMAGED: one 16th a bar
    (assert-equal 2 (length (filter (lambda (r) (tier-dropout? 2 r)) (iota 32))))
    ;; FAILING: every other beat, a 16th each
    (assert-equal 4 (length (filter (lambda (r) (tier-dropout? 3 r)) (iota 32)))))

  (test "interference follows integrity and stays off when clean"
    (let ((clean (run 200 'lap1 100.0 none none))
          (low (run 200 'lap1 20.0 none none)))
      (assert-true (near? 0.0 (fx-interf (list-ref clean 199)) 1e-12))
      (assert-true (near? 0.75 (fx-interf (list-ref low 199)) 1e-9))
      (assert-equal 3 (fx-tier (list-ref low 199)))))

  (test "the tower turns violet only while traced"
    (assert-true (near? 0.0 (fx-traced (list-ref (run 100 'lap2 100.0 none none) 99)) 1e-12))
    (assert-true (near? 1.0 (fx-traced (list-ref (run 100 'traced 100.0 none none) 99)) 1e-12))))

(test-group "horizon bend"
  (test "the bend's screen row inverts the shader's flat row"
    (for-each (lambda (a)
                (for-each (lambda (yf)
                            (let ((py (bend-screen-row yf a 80.0 270.0)))
                              (assert-true (near? yf (- py (bend-offset py a 80.0 270.0)) 1e-3))))
                          '(60.0 80.0 81.0 120.0 200.0 269.0)))
              '(12.0 -4.0 0.0)))
  (test "the sky moves with the horizon; the bottom row does not move"
    (assert-true (near? 12.0 (bend-offset 40.0 12.0 80.0 270.0) 1e-12))
    (assert-true (near? 0.0 (bend-offset 270.0 12.0 80.0 270.0) 1e-12))))
