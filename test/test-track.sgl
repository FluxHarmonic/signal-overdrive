;;; The track probe: arc length, the signed distance, the hint, zones.

(import (sigil test)
        (sigil math)
        (signal track))

(define (near? a b eps) (< (abs (- a b)) eps))
(define T (loop-track))

;; A straight corridor east along y = 0, 1000 long, half-width 50, as a
;; closed loop of two straights would be too clever: a long thin loop.
(define (straight-track)
  (let ((v (make-vector (* 6 4) 0.0)))
    (define (put! i x y tx ty) (vector-set! v (* 6 i) x) (vector-set! v (+ (* 6 i) 1) y)
      (vector-set! v (+ (* 6 i) 2) tx) (vector-set! v (+ (* 6 i) 3) ty)
      (vector-set! v (+ (* 6 i) 4) 50.0) (vector-set! v (+ (* 6 i) 5) 0.0))
    (put! 0 0.0 0.0 1.0 0.0) (put! 1 1000.0 0.0 1.0 0.0)
    (put! 2 1000.0 400.0 -1.0 0.0) (put! 3 0.0 400.0 -1.0 0.0)
    (make-track v 16.0 '((100.0 150.0 -1.0 1.0)) '((300.0 500.0 -1.0 -0.5)))))

(test-group "track probe"
  (test "the loop is long and closed"
    (assert-true (> (track-length T) 10000.0))
    (assert-true (near? (track-s T 0) 0.0 1e-9)))

  (test "a point on the centreline has d 0 and s its arc length"
    (let* ((pt (track-point T 3000.0 0.0))
           (p (track-probe T (car pt) (cadr pt) #f)))
      (assert-true (near? (probe-s p) 3000.0 0.5))
      (assert-true (near? (probe-d p) 0.0 0.5))))

  (test "a point half a half-width to the right has d = +hw/2"
    (let* ((pt (track-point T 5000.0 0.5))
           (p (track-probe T (car pt) (cadr pt) #f)))
      (assert-true (near? (probe-d p) (* 0.5 (probe-hw p)) 1.0))))

  (test "the left is negative"
    (let* ((pt (track-point T 7000.0 -0.8))
           (p (track-probe T (car pt) (cadr pt) #f)))
      (assert-true (< (probe-d p) -40.0))))

  (test "a hinted probe agrees with a full search"
    (let loop ((s 0.0))
      (when (< s (track-length T))
        (let* ((pt (track-point T s 0.3))
               (full (track-probe T (car pt) (cadr pt) #f))
               (hinted (track-probe T (car pt) (cadr pt) (probe-i (track-probe T (car pt) (cadr pt) #f)))))
          (assert-true (near? (probe-s full) (probe-s hinted) 1e-6))
          (assert-true (near? (probe-d full) (probe-d hinted) 1e-6)))
        (loop (+ s 997.0)))))

  (test "s-ahead wraps across the start line"
    (assert-true (near? (s-ahead T (- (track-length T) 10.0) 5.0) 15.0 1e-6))
    (assert-true (near? (s-ahead T 5.0 (- (track-length T) 10.0)) -15.0 1e-6)))

  (test "zones: the corridor's boost pad and repair strip"
    (let* ((st (straight-track))
           (pad (track-probe st 120.0 0.0 #f))
           (off (track-probe st 200.0 0.0 #f))
           (rep (track-probe st 400.0 -40.0 #f))
           (rep-wrong-side (track-probe st 400.0 40.0 #f)))
      (assert-true (track-on-boost? st pad))
      (assert-false (track-on-boost? st off))
      ;; y down: -40 is up the map, the left of an eastward run
      (assert-true (< (probe-d rep) 0.0))
      (assert-true (track-on-repair? st rep))
      (assert-false (track-on-repair? st rep-wrong-side))))

  (test "the oval: two boost pads, a repair strip, and wider than the loop"
    (let ((o (track-named 'oval)))
      (assert-equal 'oval (track-name o))
      (assert-equal 2 (length (track-boost o)))
      (assert-equal 1 (length (track-repair o)))
      (assert-true (> (track-hw o 0) (track-hw T 0)))))

  (test "the loop has four boost pads and a repair strip"
    (assert-equal 4 (length (track-boost T)))
    (assert-equal 1 (length (track-repair T))))

  (test "generated tracks carry5120 worlds; explicit rectangular bounds stay separate"
    (let* ((o (track-named 'oval))
           (r (make-track (track-samples o) (track-step o)
                          (track-boost o) (track-repair o) 'rectangle
                          (track-ice o) 8192 4096)))
      (assert-equal 5120 (track-world-width T))
      (assert-equal 5120 (track-world-height o))
      (assert-equal 8192 (track-world-width r))
      (assert-equal 4096 (track-world-height r))
      (assert-equal 5120 (track-world-width (straight-track))))))
