;;; The race: the countdown, laps and lap times, rivals completing laps on
;;; the racing line, the finish, and corrupt cargo ending a run.

(import (sigil test)
        (sigil math)
        (signal track)
        (signal handling)
        (signal race)
        (signal tuning)
        (signal music conductor)
        (sigil list))

(define T (tuning-defaults))
(define GRID-TICKS (song-bar->tick 4))

;; The player on the racing line too (the autopilot), n ticks.
(define (run tuning r n)
  (let loop ((r r) (i 0))
    (if (= i n)
        r
        (let ((in (ai-input (race-track r) (racer-machine (race-player r)) 0.0 #t)))
          (loop (race-step tuning r in #f) (+ i 1))))))

(define (started tuning) (race-step tuning (race-new tuning) NO-INPUT #t))

(test-group "race: start"
  (test "the title waits; a start runs four grid bars, then GO starts lap1"
    (let* ((r (race-new T)))
      (assert-equal 'title (race-phase (race-step T r NO-INPUT #f)))
      (let ((c (started T)))
        (assert-equal 'countdown (race-phase c))
        (assert-equal 'countdown (race-phase (run T c (- GRID-TICKS 1))))
        (let ((go (run T c GRID-TICKS)))
          (assert-equal 'race (race-phase go))
          (assert-equal 'lap1 (conductor-section (race-song go)))
          (assert-equal 0 (race-clock go))))))

  (test "nobody moves in the countdown"
    (let* ((c (run T (started T) (- GRID-TICKS 1)))
           (m (racer-machine (race-player c))))
      (assert-true (< (machine-speed m) 1e-9))))

  (test "restart resets the song to grid instead of retaining a pending jump"
    (let* ((running (run T (started T) (* 60 20)))
           (restart (race-start T running)))
      (assert-equal 'grid (conductor-section (race-song restart)))
      (assert-equal 0 (conductor-tick (race-song restart)))
      (assert-equal #f (conductor-pending (race-song restart)))
      (assert-equal 1 (length (conductor-log (race-song restart))))))

  (test "the grid has the player and five rivals, behind the line"
    (let ((r (race-new T)))
      (assert-equal 5 (length (race-rivals r)))
      (assert-equal 0 (racer-lap (race-player r)))
      (assert-true (> (machine-s (racer-machine (race-player r))) (* 0.9 (track-length (race-track r))))))))

(test-group "race: laps"
  ;; one long run, shared by the cases below: two laps on the line
  (define R2 (run (handling-set T 'laps 2.0) (started (handling-set T 'laps 2.0)) (* 60 90)))

  (test "crossing the line starts lap 1"
    (let ((r (run T (started T) (+ GRID-TICKS 120))))
      (assert-equal 1 (racer-lap (race-player r)))))

  (test "the autopilot finishes two laps inside 90 s, with lap times"
    (let ((p (race-player R2)))
      (assert-equal 'finished (race-phase R2))
      (assert-true (racer-finished p))
      (assert-true (racer-best-lap p))
      ;; the default track is the cup's first (Breakwater): at most 560
      ;; texels/s, so never under its length over top speed, and inside the
      ;; 35 s par gate on the line
      (assert-true (> (racer-best-lap p) (* 60 (/ (track-length (race-track R2)) 560.0))))
      (assert-true (< (racer-best-lap p) (* 60 35)))))

  (test "an out-of-range track index clamps to the last track, the oval"
    (let* ((tu (handling-set (handling-set T 'track 9.0) 'laps 1.0))
           (r (run tu (started tu) (* 60 50))))
      (assert-equal 'oval (track-name (race-track r)))
      (assert-equal 'finished (race-phase r))
      (for-each (lambda (x) (assert-true (racer-finished x))) (race-rivals r))))

  (test "every rival completes laps too"
    (for-each (lambda (x) (assert-true (>= (racer-lap x) 2))) (race-rivals R2)))

  (test "the places are 1 to 6, each once"
    (let ((ps (cons (racer-place (race-player R2)) (map racer-place (race-rivals R2)))))
      (assert-equal 21 (apply + ps))
      (assert-equal 1 (apply min ps))
      (assert-equal 6 (apply max ps))))

  (test "crossing the line again without passing halfway counts no lap"
    ;; just over the line on lap 1, put back 60 texels behind it, heading
    ;; on: it crosses the line a second time, which is not a lap
    (let* ((r (run T (started T) (+ GRID-TICKS 120)))
           (t (race-track r))
           (p (race-player r))
           (pt (track-point t (- (track-length t) 60.0) 0.0))
           (m (machine (racer-machine p) x: (car pt) y: (cadr pt)
                       heading: (atan (caddr pt) (- (cadddr pt))) hint: #f
                       s: (- (track-length t) 60.0)))
           (r2 (run T (race r player: (racer p machine: m)) 120)))
      (assert-equal 1 (racer-lap (race-player r)))
      ;; it did cross: it is past the line again
      (assert-true (< (machine-s (racer-machine (race-player r2))) 1000.0))
      (assert-equal 1 (racer-lap (race-player r2)))))

  (test "pushed back over the line on lap 1, a machine's progress does not jump a lap"
    (let* ((r (run T (started T) (+ GRID-TICKS 120)))
           (t (race-track r))
           (p (race-player r))
           (before (racer-progress p))
           (pt (track-point t (- (track-length t) 5.0) 0.0))
           (m (machine (racer-machine p) x: (car pt) y: (cadr pt) hint: #f vx: 0.0 vy: 0.0))
           (r2 (race-step T (race r player: (racer p machine: m)) NO-INPUT #f)))
      (assert-equal 1 (racer-lap (race-player r2)))
      (assert-true (< (racer-progress (race-player r2)) before))))

  (test "after the finish, laps the autopilot drives change no times"
    ;; on the oval, the short handling test, so one lap fits in 30 s
    (let* ((tu (handling-set (handling-set T 'track (exact->inexact (track-index-of 'oval))) 'laps 1.0))
           (done (run tu (started tu) (* 60 30)))
           (p (race-player done))
           (later (run tu done (* 60 30)))
           (q (race-player later)))
      (assert-equal 'finished (race-phase done))
      (assert-equal (racer-best-lap p) (racer-best-lap q))
      (assert-equal (racer-last-lap p) (racer-last-lap q))
      (assert-equal (racer-finished p) (racer-finished q))))

  (test "driving backwards over the line counts no lap"
    ;; turned round on the grid: full throttle the wrong way for 10 s
    (let* ((c (run T (started T) GRID-TICKS))
           (p (race-player c))
           (m (racer-machine p))
           (back (machine m heading: (+ (machine-heading m) 3.141592653589793)))
           (r (race c player: (racer p machine: back))))
      (let loop ((r r) (i 0))
        (if (< i 600)
            (loop (race-step T r (make-input 0.0 1.0 0.0 #f #f) #f) (+ i 1))
            (assert-equal 0 (racer-lap (race-player r))))))))

(test-group "race: ICE and the rivals"
  ;; the review's HIGH: ICE inverted every machine's steering, and the AI's
  ;; proportional steering, inverted, turns away from its line ever harder
  (test "a rival driven over the oval's ICE patch keeps off the walls"
    (let* ((t (track-named 'oval))
           (z (car (track-ice t)))
           (s0 (- (car z) 250.0))
           (u (* 0.5 (+ (caddr z) (cadddr z))))
           (pt (track-point t s0 u))
           (m0 (machine (make-machine (car pt) (cadr pt) (atan (caddr pt) (- (cadddr pt))))
                        hint: (track-index-at t s0) s: s0
                        vx: (* 450.0 (caddr pt)) vy: (* 450.0 (cadddr pt)))))
      (let loop ((m m0) (i 0) (walls 0) (iced #f))
        (if (< i 180)
            (let ((m2 (machine-step T t m (ai-input t m (- u (track-line t (track-index-at t (machine-s m)))) #f) (/ 1.0 60.0))))
              (loop m2 (+ i 1)
                    (+ walls (length (filter (lambda (e) (and (pair? e) (eq? (car e) 'wall))) (machine-events m2))))
                    (or iced (> (machine-scramble m2) 0.0))))
            (begin
              (assert-true iced)              ; it did cross the patch
              (assert-equal 0 walls)))))))

(test-group "race: song progression"
  (test "a full three-lap race visits every race section and the coda"
    (let* ((tu (handling-set (handling-set T 'track 1.0) 'laps 3.0))
           (r (run tu (started tu) (* 60 130)))
           (log (reverse (conductor-log (race-song r)))))
      (assert-equal 'finished (race-phase r))
      (assert-equal '(grid lap1 lap2 hold fill traced uplink results)
                    (map (lambda (entry) (vector-ref entry 2)) log))
      (assert-equal 'results (conductor-section (race-song r)))
      (for-each (lambda (entry)
                  (assert-equal (song-bar->tick (vector-ref entry 1)) (vector-ref entry 0)))
                log))))

(test-group "race: corrupt cargo"
  (test "integrity at zero ends the run as corrupt, and a start restarts it"
    (let* ((c (run T (started T) GRID-TICKS))
           (p (race-player c))
           (r (race c player: (racer p machine: (machine (racer-machine p) integrity: 0.0))))
           (r2 (race-step T r NO-INPUT #f)))
      (assert-equal 'corrupt (race-phase r2))
      ;; a start is taken only after a second
      (assert-equal 'corrupt (race-phase (race-step T r2 NO-INPUT #t)))
      (let ((later (let loop ((r r2) (i 0)) (if (= i 70) r (loop (race-step T r NO-INPUT #f) (+ i 1))))))
        (assert-equal 'countdown (race-phase (race-step T later NO-INPUT #t)))))))
