;;; The race: the countdown, laps and lap times, rivals completing laps on
;;; the racing line, the finish, and corrupt cargo ending a run.

(import (sigil test)
        (sigil math)
        (racer track)
        (racer handling)
        (racer race)
        (racer tuning))

(define T (tuning-defaults))

;; The player on the racing line too (the autopilot), n ticks.
(define (run tuning r n)
  (let loop ((r r) (i 0))
    (if (= i n)
        r
        (let ((in (ai-input (loop-track) (racer-machine (race-player r)) 0.0 #t)))
          (loop (race-step tuning r in #f) (+ i 1))))))

(define (started tuning) (race-step tuning (race-new tuning) NO-INPUT #t))

(test-group "race: start"
  (test "the title waits; a start begins a 3 s countdown, then the race"
    (let* ((r (race-new T)))
      (assert-equal 'title (race-phase (race-step T r NO-INPUT #f)))
      (let ((c (started T)))
        (assert-equal 'countdown (race-phase c))
        (assert-equal 'countdown (race-phase (run T c 170)))
        (assert-equal 'race (race-phase (run T c 181))))))

  (test "nobody moves in the countdown"
    (let* ((c (run T (started T) 120))
           (m (racer-machine (race-player c))))
      (assert-true (< (machine-speed m) 1e-9))))

  (test "the grid has the player and three rivals, behind the line"
    (let ((r (race-new T)))
      (assert-equal 3 (length (race-rivals r)))
      (assert-equal 0 (racer-lap (race-player r)))
      (assert-true (> (machine-s (racer-machine (race-player r))) (* 0.9 (track-length (loop-track))))))))

(test-group "race: laps"
  ;; one long run, shared by the cases below: two laps on the line
  (define R2 (run (handling-set T 'laps 2.0) (started (handling-set T 'laps 2.0)) (* 60 90)))

  (test "crossing the line starts lap 1"
    (let ((r (run T (started T) (+ 181 120))))
      (assert-equal 1 (racer-lap (race-player r)))))

  (test "the autopilot finishes two laps inside 90 s, with lap times"
    (let ((p (race-player R2)))
      (assert-equal 'finished (race-phase R2))
      (assert-true (racer-finished p))
      (assert-true (racer-best-lap p))
      ;; a lap on this loop is 14,538 texels: at most 560 texels/s, so
      ;; never under 26 s, and the line should take less than 45
      (assert-true (> (racer-best-lap p) (* 60 26)))
      (assert-true (< (racer-best-lap p) (* 60 45)))))

  (test "every rival completes laps too"
    (for-each (lambda (x) (assert-true (>= (racer-lap x) 2))) (race-rivals R2)))

  (test "the places are 1 to 4, each once"
    (let ((ps (cons (racer-place (race-player R2)) (map racer-place (race-rivals R2)))))
      (assert-equal 10 (apply + ps))
      (assert-equal 1 (apply min ps))
      (assert-equal 4 (apply max ps))))

  (test "driving backwards over the line counts no lap"
    ;; turned round on the grid: full throttle the wrong way for 10 s
    (let* ((c (run T (started T) 181))
           (p (race-player c))
           (m (racer-machine p))
           (back (machine m heading: (+ (machine-heading m) 3.141592653589793)))
           (r (race c player: (racer p machine: back))))
      (let loop ((r r) (i 0))
        (if (< i 600)
            (loop (race-step T r (make-input 0.0 1.0 0.0 #f #f) #f) (+ i 1))
            (assert-equal 0 (racer-lap (race-player r))))))))

(test-group "race: corrupt cargo"
  (test "integrity at zero ends the run as corrupt, and a start restarts it"
    (let* ((c (run T (started T) 181))
           (p (race-player c))
           (r (race c player: (racer p machine: (machine (racer-machine p) integrity: 0.0))))
           (r2 (race-step T r NO-INPUT #f)))
      (assert-equal 'corrupt (race-phase r2))
      ;; a start is taken only after a second
      (assert-equal 'corrupt (race-phase (race-step T r2 NO-INPUT #t)))
      (let ((later (let loop ((r r2) (i 0)) (if (= i 70) r (loop (race-step T r NO-INPUT #f) (+ i 1))))))
        (assert-equal 'countdown (race-phase (race-step T later NO-INPUT #t)))))))
