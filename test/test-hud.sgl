;;; The HUD under reduced motion: blinking text shown steady (hud-blink?),
;;; the meter under 30 a steady red (meter-colour); in full motion both
;;; blink as before. scripts/gate-motion checks the drawn text in the
;;; browser (the title's prompts and TRACED.).

(import (sigil test)
        (signal scene))

(define (every? f lo hi)
  (let loop ((k lo)) (or (>= k hi) (and (f k) (loop (+ k 1))))))
(define (some? f lo hi)
  (let loop ((k lo)) (and (< k hi) (or (f k) (loop (+ k 1))))))

(test-group "blinking text"
  (test "with reduced motion it is always shown"
    (for-each (lambda (half) (assert-true (every? (lambda (k) (hud-blink? #t k half)) 0 600)))
              '(4 10 30)))
  (test "in full motion it blinks on the odd halves, as before"
    (for-each (lambda (half)
                (assert-true (every? (lambda (k) (eq? (hud-blink? #f k half) (odd? (quotient k half)))) 0 600))
                (assert-true (some? (lambda (k) (not (hud-blink? #f k half))) 0 600)))
              '(4 10 30))))

(test-group "the meter's colour"
  (test "under 30 with reduced motion: a steady red"
    (assert-true (every? (lambda (k) (string=? "#FF5959" (meter-colour 20.0 0 k #t))) 0 600)))
  (test "under 30 in full motion: red pulsing to a darker red every 8 ticks, as before"
    (assert-true (every? (lambda (k) (string=? (if (odd? (quotient k 8)) "#CC3340" "#FF5959")
                                               (meter-colour 20.0 0 k #f)))
                         0 600)))
  (test "from 30 up cyan, and white in a hit's flash, either way"
    (for-each (lambda (calm)
                (assert-true (every? (lambda (k) (string=? "#4DF2D9" (meter-colour 30.0 0 k calm))) 0 100))
                (assert-true (every? (lambda (k) (string=? "#FAFCFF" (meter-colour 20.0 3 k calm))) 0 100)))
              '(#t #f))))

(test-group "damage popups"
  (test "with reduced motion they stay in place, opaque, then fade over their last 20 ticks"
    (assert-true (every? (lambda (k) (= 0 (car (popup-look k #t)))) 0 50))
    (assert-true (every? (lambda (k) (= 1.0 (cadr (popup-look k #t)))) 0 31))
    (assert-true (every? (lambda (k) (< (cadr (popup-look (+ k 1) #t)) (cadr (popup-look k #t)))) 30 49))
    (assert-true (every? (lambda (k) (> (cadr (popup-look k #t)) 0.0)) 0 50)))
  (test "in full motion they rise a row every 6 ticks, opaque, as before"
    (assert-true (every? (lambda (k) (equal? (list (quotient k 6) 1.0) (popup-look k #f))) 0 50))))

;; popups aged n ticks, as the shell ages them
(define (age-popups ps n)
  (map (lambda (p) (list (car p) (cadr p) (+ n (caddr p)) (cadddr p))) ps))

(test-group "popup slots"
  (test "two at once with reduced motion: each its own row, apart, still, both readable"
    (let* ((ps (popups-add (popups-add '() "-12" "#F2731A" #t) "-3" "#FF5959" #t))
           (a (cadr ps)) (b (car ps)))
      (assert-true (every? (lambda (k)
                             (let ((ra (popup-row (car (age-popups (list a) k)) #t))
                                   (rb (popup-row (car (age-popups (list b) k)) #t)))
                               ;; the text is 7 rows high: rows apart by 8 or more never overlap
                               (and (>= (abs (- ra rb)) 8)
                                    (= ra (popup-row a #t)) (= rb (popup-row b #t)))))
                           0 50))))
  (test "with all slots taken, a new one takes the oldest's, and every live one keeps its own"
    (let* ((full (let loop ((k 0) (ps '()))
                   (if (= k POPUP-SLOTS) ps (loop (+ k 1) (popups-add (age-popups ps 5) "-1" "#FF5959" #t)))))
           (more (popups-add full "+" "#4DF2D9" #t))
           (slots (map cadddr more)))
      (assert-equal POPUP-SLOTS (length more))
      (assert-equal (cadddr (car (reverse full))) (cadddr (car more)))
      (assert-true (every? (lambda (k) (memv k slots)) 0 POPUP-SLOTS))))
  (test "in full motion each starts in slot 0 and rises, as before"
    (let ((ps (popups-add (popups-add '() "-12" "#F2731A" #f) "-3" "#FF5959" #f)))
      (assert-equal '(0 0) (map cadddr ps))
      (assert-true (every? (lambda (k) (= (- 15 (quotient k 6)) (popup-row (car (age-popups ps k)) #f))) 0 50)))))
