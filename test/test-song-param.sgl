;;; song=ID picks the race song for checks and auditions. It is a
;;; development control: natively it always applies, and on the web only
;;; with ?dev, which may come before or after it. Without ?dev a web race
;;; plays the song its track binds.

(import (sigil test)
        (substratic store kv)
        (signal music song)
        (only (signal track) TRACKS)
        (signal shell core))

(set-store-root! "/tmp/signal-song-param-test-store")
(core-param! "mute")

;; A race starts on the first track, which plays the song it binds.
(define bound (song-for-track (car TRACKS)))

(test-group "song=ID is a development control"
  (test "natively it applies at once"
    ;; the requested song must differ from the bound one, or this passes vacuously
    (assert-false (eq? bound 'carrier-a))
    (core-boot! 'desktop)
    (core-param! "song=carrier-a")
    (assert-equal 'carrier-a (song-id))
    (song-override! #f)
    (core-boot! 'desktop)
    (assert-equal bound (song-id)))

  (test "on the web it waits for ?dev, then applies"
    (assert-false (eq? bound 'carrier-b))
    ;; an earlier test file in this process may have given ?dev
    (core-test-forget-dev!)
    (core-boot! 'web)
    (core-param! "song=carrier-b")
    (assert-equal bound (song-id))
    (core-boot! 'web)
    (assert-equal bound (song-id))
    (core-param! "dev")
    (assert-equal 'carrier-b (song-id))
    (song-override! #f)))
