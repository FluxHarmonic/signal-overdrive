;;; Source-only shell checks: muted, no graphics and no device calls.
(import (sigil test)
        (substratic input keys)
        (substratic store kv)
        (signal race)
        (signal music conductor)
        (signal shell core))

(set-store-root! "/tmp/signal-conductor-shell-test-store")
(core-param! "mute")

(test-group "shell: fixed ticks and pause"
  (test "muted frames advance on wall time and retain the six-tick stall cap"
    (core-boot! 'desktop)
    (core-advance! (/ 1.0 60.0))
    (assert-equal 1 (race-tick (core-race)))
    (core-advance! 2.0)
    (assert-equal 7 (race-tick (core-race))))

  (test "lost focus freezes ticks and drops the returning hidden interval"
    (core-boot! 'web)
    (core-advance! (/ 1.0 60.0))
    (core-focus! #f)
    (assert-true (core-paused?))
    (core-advance! 10.0)
    (assert-equal 1 (race-tick (core-race)))
    (core-focus! #t)
    (core-advance! 10.0)
    (assert-equal 1 (race-tick (core-race)))
    (core-advance! (/ 1.0 60.0))
    (assert-equal 2 (race-tick (core-race))))

  (test "F5 pause remains paused across focus loss and return"
    (core-boot! 'desktop)
    (keys-down! (core-keys) 'f5)
    (core-advance! (/ 1.0 60.0))
    (keys-up! (core-keys) 'f5)
    (keys-end-frame! (core-keys))
    (assert-true (core-paused?))
    (assert-equal 0 (race-tick (core-race)))
    (core-focus! #f)
    (core-focus! #t)
    (core-advance! 10.0)
    (assert-equal 0 (race-tick (core-race)))
    (keys-down! (core-keys) 'f5)
    (core-advance! (/ 1.0 60.0))
    (keys-up! (core-keys) 'f5)
    (keys-end-frame! (core-keys))
    (assert-false (core-paused?))
    (assert-equal 1 (race-tick (core-race)))))

(test-group "shell: a race start opens its song at tick 0"
  ;; A start mid-frame used to run the frame's remaining ticks on the new
  ;; song, so its music opened at tick 2 or 3: a late join, silent until bar 1.
  (test "a start from the title ends that frame's ticks at the new song's tick 0"
    (core-boot! (quote desktop))
    (core-advance! (/ 1.0 60.0))
    (core-param! "start")
    (core-advance! 0.05)
    (assert-equal (quote countdown) (race-phase (core-race)))
    (assert-equal 0 (conductor-tick (race-song (core-race))))
    ;; the next frame's interval was the old race's; then ticks resume
    (core-advance! (/ 1.0 60.0))
    (assert-equal 0 (conductor-tick (race-song (core-race))))
    (core-advance! (/ 1.0 60.0))
    (assert-equal 1 (conductor-tick (race-song (core-race)))))

  (test "R restarts at the new song's tick 0 even on a long frame"
    (core-boot! (quote desktop))
    (core-param! "start")
    (core-advance! (/ 1.0 60.0))
    (let frames ((n 30))
      (when (> n 0) (core-advance! (/ 1.0 60.0)) (frames (- n 1))))
    (assert-true (> (conductor-tick (race-song (core-race))) 20))
    (keys-down! (core-keys) (quote r))
    (core-advance! 0.05)
    (keys-up! (core-keys) (quote r))
    (keys-end-frame! (core-keys))
    (assert-equal 0 (conductor-tick (race-song (core-race))))))

(test-group "shell: deliberate clock-skew arm"
  (test "the skew arm plants 1% even with audio muted, and none restores wall time"
    (core-boot! 'desktop)
    (core-param! "music-sabotage=skew")
    (let frames ((n 600))
      (when (> n 0)
        (core-advance! (/ 1.0 60.0))
        (frames (- n 1))))
    (assert-true (> (race-tick (core-race)) 600))
    (assert-true (<= (race-tick (core-race)) 606))
    (core-param! "music-sabotage=none")
    (core-boot! 'desktop)
    (core-advance! (/ 1.0 60.0))
    (assert-equal 1 (race-tick (core-race)))))
