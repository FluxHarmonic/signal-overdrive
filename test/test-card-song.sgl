;;; The title's music waits for the card: nothing sounds before the card's
;;; lock, the main theme (Redline) fades in from it over card-song-fade
;;; seconds from its first bar, and a skip lets it in early with the same
;;; fade. The race song does not play on the title: it starts with the
;;; race. Fades are the stream's volume, which the ring's mix applies, as
;;; the device does. The shell runs headless (muted, so only the music is
;;; in the ring) on the native ring with no device; the test shim drains
;;; one frame's worth of samples a frame, so the d-th sample drained is
;;; played at d / rate.

(import (sigil test)
        (sigil audio)
        (sigil time)
        (substratic store kv)
        (signal tuning)
        (signal race)
        (signal intro)
        (signal music conductor)
        (signal shell music)
        (signal shell theme)
        (signal shell core))

(set-store-root! "/tmp/signal-card-song-test-store")
(core-param! "mute")

(define TUNING (tuning-defaults))
(define RATE 44100)
(define PER-FRAME (quotient RATE 60))
(define out (make-bytevector (* 8 PER-FRAME) 0))
(define LOCK (intro-lock TUNING))
(define FADE (tuning-ref TUNING 'card-song-fade))

(define (f32 bv i) (bytevector-ieee-single-ref bv (* 4 i) 'little))

;; n frames of the shell from a fresh boot, the music's context bound as
;; the audio start binds it; (tap-at . frame) taps a start on that frame.
;; Returns a vector of the loudest sample in each 1 ms played, the time of
;; the tap, and per frame #(race-song-running? theme-playing? phase).
(define (run-card n tap-at)
  (core-boot! 'desktop)
  (music-start! 'offline-test-context (race-song (core-race)))
  ;; The frames below claim 1/60 s each but run back to back, and no
  ;; interval counts more than the real time since the stream opened. Let
  ;; the opening lie further back than a frame, so every frame counts.
  (let wait ()
    (when (< (- (current-jiffy) (music-opened-jiffy)) (* 0.1 (jiffies-per-second)))
      (wait)))
  (let ((ms (make-vector (+ 2 (quotient (* 1000 n) 60)) 0.0))
        (states (make-vector n #f))
        (tapped #f))
    (let loop ((k 0) (d 0))
      (when (< k n)
        (when (and tap-at (= k tap-at))
          (set! tapped (/ d (* 1.0 RATE)))
          (core-tap!))
        (core-headless-frame! (/ 1.0 60.0))
        (vector-set! states k (vector (music-running?) (theme-playing?) (race-phase (core-race))
                                      (conductor-tick (race-song (core-race)))))
        (%audio-stream-drain-for-test out PER-FRAME 2)
        (let each ((j 0))
          (when (< j PER-FRAME)
            (let* ((s (max (abs (f32 out (* 2 j))) (abs (f32 out (+ 1 (* 2 j))))))
                   (slot (quotient (* 1000 (+ d j)) RATE)))
              (when (< slot (vector-length ms))
                (vector-set! ms slot (max s (vector-ref ms slot)))))
            (each (+ j 1))))
        (loop (+ k 1) (+ d PER-FRAME))))
    (music-close!)
    (theme-stop! 0)
    (vector ms tapped states)))

;; the loudest sample in [a, b) seconds
(define (loudest ms a b)
  (let loop ((i (exact (floor (* 1000 a)))) (m 0.0))
    (if (or (>= i (exact (floor (* 1000 b)))) (>= i (vector-length ms)))
        m
        (loop (+ i 1) (max m (vector-ref ms i))))))

;; The same boot with no fade: the theme at the same times at full
;; volume, to read the volume each millisecond was played at.
(define REF
  (begin
    (core-param! "card-song-fade=0")
    (let ((ms (vector-ref (run-card 270 #f) 0)))
      (core-param! (string-append "card-song-fade=" (number->string FADE)))
      ms)))

;; The volume in each 1 ms slot of [a, b) where the music is not quiet:
;; (seconds . the run's loudest sample / the reference's).
(define (gains ms a b)
  (let loop ((i (exact (floor (* 1000 a)))) (acc '()))
    (if (or (>= i (exact (floor (* 1000 b)))) (>= i (vector-length ms)))
        (reverse acc)
        (let ((r (vector-ref REF i)))
          (loop (+ i 1) (if (> r 0.01) (cons (cons (/ i 1000.0) (/ (vector-ref ms i) r)) acc) acc))))))

;; Never louder than a fade from base allows (the slot's end, plus a frame:
;; the volume is set once a frame), and full after it; with enough slots of
;; each to mean something.
(define (assert-fade ms base end)
  (let ((ramp (gains ms base (+ base FADE 0.1)))
        (full (gains ms (+ base FADE 0.1) end)))
    (assert-true (> (length ramp) 100))
    (assert-true (> (length full) 100))
    (for-each (lambda (g)
                (assert-true (<= (cdr g) (+ 0.001 (/ (+ (- (car g) base) 0.001 (/ 1.0 60.0)) FADE)))))
              ramp)
    (for-each (lambda (g) (assert-true (< (abs (- (cdr g) 1.0)) 1.0e-6))) full)))

(test-group "the song's wait (pure)"
  (test "the gate holds it; the card counts down to its lock; then at once"
    (let ((race (race-new TUNING))
          (lock (exact (round (* 60.0 LOCK)))))
      (assert-false (intro-song-wait (intro-new TUNING #t) TUNING))
      (let loop ((k 0) (i (intro-new TUNING #f)))
        (when (< k 200)
          (when (eq? (intro-phase i) 'card)
            (assert-equal (max 0 (- lock (min k lock))) (intro-song-wait i TUNING)))
          (loop (+ k 1) (intro-step i TUNING race #f #f))))))
  (test "a skip, the end, or the card off: at once"
    (let* ((race (race-new TUNING))
           (i (let loop ((k 0) (i (intro-new TUNING #f)))
                (if (= k 30) i (loop (+ k 1) (intro-step i TUNING race #f #f))))))
      (assert-equal 0 (intro-song-wait (intro-skip i) TUNING))
      (assert-equal 0 (intro-song-wait (intro-step i TUNING race #f #t) TUNING))
      (assert-equal 0 (intro-song-wait (intro-new (tuning-set TUNING 'card 0.0) #f) TUNING)))))

(test-group "the title's music after the card (native ring, no device)"
  (test "nothing sounds before the lock; the theme fades in from it and plays"
    (let* ((r (run-card 270 #f))
           (ms (vector-ref r 0))
           ;; the theme opens in the first frame, after its tick: the lock
           ;; is that many ticks sooner in the drained samples
           (t0 (vector-ref (vector-ref (vector-ref r 2) 0) 3))
           (lock (- LOCK (/ t0 60.0))))
      (assert-false (audio-initialized?))
      (assert-true (<= t0 2))
      ;; every sample before the lock is exactly silent, and the theme
      ;; starts at it (the reference, at full volume, sounds just after)
      (assert-equal 0.0 (loudest ms 0.0 (- lock 0.002)))
      (assert-equal 0.0 (loudest REF 0.0 (- lock 0.002)))
      (assert-true (> (loudest REF lock (+ lock 0.5)) 0.01))
      ;; from the lock it fades in, and plays in full after the fade
      (assert-fade ms lock 4.4)
      ;; the race song never played on the title
      (let loop ((k 0))
        (when (< k 270)
          (assert-false (vector-ref (vector-ref (vector-ref r 2) k) 0))
          (loop (+ k 1))))))

  (test "a skip lets the theme in long before the lock, faded in the same way"
    (let* ((r (run-card 150 30))
           (ms (vector-ref r 0))
           (skip (vector-ref r 1))
           ;; silence already queued (at most the 250 ms ring) still plays
           (in (let find ((i (exact (floor (* 1000 skip)))))
                 (if (or (>= i (vector-length ms)) (> (vector-ref ms i) 0.0))
                     (/ i 1000.0)
                     (find (+ i 1))))))
      (assert-equal 0.0 (loudest ms 0.0 skip))
      (assert-true (< in (+ skip 0.3)))
      (assert-true (< (+ in FADE 0.1) LOCK))
      (assert-true (> (loudest ms (+ in FADE 0.1) 2.45) 0.01))))

  (test "the race song starts with the race, and the theme gives way"
    (core-param! "card=0")
    (let* ((n 150)
           (r (run-card n 20))
           (states (vector-ref r 2))
           (first (let find ((k 0))
                    (cond ((= k n) #f)
                          ((vector-ref (vector-ref states k) 0) k)
                          (else (find (+ k 1)))))))
      (core-param! "card=1")
      ;; the title's fade-out (title-out, 0.5 s) after the tap, then the
      ;; countdown with the race song from its first frame
      (assert-true first)
      (assert-true (> first 20))
      (assert-equal 'countdown (vector-ref (vector-ref states first) 2))
      (assert-false (vector-ref (vector-ref states (- first 1)) 0))
      ;; the theme is gone by then, and the race song stays on
      (assert-false (vector-ref (vector-ref states (+ first 5)) 1))
      (let loop ((k first))
        (when (< k n)
          (assert-true (vector-ref (vector-ref states k) 0))
          (loop (+ k 1)))))
    (assert-false (audio-initialized?))))
