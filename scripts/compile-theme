#!/bin/sh
# The main theme's tune text for the title and pause music
# (music/theme/redline.cts, written by the music package's `carrier theme
# tune`), as src/signal/music/theme-score.sgl. Pure Sigil, like compile-score.
set -eu
cd "$(dirname "$0")/.."
CONDUCTOR_SIGIL="${CONDUCTOR_SIGIL:-$HOME/.sigil/versions/0.22.11/sigil}"
CONDUCTOR_MOTIF="${CONDUCTOR_MOTIF:-.sigil/deps/motif}"
CONDUCTOR_DSP="${CONDUCTOR_DSP:-.sigil/deps/sigil-dsp}"
export XDG_CACHE_HOME="${CONDUCTOR_CACHE_ROOT:-/tmp/signal-conductor-cache}"
exec nice -n 15 "$CONDUCTOR_SIGIL" -L "$CONDUCTOR_MOTIF/src" -L "$CONDUCTOR_DSP/src" \
  eval -f scripts/music/compile-theme.sgl -- "$@"
