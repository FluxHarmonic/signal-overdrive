#!/bin/sh
# scripts/gate-p15 [BUILD]   P15 (design §4.1): the signal's interference
# never covers the road. Lasting integrity effects live in the sky and the
# HUD only; if low integrity blurred the road, a struggling player would hit
# more walls.
#
# How: the web build (default build/web) on the title screen, where the
# camera and the road do not move, with no HUD (?nohud), no machines
# (?nosprites: their thrusters flicker even on the title, 840 px at scale 2) and
# interference alone (?fx-solo=7) at CRITICAL (?fx-tier=5, the strongest:
# tracking lines, bleed, and static dropouts). Three canvas captures: OFF1
# and OFF2 with interference off (?fx-interf=0), then ON after fx-interf=1.
# Then, by pixel count (ImageMagick compare -metric AE):
#   STILL rows below the horizon, OFF1 against OFF2: must be 0, or the frame
#         is not static and the gate cannot judge (SETUP-FAILED). Measured
#         with interference OFF, so the defect under test can never pass
#         itself off as a moving frame: the first version took STILL with
#         interference on, and its sabotage arm (interference planted on the
#         road, animated) came out SETUP-FAILED instead of RED.
#   ROAD  rows below the horizon (view row 82 down), ON against OFF1: must be 0
#   SKY   rows above it (to row 70), ON against OFF1: must be at least 2000
#         (the positive control: the interference is there to be seen)
# Prints GREEN, RED or SETUP-FAILED with the counts, and exits 0, 1 or 2.
# Renders on the GPU when GPU=1 (default), SwiftShader with GPU=0.
set -eu
REPO="$(cd "$(dirname "$0")/.." && pwd)"
BUILD="${1:-$REPO/build/web}"
if [ -n "${P15_OUT:-}" ]; then
  OUT="$P15_OUT"
  [ ! -e "$OUT" ] || { echo "SETUP-FAILED: P15_OUT must be a fresh directory"; exit 2; }
  mkdir -p "$OUT"
else
  OUT="$(mktemp -d /tmp/gate-p15-XXXXXX)"
fi
SCALE=2
cat > "$OUT/steps.json" <<'EOF'
[{"wait": 2500}, {"shot": "off1.png"}, {"wait": 700}, {"shot": "off2.png"},
 {"param": "fx-interf=1"}, {"wait": 2000}, {"shot": "on.png"}]
EOF
GPUFLAG=""; [ "${GPU:-1}" = 1 ] && GPUFLAG="--gpu"
if ! node "$REPO/scripts/fx-check.mjs" "$BUILD" "$OUT/steps.json" $GPUFLAG --scale $SCALE \
     --query "mute&nohud&nosprites&fx-solo=7&fx-tier=5&fx-interf=0" --out "$OUT" > "$OUT/run.log" 2>&1; then
  echo "SETUP-FAILED: the capture did not run cleanly; $OUT/run.log:"; cat "$OUT/run.log"; exit 2
fi
grep -E "^renderer:" "$OUT/run.log" || true
for f in off1 off2 on; do
  [ -s "$OUT/$f.png" ] || { echo "SETUP-FAILED: no $f.png"; exit 2; }
done
W=$((480 * SCALE)); H=$((270 * SCALE))
ROAD_Y=$((82 * SCALE)); ROAD_H=$((H - ROAD_Y)); SKY_H=$((70 * SCALE))
count() {   # count A B HEIGHT Y: differing pixels in the band
  if [ -n "${P15_IMAGEMAGICK_BIN:-}" ]; then
    "$P15_IMAGEMAGICK_BIN/convert" "$1" -crop "${W}x$3+0+$4" +repage "$OUT/a.png"
    "$P15_IMAGEMAGICK_BIN/convert" "$2" -crop "${W}x$3+0+$4" +repage "$OUT/b.png"
    ("$P15_IMAGEMAGICK_BIN/compare" -metric AE "$OUT/a.png" "$OUT/b.png" null: 2>&1 || true) |
      tail -1 | awk '{print $1}' | grep -E '^[0-9]+$' || true
    return
  fi
  guix shell imagemagick -- sh -c "convert '$1' -crop ${W}x$3+0+$4 +repage png:- > '$OUT/a.png'; \
    convert '$2' -crop ${W}x$3+0+$4 +repage png:- > '$OUT/b.png'; \
    compare -metric AE '$OUT/a.png' '$OUT/b.png' null: 2>&1 || true" | tail -1 | awk '{print $1}' |
    grep -E '^[0-9]+$' || true   # the first token only (IM 7 adds a fraction), whole numbers only
}
STILL=$(count "$OUT/off1.png" "$OUT/off2.png" $ROAD_H $ROAD_Y)
ROAD=$(count "$OUT/on.png" "$OUT/off1.png" $ROAD_H $ROAD_Y)
SKY=$(count "$OUT/on.png" "$OUT/off1.png" $SKY_H 0)
echo "road-diff $ROAD  still-diff $STILL  sky-diff $SKY  (pixels at scale $SCALE; captures in $OUT)"
[ -n "$ROAD" ] && [ -n "$STILL" ] && [ -n "$SKY" ] || { echo "SETUP-FAILED: a count is empty (is ImageMagick reachable?)"; exit 2; }
if [ "$STILL" -ne 0 ]; then echo "SETUP-FAILED: the road moved between two captures with interference off; the frame is not static"; exit 2; fi
if [ "$SKY" -lt 2000 ]; then echo "RED: the sky barely changed ($SKY px): the interference is not showing, so the road check proves nothing"; exit 1; fi
if [ "$ROAD" -ne 0 ]; then echo "RED: interference changed $ROAD road pixels (P15)"; exit 1; fi
echo "GREEN: interference changed $SKY sky pixels and no road pixels"
