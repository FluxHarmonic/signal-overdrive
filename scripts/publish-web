#!/bin/sh
# Publish signaloverdrive.net to Cloudflare Pages: exactly the tree
# check-site verified, or nothing. A thin front for substratic's
# publish-web, which reads every name from substratic.sgv.
#
#   scripts/publish-web DIR --dry-run             every check, nothing leaves
#   scripts/publish-web DIR "<one line>" --preview   the preview branch only
#   scripts/publish-web DIR "<one line>"          preview, checked live, then
#                                                 production (branch master)
#
# The path to a publish:
#   sgx substratic:build-remote                   web build of HEAD on a runner
#   SIGNAL_WEB_DIR=build/remote-web-<sha> sgx substratic:stage-web build/site
#   sgx substratic:check-site build/site          writes build/site.verified
#   scripts/publish-web build/site --dry-run
#   scripts/publish-web build/site "<one line>"
#
# publish-web refuses unless the tree still hashes to its manifest, the
# verdict names that manifest and the same gate files, and HEAD is the clean
# commit it was checked at. The wasm goes to R2 (bucket signaloverdrive-wasm)
# through R2's S3 API, only when its key is absent, and is read back and
# compared; nothing is ever deleted or overwritten.
#
# Credentials: CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID from the
# environment, else the pass entry substratic.sgv names. --dry-run reads no
# pass entry; with the two variables set it makes one read-only request (a
# read of the wasm's key) to show the token reaches the bucket.
set -eu
# an argument that names an existing file or directory is made absolute
# first, so it means what it meant where this was run; then to the repo root
# (through any symlink to this script)
for a in "$@"; do
  shift
  case "$a" in
    -*) ;;
    *) if [ -e "$a" ]; then a=$(cd "$(dirname "$a")" && pwd)/$(basename "$a"); fi ;;
  esac
  set -- "$@" "$a"
done
cd "$(dirname "$(readlink -f "$0")")/.." || exit 1
if [ ! -f .sigil/deps/substratic/tasks/publish-web.sgl ]; then
  echo "publish-web: substratic's tasks are not installed here; run: sigil deps install" >&2
  exit 2
fi
exec sgx substratic:publish-web "$@"
