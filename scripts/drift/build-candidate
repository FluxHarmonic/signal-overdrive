#!/bin/sh
# One bounded local candidate build plus an offline CLI smoke check.
# RESULT is authoritative; no device/window, fetch, runner or deploy.
set -u
cd "$(dirname "$0")/../.." || exit 2
CONDUCTOR_RUN="$1"
CONDUCTOR_MODE="${2:-build}"
mkdir -p "$CONDUCTOR_RUN"
rm -f "$CONDUCTOR_RUN/RESULT" "$CONDUCTOR_RUN/RESULT.tmp"
git rev-parse HEAD > "$CONDUCTOR_RUN/COMMIT"
export SIGIL_JOBS=1
export XDG_CACHE_HOME=/tmp/signal-conductor-build-cache
export ZIG_LOCAL_CACHE_DIR=/tmp/signal-conductor-zig-local
export ZIG_GLOBAL_CACHE_DIR=/tmp/signal-conductor-zig-global
ulimit -v 4194304
CONDUCTOR_CPU="$(awk '/Cpus_allowed_list/ {split($2,a,","); split(a[1],b,"-"); print b[1]}' /proc/self/status)"
if [ "$CONDUCTOR_MODE" = "smoke" ]; then
  CONDUCTOR_CODE=0
else
  timeout 1800 taskset -c "$CONDUCTOR_CPU" nice -n 15 scripts/dev \
    /home/daviwil/.sigil/versions/0.22.11/sigil build --config release \
    > "$CONDUCTOR_RUN/build.log" 2>&1
  CONDUCTOR_CODE="$?"
fi
if [ "$CONDUCTOR_CODE" -eq 0 ]; then
  printf '(#(0 0 grid) #(412 4 lap1))\n' > "$CONDUCTOR_RUN/smoke.sgv"
  : > "$CONDUCTOR_RUN/smoke.pcm"
  env SIGIL_AUDIO_BACKEND=null SIGIL_APP_PLATFORM=x11 DISPLAY= WAYLAND_DISPLAY= \
    timeout 120 taskset -c "$CONDUCTOR_CPU" nice -n 15 scripts/dev \
    ./build/release/bin/signal-overdrive --music-reference \
    "$CONDUCTOR_RUN/smoke.sgv" "$CONDUCTOR_RUN/smoke.pcm" 360000 \
    > "$CONDUCTOR_RUN/smoke.log" 2>&1
  CONDUCTOR_CODE="$?"
  if [ "$CONDUCTOR_CODE" -eq 0 ]; then
    if [ "$(wc -c < "$CONDUCTOR_RUN/smoke.pcm")" -ne 2880000 ]; then
      CONDUCTOR_CODE=1
    fi
    if ! rg -q 'offline reference complete; audio uninitialized' "$CONDUCTOR_RUN/smoke.log"; then
      CONDUCTOR_CODE=1
    fi
  fi
fi
if [ "$CONDUCTOR_CODE" -eq 0 ]; then
  env SIGIL_AUDIO_BACKEND=null SIGIL_APP_PLATFORM=x11 DISPLAY= WAYLAND_DISPLAY= \
    timeout 120 taskset -c "$CONDUCTOR_CPU" nice -n 15 scripts/dev \
    ./build/release/bin/signal-overdrive --music-reference \
    "$CONDUCTOR_RUN/smoke.sgv" "$CONDUCTOR_RUN/smoke-native-rate.pcm" 330750 44100 \
    > "$CONDUCTOR_RUN/smoke-native-rate.log" 2>&1
  CONDUCTOR_CODE="$?"
  if [ "$CONDUCTOR_CODE" -eq 0 ]; then
    if [ "$(wc -c < "$CONDUCTOR_RUN/smoke-native-rate.pcm")" -ne 2646000 ] \
        || ! rg -q 'offline reference complete; audio uninitialized' "$CONDUCTOR_RUN/smoke-native-rate.log"; then
      CONDUCTOR_CODE=1
    fi
  fi
fi
if [ "$CONDUCTOR_CODE" -eq 0 ]; then
  env SIGIL_AUDIO_BACKEND=null SIGIL_APP_PLATFORM=x11 DISPLAY= WAYLAND_DISPLAY= \
    timeout 30 taskset -c "$CONDUCTOR_CPU" nice -n 15 scripts/dev \
    ./build/release/bin/signal-overdrive --music-headless --mute --start \
    --autopilot --track=loop --musiclog --quit-after 2 \
    > "$CONDUCTOR_RUN/headless-smoke.log" 2>&1
  CONDUCTOR_CODE="$?"
  if [ "$CONDUCTOR_CODE" -eq 0 ]; then
    if ! rg -q 'headless race complete; audio uninitialized' "$CONDUCTOR_RUN/headless-smoke.log" \
        || ! rg -q 'conductor intended tick 0 bar 0 mark grid' "$CONDUCTOR_RUN/headless-smoke.log"; then
      CONDUCTOR_CODE=1
    fi
  fi
fi
if [ "$CONDUCTOR_CODE" -eq 0 ]; then
  printf 'RESULT: PASS (%s; offline CLI and muted headless race smokes)\n' "$CONDUCTOR_MODE" > "$CONDUCTOR_RUN/RESULT.tmp"
else
  printf 'RESULT: FAIL (exit %s)\n' "$CONDUCTOR_CODE" > "$CONDUCTOR_RUN/RESULT.tmp"
fi
mv "$CONDUCTOR_RUN/RESULT.tmp" "$CONDUCTOR_RUN/RESULT"
cat "$CONDUCTOR_RUN/RESULT"
exit "$CONDUCTOR_CODE"
