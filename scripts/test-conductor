#!/bin/sh
# Source-only checks: no native dependency compilation or sound device.
# Use the installed compiler matching the prototype's lock.
set -eu
cd "$(dirname "$0")/.."
CONDUCTOR_SIGIL="${CONDUCTOR_SIGIL:-$HOME/.sigil/versions/0.22.11/sigil}"
export XDG_CACHE_HOME="${CONDUCTOR_CACHE_ROOT:-/tmp/signal-conductor-cache}"
exec nice -n 15 "$CONDUCTOR_SIGIL" -L src -L .sigil/deps/sigil-test/src \
  eval '(begin (load "test/test-conductor.sgl") (run-tests))'
