;;; Build-time entry. Compiles Carrier (music/carrier/race.cts and cues.sgl) by
;;; default; any tune and cue sheet on the contract can stand in, without code changes.
(import (sigil process)
        (sigil fs)
        (motif tune)
        (signal music compile))

(define arguments
  (let find ((remaining (cdr (command-line))))
    (cond
      ((null? remaining) '())
      ((string=? (car remaining) "--") (cdr remaining))
      (else (find (cdr remaining))))))
(define tune-path (if (pair? arguments) (car arguments) "music/carrier/race.cts"))
(define cues-path (if (> (length arguments) 1) (cadr arguments) "music/carrier/cues.sgl"))
(define output-path (if (> (length arguments) 2) (caddr arguments) "src/signal/music/score.sgl"))

(define score (compile-score (read-tune-file tune-path) (read-score-cues cues-path)))
(write-file-string output-path (score-module-string score))
(display "Compiled score: ")
(display (score-field score 'id))
(display " / onsets: ")
(display (length (score-field score 'onsets)))
(newline)
