;;; Build-only lowering of a song and its cue sheet. Runtime code imports
;;; the emitted score data, so Motif's compiler never runs during a race.
(define-library (signal music compile)
  (import (sigil struct)
          (sigil math)
          (sigil list)
          (sigil io)
          (sigil fs)
          (motif tune)
          (motif tune compile))
  (export compile-score score-module-string scores-module-string score-field read-score-cues)
  (begin
    (define ONSET-RATE 44100)
    (define REQUIRED-SECTIONS '(calm grid lap1 lap2 hold fill traced uplink results))

    (define (score-field data key)
      (let ((field (assq key data)))
        (if field (cdr field) (error "missing score field" key))))

    (define (read-score-cues file)
      (call-with-input-file file read))

    (define (validate-clock t)
      (validate-tune t)
      (unless (and (= (tune-tempo t) 140)
                   (= (tune-speed t) 3)
                   (= (tune-channels t) 8)
                   (equal? (tune-meter t) '(8 . 4)))
        (error "Signal song must use 140 BPM, speed 3, eight channels and meter (8 4)"))
      (for-each
        (lambda (pattern)
          (unless (= 0 (modulo (tune-pattern-rows pattern) 32))
            (error "a song pattern must contain whole bars" (tune-pattern-id pattern)))
          (for-each
            (lambda (cell)
              ;; Loops and jumps belong to the conductor, and the race's
              ;; tempo stays constant. Otherwise row arithmetic would lie.
              (when (memv (fx-command (cell-fx cell)) '(11 13 15))
                (error "Bxx, Dxx and Fxx are not supported in a Signal song")))
            (tune-pattern-cells pattern)))
        (tune-patterns t)))

    (define (order-offsets t)
      (let loop ((order (tune-order t)) (row 0) (acc '()))
        (if (null? order)
            (list->vector (reverse (cons row acc)))
            (loop (cdr order)
                  (+ row (tune-pattern-rows (tune-find-pattern t (car order))))
                  (cons row acc)))))

    (define (section-data t cues offsets)
      (let ((policies (score-field cues 'sections))
            (regions (tune-mark-regions t)))
        (unless (and (= (length policies) (length REQUIRED-SECTIONS))
                     (= (length regions) (length REQUIRED-SECTIONS)))
          (error "song and cue sheet must each declare the nine required sections"))
        (map
          (lambda (mark)
            (let* ((region (assq mark regions))
                   (policy (assq mark policies)))
              (unless (and region policy) (error "missing section" mark))
              (let* ((from (cadr region))
                     (to (cddr region))
                     (bars (quotient (- (vector-ref offsets to) (vector-ref offsets from)) 32))
                     (loop (score-field (cdr policy) 'loop))
                     (next (score-field (cdr policy) 'next)))
                (unless (> bars 0) (error "empty section" mark))
                (when loop
                  (unless (and (pair? loop)
                               (exact-integer? (car loop)) (exact-integer? (cdr loop))
                               (<= 0 (car loop)) (< (car loop) (cdr loop)) (<= (cdr loop) bars))
                    (error "invalid section loop" mark loop)))
                (when loop
                  (let ((start (vector-ref offsets from))
                        (boundaries (vector->list offsets)))
                    (unless (and (memv (+ start (* 32 (car loop))) boundaries)
                                 (memv (+ start (* 32 (cdr loop))) boundaries))
                      (error "Motif region loop bounds must be order boundaries" mark loop))))
                (when (and next (not (memq next REQUIRED-SECTIONS)))
                  (error "unknown automatic next section" mark next))
                (when (and loop next) (error "section cannot both loop and exit automatically" mark))
                (when (and (eq? mark 'grid) (not (= bars 4)))
                  (error "grid must contain four bars"))
                (when (and (eq? mark 'fill) (not (= bars 2)))
                  (error "fill must contain two bars"))
                (let ((required-next (assq mark '((grid . lap1) (fill . traced) (uplink . results)))))
                  (when (and required-next (not (eq? next (cdr required-next))))
                    (error "wrong automatic section exit" mark next)))
                (vector mark from bars (and loop (car loop)) (and loop (cdr loop)) next))))
          REQUIRED-SECTIONS)))

    ;; Last compiler timeline row at or before an integer sample. Motif
    ;; rounds tracker tick positions; use its samples, not a guessed grid.
    (define (row-at timeline sample)
      (let search ((lo 0) (hi (- (vector-length timeline) 1)) (best #f))
        (if (> lo hi)
            (or best (error "trigger precedes compiler timeline" sample))
            (let* ((mid (quotient (+ lo hi) 2))
                   (entry (vector-ref timeline mid)))
              (if (<= (vector-ref entry 2) sample)
                  (search (+ mid 1) hi entry)
                  (search lo (- mid 1) best))))))

    (define (freq->midi frequency)
      (exact (round (+ 69.0 (* 12.0 (/ (log (/ frequency 440.0)) (log 2.0)))))))

    ;; #(absolute-score-row channel midi compiler-sample), sorted by row,
    ;; then channel. Only the TRIGGER flag creates an onset: slides,
    ;; vibrato, arpeggios and note-offs must never invent world pulses.
    (define (compiled-onsets compiled offsets)
      (let ((timeline (list->vector (compiled-tune-timeline compiled))))
        (list-sort
          (lambda (a b)
            (or (< (vector-ref a 0) (vector-ref b 0))
                (and (= (vector-ref a 0) (vector-ref b 0))
                     (< (vector-ref a 1) (vector-ref b 1)))))
          (let channels ((remaining (compiled-tune-channels compiled)) (channel 1) (acc '()))
            (if (null? remaining)
                acc
                (let ((ticks (compiled-channel-ticks (car remaining))))
                  (channels
                    (cdr remaining) (+ channel 1)
                    (let rows ((i 0) (acc acc))
                      (if (>= i (vector-length ticks))
                          acc
                          (let* ((sample (exact (round (vector-ref ticks i))))
                                 (trigger? (> (vector-ref ticks (+ i 5)) 0.5)))
                            (rows
                              (+ i 7)
                              (if trigger?
                                  (let ((entry (row-at timeline sample)))
                                    (cons (vector (+ (vector-ref offsets (vector-ref entry 0))
                                                     (vector-ref entry 1))
                                                  channel (freq->midi (vector-ref ticks (+ i 2))) sample)
                                          acc))
                                  acc))))))))))))

    (define (onset-masks t offsets onsets)
      (let ((masks (list->vector
                     (map (lambda (id) (make-vector (tune-pattern-rows (tune-find-pattern t id)) 0))
                          (tune-order t)))))
        (for-each
          (lambda (onset)
            (let find ((pos 0))
              (if (< (vector-ref onset 0) (vector-ref offsets (+ pos 1)))
                  (let* ((row (- (vector-ref onset 0) (vector-ref offsets pos)))
                         (mask (vector-ref masks pos))
                         (bit (arithmetic-shift 1 (- (vector-ref onset 1) 1))))
                    (vector-set! mask row (bitwise-ior bit (vector-ref mask row))))
                  (find (+ pos 1)))))
          onsets)
        masks))

    (define (compile-score t cues)
      (validate-clock t)
      (let* ((offsets (order-offsets t))
             (sections (section-data t cues offsets))
             (compiled (compile-tune t ONSET-RATE))
             (onsets (compiled-onsets compiled offsets)))
        (list (cons 'id (score-field cues 'id))
              (cons 'tune-text (tune->string t))
              (cons 'bpm (tune-tempo t))
              (cons 'speed (tune-speed t))
              (cons 'meter (tune-meter t))
              (cons 'order-offsets offsets)
              (cons 'sections sections)
              (cons 'onsets onsets)
              (cons 'onset-masks (onset-masks t offsets onsets)))))

    ;; The score as a library. Carrier's is (signal music score) with names
    ;; SCORE-ID ...; each other race song's is (signal music score ID) with
    ;; names SCORE-ID-... (prefix "SCORE-CARRIER-A" gives SCORE-CARRIER-A-ID).
    (define (score-module-string data . opts)
      (let* ((library (if (pair? opts) (car opts) "(signal music score)"))
             (prefix (if (and (pair? opts) (pair? (cdr opts))) (cadr opts) "SCORE"))
             (name (lambda (field) (string-append prefix "-" field))))
      (call-with-output-string
        (lambda (port)
          (display ";;; GENERATED by scripts/music/compile-score.sgl. Do not edit.\n" port)
          (display (string-append "(define-library " library "\n") port)
          (display "  (import (sigil list))\n" port)
          (display (string-append "  (export " (name "ID") " " (name "BPM") " " (name "SPEED") " "
                                  (name "METER") " " (name "TUNE-TEXT") "\n") port)
          (display (string-append "          " (name "ORDER-OFFSETS") " " (name "SECTIONS") " "
                                  (name "ONSETS") " " (name "ONSET-MASKS") ")\n") port)
          (display "  (begin\n" port)
          (for-each
            (lambda (binding)
              (display "    (define " port)
              (display (name (car binding)) port)
              (display " '" port)
              (write (score-field data (cdr binding)) port)
              (display ")\n" port))
            '(("ID" . id) ("BPM" . bpm) ("SPEED" . speed)
              ("METER" . meter) ("ORDER-OFFSETS" . order-offsets)
              ("TUNE-TEXT" . tune-text)))
          (display (string-append "    (define " (name "SECTIONS") "\n      '(\n") port)
          (for-each (lambda (entry) (display "        " port) (write entry port) (newline port))
                    (score-field data 'sections))
          ;; The native emitter nests a quoted list's cons expressions.
          ;; Bounded constants keep large scores below C's bracket limit
          ;; while exposing exactly the same flattened runtime list.
          (display (string-append "      ))\n    (define " (name "ONSETS") "\n      (append\n") port)
          (let chunks ((entries (score-field data 'onsets)))
            (if (null? entries)
                (display "        '()\n" port)
                (begin
                  (display "        '(\n" port)
                  (let ((remaining
                          (let emit ((entries entries) (n 64))
                            (if (or (= n 0) (null? entries))
                                entries
                                (begin
                                  (display "          " port)
                                  (write (car entries) port)
                                  (newline port)
                                  (emit (cdr entries) (- n 1)))))))
                    (display "        )\n" port)
                    (unless (null? remaining) (chunks remaining))))))
          (display (string-append "      ))\n    (define " (name "ONSET-MASKS") "\n      '#(\n") port)
          (for-each (lambda (entry) (display "        " port) (write entry port) (newline port))
                    (vector->list (score-field data 'onset-masks)))
          (display "      ))))\n" port)))))

    ;; The race songs together: scores is ((library . prefix) ...), the
    ;; default (Carrier) first; track-songs is ((track . song-id) ...).
    ;; SCORES: #(id order-offsets tune-text sections onsets onset-masks).
    (define (scores-module-string scores track-songs)
      (call-with-output-string
        (lambda (port)
          (display ";;; GENERATED by scripts/music/compile-score.sgl. Do not edit.\n" port)
          (display ";;; Every race song the game can play, and the song each track binds.\n" port)
          (display "(define-library (signal music scores)\n  (import" port)
          (for-each (lambda (s) (display (string-append "\n          " (car s)) port)) scores)
          (display ")\n  (export SCORES TRACK-SONGS)\n  (begin\n    (define SCORES\n      (list" port)
          (for-each
            (lambda (s)
              (let ((p (cdr s)))
                (display (string-append "\n        (vector " p "-ID " p "-ORDER-OFFSETS " p "-TUNE-TEXT "
                                        p "-SECTIONS " p "-ONSETS " p "-ONSET-MASKS)") port)))
            scores)
          (display "))\n    (define TRACK-SONGS '" port)
          (write track-songs port)
          (display ")))\n" port))))))
