;;; Build-time entry for the main theme (Redline): its tune text as a
;;; runtime constant, so the game parses it without a file system. The
;;; theme has no onset tables; nothing in the race follows it.
(import (sigil process)
        (sigil fs)
        (motif tune))

(define arguments
  (let find ((remaining (cdr (command-line))))
    (cond
      ((null? remaining) '())
      ((string=? (car remaining) "--") (cdr remaining))
      (else (find (cdr remaining))))))
(define tune-path (if (pair? arguments) (car arguments) "music/theme/redline.cts"))
(define output-path (if (> (length arguments) 1) (cadr arguments) "src/signal/music/theme-score.sgl"))

(define t (read-tune-file tune-path))
(define calm (tune-mark t 'calm))
(unless (and (exact-integer? calm) (= (tune-channels t) 8))
  (error "the theme needs a calm mark and eight channels" tune-path))

(write-file-string output-path
  (call-with-output-string
    (lambda (port)
      (display ";;; GENERATED by scripts/music/compile-theme.sgl. Do not edit.\n" port)
      (display "(define-library (signal music theme-score)\n" port)
      (display "  (export THEME-ID THEME-BPM THEME-CALM THEME-TUNE-TEXT)\n" port)
      (display "  (begin\n" port)
      (display "    (define THEME-ID " port) (write (tune-name t) port) (display ")\n" port)
      (display "    (define THEME-BPM " port) (write (tune-tempo t) port) (display ")\n" port)
      (display "    (define THEME-CALM " port) (write calm port) (display ")\n" port)
      (display "    (define THEME-TUNE-TEXT '" port) (write (tune->string t) port) (display ")))\n" port))))
(display "Compiled theme: ")
(display (tune-name t))
(newline)
