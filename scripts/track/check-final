#!/bin/sh
# Phantom final checkpoint: a single bounded worker, no device/server/deploy.
set -eu
cd "$(dirname "$0")/../.."
track_run="$1"
mkdir -p "$track_run"
trap 'track_code=$?; printf "RESULT: final verification exit %s; inspect STAGE, pipeline/RESULT, regressions.log and build.log\n" "$track_code" > "$track_run/RESULT"' EXIT
track_sigil="$HOME/.sigil/versions/0.22.11/sigil"
printf 'pipeline\n' > "$track_run/STAGE"
sh scripts/track/check-pipeline "$track_run/pipeline"
printf 'source regressions\n' > "$track_run/STAGE"
: > "$track_run/regressions.log"
for track_suite in track handling race camera conductor; do
  printf 'Suite: %s\n' "$track_suite" >> "$track_run/regressions.log"
  timeout 300 "$track_sigil" -L src -L .sigil/deps/sigil-test/src \
    eval "(begin (load \"test/test-$track_suite.sgl\") (run-tests))" \
    >> "$track_run/regressions.log" 2>&1
done
printf 'native release build\n' > "$track_run/STAGE"
timeout 1200 scripts/dev "$track_sigil" build --config release > "$track_run/build.log" 2>&1
printf 'muted native headless smoke\n' > "$track_run/STAGE"
env SIGIL_AUDIO_BACKEND=null SIGIL_APP_PLATFORM=x11 DISPLAY= WAYLAND_DISPLAY= \
  timeout 60 scripts/dev ./build/release/bin/signal-overdrive \
  --music-headless --mute --start --autopilot --track=oval --musiclog --quit-after 2 \
  > "$track_run/headless.log" 2>&1
rg -q 'headless race complete; audio uninitialized' "$track_run/headless.log"
printf 'finished\n' > "$track_run/STAGE"
