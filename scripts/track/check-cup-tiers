#!/bin/sh
# Phantom-only actual races. Per-tier REDs remain explicit in their reports.
set -eu
cd "$(dirname "$0")/../.."
track_run="$1"
track_ids="${2:-quayside basin}"
mkdir -p "$track_run"
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'track_code=$?; printf "RESULT: cup tier driving collection exit %s; inspect individual statuses and pair observations\n" "$track_code" > "$track_run/RESULT"' EXIT
track_sigil="$HOME/.sigil/versions/0.22.11/sigil"
for track_id in $track_ids; do
  case "$track_id" in breakwater|quayside|basin) ;; *) exit 2 ;; esac
  node scripts/track/runtime.mjs "tracks/$track_id.json" "$track_run/$track_id.sgv" 0
  for track_tier in learner courier elite; do
    printf 'actual %s race, %s, pair and hazard observations\n' "$track_id" "$track_tier" > "$track_run/STAGE"
    track_code=0
    timeout 600 "$track_sigil" -L src eval -f scripts/track/ai.sgl -- "$track_run/$track_id.sgv" "$track_tier" \
      > "$track_run/$track_id-$track_tier-ai.json" 2> "$track_run/$track_id-$track_tier-ai.log" || track_code="$?"
    printf '%s\n' "$track_code" > "$track_run/$track_id-$track_tier-status"
    test "$track_code" -le 1
  done
done
printf 'finished; individual statuses and non-vacuous pair evidence remain separate\n' > "$track_run/STAGE"
