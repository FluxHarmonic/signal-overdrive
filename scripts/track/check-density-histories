#!/bin/sh
# Phantom-only final actual histories; caller bounds the whole checkpoint.
set -eu
cd "$(dirname "$0")/../.."
track_run="$1"
track_driving="$2"
mkdir -p "$track_run"
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'track_code=$?; printf "RESULT: corrected-density actual histories exit %s; inspect individual reports\n" "$track_code" > "$track_run/RESULT"' EXIT
printf 'waiting for the bounded actual driving collection\n' > "$track_run/STAGE"
while test ! -f "$track_driving/RESULT"; do sleep 5; done
track_failed=0
# The default tier is checked on every track before the other six histories.
for track_tier in courier learner elite; do
  for track_id in breakwater quayside basin; do
    printf 'canonical seeded/tier gate at corrected %s %s history\n' "$track_id" "$track_tier" > "$track_run/STAGE"
    track_code=0
    timeout 540 node scripts/track/combined-ice.mjs "tracks/$track_id.json" \
      "$track_driving/$track_id-$track_tier-ai.json" "$track_run/$track_id-$track_tier-combined.json" \
      > "$track_run/$track_id-$track_tier.log" 2>&1 || track_code="$?"
    printf '%s\n' "$track_code" > "$track_run/$track_id-$track_tier-status"
    if test "$track_code" -ne 0; then track_failed=1; fi
  done
done
printf 'finished; each history retains its own acceptance status\n' > "$track_run/STAGE"
exit "$track_failed"
