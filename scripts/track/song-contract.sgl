;;; Export the active conductor's real sections and default camera/handling
;;; values as JSON for the offline Node preview. No tune compilation or audio.
(import (sigil io)
        (signal music song)
        (signal music conductor)
        (signal music score)
        (signal handling)
        (signal tuning))

(define tuning (tuning-defaults))
(define arguments
  (let find ((remaining (cdr (command-line))))
    (cond
      ((null? remaining) '())
      ((string=? (car remaining) "--") (cdr remaining))
      (else (find (cdr remaining))))))
(define cue-path (if (pair? arguments) (car arguments) "music/carrier/cues.sgl"))
(define cues (call-with-input-file cue-path read))
(unless (eq? (cdr (assq 'id cues)) SCORE-ID)
  (error "cue sheet does not match the active compiled song" cue-path))
(for-each
  (lambda (s)
    (let* ((entry (assq (song-section-mark s) (cdr (assq 'sections cues))))
           (loop (and entry (cdr (assq 'loop (cdr entry)))))
           (next (and entry (cdr (assq 'next (cdr entry)))))
           (chords (and entry (assq 'chords (cdr entry)))))
      (unless (and entry chords
                   (= (length (cdr chords)) (song-section-bars s))
                   (equal? loop (and (song-section-loop-from s)
                                     (cons (song-section-loop-from s)
                                           (song-section-loop-to s))))
                   (eq? next (song-section-next s)))
        (error "cue section disagrees with active compiled score" (song-section-mark s)))))
  SONG-SECTIONS)
(define (json-field name value)
  (display "\"")
  (display name)
  (display "\":")
  (write value))

(display "{\"id\":\"")
(display SCORE-ID)
(display "\",\"cues\":")
(write cue-path)
(display ",")
(json-field "bpm" SONG-BPM)
(display ",")
(json-field "barSeconds" (song-bar-seconds))
(display ",\"sections\":[")
(let loop ((sections SONG-SECTIONS) (first? #t))
  (unless (null? sections)
    (unless first? (display ","))
    (let ((s (car sections)))
      (display "{\"mark\":\"")
      (display (song-section-mark s))
      (display "\",")
      (json-field "bars" (song-section-bars s))
      (display ",\"loop\":")
      (if (song-section-loop-from s)
          (begin
            (display "[")
            (write (song-section-loop-from s))
            (display ",")
            (write (song-section-loop-to s))
            (display "]"))
          (display "null"))
      (display ",\"next\":")
      (if (song-section-next s)
          (begin
            (display "\"")
            (display (song-section-next s))
            (display "\""))
          (display "null"))
      (display "}"))
    (loop (cdr sections) #f)))
(display "],\"camera\":{")
(json-field "top" (handling-ref tuning 'top))
(display ",")
(json-field "machineWidth" (* 2.0 (handling-ref tuning 'radius)))
(display ",")
(json-field "fov" (+ (tuning-ref tuning 'fov) (tuning-ref tuning 'speed-fov)))
(display ",")
(json-field "behind" (+ (tuning-ref tuning 'cam-dist) (tuning-ref tuning 'speed-pull)))
(for-each
  (lambda (pair)
    (display ",")
    (json-field (car pair) (tuning-ref tuning (cdr pair))))
  '(("cameraHeight" . cam-height)
    ("pitch" . pitch)
    ("horizon" . horizon)
    ("fogEnd" . fog-end)))
(display "}}")
(newline)
