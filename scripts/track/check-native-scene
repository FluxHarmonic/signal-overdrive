#!/bin/sh
# Phantom-only integration capture; no dependency builds or audio device.
set -eu
cd "$(dirname "$0")/../.."
track_run="$1"
mkdir -p "$track_run"
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'track_code=$?; printf "RESULT: complete current native scene exit %s; inspect captures and game log\n" "$track_code" > "$track_run/RESULT"' EXIT
printf 'stage current sources beside the existing standard native test runner\n' > "$track_run/STAGE"
node scripts/track/stage-native-harness.mjs "$track_run" > "$track_run/staging.log" 2>&1
export SIGIL_TEST_HARNESS="$track_run/harness/bin/signal-live-ice-test"
printf 'actual shell, fixed-tick schedule, normal camera, HUD and pair sprites\n' > "$track_run/STAGE"
node scripts/track/native-scene.mjs "$track_run/scenes" > "$track_run/scenes.log" 2>&1
printf 'finished\n' > "$track_run/STAGE"
