#!/bin/sh
# Phantom-only acceptance at each measured tier's actual lap crossings.
set -eu
cd "$(dirname "$0")/../.."
track_run="$1"
track_driving="$2"
track_tiers="${3:-learner courier elite}"
mkdir -p "$track_run"
trap 'track_code=$?; printf "RESULT: actual-tier combined ICE exit %s; inspect reports and STAGE\n" "$track_code" > "$track_run/RESULT"' EXIT
for track_tier in $track_tiers; do
  case "$track_tier" in learner|courier|elite) ;; *) exit 2 ;; esac
  printf 'canonical seeded combined ICE at %s actual crossings\n' "$track_tier" > "$track_run/STAGE"
  timeout 540 node scripts/track/combined-ice.mjs tracks/breakwater.json \
    "$track_driving/$track_tier-ai.json" "$track_run/$track_tier-combined.json" \
    > "$track_run/$track_tier.log" 2>&1
done
printf 'finished\n' > "$track_run/STAGE"
