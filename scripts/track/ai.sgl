;;; Headless 60 Hz authoring gate over the game's own race/handling/conductor.
;;; No graphics, device or clock. Input is read as data, never evaluated.
(import (sigil io)
        (sigil fs)
        (sigil math)
        (sigil process)
        (signal track)
        (signal handling)
        (signal race)
        (signal ice runtime)
        (signal tiers)
        (signal tuning)
        (signal music conductor)
        (signal music song)
        (signal music score))

(define arguments
  (let find ((remaining (cdr (command-line))))
    (cond
      ((null? remaining) '())
      ((string=? (car remaining) "--") (cdr remaining))
      (else (find (cdr remaining))))))
(unless (pair? arguments)
  (error "usage: ai.sgl -- runtime.sgv [stall]"))
(define data (call-with-input-file (car arguments) read))
(define chunks (list-ref data 6))
(define samples (make-vector (apply + (map vector-length chunks)) 0.0))
(let loop ((remaining chunks) (offset 0))
  (unless (null? remaining)
    (let ((chunk (car remaining)))
      (let copy ((i 0))
        (when (< i (vector-length chunk))
          (vector-set! samples (+ offset i) (vector-ref chunk i))
          (copy (+ i 1))))
      (loop (cdr remaining) (+ offset (vector-length chunk))))))
(define track-value
  (make-track samples (list-ref data 2) (list-ref data 3)
              (list-ref data 4) (car data) (list-ref data 5)
              (list-ref data 7) (list-ref data 8) (list-ref data 9)))
(define tuning (tuning-set (tuning-defaults) 'track (track-index-of (car data))))
(define sabotage? (and (> (length arguments) 1) (string=? (cadr arguments) "stall")))
(define tier
  (let find ((remaining (cdr arguments)))
    (cond
      ((null? remaining) 'courier)
      ((member (car remaining) '("learner" "courier" "elite"))
       (string->symbol (car remaining)))
      (else (find (cdr remaining))))))
(tier-parameters tier)
(define progress-file
  (string-append (car arguments) "." (symbol->string tier) ".progress"))
(write-file-string progress-file "input loaded; constructing actual race\n")

(define (grid-machine row col)
  (let* ((s (wrap-s track-value (- -36.0 (* row 44.0))))
         (p (track-point track-value s (if (= col 0) -0.38 0.38)))
         (heading (atan (caddr p) (- (cadddr p)))))
    (machine (make-machine (car p) (cadr p) heading)
             s: s hint: (track-index-at track-value s))))

(define template (race-start tuning (race-new tuning tier: tier)))
(define slots '((0 . 0) (0 . 1) (1 . 0) (2 . 0) (2 . 1)))
(define initial
  (race template
        track: track-value
        ice: (ice-new (track-ice-schedule track-value) tier 0 track-value)
        wake: #f
        player: (racer (race-player template) machine: (grid-machine 1 1))
        rivals: (map (lambda (r slot)
                       (racer r machine: (grid-machine (car slot) (cdr slot))))
                     (race-rivals template) slots)))

(define landings '())
(define lap-times '())
(define crossings '())
(define live-ticks 0)
(define warning-ticks 0)
(define hazard-ticks '(("firewall" . 0) ("drone" . 0) ("tracer" . 0) ("wake" . 0)))
(define null-attack-ticks 0)
(define void-attack-ticks 0)
(define null-warning-ticks 0)
(define (all-finished? r)
  (and (racer-finished (race-player r))
       (let loop ((remaining (race-rivals r)))
         (or (null? remaining)
             (and (racer-finished (car remaining)) (loop (cdr remaining)))))))

(define final
  (let loop ((r initial) (i 0))
    (when (= (modulo i 600) 0)
      (write-file-string progress-file
        (string-append "simulation tick " (number->string i)
                       "; race phase " (symbol->string (race-phase r))
                       "; player lap " (number->string (racer-lap (race-player r))) "\n")))
    (if (or (>= i (* 60 180))
            (and (all-finished? r)
                 (eq? (conductor-section (race-song r)) 'results)))
        r
        (let* ((before (race-player r))
               (controls (if sabotage?
                             NO-INPUT
                             (ai-input track-value (racer-machine before) 0.0 #t)))
               (next (race-step tuning r controls #f))
               (after (race-player next))
               (m (racer-machine after)))
          (when (pair? (ice-state-active (race-ice next)))
            (set! live-ticks (+ live-ticks 1)))
          (when (pair? (ice-state-telegraphs (race-ice next)))
            (set! warning-ticks (+ warning-ticks 1)))
          (let ((kinds (map cadr (ice-state-active (race-ice next)))))
            (set! hazard-ticks
              (map (lambda (entry)
                     (if (member (car entry) kinds)
                         (cons (car entry) (+ (cdr entry) 1)) entry))
                   hazard-ticks)))
          (for-each
            (lambda (rival)
              (when (race-rival-attacking? next rival)
                (cond
                  ((string=? (racer-name rival) "NULL")
                   (set! null-attack-ticks (+ null-attack-ticks 1)))
                  ((string=? (racer-name rival) "VOID")
                   (set! void-attack-ticks (+ void-attack-ticks 1)))))
              (when (race-null-flare? next rival)
                (set! null-warning-ticks (+ null-warning-ticks 1))))
            (race-rivals next))
          (when (or (> (racer-lap after) (racer-lap before))
                    (and (not (racer-finished before)) (racer-finished after)))
            (set! crossings
                  (cons (list (if (racer-finished after) 4 (racer-lap after))
                              (conductor-tick (race-song next)))
                        crossings)))
          (when (and (> (racer-lap before) 0)
                     (or (> (racer-lap after) (racer-lap before))
                         (and (not (racer-finished before)) (racer-finished after))))
            (set! lap-times (cons (racer-last-lap after) lap-times)))
          (when (not (eq? (conductor-section (race-song r))
                          (conductor-section (race-song next))))
            (set! landings
                  (cons (list (conductor-section (race-song next))
                              (conductor-tick (race-song next))
                              (racer-lap after) (machine-s m)
                              (machine-x m) (machine-y m)
                              (racer-progress after) (or (racer-finished after) 0))
                        landings)))
          (loop next (+ i 1))))))

(define best (racer-best-lap (race-player final)))
(define par-seconds (and best (/ best 60.0)))
(define finished? (and (all-finished? final) (not (eq? (race-phase final) 'corrupt))))
(define par-ok? (or (eq? (list-ref data 1) 'test)
                    (and par-seconds (<= 25.0 par-seconds) (<= par-seconds 35.0))))
(define pass? (and finished? par-ok?))

(display "{\"id\":\"")
(display (car data))
(display "\",\"tier\":\"")
(display tier)
(display "\",\"scheduler\":\"signal/ice/runtime; actual input-track contract")
(display "\",\"liveIceTicks\":")
(write live-ticks)
(display ",\"warningTicks\":")
(write warning-ticks)
(display ",\"hazardTicks\":{")
(let emit-hazards ((rest hazard-ticks) (first? #t))
  (unless (null? rest)
    (unless first? (display ","))
    (write (caar rest)) (display ":") (write (cdar rest))
    (emit-hazards (cdr rest) #f)))
(display "},\"nullAttackTicks\":") (write null-attack-ticks)
(display ",\"voidAttackTicks\":") (write void-attack-ticks)
(display ",\"nullWarningTicks\":") (write null-warning-ticks)
(display ",\"rivalNames\":[")
(let loop ((remaining (race-rivals initial)) (first? #t))
  (unless (null? remaining)
    (unless first? (display ","))
    (write (racer-name (car remaining)))
    (loop (cdr remaining) #f)))
(display "],\"activeSong\":\"")
(display (song-id))
(display "\",\"world\":{\"width\":")
(write (track-world-width track-value))
(display ",\"height\":")
(write (track-world-height track-value))
(display "},\"pass\":")
(display (if pass? "true" "false"))
(display ",\"threeLapsAllRacers\":")
(display (if finished? "true" "false"))
(display ",\"parGate\":")
(display (if par-ok? "true" "false"))
(display ",\"bestLapSeconds\":")
(if par-seconds (write par-seconds) (display "null"))
(display ",\"lapTicks\":[")
(let loop ((times (reverse lap-times)) (first? #t))
  (unless (null? times)
    (unless first? (display ","))
    (write (car times))
    (loop (cdr times) #f)))
(display "],\"crossings\":[")
(let loop ((entries (reverse crossings)) (first? #t))
  (unless (null? entries)
    (unless first? (display ","))
    (display "{\"lap\":")
    (write (caar entries))
    (display ",\"tick\":")
    (write (cadar entries))
    (display "}")
    (loop (cdr entries) #f)))
(display "],\"landings\":[")
(let loop ((events (reverse landings)) (first? #t))
  (unless (null? events)
    (unless first? (display ","))
    (let ((entry (car events)))
      (display "{\"mark\":\"")
      (display (car entry))
      (display "\",\"tick\":")
      (write (cadr entry))
      (for-each
        (lambda (name value)
          (display ",\"")
          (display name)
          (display "\":")
          (write value))
        '("lap" "s" "x" "y" "progress" "finishTick") (cddr entry))
      (display "}"))
    (loop (cdr events) #f)))
(display "]}")
(newline)
(unless pass? (exit 1))
