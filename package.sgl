;;; signal-overdrive - a Mode 7 racer in the spirit of F-Zero, set in the Crash
;;; The Stack world: you are a data courier, and your cargo's integrity is
;;; the energy meter. The track is a Mode 7 ground plane (a fragment shader
;;; projecting a tiled track toward a horizon), the machines are sprites.
;;;
;;; One source tree, two targets, Emberlight's shape: (signal main) picks the
;;; shell, (signal shell native) over sigil-desktop for dev/release and
;;; (signal shell web) over requestAnimationFrame for the web config.
;;;
;;;   scripts/dev sigil deps install
;;;   scripts/dev sigil build                       native (dev: bytecode)
;;;   scripts/dev sigil build --config release      native, what you play
;;;   scripts/dev sigil build --config web          browser (manifest has binaryen)
;;;
;;; The art in assets/signal/ is generated by scripts/art/*.mjs (node, no
;;; dependencies).

(import (sigil process) (sigil string) (sigil time) (sigil fs))

(define sigil-repo "codeberg:sigil/sigil")

;; The build's stamp: the commit, plus the second when the tree was dirty.
(define (build-stamp)
  (let* ((sha (string-trim (process-output->string "git" "rev-parse" "--short=12" "HEAD")))
         (dirty (string-trim (process-output->string "git" "status" "--porcelain" "--untracked-files=no")))
         (sha (if (string=? sha "") "unversioned" sha)))
    (if (string=? dirty "")
        sha
        (string-append sha "-dirty-" (number->string (exact (floor (current-second))))))))

;; After link-web-application: the page stamped with the build.
(define (stamp-web ctx)
  (let* ((stamp (build-stamp))
         (out (config-output-dir (context-config ctx)))
         (page-path (path-join out "index.html"))
         (page (read-file-string page-path)))
    (write-file-string page-path
                       (string-replace (string-replace page "__VERSION__" stamp)
                                       "__TITLE__" "Signal Overdrive"))
    (write-file-string (path-join out "build.txt") (string-append stamp "\n"))
    (unless (= 0 (process-run "node" "scripts/prepare-pwa.mjs" out))
      (error "PWA preparation failed"))
    (display "  web stamp ") (display stamp) (newline)
    ctx))

(package
  name: "signal-overdrive"
  version: "0.1.0"
  sigil: "0.22.11"
  description: "A Mode 7 racer in the spirit of F-Zero, set in the world of Crash The Stack"
  license: "GPL-3.0-or-later"
  authors: (list "David Wilson <david@daviwil.com>")

  entry: '(signal main)
  bundle-name: "signal-overdrive"

  configs: (list
    (config
      name: 'dev
      output-dir: "build/dev"
      debug?: #t
      optimize: 0
      bundle?: #t)
    (config
      name: 'release
      output-dir: "build/release"
      debug?: #f
      optimize: 2
      backend: 'native
      bundle?: #t)
    (config
      name: 'web
      output-dir: "build/web"
      toolchain: 'zig
      target: "wasm32-wasi"
      backend: 'native
      debug?: #f
      optimize: 2
      bundle?: #t
      features: '(web wasm graphics)))

  dependencies: (list
    ;; The shared engine: view, keys, pad, touch sticks, store, params, font.
    (from-git url: "github:substratic/substratic" version: "^0.3.0")
    ;; Window and keyboard (GLFW); native only.
    (from-git url: "codeberg:sigil/sigil-desktop" version: "^0.13.0" configs: '(dev release))
    ;; Drawing, both targets; the 3D path carries the Mode 7 pass.
    (from-git url: "codeberg:sigil/sigil-graphics" version: "^0.13.0")
    ;; Web only: the wasm runtime and loader, the WebGL2 bridge, localStorage.
    (from-git url: sigil-repo package: "sigil-wasm-runtime" version: ">=0.22.11, <0.22.12" configs: '(web))
    (from-git url: sigil-repo package: "sigil-wasm-gles3" version: ">=0.22.11, <0.22.12" configs: '(web))
    (from-git url: sigil-repo package: "sigil-browser" version: ">=0.22.11, <0.22.12" configs: '(web))
    ;; The placeholder sound's sink: miniaudio natively, the WebAudio bridge
    ;; on the web (sigil-wasm-audio), as Phantom Burn.
    (from-git url: "codeberg:sigil/sigil-audio" version: "^0.13.0")
    ;; The live adaptive song; its channel inserts are the measured music path.
    (from-git url: "codeberg:sigil/motif" version: "^0.9.0")
    (from-git url: sigil-repo package: "sigil-wasm-audio" version: ">=0.22.11, <0.22.12" configs: '(web)))

  dev-dependencies: (list
    (from-git url: sigil-repo package: "sigil-test" version: ">=0.22.11, <0.22.12")
    (from-git url: sigil-repo package: "sigil-test-runner" version: ">=0.22.11, <0.22.12"))

  ;; Small reusable API addition absent from the pinned desktop host.
  ;; The wasm implementation is inert; its shell receives DOM focus.
  libraries: (list
    (library
      name: 'signal-overdrive
      c-sources: '("src/c/desktop-focus.c")
      native-init: "sigil__init_signal_extensions"))

  tasks: (list
    (task
      name: 'build
      description: "Compile the racer (and, on the web config, link the browser app)"
      steps: (list
        ;; Lower note-on triggers and the cue sheet before runtime modules
        ;; compile. A mismatched score must fail the build, never linger.
        (lambda (ctx)
          (let ((status (process-run "scripts/compile-score")))
            (unless (= status 0)
              (error "music score compilation failed" status)))
          (let ((status (process-run "scripts/compile-theme")))
            (unless (= status 0)
              (error "theme compilation failed" status)))
          ctx)
        (compile-c-sources sources: '("src/c/desktop-focus.c")
                           flags: (with-sigil-c-flags '("-std=c99")))
        ;; the web config links sigil-audio's native-init with no C of its own
        ;; on wasm: a stub supplies the symbol (src/c/wasm-audio-stub.c, Phantom's)
        (lambda (ctx)
          (if (memq (target-os ctx) '(wasm wasi))
              ((compile-c-sources sources: (list "src/c/wasm-audio-stub.c")
                                  flags: (with-sigil-c-flags '("-std=c99"))) ctx)
              ctx))
        (create-static-library name: "signal-overdrive")
        ;; Default tests need the build-time compiler on the harness's
        ;; module path. Keep it out of release/web runtime artifacts.
        (lambda (ctx)
          (if (eq? (config-name (context-config ctx)) 'dev)
              ((compile-sigil-modules sources: "scripts/music/src/**/*.sgl") ctx)
              ctx))
        (compile-sigil-modules sources: "src/**/*.sgl")
        (link-assets)
        (lambda (ctx)
          (if (memq (target-os ctx) '(wasm wasi))
              (stamp-web ((link-web-application name: "signal-overdrive" html-mount-id: "status") ctx))
              ctx))))))
